{
  "compilerOptions": {
    "module": "commonjs",
    "allowJs": true,
    "noImplicitReturns": true,
    "noUnusedLocals": false,
    "outDir": "lib",
    "rootDir": "src",
    "sourceMap": true,
    "strict": true,
    "target": "es2020",
    "lib": [
      "es2020"
    ],
    "types": [
      "jest",
      "node"
    ],
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "compileOnSave": true,
  "include": [
    "src"
  ],
  "exclude": [
    "src/test"
  ]
}
