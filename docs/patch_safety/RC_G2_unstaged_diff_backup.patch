+            child: Text(isApprove ? 'Confirm Approval' : 'Submit'),
+          ),
+        ],
+      ),
+    );
+
+    if (confirm != true) return;
+
+    try {
+      final db = FirebaseFirestore.instance;
+      final user = FirebaseAuth.instance.currentUser;
+      final now = FieldValue.serverTimestamp();
+
+      final batch = db.batch();
+      final bpRef = db.collection('mission_realms').doc(missionId).collection('crucible_test_blueprints').doc(blueprintId);
+
+      batch.update(bpRef, {
+        'status': targetStatus,
+        'founderReviewStatus': targetStatus,
+        'approvedForQuestionGeneration': isApprove,
+        'reviewedBy': user?.email ?? 'Founder',
+        'reviewedAt': now,
+        'reviewNote': noteCtrl.text.trim().isEmpty ? null : noteCtrl.text.trim(),
+        'updatedAt': now,
+      });
+
+      await batch.commit();
+      
+      // Update plan summary
+      await _updatePlanSummary();
+      
+      scaffold.showSnackBar(SnackBar(content: Text('Blueprint $targetStatus successfully.')));
+    } catch (e) {
+      scaffold.showSnackBar(SnackBar(content: Text('Error: $e')));
+    }
+  }
+
+  Future<void> _updatePlanSummary() async {
+    final db = FirebaseFirestore.instance;
+    final blueprints = await db
+        .collection('mission_realms')
+        .doc(missionId)
+        .collection('crucible_test_blueprints')
+        .where('planId', isEqualTo: planId)
+        .where('status', isNotEqualTo: 'SUPERSEDED')
+        .get();
+
+    int total = blueprints.docs.length;
+    int approved = blueprints.docs.where((d) => d.data()['status'] == 'APPROVED').length;
+    int rejected = blueprints.docs.where((d) => d.data()['status'] == 'REJECTED').length;
+    int revision = blueprints.docs.where((d) => d.data()['status'] == 'NEEDS_REVISION').length;
+
+    String planStatus = 'REVIEW_IN_PROGRESS';
+    if (approved == total && total > 0) planStatus = 'APPROVED';
+    if (revision > 0) planStatus = 'NEEDS_REVISION';
+
+    await db.collection('mission_realms').doc(missionId).collection('crucible_plans').doc(planId).update({
+      'testBlueprintStatus': planStatus,
+      'testBlueprintApprovedCount': approved,
+      'testBlueprintRejectedCount': rejected,
+      'testBlueprintNeedsRevisionCount': revision,
+      'readyForQuestionGeneration': approved == total && total > 0,
+      'lastTestBlueprintReviewAt': FieldValue.serverTimestamp(),
+    });
+  }
