+  static List<Recruitment> _missionRealmToRecruitments(
+    String missionId,
+    Map<String, dynamic> data,
+  ) {
+    final variables = data['variables'];
+    final activeVariables = variables is List
+        ? variables
+            .whereType<Map>()
+            .map((item) => item.cast<String, dynamic>())
+            .where((item) => item['status'] != 'archived')
+            .toList()
+        : <Map<String, dynamic>>[];
+
+    if (activeVariables.isEmpty) {
+      return [
+        _missionRealmRecruitment(data, missionId: missionId),
+      ];
+    }
+
+    return activeVariables.map((variable) {
+      return _missionRealmRecruitment(
+        data,
+        missionId: missionId,
+        variable: variable,
+      );
+    }).toList();
+  }
+
+  static Recruitment _missionRealmRecruitment(
+    Map<String, dynamic> mission, {
+    required String missionId,
+    Map<String, dynamic>? variable,
+  }) {
+    final missionTitle =
+        _firstText([mission['name'], mission['title'], missionId]);
+    final missionCode = _firstText([mission['code'], missionId]);
+    final variableId = _firstText([variable?['id'], 'default']);
+    final variableName = _firstText([variable?['name'], variable?['code']]);
+    final variableCode = _firstText([variable?['code'], variableId]);
+    final title =
+        variable == null ? missionTitle : '$missionTitle - $variableName';
+    final year =
+        int.tryParse('${mission['year'] ?? mission['exam_year'] ?? mission['examYear'] ?? ''}') ?? DateTime.now().year;
+
+    return Recruitment(
+      id: variable == null ? missionId : '${missionId}_$variableId',
+      recruitmentGroupId: missionId,
+      boardId: _firstText([mission['organizationCode'], mission['boardId']]),
+      examId: missionCode,
+      examBlueprintId: variable == null
+          ? '${missionCode}_BLUEPRINT'
+          : '${missionCode}_${variableCode}_BLUEPRINT',
+      title: title,
+      titleHindi:
+          _firstText([variable?['hindiName'], mission['titleHindi'], title]),
+      year: year,
+      state: _firstText([mission['state'], 'Rajasthan']),
+      examCategory: _firstText([mission['examCategory'], mission['exam_category'], 'competitive']),
+      status: 'published',
+      examDifficulty: _toDouble(mission['examDifficulty'], fallback: 0.6),
+      variantCode: variable == null ? missionCode : variableCode,
+      version: _firstText([mission['version'], '1.0.0']),
+      priority: int.tryParse('${mission['priority'] ?? mission['displayOrder'] ?? mission['sortOrder'] ?? '0'}') ?? 0,
+      nature: _firstText([mission['nature'], mission['status'], 'PASSIVE']),
+      catalogStatus: _firstText([mission['catalogStatus'], mission['status'], 'COMING_SOON']),
+      studentMessage: _firstText([mission['studentMessage']]),
+      contentReadiness: mission['contentReadiness'] != null ? Map<String, dynamic>.from(mission['contentReadiness']) : const {},
+    );
+  }
+
+  static String _firstText(List<dynamic> values) {
+    for (final value in values) {
+      final text = value?.toString().trim() ?? '';
+      if (text.isNotEmpty) return text;
+    }
+    return '';
+  }
+
+  static double _toDouble(dynamic value, {required double fallback}) {
+    if (value is num) return value.toDouble();
+    return double.tryParse(value?.toString() ?? '') ?? fallback;
