+  void _handleOpenWorkItem(BuildContext context, String taskId, Map<String, dynamic> task, Map<String, dynamic>? currentPermissions) {
+    final reqPerm = task['requiredPermission']?.toString();
+    bool hasPermission = true;
+    if (currentPermissions != null && reqPerm != null) {
+      if (reqPerm == 'ingestionReviewView') {
+         hasPermission = currentPermissions['ingestionReviewView'] == true || currentPermissions['missionDocumentsView'] == true;
+      } else {
+         hasPermission = currentPermissions[reqPerm] == true;
+      }
+    }
+
+    if (!hasPermission) {
+      _logAccessDenied(taskId, task, reqPerm ?? 'unknown');
+      if (context.mounted) {
+        ScaffoldMessenger.of(context).showSnackBar(
+          const SnackBar(content: Text('Permission revoked by Founder. You cannot open this task.'), backgroundColor: Colors.red),
+        );
+      }
+      return;
+    }
+
+    final String type = task['taskType'] ?? '';
+    String message = 'Deep link pending. Open relevant module manually.';
+    
+    if (type == 'DOCUMENT_REVIEW' || type == 'OCR_REPROCESS_REVIEW' || type == 'NOTIFICATION_AUDIT' || type == 'AMENDMENT_LINK_AUDIT') {
+      message = 'Open "INTEL" tab to review assets.';
+    } else if (type == 'SYLLABUS_ATOM_REVIEW' || type == 'PYQ_QUESTION_REVIEW') {
+      message = 'Open "REVIEW" tab for detailed audit.';
+    } else if (type == 'CRUCIBLE_PLAN_AUDIT' || type == 'BLUEPRINT_REVIEW' || type == 'QUESTION_SET_REVIEW') {
+      message = 'Open "MISSION" tab -> Open Mission Detail -> View Crucible.';
+    }
+
+    if (onOpenTask != null) {
+      onOpenTask!(taskId, type, task['missionId']);
+      return;
+    }
+
+    ScaffoldMessenger.of(context).showSnackBar(
+      SnackBar(
+        content: Text(message),
+        duration: const Duration(seconds: 5),
+        action: SnackBarAction(label: 'OK', onPressed: () {}),
+      ),
+    );
+  }
+
+  Future<void> _logAccessDenied(String taskId, Map<String, dynamic> task, String reqPerm) async {
+    try {
+      final user = FirebaseAuth.instance.currentUser;
+      final now = FieldValue.serverTimestamp();
+      await FirebaseFirestore.instance.collection('admin_task_audit').add({
+        'taskId': taskId,
+        'action': 'TASK_ACCESS_DENIED',
+        'actorUid': user?.uid,
+        'actorEmail': user?.email,
+        'targetAdminUid': user?.uid,
+        'requiredPermission': reqPerm,
+        'reason': 'PERMISSION_REVOKED',
+        'timestamp': now,
+      });
+    } catch (e) {
+      debugPrint('Failed to log TASK_ACCESS_DENIED: $e');
+    }
+  }
 }
