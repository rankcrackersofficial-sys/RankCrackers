+              decoration: const InputDecoration(hintText: 'Note...'),
+              maxLines: 3,
+            ),
+          ],
+        ),
+        actions: [
+          TextButton(onPressed: () => Navigator.pop(context, false), child: const Text('Cancel')),
+          FilledButton(
+            onPressed: () => Navigator.pop(context, true),
+            style: FilledButton.styleFrom(backgroundColor: isReject ? rcRed : rcGold),
+            child: const Text('Submit'),
+          ),
+        ],
+      ),
+    ) ?? false;
+
+    if (!confirm || ctrl.text.trim().isEmpty) return;
+
+    setState(() => _loading = true);
+    try {
+      final db = FirebaseFirestore.instance;
+      final now = FieldValue.serverTimestamp();
+      final user = FirebaseAuth.instance.currentUser;
+
+      await db.runTransaction((transaction) async {
+        final setRef = db.collection('mission_realms').doc(widget.missionId).collection('crucible_question_sets').doc(widget.setId);
+        
+        transaction.update(setRef, {
+          'status': targetStatus,
+          'founderReviewStatus': targetStatus,
+          'approvedForAssessmentBuild': false,
+          'reviewNote': ctrl.text.trim(),
+          'reviewedBy': user?.email ?? user?.uid,
+          'reviewedAt': now,
+          'updatedAt': now,
+        });
+
+        // Mirror to blueprint
+        final blueprintId = set['blueprintId'];
+        if (blueprintId != null) {
+          final bpRef = db.collection('mission_realms').doc(widget.missionId).collection('crucible_test_blueprints').doc(blueprintId);
+          transaction.update(bpRef, {
+            'questionSetStatus': targetStatus,
+            'questionSetApproved': false,
+            'lastQuestionSetReviewAt': now,
+          });
+        }
+
+        // Update plan summary
+        final planId = set['planId'];
+        if (planId != null) {
+          final planRef = db.collection('mission_realms').doc(widget.missionId).collection('crucible_plans').doc(planId);
+          // Simple count update without full fetch for performance in rejection
+          transaction.update(planRef, {
+            'questionSetStatus': 'NEEDS_REVISION',
+            'readyForAssessmentBuild': false,
+            'lastQuestionSetReviewAt': now,
+          });
+        }
+      });
+
+      if (mounted) {
+        ScaffoldMessenger.of(context).showSnackBar(SnackBar(content: Text('Question set marked as $targetStatus.')));
+        Navigator.pop(context);
+      }
+    } catch (e) {
+      if (mounted) {
+        ScaffoldMessenger.of(context).showSnackBar(SnackBar(content: Text('Error updating set: $e')));
+      }
+    } finally {
+      if (mounted) setState(() => _loading = false);
+    }
+  }
