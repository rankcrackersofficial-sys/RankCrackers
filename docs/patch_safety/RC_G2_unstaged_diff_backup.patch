+  Future<void> _handleDoctorAction(BuildContext context, String action) async {
+    final scaffold = ScaffoldMessenger.of(context);
+    final db = FirebaseFirestore.instance;
+    final now = FieldValue.serverTimestamp();
+
+    try {
+      if (action == 'RETRY' || action == 'RETRY_NATIVE') {
+         await db.collection('ai_queue').doc(documentId).set({
+           'status': 'received',
+           'requestedMode': action == 'RETRY_NATIVE' ? 'NATIVE_ONLY' : 'ENGLISH_VISION_OCR',
+           'manualTrigger': true,
+           'updatedAt': now,
+         }, SetOptions(merge: true));
+         scaffold.showSnackBar(const SnackBar(content: Text('Re-extraction task queued.')));
+      } else if (action == 'FORCE_QUEUE') {
+         await db.collection('ai_queue').doc(documentId).update({
+           'status': 'received',
+           'bypassBudget': true,
+           'updatedAt': now,
+         });
+         scaffold.showSnackBar(const SnackBar(content: Text('Bypassing budget / Force Queue.')));
+      } else if (action == 'VERIFY_PRO') {
+         final verifyTaskId = 'verify_${data['latestDraftId'] ?? documentId}';
+         await db.collection('ai_queue').doc(verifyTaskId).set({
+            'type': 'SENTINEL_VERIFICATION',
+            'provider': 'gemini_pro',
+            'status': 'received',
+            'createdAt': now,
+            'payload': { 'documentId': documentId, 'missionId': missionId }
+         }, SetOptions(merge: true));
+         scaffold.showSnackBar(const SnackBar(content: Text('Pro Verification queued.')));
+      } else if (action == 'OUT_OF_SCOPE') {
+         await db.collection('mission_realms').doc(missionId).collection('official_documents').doc(documentId).update({
+           'health_status': 'OUT_OF_SCOPE',
+           'status': 'ARCHIVED',
+           'updatedAt': now,
+         });
+         scaffold.showSnackBar(const SnackBar(content: Text('Marked as Out of Pilot Scope.')));
+      } else if (action == 'ARCHIVE') {
+         await db.collection('mission_realms').doc(missionId).collection('official_documents').doc(documentId).update({
+           'status': 'ARCHIVED',
+           'updatedAt': now,
+         });
+         scaffold.showSnackBar(const SnackBar(content: Text('Document archived.')));
+      }
+
+      if (context.mounted) Navigator.pop(context);
+    } catch (e) {
+      scaffold.showSnackBar(SnackBar(content: Text('Action failed: $e'), backgroundColor: rcRed));
+    }
+  }
+
+  Future<void> _reprocessDocument(BuildContext context, String mode) async {
+    final scaffold = ScaffoldMessenger.of(context);
+    try {
+      await FirebaseFirestore.instance.collection('ai_queue').doc(documentId).set({
+        'type': 'pdfParse',
+        'provider': 'gemini',
+        'sourceType': 'MISSION_DOCUMENT',
+        'documentId': documentId,
+        'missionId': missionId,
+        'reprocessReason': 'LOW_QUALITY_OCR',
+        'requestedMode': mode,
+        'status': 'received',
+        'manualTrigger': true,
+        'createdAt': FieldValue.serverTimestamp(),
+      }, SetOptions(merge: true));
+      
+      scaffold.showSnackBar(SnackBar(content: Text('Reprocess task queued: $mode')));
+      if (context.mounted) Navigator.pop(context);
+    } catch (e) {
+      scaffold.showSnackBar(SnackBar(content: Text('Failed to queue reprocess: $e')));
+    }
+  }
