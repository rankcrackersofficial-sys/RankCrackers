index ee6f37b..325f4e8 100644
--- a/storage.rules
+++ b/storage.rules
@@ -1,27 +1,64 @@
 rules_version = '2';
 service firebase.storage {
   match /b/{bucket}/o {
+    function isFounder() {
+      return request.auth != null && (
+        request.auth.token.founder == true ||
+        (request.auth.token.email_verified == true && (
+          request.auth.token.email == 'rankcrackersofficial@gmail.com' ||
+          request.auth.token.email == 'rankcrackers.founder@gmail.com' ||
+          request.auth.token.email == 'founder.rcofficial@gmail.com'
+        ))
+      );
+    }
+
+    function isAdmin() {
+      return request.auth != null && (
+        request.auth.token.admin == true || isFounder()
+      );
+    }
 
-    // 🔱 USER ASSETS: Citizens can read/write their own identity folder
+    //  USER ASSETS: Citizens can read/write their own identity folder
     match /users/{userId}/{allPaths=**} {
       allow read, write: if request.auth != null && request.auth.uid == userId;
     }
 
-    // 🔱 PUBLIC ASSETS: Authenticated users can read mission/educational content
+    //  PUBLIC ASSETS: Authenticated users can read mission/educational content
     match /assets/{allPaths=**} {
       allow read: if request.auth != null;
-      allow write: if request.auth != null && (request.auth.token.admin == true || request.auth.token.founder == true);
+      allow write: if isFounder() || isAdmin();
     }
 
-    // 🔱 CERTIFICATES: Users can read their own, only workers can write
+    //  CERTIFICATES: Users can read their own, only workers can write
     match /certificates/{userId}/{allPaths=**} {
       allow read: if request.auth != null && request.auth.uid == userId;
       allow write: if false; // Handled by Render Worker (Admin SDK)
     }
 
-    // 🔱 INGESTION: Sentinel Worker path
+    //  MISSION DOCUMENTS: Founder-managed official mission documents
+    match /mission_realms/{missionId}/official_documents/{allPaths=**} {
+      allow read, write: if isFounder() || isAdmin();
+    }
+
+    //  STUDY LIBRARY: Independent subject-wise study material library
+    match /study_library/{allPaths=**} {
+      allow read, write: if isFounder() || isAdmin();
+    }
+
+    //  INGESTION: Sentinel Worker path
     match /ingestion/{allPaths=**} {
-      allow read, write: if request.auth != null && (request.auth.token.admin == true || request.auth.token.founder == true);
+      allow read, write: if isFounder();
+    }
+
+    //  INGESTION REFINERY: Raw uploads and structured extraction files (Founder only)
+    match /ingestion_refinery/{allPaths=**} {
+      allow read, write: if isFounder();
+    }
+
+    //  PUBLISHED ASSETS: Read-access for all auth users, writes restricted to Admin/Founder
+    match /published_assets/{allPaths=**} {
+      allow read: if request.auth != null;
+      allow write: if isFounder() || isAdmin();
     }
   }
 }
