+        color: col.withValues(alpha: 0.1),
+        borderRadius: BorderRadius.circular(4),
+        border: Border.all(color: col.withValues(alpha: 0.3)),
+      ),
+      child: Text(status, style: TextStyle(color: col, fontSize: 9, fontWeight: FontWeight.bold)),
+    );
+  }
