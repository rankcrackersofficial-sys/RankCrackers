+class _ReviewButton extends StatefulWidget {
+  final String? linkedDraftId;
+  final String? sourceId;
+  const _ReviewButton({this.linkedDraftId, this.sourceId});
+
+  @override
+  State<_ReviewButton> createState() => _ReviewButtonState();
+}
+
+class _ReviewButtonState extends State<_ReviewButton> {
+  bool _isLoading = false;
+
+  @override
+  Widget build(BuildContext context) {
+    if (widget.linkedDraftId == null && widget.sourceId == null) {
+      return const SizedBox.shrink();
+    }
+
+    if (_isLoading) {
+      return const SizedBox(
+          width: 16,
+          height: 16,
+          child:
+              CircularProgressIndicator(strokeWidth: 2, color: AppColors.gold));
     }
+
+    return IconButton(
+      onPressed: () async {
+        setState(() => _isLoading = true);
+        try {
+          DocumentSnapshot<Map<String, dynamic>>? snap;
+          if (widget.linkedDraftId != null) {
+            snap = await FirebaseFirestore.instance
+                .collection('sentinel_drafts')
+                .doc(widget.linkedDraftId)
+                .get();
+          }
+          if ((snap == null || !snap.exists) && widget.sourceId != null) {
+            final fallback = await FirebaseFirestore.instance
+                .collection('sentinel_drafts')
+                .where('sourceId', isEqualTo: widget.sourceId)
+                .limit(1)
+                .get();
+            if (fallback.docs.isNotEmpty) snap = fallback.docs.first;
+          }
+          if (snap != null && snap.exists && mounted) {
+            final draft =
+                SentinelDraft.fromMap({...snap.data()!, 'id': snap.id});
+            if (!context.mounted) return;
+            Navigator.push(
+              context,
+              MaterialPageRoute(
+                  builder: (context) => VerificationWorkspace(draft: draft)),
+            );
+          } else if (context.mounted) {
+            ScaffoldMessenger.of(context).showSnackBar(
+              const SnackBar(
+                content: Text("Review draft not ready yet. Reprocess if this upload is stuck."),
+              ),
+            );
+          }
+        } finally {
+          if (mounted) setState(() => _isLoading = false);
+        }
+      },
+      icon: const Icon(Icons.rate_review_rounded,
+          color: AppColors.gold, size: 16),
+      padding: EdgeInsets.zero,
+      constraints: const BoxConstraints(),
+      visualDensity: VisualDensity.compact,
+    );
   }
 }
 
