+  String _getNextStepText(Map<String, dynamic> data) {
+    final queue = _getQueueStatus(data);
+    final isExtracted = _isExtractionGood(data);
+    final isVerified = _getFounderReviewStatusLabel(data) == 'VERIFIED';
+    final type = (data['documentType'] ?? '').toString();
+    final extractionQuality = data['extractionQuality'] ?? 'UNKNOWN';
+
+    if (queue != 'COMPLETED') return 'Wait for AI extraction to finish, then review the output.';
+    if (extractionQuality == 'FAILED') return 'Hindi/OCR extraction quality failed. Reprocess required.';
+    if (!isExtracted) return 'AI failed to extract structured data. Check Technical Details or re-upload.';
+    if (!isVerified) {
+       if (type.contains('syllabus')) return 'Open "Review Syllabus Atoms" to verify extracted topics.';
+       if (type.contains('pyq')) return 'Open "Review PYQ Questions" to verify questions and link atoms.';
+       return 'Review extracted facts and verify accuracy.';
+    }
+    if (data['appliedToMission'] != true) return 'Verification complete. Apply verified data to mission structures.';
+    if (_getAccessStatus(data) != 'LIVE') return 'Mission logic updated. Move document to Published state for student use.';
+    
+    return 'Document journey complete. Monitor Crucible/DigiBook usage stats.';
+  }
