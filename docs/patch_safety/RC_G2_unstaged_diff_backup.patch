+              ),
+              if (error != null) ...[
+                const SizedBox(height: 12),
+                Text(
+                  'Diagnostic details: $error',
+                  textAlign: TextAlign.center,
+                  style: AppTypography.body.copyWith(
+                      color: Colors.redAccent, fontSize: 12),
+                ),
+              ],
+            ],
+          ),
+        ),
+      );
+    }
+    return Center(
+      child: Padding(
+        padding: const EdgeInsets.symmetric(vertical: 40),
+        child: Text(
+          'No $selectedCategory missions found for $selectedState.',
+          textAlign: TextAlign.center,
+          style: AppTypography.body.copyWith(color: Colors.white24),
+        ),
+      ),
+    );
+  }
+
+  Widget _sectionTitle(String title) {
+    return Text(
+      title,
+      style: AppTypography.label
+          .copyWith(color: AppColors.gold, letterSpacing: 2.0, fontSize: 10),
+    );
+  }
+
+  List<_MissionGroup> _groupMissionVariables(List<Recruitment> missions) {
+    final grouped = <String, List<Recruitment>>{};
+    for (final mission in missions) {
+      grouped.putIfAbsent(_missionGroupId(mission), () => []).add(mission);
+    }
+
+    return grouped.entries.map((entry) {
+      final variables = entry.value
+        ..sort((a, b) => _variantTitle(a).compareTo(_variantTitle(b)));
+      return _MissionGroup(
+        id: entry.key,
+        title: _missionTitle(variables.first),
+        primary: variables.first,
+        variables: variables,
+      );
+    }).toList()
+      ..sort((a, b) {
+        final pComp = a.primary.priority.compareTo(b.primary.priority);
+        if (pComp != 0) return pComp;
+        return a.title.compareTo(b.title);
+      });
+  }
+
+  String _missionGroupId(Recruitment recruitment) {
+    return recruitment.recruitmentGroupId.isNotEmpty
+        ? recruitment.recruitmentGroupId
+        : recruitment.id;
+  }
+
+  String _missionTitle(Recruitment recruitment) {
+    final parts = recruitment.title.split(' - ');
+    return parts.first.trim().isEmpty ? recruitment.title : parts.first.trim();
+  }
+
+  String _variantTitle(Recruitment recruitment) {
+    final parts = recruitment.title.split(' - ');
+    if (parts.length > 1 && parts.last.trim().isNotEmpty) {
+      return parts.last.trim();
+    }
+    return recruitment.variantCode.isNotEmpty
+        ? recruitment.variantCode
+        : recruitment.title;
+  }
+}
+
+class _MissionGroup {
+  final String id;
+  final String title;
+  final Recruitment primary;
+  final List<Recruitment> variables;
+
+  const _MissionGroup({
+    required this.id,
+    required this.title,
+    required this.primary,
+    required this.variables,
+  });
 }
