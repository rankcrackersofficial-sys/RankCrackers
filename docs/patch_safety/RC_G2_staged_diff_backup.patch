+import 'package:cloud_firestore/cloud_firestore.dart';
+import 'package:firebase_auth/firebase_auth.dart';
+import 'package:flutter/material.dart';
+
+import '../../shared/rc_colors.dart';
+import '../../shared/rc_loaders.dart';
+import '../../shared/rc_panel.dart';
+
+class PyqQuestionReviewCenter extends StatefulWidget {
+  final String missionId;
+  final String? initialDocumentId;
+  final List<QueryDocumentSnapshot<Map<String, dynamic>>> variables;
+
+  const PyqQuestionReviewCenter({
+    super.key,
+    required this.missionId,
+    this.initialDocumentId,
+    required this.variables,
+  });
+
+  @override
+  State<PyqQuestionReviewCenter> createState() => _PyqQuestionReviewCenterState();
+}
+
+class _PyqQuestionReviewCenterState extends State<PyqQuestionReviewCenter> {
+  String? _documentFilter;
+  String _statusFilter = 'all'; // all, DRAFT, APPROVED, REJECTED, NEEDS_CORRECTION
+  String _variableFilter = 'all';
+  bool _missingProofOnly = false;
+  bool _missingAnswerOnly = false;
+
+  @override
+  void initState() {
+    super.initState();
+    _documentFilter = widget.initialDocumentId;
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    return Column(
+      children: [
+        _buildHeader(),
+        _buildFilters(),
+        Expanded(child: _buildQuestionList()),
+      ],
+    );
+  }
+
+  Widget _buildHeader() {
+    return StreamBuilder<QuerySnapshot<Map<String, dynamic>>>(
+      stream: FirebaseFirestore.instance
+          .collection('mission_realms')
+          .doc(widget.missionId)
+          .collection('question_bank')
+          .snapshots(),
+      builder: (context, snapshot) {
+        final docs = snapshot.data?.docs ?? [];
+        final total = docs.length;
+        final approved = docs.where((d) => d.data()['status'] == 'APPROVED').length;
+        final pending = docs.where((d) => d.data()['status'] == 'DRAFT').length;
+        final ready = docs.where((d) => d.data()['readyForCrucible'] == true).length;
+
+        return Container(
+          padding: const EdgeInsets.symmetric(horizontal: 24, vertical: 16),
+          color: rcSurface.withValues(alpha: 0.5),
+          child: Row(
+            children: [
+              _stat('Total Questions', total.toString(), Colors.white),
+              const SizedBox(width: 24),
+              _stat('Pending Review', pending.toString(), rcGold),
+              const SizedBox(width: 24),
+              _stat('Approved', approved.toString(), rcGreen),
+              const SizedBox(width: 24),
+              _stat('Ready for Crucible', ready.toString(), Colors.blue),
+            ],
+          ),
+        );
+      },
+    );
+  }
+
+  Widget _stat(String label, String value, Color color) {
+    return Column(
+      crossAxisAlignment: CrossAxisAlignment.start,
+      children: [
+        Text(label, style: const TextStyle(color: Colors.white30, fontSize: 10, fontWeight: FontWeight.bold)),
+        Text(value, style: TextStyle(color: color, fontSize: 18, fontWeight: FontWeight.w900)),
+      ],
+    );
+  }
+
+  Widget _buildFilters() {
+    return Padding(
+      padding: const EdgeInsets.all(16),
+      child: RcPanel(
+        child: Wrap(
+          spacing: 12,
+          runSpacing: 12,
+          crossAxisAlignment: WrapCrossAlignment.center,
+          children: [
+            SizedBox(
+              width: 200,
+              child: DropdownButtonFormField<String>(
+                value: _statusFilter,
+                decoration: const InputDecoration(labelText: 'Status'),
+                items: const [
+                  DropdownMenuItem(value: 'all', child: Text('All Statuses')),
+                  DropdownMenuItem(value: 'DRAFT', child: Text('Draft / Pending')),
+                  DropdownMenuItem(value: 'APPROVED', child: Text('Approved')),
+                  DropdownMenuItem(value: 'REJECTED', child: Text('Rejected')),
+                  DropdownMenuItem(value: 'NEEDS_CORRECTION', child: Text('Needs Correction')),
+                ],
+                onChanged: (v) => setState(() => _statusFilter = v!),
+              ),
+            ),
+            SizedBox(
+              width: 180,
+              child: DropdownButtonFormField<String>(
+                value: _variableFilter,
+                decoration: const InputDecoration(labelText: 'Variable'),
+                items: [
+                  const DropdownMenuItem(value: 'all', child: Text('All Variables')),
+                  ...widget.variables.map((v) => DropdownMenuItem(
+                        value: v.id,
+                        child: Text(v.data()['displayName'] ?? v.id),
+                      )),
+                ],
+                onChanged: (v) => setState(() => _variableFilter = v!),
+              ),
+            ),
+            _filterToggle('Missing Proof', _missingProofOnly, (v) => setState(() => _missingProofOnly = v)),
+            _filterToggle('Missing Answer', _missingAnswerOnly, (v) => setState(() => _missingAnswerOnly = v)),
+            if (_documentFilter != null)
+              Chip(
+                label: const Text('Filtered by Document'),
+                onDeleted: () => setState(() => _documentFilter = null),
+                backgroundColor: rcGold.withValues(alpha: 0.1),
+                labelStyle: const TextStyle(color: rcGold, fontSize: 11),
+                deleteIconColor: rcGold,
+              ),
+          ],
+        ),
+      ),
+    );
+  }
+
+  Widget _filterToggle(String label, bool value, ValueChanged<bool> onChanged) {
+    return Row(
+      mainAxisSize: MainAxisSize.min,
+      children: [
+        Text(label, style: const TextStyle(fontSize: 12, color: Colors.white54)),
+        Switch(value: value, onChanged: onChanged),
+      ],
+    );
+  }
+
+  Widget _buildQuestionList() {
+    Query<Map<String, dynamic>> query = FirebaseFirestore.instance
+        .collection('mission_realms')
+        .doc(widget.missionId)
+        .collection('question_bank');
+
+    if (_documentFilter != null) query = query.where('documentId', isEqualTo: _documentFilter);
+    if (_statusFilter != 'all') query = query.where('status', isEqualTo: _statusFilter);
+    if (_variableFilter != 'all') query = query.where('variableId', isEqualTo: _variableFilter);
+
+    return StreamBuilder<QuerySnapshot<Map<String, dynamic>>>(
+      stream: query.snapshots(),
+      builder: (context, snapshot) {
+        if (!snapshot.hasData) return const RcCenteredLoader(compact: true);
+        var docs = snapshot.data!.docs;
+
+        if (_missingProofOnly) {
+          docs = docs.where((d) => d.data()['sourceProofComplete'] != true).toList();
+        }
+        if (_missingAnswerOnly) {
+          docs = docs.where((d) => d.data()['answerProofComplete'] != true).toList();
+        }
+
+        if (docs.isEmpty) {
+          return const Center(child: Text('No questions match current filters.'));
+        }
+
+        return ListView.builder(
+          padding: const EdgeInsets.all(24),
+          itemCount: docs.length,
+          itemBuilder: (context, index) {
+            final doc = docs[index];
+            return _QuestionReviewCard(
+              missionId: widget.missionId,
+              questionId: doc.id,
+              data: doc.data(),
+            );
+          },
+        );
+      },
+    );
+  }
+}
+
+class _QuestionReviewCard extends StatefulWidget {
+  final String missionId;
+  final String questionId;
+  final Map<String, dynamic> data;
+
+  const _QuestionReviewCard({
+    required this.missionId,
+    required this.questionId,
+    required this.data,
+  });
+
+  @override
+  State<_QuestionReviewCard> createState() => _QuestionReviewCardState();
+}
+
+class _QuestionReviewCardState extends State<_QuestionReviewCard> {
+  final List<String> _selectedAtomIds = [];
+  bool _loading = false;
+
+  @override
+  void initState() {
+    super.initState();
+    final existing = widget.data['syllabusAtomIds'] as List?;
+    if (existing != null) {
+      _selectedAtomIds.addAll(existing.cast<String>());
+    }
+  }
+
+  Future<void> _updateStatus(String status, bool ready, {String? note}) async {
+    setState(() => _loading = true);
+    final db = FirebaseFirestore.instance;
+    final now = FieldValue.serverTimestamp();
+    final user = FirebaseAuth.instance.currentUser;
+
+    try {
+      await db.runTransaction((transaction) async {
+        final qRef = db.collection('mission_realms').doc(widget.missionId).collection('question_bank').doc(widget.questionId);
+        transaction.update(qRef, {
+          'status': status,
+          'reviewStatus': status,
+          'founderReviewStatus': status,
+          'readyForCrucible': ready,
+          'syllabusAtomIds': _selectedAtomIds,
+          'reviewedBy': user?.email ?? user?.uid,
+          'reviewedAt': now,
+          'updatedAt': now,
+          if (note != null) 'reviewNote': note,
+        });
+
+        // Update document summary
+        final docId = widget.data['documentId'];
+        if (docId != null) {
+          final docRef = db.collection('mission_realms').doc(widget.missionId).collection('official_documents').doc(docId);
+          
+          final qSnap = await db.collection('mission_realms').doc(widget.missionId).collection('question_bank')
+              .where('documentId', isEqualTo: docId).get();
+          
+          int total = qSnap.docs.length;
+          int approved = 0;
+          int rejected = 0;
+          int needsCorr = 0;
+          int readyCount = 0;
+          int draft = 0;
+
+          for (var d in qSnap.docs) {
+            final data = d.data();
+            final s = d.id == widget.questionId ? status : (data['status'] ?? 'DRAFT');
+            final r = d.id == widget.questionId ? ready : (data['readyForCrucible'] == true);
+
+            if (s == 'APPROVED') approved++;
+            else if (s == 'REJECTED') rejected++;
+            else if (s == 'NEEDS_CORRECTION') needsCorr++;
+            else draft++;
+
+            if (r) readyCount++;
+          }
+
+          transaction.update(docRef, {
+            'approvedQuestionCount': approved,
+            'rejectedQuestionCount': rejected,
+            'needsCorrectionQuestionCount': needsCorr,
+            'draftQuestionCount': draft,
+            'readyForCrucibleQuestionCount': readyCount,
+            'lastQuestionReviewAt': now,
+          });
+        }
+      });
+      if (mounted) {
+        ScaffoldMessenger.of(context).showSnackBar(SnackBar(content: Text('Question marked as $status')));
+      }
+    } catch (e) {
+      if (mounted) {
+        ScaffoldMessenger.of(context).showSnackBar(SnackBar(content: Text('Error updating question: $e')));
+      }
+    } finally {
+      if (mounted) setState(() => _loading = false);
+    }
+  }
+
+  void _showActionDialog(String action) {
+    final ctrl = TextEditingController();
+    final bool isReject = action == 'REJECTED';
+
+    showDialog(
+      context: context,
+      builder: (context) => AlertDialog(
+        backgroundColor: rcSurface,
+        title: Text(isReject ? 'REJECT QUESTION' : 'MARK NEEDS CORRECTION'),
+        content: TextField(
+          controller: ctrl,
+          decoration: const InputDecoration(labelText: 'Reason / Note'),
+          maxLines: 3,
+        ),
