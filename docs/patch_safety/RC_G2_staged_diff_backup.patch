@@ -0,0 +1,66 @@
+const admin = require("firebase-admin");
+
+/**
+ * 🔱 GRAPH TRAVERSAL SERVICE (RC-P13-C)
+ * Recursive Graph Explorer for Knowledge Lineage and Fact Discovery.
+ */
+
+const db = admin.firestore();
+
+/**
+ * Traverses down from an entity to find all connected Atomic Facts.
+ * Path: Realm -> Subject -> Major -> Macro -> AMTN -> Atomic Facts
+ */
+async function getEntityFacts(entityId, depth = 0) {
+    if (depth > 10) return []; // Safety recursion guard
+
+    // 1. Check if the entity is itself an Atomic Fact
+    const entityDoc = await db.collection('entity_registry').doc(entityId).get();
+    if (entityDoc.exists && entityDoc.data().entityType === 'ATOMIC_FACT') {
+        return [{ id: entityId, weight: entityDoc.data().metadata?.importance || 1 }];
+    }
+
+    // 2. Find all child edges
+    const edgesSnap = await db.collection('entity_edges')
+        .where('from', '==', entityId)
+        .get();
+
+    if (edgesSnap.empty) return [];
+
+    const factPromises = edgesSnap.docs.map(edgeDoc => {
+        const edge = edgeDoc.data();
+        return getEntityFacts(edge.to, depth + 1);
+    });
+
+    const results = await Promise.all(factPromises);
+    return results.flat();
+}
+
+/**
+ * Retrieves the Lineage (Ancestors) of a fact.
+ */
+async function getFactLineage(factId) {
+    const lineage = [factId];
+    let currentId = factId;
+    let hasParent = true;
+
+    while (hasParent) {
+        const parentEdge = await db.collection('entity_edges')
+            .where('to', '==', currentId)
+            .limit(1)
+            .get();
+
+        if (parentEdge.empty) {
+            hasParent = false;
+        } else {
+            currentId = parentEdge.docs[0].data().from;
+            lineage.push(currentId);
+        }
+    }
+    return lineage.reverse();
+}
+
+module.exports = {
+    getEntityFacts,
+    getFactLineage
+};
