@@ -0,0 +1,219 @@
+import 'package:cloud_firestore/cloud_firestore.dart';
+import 'package:firebase_auth/firebase_auth.dart';
+import 'package:flutter/material.dart';
+import '../../shared/rc_colors.dart';
+
+class SyllabusAtomBulkReviewPanel extends StatelessWidget {
+  final String missionId;
+  final List<String> selectedAtomIds;
+  final List<Map<String, dynamic>> selectedAtoms;
+  final VoidCallback onClear;
+  final VoidCallback onSuccess;
+
+  const SyllabusAtomBulkReviewPanel({
+    super.key,
+    required this.missionId,
+    required this.selectedAtomIds,
+    required this.selectedAtoms,
+    required this.onClear,
+    required this.onSuccess,
+  });
+
+  @override
+  Widget build(BuildContext context) {
+    if (selectedAtomIds.isEmpty) return const SizedBox.shrink();
+
+    final bool allHaveProof = selectedAtoms.every((a) => (a['sourceSnippet'] ?? '').toString().length > 5);
+
+    return Container(
+      padding: const EdgeInsets.symmetric(horizontal: 24, vertical: 16),
+      decoration: BoxDecoration(
+        color: rcSurface,
+        border: const Border(top: BorderSide(color: rcGold, width: 2)),
+        boxShadow: [
+          BoxShadow(color: Colors.black.withValues(alpha: 0.5), blurRadius: 20, offset: const Offset(0, -5))
+        ],
+      ),
+      child: SafeArea(
+        child: Row(
+          children: [
+            Column(
+              mainAxisSize: MainAxisSize.min,
+              crossAxisAlignment: CrossAxisAlignment.start,
+              children: [
+                Text(
+                  '${selectedAtomIds.length} ATOMS SELECTED',
+                  style: const TextStyle(color: rcGold, fontWeight: FontWeight.bold, fontSize: 14),
+                ),
+                if (!allHaveProof)
+                  const Text(
+                    'Warning: Some selected atoms lack source snippets.',
+                    style: TextStyle(color: rcRed, fontSize: 11),
+                  )
+                else
+                  const Text(
+                    'All selected atoms have valid source proof.',
+                    style: TextStyle(color: rcGreen, fontSize: 11),
+                  ),
+              ],
+            ),
+            const Spacer(),
+            TextButton(
+              onPressed: onClear,
+              child: const Text('CLEAR SELECTION'),
+            ),
+            const SizedBox(width: 16),
+            OutlinedButton(
+              onPressed: () => _handleBulkAction(context, 'NEEDS_CORRECTION'),
+              style: OutlinedButton.styleFrom(foregroundColor: rcGold, side: const BorderSide(color: rcGold)),
+              child: const Text('NEEDS CORRECTION'),
+            ),
+            const SizedBox(width: 12),
+            OutlinedButton(
+              onPressed: () => _handleBulkAction(context, 'REJECTED'),
+              style: OutlinedButton.styleFrom(foregroundColor: rcRed, side: const BorderSide(color: rcRed)),
+              child: const Text('REJECT'),
+            ),
+            const SizedBox(width: 12),
+            FilledButton.icon(
+              onPressed: allHaveProof ? () => _handleBulkVerify(context) : null,
+              icon: const Icon(Icons.verified_rounded, size: 18),
+              label: const Text('VERIFY SELECTED'),
+              style: FilledButton.styleFrom(backgroundColor: rcGreen, foregroundColor: Colors.black),
+            ),
+          ],
+        ),
+      ),
+    );
+  }
+
+  Future<void> _handleBulkVerify(BuildContext context) async {
+    final bool confirm = await showDialog<bool>(
+      context: context,
+      builder: (context) => AlertDialog(
+        backgroundColor: rcSurface,
+        title: const Text('BULK VERIFY SYLLABUS ATOMS'),
+        content: SizedBox(
+          width: 500,
+          child: Column(
+            mainAxisSize: MainAxisSize.min,
+            crossAxisAlignment: CrossAxisAlignment.start,
+            children: [
+              Text('You are verifying ${selectedAtomIds.length} atoms. This will make them "Crucible Eligible" and they will be used in study plan generation.'),
+              const SizedBox(height: 16),
+              const Text('Sample of selection:', style: TextStyle(color: rcGold, fontSize: 10, fontWeight: FontWeight.bold)),
+              const SizedBox(height: 8),
+              ...selectedAtoms.take(3).map((a) => Padding(
+                padding: const EdgeInsets.only(bottom: 4),
+                child: Text('• ${a['displayTitle']}', style: const TextStyle(fontSize: 12, color: Colors.white70)),
+              )),
+              if (selectedAtoms.length > 3) const Text('...', style: TextStyle(color: Colors.white30)),
+            ],
+          ),
+        ),
+        actions: [
+          TextButton(onPressed: () => Navigator.pop(context, false), child: const Text('Cancel')),
+          FilledButton(onPressed: () => Navigator.pop(context, true), child: const Text('Confirm Bulk Verify')),
+        ],
+      ),
+    ) ?? false;
+
+    if (!confirm) return;
+
+    await _executeBulkUpdate(context, 'VERIFIED', true);
+  }
+
+  Future<void> _handleBulkAction(BuildContext context, String status) async {
+    final ctrl = TextEditingController();
+    final isReject = status == 'REJECTED';
+
+    final bool confirm = await showDialog<bool>(
+      context: context,
+      builder: (context) => AlertDialog(
+        backgroundColor: rcSurface,
+        title: Text(isReject ? 'BULK REJECT ATOMS' : 'BULK NEEDS CORRECTION'),
+        content: Column(
+          mainAxisSize: MainAxisSize.min,
+          children: [
+            Text('Action will affect ${selectedAtomIds.length} atoms. Provide a mandatory reason:'),
+            const SizedBox(height: 12),
+            TextField(
+              controller: ctrl,
+              decoration: const InputDecoration(hintText: 'Note...'),
+              maxLines: 3,
+            ),
+          ],
+        ),
+        actions: [
+          TextButton(onPressed: () => Navigator.pop(context, false), child: const Text('Cancel')),
+          FilledButton(
+            onPressed: () {
+              if (ctrl.text.trim().isNotEmpty) Navigator.pop(context, true);
+            },
+            style: FilledButton.styleFrom(backgroundColor: isReject ? rcRed : rcGold),
+            child: const Text('Submit'),
+          ),
+        ],
+      ),
+    ) ?? false;
+
+    if (!confirm) return;
+
+    await _executeBulkUpdate(context, status, false, note: ctrl.text.trim());
+  }
+
+  Future<void> _executeBulkUpdate(BuildContext context, String status, bool eligible, {String? note}) async {
+    final scaffold = ScaffoldMessenger.of(context);
+    final db = FirebaseFirestore.instance;
+    final user = FirebaseAuth.instance.currentUser;
+    final now = FieldValue.serverTimestamp();
+
+    try {
+      final batch = db.batch();
+      final affectedDocIds = <String>{};
+
+      for (var i = 0; i < selectedAtomIds.length; i++) {
+        final atomId = selectedAtomIds[i];
+        final atomData = selectedAtoms[i];
+        final docId = atomData['documentId'];
+        if (docId != null) affectedDocIds.add(docId);
+
+        final ref = db.collection('mission_realms').doc(missionId).collection('syllabus_atoms').doc(atomId);
+        batch.update(ref, {
+          'status': status,
+          'verificationStatus': status,
+          'founderReviewStatus': status == 'VERIFIED' ? 'APPROVED' : status,
+          'crucibleEligible': eligible,
+          'reviewedBy': user?.email ?? user?.uid,
+          'reviewedAt': now,
+          'updatedAt': now,
+          if (note != null) 'reviewNote': note,
+        });
+      }
+
+      // Record batch audit
+      final batchId = 'batch_${now.toString().hashCode}_${DateTime.now().millisecondsSinceEpoch}';
+      final auditRef = db.collection('mission_realms').doc(missionId).collection('atom_review_batches').doc(batchId);
+      batch.set(auditRef, {
+        'batchId': batchId,
+        'action': status,
+        'atomCount': selectedAtomIds.length,
+        'atomIds': selectedAtomIds,
+        'documentIds': affectedDocIds.toList(),
+        'performedBy': user?.email ?? user?.uid,
+        'performedAt': now,
+        'reviewNote': note,
+      });
+
+      await batch.commit();
+
+      // Trigger summary refresh for each document (one-by-one or separate worker)
+      // For now, we'll rely on the UI to reflect changes and the next atomization pass to sync counts.
+      
+      onSuccess();
+      scaffold.showSnackBar(SnackBar(content: Text('Bulk action $status completed for ${selectedAtomIds.length} atoms.')));
+    } catch (e) {
+      scaffold.showSnackBar(SnackBar(content: Text('Bulk action failed: $e')));
+    }
+  }
+}
