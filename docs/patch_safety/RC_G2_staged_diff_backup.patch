+                      // =====================================
+                      _label('Study Medium'),
+                      const SizedBox(height: 12),
+                      Row(
+                        children: [
+                          _languageOption('Hindi', 'Hindi Medium'),
+                          const SizedBox(width: 16),
+                          _languageOption('English', 'English Medium'),
+                        ],
+                      ),
+  
+                      const SizedBox(height: 42),
+  
+                      // =====================================
+                      // CONTINUE
+                      // =====================================
+                      PremiumButton(
+                        text: 'CONTINUE',
+                        onTap: _continue,
+                      ),
+                    ],
+                  ),
+                ),
+              ),
+            ),
+          ),
+        ),
+      ),
+    );
+  }
+
+  Widget _label(String text) {
+    return Padding(
+      padding: const EdgeInsets.only(bottom: 10, left: 4),
+      child: Text(text.toUpperCase(), style: AppTypography.label.copyWith(fontSize: 10)),
+    );
+  }
+
+  Widget _input(TextEditingController controller, String hint, 
+      {TextInputType keyboardType = TextInputType.text, bool readOnly = false, bool capitalizeFirstLetter = false}) {
+    return Container(
+      decoration: BoxDecoration(
+        color: readOnly ? AppColors.surface.withValues(alpha: 0.5) : AppColors.surface,
+        borderRadius: BorderRadius.circular(14),
+        border: Border.all(color: AppColors.borderSoft),
+      ),
+      child: TextField(
+        controller: controller,
+        keyboardType: keyboardType,
+        readOnly: readOnly,
+        inputFormatters: capitalizeFirstLetter ? [CapitalizeNameFormatter()] : null,
+        style: AppTypography.body.copyWith(color: readOnly ? Colors.white38 : Colors.white),
+        decoration: InputDecoration(
+          border: InputBorder.none,
+          hintText: hint,
+          hintStyle: AppTypography.body.copyWith(color: Colors.white10),
+          contentPadding: const EdgeInsets.all(18),
+        ),
+      ),
+    );
+  }
+
+  Widget _languageOption(String value, String display) {
+    final bool isSelected = selectedLanguage == value;
+    return Expanded(
+      child: GestureDetector(
+        onTap: () {
+          setState(() {
+            selectedLanguage = value;
+          });
+        },
+        child: AnimatedContainer(
+          duration: const Duration(milliseconds: 220),
+          padding: const EdgeInsets.symmetric(vertical: 18),
+          decoration: BoxDecoration(
+            color: isSelected ? AppColors.gold : AppColors.surface,
+            borderRadius: BorderRadius.circular(18),
+            border: Border.all(
+              color: isSelected ? AppColors.gold : AppColors.borderSoft,
+            ),
+          ),
+          child: Center(
+            child: Text(
+              display,
+              maxLines: 1,
+              overflow: TextOverflow.ellipsis,
+              textAlign: TextAlign.center,
+              style: AppTypography.body.copyWith(
+                color: isSelected ? Colors.black : Colors.white70,
+                fontWeight: FontWeight.bold,
+              ),
+            ),
+          ),
+        ),
+      ),
+    );
+  }
+}
+
+class CapitalizeNameFormatter extends TextInputFormatter {
+  @override
+  TextEditingValue formatEditUpdate(TextEditingValue oldValue, TextEditingValue newValue) {
+    if (newValue.text.isEmpty) return newValue;
+    final String text = newValue.text;
+    final List<String> words = text.split(' ');
+    final String formatted = words.map((word) {
+      if (word.isEmpty) return "";
+      return word[0].toUpperCase() + word.substring(1).toLowerCase();
+    }).join(' ');
+    return TextEditingValue(
+      text: formatted,
+      selection: newValue.selection,
+    );
+  }
+}
