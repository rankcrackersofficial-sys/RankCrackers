+import 'package:cloud_firestore/cloud_firestore.dart';
+import 'package:firebase_auth/firebase_auth.dart';
+import 'package:flutter/material.dart';
+
+class DigibookFactory {
+  static Future<void> generateDraftsForDay({
+    required BuildContext context,
+    required String missionId,
+    required String crucibleId,
+    required String dayId,
+    required List<String> atomIds,
+  }) async {
+    final scaffold = ScaffoldMessenger.of(context);
+    final db = FirebaseFirestore.instance;
+
+    try {
+      int generatedCount = 0;
+      
+      for (String atomId in atomIds) {
+        // 1. Fetch Verified Atom
+        final atomSnap = await db.collection('mission_realms')
+            .doc(missionId)
+            .collection('syllabus_atoms')
+            .doc(atomId)
+            .get();
+        
+        final atomData = atomSnap.data();
+        if (atomData == null || atomData['verification_status'] != 'verified') continue;
+
+        // 2. Fetch Linked PYQs
+        final pyqsSnap = await db.collection('mission_realms')
+            .doc(missionId)
+            .collection('question_bank')
+            .where('mapped_atom_ids', arrayContains: atomId)
+            .where('verification_status', isEqualTo: 'verified')
+            .get();
+        
+        final List<Map<String, dynamic>> pyqs = pyqsSnap.docs.map((d) => d.data()).toList();
+
+        // 3. Fetch Relevant Exam Rules
+        final rulesSnap = await db.collection('mission_realms')
+            .doc(missionId)
+            .collection('exam_rules')
+            .where('verification_status', isEqualTo: 'verified')
+            .get();
+        
+        final List<Map<String, dynamic>> rules = rulesSnap.docs.map((d) => d.data()).toList();
+
+        // 4. Trigger AI Queue Task (Conceptually for Pilot)
+        // For the pilot, we create a 'digibook_unit' draft document and add it to the AI queue
+        final unitId = 'DB_${atomId}';
+        final now = FieldValue.serverTimestamp();
+
+        // Create the shell document
+        await db.collection('mission_realms').doc(missionId).collection('digibook_units').doc(unitId).set({
+          'digibook_unit_id': unitId,
+          'mission_id': missionId,
+          'exam_id': atomData['exam_id'],
+          'language': 'en',
+          'crucible_id': crucibleId,
+          'crucible_day_ids': [dayId],
+          'atom_id': atomId,
+          'title': atomData['atom_title'],
+          'subject': atomData['subject'],
+          'unit': atomData['unit'],
+          'chapter': atomData['chapter'],
+          'topic': atomData['topic'],
+          'subtopic': atomData['subtopic'],
+          'hierarchy_path': atomData['hierarchy_path'],
+          'source_text_excerpt': atomData['source_text_excerpt'],
+          'source_document_id': atomData['source_document_id'],
+          'verification_status': 'draft',
+          'founder_approved': false,
+          'published': false,
+          'created_at': now,
+          'updated_at': now,
+          'source_links': {
+            'syllabus_atom_id': atomId,
+            'pyq_question_ids': pyqs.map((p) => p['question_id']).toList(),
+            'exam_rule_ids': rules.map((r) => r['rule_id']).toList(),
+          }
+        }, SetOptions(merge: true));
+
+        // Add to AI Queue
+        await db.collection('ai_queue').add({
+          'type': 'digibook_unit',
+          'status': 'received',
+          'payload': {
+            'missionId': missionId,
+            'atom_id': atomId,
+            'atom_title': atomData['atom_title'],
+            'source_text_excerpt': atomData['source_text_excerpt'],
+            'pyqs': pyqs,
+            'rules': rules,
+            'unitId': unitId,
+          },
+          'createdAt': now,
+          'manualTrigger': true,
+        });
+
+        generatedCount++;
+      }
+
+      // Update Crucible Day Metadata
+      await db.collection('mission_realms').doc(missionId).collection('crucible_days').doc(dayId).update({
+        'digibook_status': 'draft_generation_queued',
+        'digibook_ready_count': generatedCount,
+        'updated_at': FieldValue.serverTimestamp(),
+      });
+
+      scaffold.showSnackBar(SnackBar(content: Text('DigiBook Generation queued for $generatedCount atoms.')));
+
+    } catch (e) {
+      scaffold.showSnackBar(SnackBar(content: Text('DigiBook Generation failed: $e')));
+    }
+  }
+}
diff --git a/lib/web/founder/mission_control/digibook_review_tab.dart b/lib/web/founder/mission_control/digibook_review_tab.dart
new file mode 100644
index 0000000..735775f
--- /dev/null
+++ b/lib/web/founder/mission_control/digibook_review_tab.dart
@@ -0,0 +1,222 @@
+import 'package:cloud_firestore/cloud_firestore.dart';
+import 'package:flutter/material.dart';
+import 'package:flutter/services.dart';
+import '../../shared/rc_colors.dart';
+import '../../shared/rc_loaders.dart';
+import '../../shared/rc_panel.dart';
+import '../../shared/unified_command_console.dart';
+
+class DigibookReviewTab extends StatefulWidget {
+  final String missionId;
+  final ConsoleRoleMode roleMode;
+
+  const DigibookReviewTab({
+    super.key,
+    required this.missionId,
+    this.roleMode = ConsoleRoleMode.founder,
+  });
+
+  @override
+  State<DigibookReviewTab> createState() => _DigibookReviewTabState();
+}
+
+class _DigibookReviewTabState extends State<DigibookReviewTab> {
+  String _statusFilter = 'all';
+  String _searchQuery = '';
+
+  @override
+  Widget build(BuildContext context) {
+    return Column(
+      children: [
+        _buildHeader(),
+        _buildFilters(),
+        Expanded(child: _buildUnitList()),
+      ],
+    );
+  }
+
+  Widget _buildHeader() {
+    return Container(
+      padding: const EdgeInsets.symmetric(horizontal: 24, vertical: 20),
+      color: rcSurface.withValues(alpha: 0.5),
+      child: Row(
+        children: [
+          const Icon(Icons.menu_book_rounded, color: rcGold, size: 28),
+          const SizedBox(width: 16),
+          Expanded(
+            child: Column(
+              crossAxisAlignment: CrossAxisAlignment.start,
+              children: [
+                const Text('DIGIBOOK CONTENT AUDIT', style: TextStyle(color: Colors.white, fontSize: 18, fontWeight: FontWeight.bold)),
+                Text('Mission: ${widget.missionId} | Pre-generated Unit Review', style: const TextStyle(color: Colors.white30, fontSize: 11)),
+              ],
+            ),
+          ),
+          FilledButton.icon(
+            onPressed: () {
+               ScaffoldMessenger.of(context).showSnackBar(const SnackBar(content: Text('DigiBook Generation is handled by the backend Crucible pulse.')));
+            },
+            icon: const Icon(Icons.auto_awesome_rounded),
+            label: const Text('TRIGGER BATCH DRAFTING (Backend)'),
+            style: FilledButton.styleFrom(backgroundColor: Colors.blueGrey, foregroundColor: Colors.white),
+          ),
+        ],
+      ),
+    );
+  }
+
+  Widget _buildFilters() {
+    return Padding(
+      padding: const EdgeInsets.all(16),
+      child: RcPanel(
+        child: Row(
+          children: [
+            Expanded(
+              child: TextField(
+                onChanged: (v) => setState(() => _searchQuery = v.toLowerCase()),
+                decoration: const InputDecoration(hintText: 'Search by title or atom ID...', prefixIcon: Icon(Icons.search), isDense: true),
+              ),
+            ),
+            const SizedBox(width: 16),
+            _dropdown('Status', _statusFilter, ['all', 'draft', 'verified', 'published'], (v) => setState(() => _statusFilter = v!)),
+          ],
+        ),
+      ),
+    );
+  }
+
+  Widget _dropdown(String label, String value, List<String> items, ValueChanged<String?> onChanged) {
+    return SizedBox(
+      width: 160,
+      child: DropdownButtonFormField<String>(
+        value: value,
+        decoration: InputDecoration(labelText: label, isDense: true),
+        items: items.map((e) => DropdownMenuItem(value: e, child: Text(e.toUpperCase(), style: const TextStyle(fontSize: 10)))).toList(),
+        onChanged: onChanged,
+      ),
+    );
+  }
+
+  Widget _buildUnitList() {
+    return StreamBuilder<QuerySnapshot<Map<String, dynamic>>>(
+      stream: FirebaseFirestore.instance
+          .collection('mission_realms')
+          .doc(widget.missionId)
+          .collection('digibook_units')
+          .orderBy('updated_at', descending: true)
+          .snapshots(),
+      builder: (context, snapshot) {
+        if (snapshot.hasError) return Center(child: Text('Error: ${snapshot.error}'));
+        if (!snapshot.hasData) return const RcCenteredLoader();
+
+        final docs = snapshot.data!.docs.where((doc) {
+          final data = doc.data();
+          final String title = (data['title'] ?? '').toString().toLowerCase();
+          final String atomId = (data['atom_id'] ?? '').toString().toLowerCase();
+          final String status = (data['verification_status'] ?? 'draft').toString();
+
+          if (_statusFilter != 'all' && status != _statusFilter) return false;
+          if (_searchQuery.isNotEmpty && !title.contains(_searchQuery) && !atomId.contains(_searchQuery)) return false;
+          return true;
+        }).toList();
+
+        if (docs.isEmpty) return const Center(child: Text('No DigiBook units found matching filters.', style: TextStyle(color: Colors.white24)));
+
+        return ListView.builder(
+          padding: const EdgeInsets.all(24),
+          itemCount: docs.length,
+          itemBuilder: (context, index) => _UnitCard(doc: docs[index], missionId: widget.missionId),
+        );
+      },
+    );
+  }
+}
+
+class _UnitCard extends StatelessWidget {
+  final QueryDocumentSnapshot<Map<String, dynamic>> doc;
+  final String missionId;
+  const _UnitCard({required this.doc, required this.missionId});
+
+  @override
+  Widget build(BuildContext context) {
+    final data = doc.data();
+    final String status = (data['verification_status'] ?? 'draft').toString();
+    final bool isApproved = data['founder_approved'] == true;
+    
+    Color statusColor = rcGold;
+    if (status == 'verified' || isApproved) statusColor = rcGreen;
+
+    return Card(
+      color: rcSurface,
+      margin: const EdgeInsets.only(bottom: 16),
+      shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(12), border: Border.all(color: isApproved ? rcGreen.withValues(alpha: 0.3) : rcLine)),
+      child: ExpansionTile(
+        title: Text(data['title'] ?? 'Untitled Unit', style: const TextStyle(fontWeight: FontWeight.bold, fontSize: 14)),
+        subtitle: Text('Atom: ${data['atom_id']} | ${data['subject']} > ${data['chapter']}', style: const TextStyle(color: Colors.white30, fontSize: 11)),
+        trailing: Container(
+          padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 4),
+          decoration: BoxDecoration(color: statusColor.withValues(alpha: 0.1), borderRadius: BorderRadius.circular(4)),
+          child: Text(status.toUpperCase(), style: TextStyle(color: statusColor, fontSize: 8, fontWeight: FontWeight.bold)),
+        ),
+        children: [
+          const Divider(height: 1, color: rcLine),
+          Padding(
+            padding: const EdgeInsets.all(20),
+            child: Column(
+              crossAxisAlignment: CrossAxisAlignment.start,
+              children: [
+                _section('MENTOR INTRO', data['blocks']?['mentor_intro']),
+                _section('CORE CONCEPT', data['blocks']?['core_concept']),
+                _section('TRAP ALERT', data['blocks']?['trap_alert'], color: rcRed),
+                const SizedBox(height: 20),
+                Row(
+                  mainAxisAlignment: MainAxisAlignment.end,
+                  children: [
+                    TextButton(onPressed: () {}, child: const Text('EDIT CONTENT')),
+                    const SizedBox(width: 12),
+                    if (!isApproved)
+                       FilledButton.icon(
+                         onPressed: () => _approve(context),
+                         icon: const Icon(Icons.check_circle_rounded),
+                         label: const Text('APPROVE UNIT'),
+                         style: FilledButton.styleFrom(backgroundColor: rcGreen, foregroundColor: Colors.black),
+                       ),
+                  ],
+                ),
+              ],
+            ),
+          ),
+        ],
+      ),
+    );
+  }
+
+  Widget _section(String label, String? content, {Color? color}) {
+    if (content == null || content.isEmpty) return const SizedBox.shrink();
+    return Padding(
+      padding: const EdgeInsets.only(bottom: 16),
+      child: Column(
+        crossAxisAlignment: CrossAxisAlignment.start,
+        children: [
+          Text(label, style: TextStyle(color: color ?? rcGold, fontSize: 9, fontWeight: FontWeight.bold, letterSpacing: 1)),
+          const SizedBox(height: 8),
+          Text(content, style: const TextStyle(color: Colors.white70, fontSize: 12, height: 1.5)),
+        ],
+      ),
+    );
+  }
+
+  Future<void> _approve(BuildContext context) async {
+    await FirebaseFirestore.instance
+        .collection('mission_realms')
+        .doc(missionId)
+        .collection('digibook_units')
+        .doc(doc.id)
+        .update({
+      'verification_status': 'verified',
+      'founder_approved': true,
+      'updated_at': FieldValue.serverTimestamp(),
+    });
+    ScaffoldMessenger.of(context).showSnackBar(const SnackBar(content: Text('DigiBook Unit Approved!')));
+  }
+}
