@@ -0,0 +1,82 @@
+const admin = require('firebase-admin');
+if (!admin.apps.length) admin.initializeApp();
+const db = admin.firestore();
+
+async function validateCrucibleR11(missionId, planId) {
+    console.log(`AUDIT: Validating Crucible Spine R11 for ${missionId}/${planId}`);
+
+    const planSnap = await db.collection('mission_realms').doc(missionId).collection('crucible_plans').doc(planId).get();
+    if (!planSnap.exists) {
+        console.error("FAIL: Plan not found");
+        return;
+    }
+    const plan = planSnap.data();
+
+    // 1. Check Counts
+    const counts = {
+        schedules: plan.total_schedules || 0,
+        micro: plan.total_micro_tests || 0,
+        macro: plan.total_macro_tests || 0,
+        major: plan.total_major_tests || 0
+    };
+
+    const expected = { schedules: 36, micro: 36, macro: 6, major: 5 };
+
+    for (let key in expected) {
+        if (counts[key] !== expected[key]) {
+            console.error(`FAIL: ${key} count mismatch. Found ${counts[key]}, expected ${expected[key]}`);
+        } else {
+            console.log(`PASS: ${key} count matches (${counts[key]})`);
+        }
+    }
+
+    // 2. Validate Tests Sizes
+    const testsSnap = await db.collection('mission_realms').doc(missionId).collection('crucible_tests')
+        .where('crucible_id', '==', planId).get();
+
+    let errors = 0;
+    testsSnap.forEach(doc => {
+        const t = doc.data();
+        if (t.test_type === 'micro') {
+            if (t.question_count !== 20 || t.duration_minutes !== 60) {
+                console.error(`FAIL: Micro test ${t.test_id} invalid size`);
+                errors++;
+            }
+        } else if (t.test_type === 'macro') {
+            if (t.question_count !== 40 || t.duration_minutes !== 120) {
+                console.error(`FAIL: Macro test ${t.test_id} invalid size`);
+                errors++;
+            }
+        } else if (t.test_type.startsWith('major')) {
+            if (t.question_count !== 70 || t.duration_minutes !== 180) {
+                console.error(`FAIL: Major test ${t.test_id} invalid size`);
+                errors++;
+            }
+        }
+    });
+
+    if (errors === 0) console.log("PASS: All tests have correct question counts and durations");
+
+    // 3. Validate Days 91-100
+    const daysSnap = await db.collection('mission_realms').doc(missionId).collection('crucible_days')
+        .where('crucible_id', '==', planId)
+        .where('day_number', '>=', 91).get();
+
+    daysSnap.forEach(doc => {
+        const d = doc.data();
+        if (d.study_atom_ids && d.study_atom_ids.length > 0) {
+            console.error(`FAIL: Day ${d.day_number} has new study atoms (not allowed in Major Rebuild phase)`);
+        } else {
+            console.log(`PASS: Day ${d.day_number} has no new study topics`);
+        }
+    });
+
+    console.log("AUDIT COMPLETE: FDC_6T_R11_VALIDATION_FINISHED");
+}
+
+const args = process.argv.slice(2);
+if (args.length >= 2) {
+    validateCrucibleR11(args[0], args[1]);
+} else {
+    console.log("Usage: node validate_crucible_testing_spine.js <missionId> <planId>");
+}
