@@ -0,0 +1,523 @@
+import 'package:flutter/material.dart';
+import 'package:flutter/services.dart';
+import 'package:go_router/go_router.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+import 'package:firebase_auth/firebase_auth.dart';
+import 'package:cloud_firestore/cloud_firestore.dart';
+
+import '../../../../core/theme/app_colors.dart';
+import '../../../../core/theme/app_typography.dart';
+import '../../../../core/utils/app_routes.dart';
+import '../../../../core/widgets/premium_button.dart';
+import '../../../../shared/session/session_manager.dart';
+import '../../../../core/firebase/firestore_service.dart';
+import '../../../../core/telemetry/telemetry_engine.dart';
+import '../../../../data/india_states.dart';
+import '../../../../data/india_districts.dart';
+import '../widgets/smart_search_field.dart';
+
+class ProfileSetupScreen extends StatefulWidget {
+  const ProfileSetupScreen({super.key});
+
+  @override
+  State<ProfileSetupScreen> createState() => _ProfileSetupScreenState();
+}
+
+class _ProfileSetupScreenState extends State<ProfileSetupScreen> {
+  final TextEditingController firstNameController = TextEditingController();
+  final TextEditingController lastNameController = TextEditingController();
+  final TextEditingController emailController = TextEditingController();
+  final TextEditingController mobileController = TextEditingController();
+  final TextEditingController stateController = TextEditingController();
+  final TextEditingController districtController = TextEditingController();
+
+  List<String> filteredStates = [];
+  List<String> filteredDistricts = [];
+  String selectedLanguage = 'Hindi';
+  String? selectedState;
+
+  @override
+  void initState() {
+    super.initState();
+    // 🔱 Telemetry: Onboarding Start
+    TelemetryEngine.instance.capture(eventName: 'profile_setup_start', durationMs: 0);
+
+    // 🔱 AUTO PREFILL FROM FIREBASE
+    final user = FirebaseAuth.instance.currentUser;
+    emailController.text = user?.email ?? '';
+    
+    // Start with no suggestions 🔱
+    filteredStates = [];
+  }
+
+  void searchStates(String value) {
+    if (value.trim().isEmpty) {
+      setState(() {
+        filteredStates = [];
+      });
+      return;
+    }
+
+    setState(() {
+      filteredStates = IndiaStates.statesAndUTs
+          .where((state) => state.toLowerCase().startsWith(value.toLowerCase()))
+          .take(6)
+          .toList();
+    });
+  }
+
+  void searchDistricts(String value) {
+    if (selectedState == null) return;
+
+    if (value.trim().isEmpty) {
+      setState(() {
+        filteredDistricts = [];
+      });
+      return;
+    }
+
+    final districts = IndiaDistricts.districts[selectedState] ?? [];
+    setState(() {
+      filteredDistricts = districts
+          .where((district) => district.toLowerCase().startsWith(value.toLowerCase()))
+          .take(6)
+          .toList();
+    });
+  }
+
+  void _pickImage() {
+    ScaffoldMessenger.of(context).showSnackBar(
+      const SnackBar(content: Text('Image picking coming soon...')),
+    );
+  }
+
+  Future<void> _continue() async {
+    final start = DateTime.now().millisecondsSinceEpoch;
+
+    // 🔱 First Name Mandatory
+    if (firstNameController.text.trim().isEmpty) {
+      _showError('कृपया अपना नाम दर्ज करें (Enter First Name)');
+      return;
+    }
+
+    // 🔱 Contact Validation (Audit Fix)
+    final mobile = mobileController.text.trim();
+    if (mobile.length != 10) {
+      _showError('कृपया 10 अंकों का मोबाइल नंबर दर्ज करें');
+      return;
+    }
+
+    // 🔱 State Validation
+    final stateText = stateController.text.trim();
+    if (stateText.isEmpty) {
+      _showError('राज्य का चयन करें (Select State)');
+      return;
+    }
+    if (!IndiaStates.statesAndUTs.contains(stateText)) {
+      _showError('कृपया एक वैध राज्य चुनें (Please select a valid state)');
+      return;
+    }
+
+    // 🔱 District Validation
+    final districtText = districtController.text.trim();
+    if (districtText.isEmpty) {
+      _showError('जिले का चयन करें (Select District)');
+      return;
+    }
+    final districts = IndiaDistricts.districts[selectedState] ?? [];
+    if (!districts.contains(districtText)) {
+      _showError('कृपया एक वैध जिला चुनें (Please select a valid district)');
+      return;
+    }
+
+    final firstName = firstNameController.text.trim();
+    final lastName = lastNameController.text.trim();
+    
+    // 🔱 Last Name Optional Handling
+    final name = lastName.isEmpty ? firstName : '$firstName $lastName';
+
+    // 🔱 1. Local Truth Update
+    await SessionManager.completeProfile(
+      studentName: name,
+      studentCity: districtText,
+    );
+
+    await SessionManager.saveStudentEmail(emailController.text.trim());
+    await SessionManager.saveStudentMobile(mobile);
+
+    final currentUser = FirebaseAuth.instance.currentUser;
+    if (currentUser != null) {
+      await SessionManager.saveFirebaseIdentity(uid: currentUser.uid, email: currentUser.email ?? '');
+      if (currentUser.photoURL != null) {
+        await SessionManager.saveStudentPhoto(currentUser.photoURL!);
+      }
+    }
+
+    final prefs = await SharedPreferences.getInstance();
+    await prefs.setString('preferred_language', selectedLanguage == 'Hindi' ? 'Hindi Medium' : 'English Medium');
+    await prefs.setString('user_state', stateText);
+
+    // 🔱 2. Cloud Truth Sync (Constitutional Law)
+    if (currentUser != null) {
+      await FirestoreService.saveUserProfile(
+        uid: currentUser.uid, 
+        profileData: {
+          'name': name,
+          'city': districtText,
+          'state': stateText,
+          'language': selectedLanguage,
+          'onboardingCompleted': true,
+          'photoUrl': currentUser.photoURL,
+          'updatedAt': FieldValue.serverTimestamp(),
+          'email': currentUser.email,
+          'mobile': mobile,
+        }
+      );
+    }
+
+    // 🔱 3. Telemetry Capture
+    final duration = DateTime.now().millisecondsSinceEpoch - start;
+    TelemetryEngine.instance.capture(
+      eventName: 'profile_setup_complete', 
+      durationMs: duration,
+      metadata: {
+        'state': stateText,
+        'language': selectedLanguage,
+      }
+    );
+
+    if (!mounted) return;
+    context.go(AppRoutes.missionRealm);
+  }
+
+  void _showError(String message) {
+    ScaffoldMessenger.of(context).showSnackBar(
+      SnackBar(content: Text(message), backgroundColor: AppColors.error),
+    );
+  }
+
+  @override
+  void dispose() {
+    firstNameController.dispose();
+    lastNameController.dispose();
+    emailController.dispose();
+    mobileController.dispose();
+    stateController.dispose();
+    districtController.dispose();
+    super.dispose();
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    return PopScope(
+      canPop: false, // 🔱 Mandatory Onboarding Law: Profile must be completed
+      child: GestureDetector(
+        onTap: () => FocusScope.of(context).unfocus(),
+        child: Scaffold(
+          backgroundColor: AppColors.background,
+          body: SafeArea(
+            child: SingleChildScrollView(
+              keyboardDismissBehavior: ScrollViewKeyboardDismissBehavior.onDrag,
+              padding: const EdgeInsets.fromLTRB(24, 24, 24, 32),
+              child: Center(
+                child: ConstrainedBox(
+                  constraints: const BoxConstraints(maxWidth: 500),
+                  child: Column(
+                    crossAxisAlignment: CrossAxisAlignment.start,
+                    children: [
+                      // =====================================
+                      // IDENTITY HEADER 🔱 (Refined)
+                      // =====================================
+                      Row(
+                      mainAxisAlignment: MainAxisAlignment.spaceBetween,
+                      children: [
+                        Text(
+                          'Preparation Identity',
+                          style: AppTypography.hero,
+                        ),
+                        IconButton(
+                          onPressed: () async {
+                            await FirebaseAuth.instance.signOut();
+                            if (mounted) {
+                              context.go(AppRoutes.login);
+                            }
+                          },
+                          icon: const Icon(Icons.logout_rounded, color: Colors.white24),
+                        ),
+                      ],
+                    ),
+                      const SizedBox(height: 6),
+                      Text(
+                        'Configure your learning profile',
+                        style: AppTypography.body.copyWith(color: Colors.white54),
+                      ),
+  
+                      const SizedBox(height: 24),
+  
+                      // =====================================
+                      // PROFILE IMAGE 🔱 (Compact)
+                      // =====================================
+                      Center(
+                        child: Stack(
+                          children: [
+                            Container(
+                              height: 80,
+                              width: 80,
+                              decoration: BoxDecoration(
+                                shape: BoxShape.circle,
+                                color: AppColors.surface,
+                                border: Border.all(
+                                  color: AppColors.gold,
+                                  width: 1.5,
+                                ),
+                              ),
+                              child: ClipOval(
+                                child: Padding(
+                                  padding: const EdgeInsets.all(16),
+                                  child: Image.asset('assets/images/logo.png'),
+                                ),
+                              ),
+                            ),
+                            Positioned(
+                              right: 0,
+                              bottom: 0,
+                              child: GestureDetector(
+                                onTap: _pickImage,
+                                child: Container(
+                                  padding: const EdgeInsets.all(6),
+                                  decoration: const BoxDecoration(
+                                    color: AppColors.gold,
+                                    shape: BoxShape.circle,
+                                  ),
+                                  child: const Icon(
+                                    Icons.edit,
+                                    size: 14,
+                                    color: Colors.black,
+                                  ),
+                                ),
+                              ),
+                            ),
+                          ],
+                        ),
+                      ),
+  
+                      const SizedBox(height: 24),
+  
+                      // =====================================
+                      // NAME 🔱 (Capitalized & Compact)
+                      // =====================================
+                      Row(
+                        children: [
+                          Expanded(
+                            child: Column(
+                              crossAxisAlignment: CrossAxisAlignment.start,
+                              children: [
+                                _label('First Name'),
+                                _input(
+                                  firstNameController, 
+                                  'Enter Name', 
+                                  capitalizeFirstLetter: true,
+                                ),
+                              ],
+                            ),
+                          ),
+                          const SizedBox(width: 14),
+                          Expanded(
+                            child: Column(
+                              crossAxisAlignment: CrossAxisAlignment.start,
+                              children: [
+                                _label('Last Name'),
+                                _input(
+                                  lastNameController, 
+                                  'Optional', 
+                                  capitalizeFirstLetter: true,
+                                ),
+                              ],
+                            ),
+                          ),
+                        ],
+                      ),
+                      const SizedBox(height: 14),
+  
+                      // =====================================
+                      // EMAIL / MOBILE 🔱 (Audit Fix)
+                      // =====================================
+                      _label('Email Address'),
+                      _input(
+                        emailController, 
+                        'Enter Email Address', 
+                        keyboardType: TextInputType.emailAddress,
+                        readOnly: true, // Always from Firebase
+                      ),
+                      const SizedBox(height: 14),
+                      _label('Mobile Number'),
+                      _input(
+                        mobileController, 
+                        'Enter Mobile Number', 
+                        keyboardType: TextInputType.phone,
+                        readOnly: false, // Always required from user
+                      ),
+  
+                      const SizedBox(height: 20),
+  
+                      // =====================================
+                      // STATE SEARCH 🔱
+                      // =====================================
+                      SmartSearchField(
+                        title: 'STATE / UT',
+                        hint: 'Search State',
+                        controller: stateController,
+                        suggestions: filteredStates,
+                        onChanged: searchStates,
+                        onSelected: (state) {
+                          FocusScope.of(context).unfocus();
+                          setState(() {
+                            selectedState = state;
+                            stateController.text = state;
+                            filteredStates = [];
+                            districtController.clear();
+                            filteredDistricts = [];
+                          });
+                        },
+                      ),
+  
+                      const SizedBox(height: 14),
+  
+                      // =====================================
+                      // DISTRICT SEARCH 🔱
+                      // =====================================
+                      SmartSearchField(
+                        title: 'DISTRICT',
+                        hint: 'Search District',
+                        controller: districtController,
+                        suggestions: filteredDistricts,
+                        enabled: selectedState != null,
+                        onChanged: searchDistricts,
+                        onSelected: (district) {
+                          FocusScope.of(context).unfocus();
+                          setState(() {
