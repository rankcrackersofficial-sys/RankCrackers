index 0000000..3fef82f
--- /dev/null
+++ b/lib/web/founder/mission_control/crucible_factory.dart
@@ -0,0 +1,168 @@
+import 'package:cloud_firestore/cloud_firestore.dart';
+import 'package:firebase_auth/firebase_auth.dart';
+import 'package:flutter/material.dart';
+
+class CrucibleFactory {
+  static Future<void> generate100DaySchedule({
+    required BuildContext context,
+    required String missionId,
+    required String examId, // JEE or NEET
+    required Map<String, dynamic> mission,
+  }) async {
+    final scaffold = ScaffoldMessenger.of(context);
+    final db = FirebaseFirestore.instance;
+    final user = FirebaseAuth.instance.currentUser;
+
+    try {
+      // 1. Fetch Verified Inputs
+      final atomsSnap = await db.collection('mission_realms').doc(missionId)
+          .collection('syllabus_atoms')
+          .where('verification_status', isEqualTo: 'verified')
+          .get();
+      
+      final pyqsSnap = await db.collection('mission_realms').doc(missionId)
+          .collection('question_bank')
+          .where('verification_status', isEqualTo: 'verified')
+          .get();
+
+      final rulesSnap = await db.collection('mission_realms').doc(missionId)
+          .collection('exam_rules')
+          .where('verification_status', isEqualTo: 'verified')
+          .get();
+
+      final List<Map<String, dynamic>> allAtoms = atomsSnap.docs.map((d) => d.data()).toList();
+      final List<Map<String, dynamic>> allPyqs = pyqsSnap.docs.map((d) => d.data()).toList();
+
+      if (allAtoms.isEmpty) {
+        scaffold.showSnackBar(const SnackBar(content: Text('No verified atoms found. Please verify syllabus atoms first.')));
+        return;
+      }
+
+      // 2. Define Scheduling Strategy based on Exam
+      final isNeet = examId.toUpperCase().contains('NEET');
+      final totalDays = 100;
+
+      // Group atoms by subject
+      final Map<String, List<Map<String, dynamic>>> atomsBySubject = {};
+      for (var a in allAtoms) {
+        final sub = (a['subject'] ?? 'General').toString();
+        atomsBySubject.putIfAbsent(sub, () => []).add(a);
+      }
+
+      final List<String> subjects = atomsBySubject.keys.toList();
+      
+      // Target Distribution
+      // NEET: Biology 45%, Chemistry 30%, Physics 25%
+      // JEE: Mathematics 34%, Physics 33%, Chemistry 33%
+      final Map<String, double> targetWeight = {};
+      if (isNeet) {
+        targetWeight['Biology'] = 0.45;
+        targetWeight['Chemistry'] = 0.30;
+        targetWeight['Physics'] = 0.25;
+      } else {
+        targetWeight['Mathematics'] = 0.34;
+        targetWeight['Physics'] = 0.33;
+        targetWeight['Chemistry'] = 0.33;
+      }
+
+      // 3. Generate Schedule
+      final crucibleId = '${examId}_100D_EN_PILOT_${DateTime.now().millisecondsSinceEpoch}';
+      final batch = db.batch();
+      
+      final planRef = db.collection('mission_realms').doc(missionId).collection('crucible_plans').doc(crucibleId);
+      
+      // Simple interleaving distribution logic for pilot
+      // In a real implementation, this would use a complex priority queue based on prerequisites
+      int totalAssignedAtoms = 0;
+      
+      for (int day = 1; day <= totalDays; day++) {
+        final dayId = '${crucibleId}_D${day.toString().padStart(3, '0')}';
+        final dayRef = db.collection('mission_realms').doc(missionId).collection('crucible_days').doc(dayId);
+        
+        final List<String> studyAtomIds = [];
+        final List<String> pyqIds = [];
+        
+        // Pick atoms for this day based on distribution
+        for (var sub in subjects) {
+          final subAtoms = atomsBySubject[sub] ?? [];
+          if (subAtoms.isEmpty) continue;
+          
+          final weight = targetWeight[sub] ?? (1.0 / subjects.length);
+          final atomsForDaySub = (allAtoms.length / totalDays * weight).ceil();
+          
+          for (int k = 0; k < atomsForDaySub; k++) {
+            if (subAtoms.isNotEmpty) {
+              final atom = subAtoms.removeAt(0);
+              studyAtomIds.add(atom['atomId']);
+              totalAssignedAtoms++;
+              
+              // Find matching PYQs
+              final matchingPyqs = allPyqs.where((p) {
+                final List mapped = p['mapped_atom_ids'] ?? [];
+                return mapped.contains(atom['atomId']);
+              }).toList();
+              
+              if (matchingPyqs.isNotEmpty) {
+                pyqIds.add(matchingPyqs.first['question_id']);
+              }
+            }
+          }
+        }
+
+        // Add revision (every 7th day focuses on previous atoms)
+        final List<String> revisionIds = [];
+        if (day % 7 == 0 && day > 1) {
+           // Simple revision logic: pick some atoms from 3 days ago
+           // In production this would be spaced repetition (SRS)
+        }
+
+        batch.set(dayRef, {
+          'day_id': dayId,
+          'crucible_id': crucibleId,
+          'mission_id': missionId,
+          'exam_id': examId,
+          'language': 'en',
+          'day_number': day,
+          'day_focus': 'Focus on key ${subjects.join("/")} atoms',
+          'subject_distribution': targetWeight,
+          'study_atom_ids': studyAtomIds,
+          'revision_atom_ids': revisionIds,
+          'pyq_question_ids': pyqIds,
+          'estimated_minutes': 180,
+          'cognitive_load': studyAtomIds.length > 5 ? 'high' : (studyAtomIds.length > 2 ? 'medium' : 'low'),
+          'trap_focus_atoms': [], 
+          'micro_test_placeholder': true,
+          'status': 'review_pending',
+          'founder_approved': false,
+          'published': false,
+          'created_at': FieldValue.serverTimestamp(),
+          'updated_at': FieldValue.serverTimestamp(),
+        });
+      }
+
+      // Save Plan Header
+      batch.set(planRef, {
+        'crucible_id': crucibleId,
+        'mission_id': missionId,
+        'exam_id': examId,
+        'language': 'en',
+        'duration_days': totalDays,
+        'source_atom_count': allAtoms.length,
+        'source_pyq_count': allPyqs.length,
+        'source_exam_rule_count': rulesSnap.docs.length,
+        'generation_strategy': isNeet ? 'NEET_B45_C30_P25' : 'JEE_M34_P33_C33',
+        'status': 'review_pending',
+        'founder_approved': false,
+        'published': false,
+        'created_at': FieldValue.serverTimestamp(),
+        'updated_at': FieldValue.serverTimestamp(),
+      });
+
+      await batch.commit();
+      scaffold.showSnackBar(SnackBar(content: Text('100-Day Crucible Schedule generated: $crucibleId')));
+
+    } catch (e) {
+      scaffold.showSnackBar(SnackBar(content: Text('Generation failed: $e')));
+    }
+  }
+}
diff --git a/lib/web/founder/mission_control/crucible_planner_tab.dart b/lib/web/founder/mission_control/crucible_planner_tab.dart
