+const functions = require("firebase-functions");
+const admin = require("firebase-admin");
+const { logFounderActivity } = require("../services/audit_service");
+
+/**
+ * 🔱 KNOWLEDGE GRAPH VALIDATOR (RC-P11-B.5)
+ * Scans Entity Registry and Edges for structural integrity gaps.
+ */
+exports.graphValidatorWorker = functions.pubsub
+  .schedule('every 12 hours')
+  .onRun(async (context) => {
+    const db = admin.firestore();
+    const errors = [];
+    const startTime = Date.now();
+
+    console.log("🔱 GRAPH_VALIDATOR: Initiating structural integrity scan...");
+
+    try {
+      // 1. SCAN EDGES FOR GHOST TARGETS
+      const edgesSnap = await db.collection('entity_edges').get();
+      for (const doc of edgesSnap.docs) {
+        const edge = doc.data();
+
+        // Check if 'from' entity exists
+        const fromExists = await db.collection('entity_registry').doc(edge.from).get();
+        if (!fromExists.exists) {
+            errors.push({ type: 'GHOST_SOURCE', edgeId: doc.id, entityId: edge.from });
+        }
+
+        // Check if 'to' entity exists
+        const toExists = await db.collection('entity_registry').doc(edge.to).get();
+        if (!toExists.exists) {
+            errors.push({ type: 'GHOST_TARGET', edgeId: doc.id, entityId: edge.to });
+        }
+      }
+
+      // 2. SCAN ENTITIES FOR ORPHANED ROOTS (Excluding Top-level Recruitments)
+      const entitiesSnap = await db.collection('entity_registry')
+        .where('entityType', '==', 'REALM').get(); // Only checking Realms for now
+
+      for (const doc of entitiesSnap.docs) {
+        const entity = doc.data();
+        const incoming = await db.collection('entity_edges').where('to', '==', doc.id).get();
+        if (incoming.empty) {
+            errors.push({ type: 'ORPHANED_REALM', entityId: doc.id });
+        }
+      }
+
+      // 3. LOG FINDINGS
+      if (errors.length > 0) {
+          console.error(`🔱 GRAPH_INTEGRITY_ERROR: Detected ${errors.length} anomalies.`);
+          await logFounderActivity({
+              type: 'GRAPH_INTEGRITY_ALERT',
+              message: `Knowledge Graph has ${errors.length} structural gaps.`,
+              metadata: { errors, durationMs: Date.now() - startTime }
+          });
+      } else {
+          console.log("🔱 GRAPH_VALIDATOR: Integrity Verified. 0 gaps found.");
+      }
+
+    } catch (error) {
+      console.error("🔱 GRAPH_VALIDATOR_CRASH:", error);
+    }
+
+    return null;
+  });
