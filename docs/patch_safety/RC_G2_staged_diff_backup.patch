+import 'package:cloud_firestore/cloud_firestore.dart';
+import 'package:flutter/material.dart';
+import 'package:intl/intl.dart';
+import '../../shared/rc_colors.dart';
+import '../../shared/rc_loaders.dart';
+import '../../shared/rc_panel.dart';
+import 'crucible_factory.dart';
+
+class CruciblePlannerTab extends StatefulWidget {
+  final String missionId;
+  final Map<String, dynamic> mission;
+  final String examId;
+
+  const CruciblePlannerTab({
+    super.key,
+    required this.missionId,
+    required this.mission,
+    required this.examId,
+  });
+
+  @override
+  State<CruciblePlannerTab> createState() => _CruciblePlannerTabState();
+}
+
+class _CruciblePlannerTabState extends State<CruciblePlannerTab> {
+  bool _generating = false;
+
+  @override
+  Widget build(BuildContext context) {
+    return Column(
+      children: [
+        _buildHeader(),
+        Expanded(child: _buildPlanList()),
+      ],
+    );
+  }
+
+  Widget _buildHeader() {
+    return Container(
+      padding: const EdgeInsets.symmetric(horizontal: 24, vertical: 20),
+      color: rcSurface.withValues(alpha: 0.5),
+      child: Row(
+        children: [
+          const Icon(Icons.calendar_month_rounded, color: rcGold, size: 28),
+          const SizedBox(width: 16),
+          Expanded(
+            child: Column(
+              crossAxisAlignment: CrossAxisAlignment.start,
+              children: [
+                const Text('CRUCIBLE 100-DAY FACTORY', style: TextStyle(color: Colors.white, fontSize: 18, fontWeight: FontWeight.bold)),
+                Text('Mission ID: ${widget.missionId} | Pattern: ${widget.examId}', style: const TextStyle(color: Colors.white30, fontSize: 11)),
+              ],
+            ),
+          ),
+          FilledButton.icon(
+            onPressed: _generating ? null : _handleGenerate,
+            icon: _generating ? const RcCenteredLoader(compact: true) : const Icon(Icons.bolt_rounded),
+            label: const Text('GENERATE 100-DAY SCHEDULE'),
+            style: FilledButton.styleFrom(backgroundColor: rcGold, foregroundColor: Colors.black),
+          ),
+        ],
+      ),
+    );
+  }
+
+  Future<void> _handleGenerate() async {
+    setState(() => _generating = true);
+    await CrucibleFactory.generate100DaySchedule(
+      context: context,
+      missionId: widget.missionId,
+      examId: widget.examId,
+      mission: widget.mission,
+    );
+    setState(() => _generating = false);
+  }
+
+  Widget _buildPlanList() {
+    return StreamBuilder<QuerySnapshot<Map<String, dynamic>>>(
+      stream: FirebaseFirestore.instance
+          .collection('mission_realms')
+          .doc(widget.missionId)
+          .collection('crucible_plans')
+          .orderBy('created_at', descending: true)
+          .snapshots(),
+      builder: (context, snapshot) {
+        if (!snapshot.hasData) return const RcCenteredLoader();
+        final docs = snapshot.data!.docs;
+
+        if (docs.isEmpty) {
+          return const Center(
+            child: Column(
+              mainAxisAlignment: MainAxisAlignment.center,
+              children: [
+                Icon(Icons.event_note_rounded, size: 64, color: Colors.white10),
+                SizedBox(height: 16),
+                Text('No Crucible schedules generated yet.', style: TextStyle(color: Colors.white24)),
+              ],
+            ),
+          );
+        }
+
+        return ListView.builder(
+          padding: const EdgeInsets.all(24),
+          itemCount: docs.length,
+          itemBuilder: (context, index) {
+            final data = docs[index].data();
+            return _PlanCard(missionId: widget.missionId, planId: docs[index].id, data: data);
+          },
+        );
+      },
+    );
+  }
+}
+
+class _PlanCard extends StatelessWidget {
+  final String missionId;
+  final String planId;
+  final Map<String, dynamic> data;
+
+  const _PlanCard({required this.missionId, required this.planId, required this.data});
+
+  @override
+  Widget build(BuildContext context) {
+    final bool isApproved = data['founder_approved'] == true;
+    final String strategy = data['generation_strategy'] ?? 'UNKNOWN';
+    final int days = data['duration_days'] ?? 0;
+    final int atoms = data['source_atom_count'] ?? 0;
+
+    return Card(
+      color: rcSurface,
+      margin: const EdgeInsets.only(bottom: 16),
+      shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(12), border: Border.all(color: isApproved ? rcGreen.withValues(alpha: 0.3) : rcLine)),
+      child: ExpansionTile(
+        title: Text(planId, style: const TextStyle(fontWeight: FontWeight.bold, fontSize: 14, color: rcGold)),
+        subtitle: Text('Strategy: $strategy | $days Days | $atoms Atoms Covered', style: const TextStyle(fontSize: 11, color: Colors.white30)),
+        trailing: _statusChip(data['status'] ?? 'PENDING'),
+        children: [
+          const Divider(height: 1, color: rcLine),
+          Padding(
+            padding: const EdgeInsets.all(16),
+            child: Column(
+              crossAxisAlignment: CrossAxisAlignment.start,
+              children: [
+                const Text('SCHEDULE OVERVIEW (SAMPLED)', style: TextStyle(color: Colors.white24, fontSize: 10, fontWeight: FontWeight.bold)),
+                const SizedBox(height: 12),
+                _buildDaysSample(),
+                const SizedBox(height: 24),
+                Row(
+                  mainAxisAlignment: MainAxisAlignment.end,
+                  children: [
+                    if (!isApproved)
+                      FilledButton.icon(
+                        onPressed: () => _approvePlan(context),
+                        icon: const Icon(Icons.check_circle_rounded),
+                        label: const Text('APPROVE FOR DIGIBOOK GENERATION'),
+                        style: FilledButton.styleFrom(backgroundColor: rcGreen, foregroundColor: Colors.black),
+                      ),
+                  ],
+                ),
+              ],
+            ),
+          ),
+        ],
+      ),
+    );
+  }
+
+  Widget _buildDaysSample() {
+    return StreamBuilder<QuerySnapshot<Map<String, dynamic>>>(
+      stream: FirebaseFirestore.instance
+          .collection('mission_realms')
+          .doc(missionId)
+          .collection('crucible_days')
+          .where('crucible_id', isEqualTo: planId)
+          .limit(10)
+          .orderBy('day_number')
+          .snapshots(),
+      builder: (context, snapshot) {
+        if (!snapshot.hasData) return const RcCenteredLoader(compact: true);
+        final days = snapshot.data!.docs;
+
+        return Wrap(
+          spacing: 12,
+          runSpacing: 12,
+          children: days.map((d) {
+            final dayData = d.data();
+            final int atoms = (dayData['study_atom_ids'] as List).length;
+            final String load = dayData['cognitive_load'] ?? 'medium';
+            Color loadColor = rcGreen;
+            if (load == 'high') loadColor = rcRed;
+            if (load == 'medium') loadColor = rcGold;
+
+            return Container(
+              width: 140,
+              padding: const EdgeInsets.all(12),
+              decoration: BoxDecoration(color: Colors.white.withValues(alpha: 0.03), borderRadius: BorderRadius.circular(8), border: Border.all(color: rcLine)),
+              child: Column(
+                crossAxisAlignment: CrossAxisAlignment.start,
+                children: [
+                  Text('Day ${dayData['day_number']}', style: const TextStyle(fontWeight: FontWeight.bold, fontSize: 12)),
+                  const SizedBox(height: 4),
+                  Text('$atoms Atoms', style: const TextStyle(color: Colors.white54, fontSize: 10)),
+                  const SizedBox(height: 8),
+                  Container(
+                    padding: const EdgeInsets.symmetric(horizontal: 6, vertical: 2),
+                    decoration: BoxDecoration(color: loadColor.withValues(alpha: 0.1), borderRadius: BorderRadius.circular(4)),
+                    child: Text(load.toUpperCase(), style: TextStyle(color: loadColor, fontSize: 8, fontWeight: FontWeight.bold)),
+                  ),
+                ],
+              ),
+            );
+          }).toList(),
+        );
+      },
+    );
+  }
+
+  Widget _statusChip(String status) {
+    Color col = rcGold;
+    if (status == 'verified' || status == 'approved') col = rcGreen;
+    return Container(
+      padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 4),
+      decoration: BoxDecoration(color: col.withValues(alpha: 0.1), borderRadius: BorderRadius.circular(4), border: Border.all(color: col.withValues(alpha: 0.2))),
+      child: Text(status.toUpperCase(), style: TextStyle(color: col, fontSize: 9, fontWeight: FontWeight.bold)),
+    );
+  }
+
+  Future<void> _approvePlan(BuildContext context) async {
+    try {
+      await FirebaseFirestore.instance
+          .collection('mission_realms')
+          .doc(missionId)
+          .collection('crucible_plans')
+          .doc(planId)
+          .update({
+        'status': 'approved',
+        'founder_approved': true,
+        'updated_at': FieldValue.serverTimestamp(),
+      });
+      ScaffoldMessenger.of(context).showSnackBar(const SnackBar(content: Text('Plan Approved! Ready for FDC-7 (DigiBook).')));
+    } catch (e) {
+      ScaffoldMessenger.of(context).showSnackBar(SnackBar(content: Text('Approval failed: $e')));
+    }
+  }
+}
