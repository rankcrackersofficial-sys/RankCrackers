+const admin = require("firebase-admin");
+
+/**
+ * 🔱 SOVEREIGN ENTITY REGISTRY SERVICE (RC-P11)
+ * The Master Graph for RankCrackers Knowledge Ecosystem.
+ * Tracks lineage, relationships, and existence of all core entities.
+ */
+
+const db = admin.firestore();
+
+/**
+ * Registers an entity in the Master Registry.
+ * Anchors the entity's identity and its source drafts.
+ */
+async function registerEntity(entityData) {
+    const { id, type, parentId, draftIds, metadata } = entityData;
+
+    if (!id || !type) throw new Error("🔱 REGISTRY ERROR: ID and Type are mandatory.");
+
+    const registryRef = db.collection('entity_registry').doc(id);
+    const now = admin.firestore.FieldValue.serverTimestamp();
+
+    await registryRef.set({
+        id,
+        entityType: type.toUpperCase(),
+        parentEntityId: parentId || null,
+        sourceDraftIds: draftIds || [],
+        status: metadata?.status || 'staged',
+        metadata: metadata || {},
+        createdAt: now,
+        updatedAt: now
+    }, { merge: true });
+
+    console.log(`🔱 REGISTRY: Entity [${type}] registered: ${id}`);
+}
+
+/**
+ * Creates a Relationship Edge in the Knowledge Graph.
+ * RC-P11-B: Supporting Graph Traversal for Coverage & Risk Engines.
+ */
+async function createEdge(from, to, relationshipType) {
+    if (!from || !to || !relationshipType) return;
+
+    const edgeId = `edge_${from}_${to}_${relationshipType.toLowerCase()}`;
+    const edgeRef = db.collection('entity_edges').doc(edgeId);
+
+    await edgeRef.set({
+        id: edgeId,
+        from,
+        to,
+        type: relationshipType.toUpperCase(),
+        createdAt: admin.firestore.FieldValue.serverTimestamp()
+    }, { merge: true });
+
+    console.log(`🔱 GRAPH: Edge Created: [${from}] --(${relationshipType})--> [${to}]`);
+}
+
+/**
+ * Retrieves the full lineage of an entity.
+ */
+async function getLineage(entityId) {
+    const registry = await db.collection('entity_registry').doc(entityId).get();
+    if (!registry.exists) return null;
+
+    const data = registry.data();
+    const edges = await db.collection('entity_edges').where('to', '==', entityId).get();
+
+    return {
+        entity: data,
+        parents: edges.docs.map(doc => doc.data().from)
+    };
+}
+
+module.exports = {
+    registerEntity,
+    createEdge,
+    getLineage
+};
