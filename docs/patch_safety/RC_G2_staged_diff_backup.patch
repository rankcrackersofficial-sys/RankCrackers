+++ b/functions/services/adaptive_scheduler_service.js
@@ -0,0 +1,110 @@
+const admin = require("firebase-admin");
+
+/**
+ * 🔱 ADAPTIVE SCHEDULER SERVICE (RC-P16-E)
+ * Dynamically modifies preparation intensity and session distribution based on performance.
+ */
+
+const db = admin.firestore();
+
+/**
+ * Updates the Adaptive Snapshot for a student by analyzing recent session performance.
+ */
+async function updateAdaptiveSnapshot(studentId) {
+    const now = admin.firestore.Timestamp.now();
+    const sevenDaysAgo = admin.firestore.Timestamp.fromMillis(now.toMillis() - (7 * 24 * 60 * 60 * 1000));
+
+    // 1. Fetch recent sessions
+    const sessionsSnap = await db.collection('battle_sessions')
+        .where('studentId', '==', studentId)
+        .where('updatedAt', '>=', sevenDaysAgo)
+        .get();
+
+    if (sessionsSnap.empty) {
+        return null;
+    }
+
+    let completed = 0;
+    let failed = 0;
+    let skipped = 0;
+    let total = 0;
+
+    let battleTotal = 0;
+    let battleSuccess = 0;
+    let practiceTotal = 0;
+    let practiceSuccess = 0;
+
+    sessionsSnap.forEach(doc => {
+        const data = doc.data();
+        total++;
+        if (data.status === 'COMPLETED') completed++;
+        else if (data.status === 'FAILED') failed++;
+        else if (data.status === 'SKIPPED') skipped++;
+
+        if (data.sessionType === 'BATTLE_SESSION') {
+            battleTotal++;
+            if (data.status === 'COMPLETED') battleSuccess++;
+        } else if (data.sessionType === 'PRACTICE_SESSION') {
+            practiceTotal++;
+            if (data.status === 'COMPLETED') practiceSuccess++;
+        }
+    });
+
+    const completionRate = (completed / total) * 100;
+    const battleSuccessRate = battleTotal > 0 ? (battleSuccess / battleTotal) * 100 : 100;
+    const practiceSuccessRate = practiceTotal > 0 ? (practiceSuccess / practiceTotal) * 100 : 100;
+    const missedSessions = failed + skipped;
+
+    // 2. Generate Adaptive Recommendations
+    let recommendedIntensityAdjustment = 0;
+    let recommendedPracticeBoost = 0;
+    let recommendedBattleReduction = 0;
+    let recommendedRevisionBoost = 0;
+
+    // Rule 1: SESSION_OVERLOAD (Completion rate low)
+    if (completionRate < 60) {
+        recommendedIntensityAdjustment = -1;
+    } else if (completionRate > 90 && total > 5) {
+        recommendedIntensityAdjustment = 1; // HIGH_PERFORMANCE
+    }
+
+    // Rule 2: MISSED_REVISION (Missed sessions high)
+    if (missedSessions > 5) {
+        recommendedRevisionBoost = 1;
+    }
+
+    // Rule 3: LOW_BATTLE_SUCCESS
+    if (battleSuccessRate < 50 && battleTotal > 2) {
+        recommendedBattleReduction = 1;
+        recommendedPracticeBoost = 1;
+    }
+
+    const snapshot = {
+        studentId,
+        completionRate: parseFloat(completionRate.toFixed(2)),
+        battleSuccessRate: parseFloat(battleSuccessRate.toFixed(2)),
+        practiceSuccessRate: parseFloat(practiceSuccessRate.toFixed(2)),
+        missedSessions,
+        recommendedIntensityAdjustment,
+        recommendedPracticeBoost,
+        recommendedBattleReduction,
+        recommendedRevisionBoost,
+        updatedAt: now
+    };
+
+    await db.collection('adaptive_scheduler_snapshots').doc(studentId).set(snapshot, { merge: true });
+    return snapshot;
+}
+
+/**
+ * Retrieves the latest adaptive snapshot.
+ */
+async function getAdaptiveSnapshot(studentId) {
+    const doc = await db.collection('adaptive_scheduler_snapshots').doc(studentId).get();
+    return doc.exists ? doc.data() : null;
+}
+
+module.exports = {
+    updateAdaptiveSnapshot,
+    getAdaptiveSnapshot
+};
