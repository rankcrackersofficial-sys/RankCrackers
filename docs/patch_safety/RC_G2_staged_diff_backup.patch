+const admin = require("firebase-admin");
+
+/**
+ * 🔱 MASTERY ENGINE SERVICE (RC-P14-A)
+ * Implementation of Forgetting Curve and Spaced Repetition (Document 47).
+ */
+
+const db = admin.firestore();
+
+const STATES = {
+    NEW: 'NEW',
+    LEARNING: 'LEARNING',
+    MASTERED: 'MASTERED',
+    DECAYING: 'DECAYING',
+    AT_RISK: 'AT_RISK',
+    FORGOTTEN: 'FORGOTTEN'
+};
+
+/**
+ * Marks a fact as reviewed and recalculates its stability.
+ */
+async function markReview(studentId, factId, confidence) {
+    const masteryId = `${studentId}_${factId}`;
+    const masteryRef = db.collection('student_fact_mastery').doc(masteryId);
+    const now = admin.firestore.Timestamp.now();
+
+    await db.runTransaction(async (transaction) => {
+        const snap = await transaction.get(masteryRef);
+        let data = snap.exists ? snap.data() : {
+            studentId, factId, repetitionCount: 0, stabilityScore: 1,
+            masteryState: STATES.NEW, firstLearnedAt: now
+        };
+
+        // 🔱 SRS LOGIC (Spaced Repetition)
+        const repetitionCount = (data.repetitionCount || 0) + 1;
+        const stabilityScore = calculateStability(data.stabilityScore || 1, confidence, repetitionCount);
+
+        const nextReviewDays = Math.ceil(stabilityScore);
+        const nextReviewAt = admin.firestore.Timestamp.fromMillis(now.toMillis() + (nextReviewDays * 24 * 60 * 60 * 1000));
+
+        const update = {
+            ...data,
+            confidence: confidence,
+            repetitionCount: repetitionCount,
+            stabilityScore: stabilityScore,
+            masteryState: promoteState(data.masteryState, confidence, stabilityScore),
+            lastReviewedAt: now,
+            nextReviewAt: nextReviewAt,
+            updatedAt: now
+        };
+
+        transaction.set(masteryRef, update, { merge: true });
+
+        // Immutable Event Logging
+        const eventRef = db.collection('mastery_events').doc();
+        transaction.set(eventRef, {
+            studentId, factId, type: 'FACT_REVIEWED',
+            oldState: data.masteryState, newState: update.masteryState,
+            confidence, timestamp: now
+        });
+    });
+}
+
+/**
+ * Basic Stability Formula (Simplified Half-life logic)
+ */
+function calculateStability(oldStability, confidence, count) {
+    // Stability increases with review, but weighted by confidence.
+    // If confidence is low, stability grows slowly.
+    const multiplier = 1 + (confidence * 1.5);
+    return oldStability * multiplier;
+}
+
+/**
+ * Determines the next State in the Mastery Spectrum.
+ */
+function promoteState(currentState, confidence, stability) {
+    if (confidence < 0.4) return STATES.FORGOTTEN;
+    if (confidence < 0.7) return STATES.LEARNING;
+    if (stability > 30) return STATES.MASTERED;
+    return STATES.LEARNING;
+}
+
+/**
+ * Periodic decay check (To be called by a Worker)
+ */
+async function calculateDecay(studentId, factId) {
+    const masteryRef = db.collection('student_fact_mastery').doc(`${studentId}_${factId}`);
+    const snap = await masteryRef.get();
+    if (!snap.exists) return;
+
+    const data = snap.data();
+    const now = Date.now();
+    const nextReview = data.nextReviewAt.toMillis();
+
+    if (now > nextReview && data.masteryState === STATES.MASTERED) {
+        await masteryRef.update({
+            masteryState: STATES.DECAYING,
+            updatedAt: admin.firestore.FieldValue.serverTimestamp()
+        });
+    }
+}
+
+module.exports = {
+    markReview,
+    calculateDecay,
+    STATES
+};
