@@ -0,0 +1,510 @@
+import 'package:cloud_firestore/cloud_firestore.dart';
+import 'package:flutter/material.dart';
+
+import '../../shared/rc_colors.dart';
+import '../../shared/rc_loaders.dart';
+import '../../shared/rc_panel.dart';
+
+class CrucibleReadinessSummary extends StatelessWidget {
+  final String missionId;
+  final Map<String, dynamic> mission;
+
+  const CrucibleReadinessSummary({
+    super.key,
+    required this.missionId,
+    required this.mission,
+  });
+
+  @override
+  Widget build(BuildContext context) {
+    return StreamBuilder<QuerySnapshot<Map<String, dynamic>>>(
+      stream: FirebaseFirestore.instance
+          .collection('mission_realms')
+          .doc(missionId)
+          .collection('syllabus_atoms')
+          .snapshots(),
+      builder: (context, atomSnapshot) {
+        return StreamBuilder<QuerySnapshot<Map<String, dynamic>>>(
+          stream: FirebaseFirestore.instance
+              .collection('mission_realms')
+              .doc(missionId)
+              .collection('variables')
+              .snapshots(),
+          builder: (context, varSnapshot) {
+            final atoms = atomSnapshot.data?.docs ?? [];
+            final vars = varSnapshot.data?.docs ?? [];
+
+            final report = _calculateReadiness(mission, vars, atoms);
+            final isReady = report.status == 'READY_FOR_C1';
+
+            return RcPanel(
+              child: Column(
+                crossAxisAlignment: CrossAxisAlignment.start,
+                children: [
+                  Row(
+                    mainAxisAlignment: MainAxisAlignment.spaceBetween,
+                    children: [
+                      const Text(
+                        'CRUCIBLE READINESS (C0)',
+                        style: TextStyle(
+                          color: rcGold,
+                          fontSize: 14,
+                          fontWeight: FontWeight.bold,
+                        ),
+                      ),
+                      Container(
+                        padding: const EdgeInsets.symmetric(
+                            horizontal: 8, vertical: 4),
+                        decoration: BoxDecoration(
+                          color: (isReady ? rcGreen : rcRed).withValues(alpha: 0.1),
+                          borderRadius: BorderRadius.circular(4),
+                          border: Border.all(
+                              color: (isReady ? rcGreen : rcRed).withValues(alpha: 0.3)),
+                        ),
+                        child: Text(
+                          isReady ? 'READY' : 'BLOCKED',
+                          style: TextStyle(
+                            color: isReady ? rcGreen : rcRed,
+                            fontSize: 10,
+                            fontWeight: FontWeight.bold,
+                          ),
+                        ),
+                      ),
+                    ],
+                  ),
+                  const SizedBox(height: 16),
+                  _summaryRow('Mission Structure', report.missionStructureReady),
+                  _summaryRow('Common Paper Coverage', report.commonPaperReady),
+                  _summaryRow('Variable Coverage', report.variableCoverageReady),
+                  _summaryRow('Source Proof Integrity', report.sourceProofReady),
+                  _summaryRow('Cross-subject Safety', report.crossSubjectSafe),
+                  const SizedBox(height: 16),
+                  SizedBox(
+                    width: double.infinity,
+                    child: OutlinedButton.icon(
+                      onPressed: () => _showReadinessDetails(context, report),
+                      icon: const Icon(Icons.analytics_rounded, size: 16),
+                      label: const Text('Open Readiness Details'),
+                    ),
+                  ),
+                ],
+              ),
+            );
+          },
+        );
+      },
+    );
+  }
+
+  Widget _summaryRow(String label, bool ready) {
+    return Padding(
+      padding: const EdgeInsets.only(bottom: 8),
+      child: Row(
+        children: [
+          Icon(
+            ready ? Icons.check_circle_rounded : Icons.block_flipped,
+            color: ready ? rcGreen : rcRed,
+            size: 14,
+          ),
+          const SizedBox(width: 8),
+          Text(
+            label,
+            style: TextStyle(
+              fontSize: 12,
+              color: ready ? Colors.white70 : Colors.white38,
+            ),
+          ),
+        ],
+      ),
+    );
+  }
+
+  void _showReadinessDetails(BuildContext context, _ReadinessReport report) {
+    showDialog(
+      context: context,
+      builder: (context) => _ReadinessDetailsDialog(report: report),
+    );
+  }
+
+  _ReadinessReport _calculateReadiness(
+    Map<String, dynamic> mission,
+    List<QueryDocumentSnapshot<Map<String, dynamic>>> vars,
+    List<QueryDocumentSnapshot<Map<String, dynamic>>> atoms,
+  ) {
+    final struct = mission['examStructure'] as Map?;
+    final papers = List.from(struct?['papers'] ?? []);
+    final plan = mission['missionPlan'] as Map?;
+
+    bool structReady = papers.isNotEmpty &&
+        papers.every((p) => p['paperCode'] != null && p['scope'] != null);
+    bool planReady = plan != null &&
+        plan['totalDays'] != null &&
+        plan['coveragePolicy'] == 'MUST_COVER_ALL_VERIFIED_SYLLABUS_ATOMS';
+
+    final commonPapers =
+        papers.where((p) => p['scope'] == 'COMMON_TO_ALL_VARIABLES').toList();
+    final variablePapers =
+        papers.where((p) => p['scope'] == 'VARIABLE_SPECIFIC').toList();
+
+    bool commonPaperReady = true;
+    final List<String> missingItems = [];
+
+    if (commonPapers.isEmpty) {
+      commonPaperReady = false;
+      missingItems.add('No common paper defined in structure.');
+    } else {
+      for (var cp in commonPapers) {
+        final code = cp['paperCode'];
+        final cpAtoms = atoms.where((a) {
+          final d = a.data();
+          return d['paperCode'] == code &&
+              d['paperScope'] == 'COMMON_TO_ALL_VARIABLES' &&
+              d['status'] == 'VERIFIED' &&
+              d['crucibleEligible'] == true;
+        }).toList();
+
+        if (cpAtoms.isEmpty) {
+          commonPaperReady = false;
+          missingItems.add('Paper $code (Common) has 0 verified atoms.');
+        }
+      }
+    }
+
+    bool variableCoverageReady = true;
+    bool crossSubjectSafe = true;
+
+    if (vars.isEmpty) {
+      variableCoverageReady = false;
+      missingItems.add('No variables registered for this mission.');
+    } else {
+      for (var v in vars) {
+        final varId = v.id;
+        for (var vp in variablePapers) {
+          final code = vp['paperCode'];
+          final vpAtoms = atoms.where((a) {
+            final d = a.data();
+            return d['paperCode'] == code &&
+                d['paperScope'] == 'VARIABLE_SPECIFIC' &&
+                (d['variableId'] == varId ||
+                    (d['appliesToVariableIds'] as List?)?.contains(varId) ==
+                        true) &&
+                d['status'] == 'VERIFIED' &&
+                d['crucibleEligible'] == true;
+          }).toList();
+
+          if (vpAtoms.isEmpty) {
+            variableCoverageReady = false;
+            missingItems.add(
+                'Variable ${v.data()['displayName'] ?? varId} is missing verified atoms for $code.');
+          }
+
+          // Cross-subject check
+          final leakedAtoms = atoms.where((a) {
+            final d = a.data();
+            return d['paperScope'] == 'VARIABLE_SPECIFIC' &&
+                d['variableId'] != varId &&
+                (d['appliesToVariableIds'] as List?)?.contains(varId) == true;
+          }).toList();
+          if (leakedAtoms.isNotEmpty) {
+            crossSubjectSafe = false;
+          }
+        }
+      }
+    }
+
+    bool sourceProofReady = atoms.every((a) {
+      final d = a.data();
+      if (d['crucibleEligible'] != true) return true;
+      final hasSnippet = (d['sourceSnippet'] ?? '').toString().length > 5;
+      final hasPage = d['sourcePageNumber'] != null || d['sourcePage'] != null;
+      return hasSnippet && hasPage;
+    });
+
+    if (!sourceProofReady) {
+      missingItems.add('Some eligible atoms are missing mandatory source proof.');
+    }
+
+    final totalEligible = atoms.where((a) => a.data()['crucibleEligible'] == true).length;
+    final totalBlocked = atoms.where((a) => a.data()['crucibleEligible'] != true).length;
+
+    String status = (structReady &&
+            planReady &&
+            commonPaperReady &&
+            variableCoverageReady &&
+            sourceProofReady &&
+            crossSubjectSafe)
+        ? 'READY_FOR_C1'
+        : 'BLOCKED';
+
+    return _ReadinessReport(
+      status: status,
+      missionStructureReady: structReady,
+      missionPlanReady: planReady,
+      commonPaperReady: commonPaperReady,
+      variableCoverageReady: variableCoverageReady,
+      sourceProofReady: sourceProofReady,
+      crossSubjectSafe: crossSubjectSafe,
+      totalEligibleAtoms: totalEligible,
+      totalBlockedAtoms: totalBlocked,
+      missingItems: missingItems,
+      papers: papers,
+      atoms: atoms.map((e) => e.data()).toList(),
+      vars: vars.map((e) => e.data()).toList(),
+    );
+  }
+}
+
