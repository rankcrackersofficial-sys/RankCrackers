diff --git a/lib/web/founder/mission_control/crucible_publish_preparation.dart b/lib/web/founder/mission_control/crucible_publish_preparation.dart
new file mode 100644
index 0000000..cddb991
--- /dev/null
+++ b/lib/web/founder/mission_control/crucible_publish_preparation.dart
@@ -0,0 +1,122 @@
+import 'package:cloud_firestore/cloud_firestore.dart';
+import 'package:firebase_auth/firebase_auth.dart';
+import 'package:flutter/material.dart';
+
+class CruciblePublishPreparation {
+  static Future<void> preparePackage({
+    required BuildContext context,
+    required String missionId,
+    required String planId,
+  }) async {
+    final scaffold = ScaffoldMessenger.of(context);
+    final db = FirebaseFirestore.instance;
+    final user = FirebaseAuth.instance.currentUser;
+
+    try {
+      // 1. Fetch Approved Assessment Drafts
+      final assessmentsSnap = await db
+          .collection('mission_realms')
+          .doc(missionId)
+          .collection('crucible_assessment_drafts')
+          .where('planId', isEqualTo: planId)
+          .where('status', isEqualTo: 'APPROVED')
+          .get();
+
+      if (assessmentsSnap.docs.isEmpty) {
+        scaffold.showSnackBar(const SnackBar(content: Text('No approved assessment drafts found for this plan.')));
+        return;
+      }
+
+      final List<String> assessmentIds = [];
+      final Set<String> blueprintIds = {};
+      final Set<String> questionSetIds = {};
+      final Set<String> variableIds = {};
+      final Set<int> dayNumbers = {};
+      final Set<String> testTypes = {};
+      int totalQuestions = 0;
+
+      for (var doc in assessmentsSnap.docs) {
+        final d = doc.data();
+        assessmentIds.add(doc.id);
+        if (d['blueprintId'] != null) blueprintIds.add(d['blueprintId']);
+        if (d['questionSetId'] != null) questionSetIds.add(d['questionSetId']);
+        if (d['variableId'] != null) variableIds.add(d['variableId']);
+        if (d['dayNumber'] != null) dayNumbers.add(d['dayNumber']);
+        if (d['testType'] != null) testTypes.add(d['testType']);
+        totalQuestions += (d['questionCount'] as num? ?? 0).toInt();
+      }
+
+      final String packageId = 'pkg_${planId}_${DateTime.now().millisecondsSinceEpoch}';
+      final packageRef = db.collection('mission_realms').doc(missionId).collection('crucible_publish_packages').doc(packageId);
+
+      final batch = db.batch();
+
+      // 2. Supersede old packages for this plan
+      final oldPackages = await db.collection('mission_realms').doc(missionId).collection('crucible_publish_packages')
+          .where('planId', isEqualTo: planId).where('status', isEqualTo: 'PREPARED').get();
+      
+      for (var doc in oldPackages.docs) {
+        batch.update(doc.reference, {'status': 'SUPERSEDED', 'updatedAt': FieldValue.serverTimestamp()});
+      }
+
+      // 3. Create Package
+      batch.set(packageRef, {
+        'packageId': packageId,
+        'missionId': missionId,
+        'planId': planId,
+        'createdFrom': 'Q3',
+        'packageType': 'CRUCIBLE_ASSESSMENT_RELEASE_PREP',
+        'releaseMode': 'DRAFT_PREPARATION',
+
+        'assessmentDraftIds': assessmentIds,
+        'blueprintIds': blueprintIds.toList(),
+        'questionSetIds': questionSetIds.toList(),
+        'variableIdsIncluded': variableIds.toList(),
+        'dayNumbersIncluded': dayNumbers.toList()..sort(),
+        'testTypesIncluded': testTypes.toList(),
+        'totalAssessments': assessmentIds.length,
+        'totalQuestions': totalQuestions,
+
+        'allAssessmentsApproved': true,
+        'allStudentVisibleFalse': true,
+        'allPublishStatusDraft': true,
+        'allQuestionsSourceBacked': true,
+        'noDailyCyclesCreated': true,
+        'noStudentAssignmentsCreated': true,
+
+        'status': 'PREPARED',
+        'founderReviewStatus': 'PENDING',
+        'publishStatus': 'DRAFT',
+        'approvedForRelease': false,
+        'studentVisible': false,
+
+        'preparedBy': user?.email ?? user?.uid,
+        'preparedAt': FieldValue.serverTimestamp(),
+        'updatedAt': FieldValue.serverTimestamp(),
+      });
+
+      // 4. Update Summary Mirrors
+      final planRef = db.collection('mission_realms').doc(missionId).collection('crucible_plans').doc(planId);
+      batch.update(planRef, {
+        'publishPreparationStatus': 'PREPARED',
+        'publishPackageId': packageId,
+        'readyForFinalReleaseReview': true,
+        'lastPublishPreparationAt': FieldValue.serverTimestamp(),
+      });
+
+      for (var id in assessmentIds) {
+        final docRef = db.collection('mission_realms').doc(missionId).collection('crucible_assessment_drafts').doc(id);
+        batch.update(docRef, {
+          'publishPreparationStatus': 'INCLUDED_IN_PACKAGE',
+          'publishPackageId': packageId,
+        });
+      }
+
+      await batch.commit();
+      scaffold.showSnackBar(const SnackBar(content: Text('Publish Preparation Package created successfully.')));
+
+    } catch (e) {
+      scaffold.showSnackBar(SnackBar(content: Text('Failed to prepare package: $e')));
+    }
+  }
+}
diff --git a/lib/web/founder/mission_control/crucible_question_set_assembler.dart b/lib/web/founder/mission_control/crucible_question_set_assembler.dart
new file mode 100644
index 0000000..0fd8ac3
--- /dev/null
+++ b/lib/web/founder/mission_control/crucible_question_set_assembler.dart
@@ -0,0 +1,152 @@
+import 'package:cloud_firestore/cloud_firestore.dart';
+import 'package:firebase_auth/firebase_auth.dart';
+import 'package:flutter/material.dart';
+
+class CrucibleQuestionSetAssembler {
+  static Future<void> assembleDraftSet({
+    required BuildContext context,
+    required String missionId,
+    required String blueprintId,
+    required Map<String, dynamic> blueprint,
+  }) async {
+    final scaffold = ScaffoldMessenger.of(context);
+    final db = FirebaseFirestore.instance;
+    final user = FirebaseAuth.instance.currentUser;
+
+    try {
+      // 1. Fetch Approved & Ready Questions for this mission
+      final questionsSnap = await db
+          .collection('mission_realms')
+          .doc(missionId)
+          .collection('question_bank')
+          .where('status', isEqualTo: 'APPROVED')
+          .where('readyForCrucible', isEqualTo: true)
+          .where('sourceProofComplete', isEqualTo: true)
+          .where('answerProofComplete', isEqualTo: true)
+          .get();
+
+      if (questionsSnap.docs.isEmpty) {
+        scaffold.showSnackBar(const SnackBar(content: Text('No approved/ready questions found in the bank.')));
+        return;
+      }
+
+      final List<String> blueprintAtomIds = List<String>.from(blueprint['assignedAtomIds'] ?? []);
+      final int requiredCount = blueprint['suggestedQuestionCount'] ?? 10;
+      final String? varId = blueprint['variableId'];
+
+      // 2. Filter questions by atom overlap and variable safety
+      final List<QueryDocumentSnapshot<Map<String, dynamic>>> candidates = [];
+      for (var doc in questionsSnap.docs) {
+        final data = doc.data();
+        final List qAtomIds = data['syllabusAtomIds'] as List? ?? [];
+        
+        // Atom overlap check
+        final bool hasOverlap = qAtomIds.any((id) => blueprintAtomIds.contains(id));
+        if (!hasOverlap) continue;
+
+        // Variable safety check
+        if (varId != null) {
+          final bool isCommon = data['appliesToAllVariables'] == true;
+          final bool matchesVar = data['variableId'] == varId || 
+                                 (data['appliesToVariableIds'] as List?)?.contains(varId) == true;
+          if (!isCommon && !matchesVar) continue;
+        }
+
+        candidates.add(doc);
+      }
+
+      if (candidates.isEmpty) {
+        scaffold.showSnackBar(const SnackBar(content: Text('No matching questions found for this blueprint\'s atoms.')));
+        return;
+      }
+
+      // 3. Simple Selection Logic (Take first N for now, prioritizing atom diversity)
+      final List<String> selectedIds = [];
+      final Set<String> coveredAtoms = {};
+      
+      // Pass 1: Try to cover each atom at least once
+      for (var id in blueprintAtomIds) {
+        if (selectedIds.length >= requiredCount) break;
+        final match = candidates.firstWhere(
+          (c) => (c.data()['syllabusAtomIds'] as List).contains(id) && !selectedIds.contains(c.id),
+          orElse: () => candidates.first, // Dummy fallback, will be checked
+        );
+        
+        // Re-check matches to avoid duplicates or unrelated
+        if (selectedIds.length < requiredCount) {
+           final validMatch = candidates.where((c) => (c.data()['syllabusAtomIds'] as List).contains(id) && !selectedIds.contains(c.id)).firstOrNull;
+           if (validMatch != null) {
+             selectedIds.add(validMatch.id);
+             coveredAtoms.addAll((validMatch.data()['syllabusAtomIds'] as List).cast<String>());
+           }
+        }
+      }
+
+      // Pass 2: Fill remaining slots
+      if (selectedIds.length < requiredCount) {
+        for (var c in candidates) {
+          if (selectedIds.length >= requiredCount) break;
+          if (!selectedIds.contains(c.id)) {
+            selectedIds.add(c.id);
+            coveredAtoms.addAll((c.data()['syllabusAtomIds'] as List).cast<String>());
+          }
+        }
+      }
+
+      final int missingCount = requiredCount - selectedIds.length;
+      final List<String> uncoveredAtoms = blueprintAtomIds.where((id) => !coveredAtoms.contains(id)).toList();
+      final String status = missingCount > 0 ? 'BLOCKED_DRAFT' : 'DRAFT';
+      final String setId = 'qset_${blueprintId}_${DateTime.now().millisecondsSinceEpoch}';
+
+      final batch = db.batch();
+
+      // 4. Supersede old sets
+      final oldSets = await db.collection('mission_realms').doc(missionId).collection('crucible_question_sets')
+          .where('blueprintId', isEqualTo: blueprintId).get();
+      for (var doc in oldSets.docs) {
+        batch.update(doc.reference, {'status': 'SUPERSEDED', 'updatedAt': FieldValue.serverTimestamp()});
+      }
+
+      // 5. Create new set
+      final setRef = db.collection('mission_realms').doc(missionId).collection('crucible_question_sets').doc(setId);
+      batch.set(setRef, {
+        'setId': setId,
+        'missionId': missionId,
+        'blueprintId': blueprintId,
+        'planId': blueprint['planId'],
+        'dayNumber': blueprint['dayNumber'],
+        'testType': blueprint['testType'],
+        'variableId': varId,
+        'selectedQuestionIds': selectedIds,
+        'selectedQuestionCount': selectedIds.length,
+        'requiredQuestionCount': requiredCount,
+        'missingQuestionCount': missingCount,
+        'coveredAtomIds': coveredAtoms.toList(),
+        'uncoveredAtomIds': uncoveredAtoms,
+        'status': status,
+        'founderReviewStatus': 'PENDING',
+        'publishStatus': 'DRAFT',
+        'generatedFrom': 'Q1',
+        'createdAt': FieldValue.serverTimestamp(),
+        'updatedAt': FieldValue.serverTimestamp(),
+        'createdBy': user?.email ?? user?.uid,
+      });
+
+      // 6. Update blueprint
+      final bpRef = db.collection('mission_realms').doc(missionId).collection('crucible_test_blueprints').doc(blueprintId);
+      batch.update(bpRef, {
+        'questionSetStatus': status + '_CREATED',
+        'questionSetId': setId,
+        'selectedQuestionCount': selectedIds.length,
+        'missingQuestionCount': missingCount,
+        'lastQuestionSetAssemblyAt': FieldValue.serverTimestamp(),
+      });
+
+      await batch.commit();
+      scaffold.showSnackBar(SnackBar(content: Text('Question set assembled: ${selectedIds.length}/$requiredCount questions found.')));
+
+    } catch (e) {
+      scaffold.showSnackBar(SnackBar(content: Text('Failed to assemble question set: $e')));
+    }
+  }
+}
