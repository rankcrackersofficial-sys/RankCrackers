+import 'package:flutter/material.dart';
+import 'package:rank_crackers/core/theme/app_colors.dart';
+import 'package:rank_crackers/core/theme/app_typography.dart';
+import 'package:rank_crackers/core/theme/tactical_noir_background.dart';
+import 'package:rank_crackers/features/subscription/data/models/subscription_models.dart';
+import 'package:rank_crackers/features/subscription/data/repositories/subscription_repository.dart';
+
+class SubscriptionPassScreen extends StatefulWidget {
+  const SubscriptionPassScreen({super.key});
+
+  @override
+  State<SubscriptionPassScreen> createState() => _SubscriptionPassScreenState();
+}
+
+class _SubscriptionPassScreenState extends State<SubscriptionPassScreen> {
+  final SubscriptionRepository _repository = SubscriptionRepository();
+  List<RcPlan>? _plans;
+  bool _isLoading = true;
+  String? _error;
+
+  @override
+  void initState() {
+    super.initState();
+    _loadPlans();
+  }
+
+  Future<void> _loadPlans() async {
+    try {
+      final plans = await _repository.getActivePlans();
+      if (mounted) {
+        setState(() {
+          _plans = plans;
+          _isLoading = false;
+        });
+      }
+    } catch (e) {
+      if (mounted) {
+        setState(() {
+          _error = e.toString();
+          _isLoading = false;
+        });
+      }
+    }
+  }
+
+  Future<void> _handlePayment(RcPlan plan) async {
+    // Architectural Placeholder for UPI / Play Billing
+    ScaffoldMessenger.of(context).showSnackBar(
+      SnackBar(content: Text("Initiating payment for ${plan.name}...")),
+    );
+    
+    try {
+      final order = await _repository.createOrder(plan.planId);
+      // Here you would normally call the SDK (Razorpay/Play Billing etc)
+      // Since no specific gateway SDK is requested to be integrated now, 
+      // we just show the order details.
+      
+      showDialog(
+        context: context,
+        builder: (context) => AlertDialog(
+          title: const Text("Order Created"),
+          content: Text("Order ID: ${order['orderId']}\nAmount: ₹${order['finalAmount']}\n\nGateway integration pending."),
+          actions: [
+            TextButton(onPressed: () => Navigator.pop(context), child: const Text("OK")),
+          ],
+        ),
+      );
+    } catch (e) {
+      ScaffoldMessenger.of(context).showSnackBar(
+        SnackBar(content: Text("Error creating order: $e")),
+      );
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    return Scaffold(
+      body: TacticalNoirBackground(
+        child: SafeArea(
+          child: Column(
+            children: [
+              _buildHeader(),
+              Expanded(
+                child: _isLoading 
+                  ? const Center(child: CircularProgressIndicator(color: AppColors.gold))
+                  : _error != null
+                    ? Center(child: Text("Error: $_error", style: const TextStyle(color: Colors.red)))
+                    : _plans == null || _plans!.isEmpty
+                      ? const Center(child: Text("No active plans available.", style: TextStyle(color: Colors.white54)))
+                      : ListView.builder(
+                          padding: const EdgeInsets.all(20),
+                          itemCount: _plans!.length,
+                          itemBuilder: (context, index) {
+                            final plan = _plans![index];
+                            return _buildPlanCard(plan);
+                          },
+                        ),
+              ),
+            ],
+          ),
+        ),
+      ),
+    );
+  }
+
+  Widget _buildHeader() {
+    return Container(
+      padding: const EdgeInsets.all(24),
+      child: Column(
+        crossAxisAlignment: CrossAxisAlignment.start,
+        children: [
+          Row(
+            children: [
+              IconButton(
+                icon: const Icon(Icons.arrow_back_ios, color: Colors.white, size: 20),
+                onPressed: () => Navigator.pop(context),
+              ),
+              const SizedBox(width: 8),
+              Text("ACCESS PASS", style: AppTypography.hero.copyWith(fontSize: 24, color: AppColors.gold)),
+            ],
+          ),
+          const SizedBox(height: 8),
+          Padding(
+            padding: const EdgeInsets.only(left: 48),
+            child: Text("Unlock the full RankCrackers experience.", style: AppTypography.body.copyWith(color: Colors.white54)),
+          ),
+        ],
+      ),
+    );
+  }
+
+  Widget _buildPlanCard(RcPlan plan) {
+    return Container(
+      margin: const EdgeInsets.only(bottom: 20),
+      padding: const EdgeInsets.all(24),
+      decoration: BoxDecoration(
+        color: Colors.white.withOpacity(0.05),
+        borderRadius: BorderRadius.circular(16),
+        border: Border.all(color: AppColors.gold.withOpacity(0.2)),
+      ),
+      child: Column(
+        crossAxisAlignment: CrossAxisAlignment.start,
+        children: [
+          Text(plan.name, style: AppTypography.heading.copyWith(color: AppColors.gold)),
+          const SizedBox(height: 16),
+          Row(
+            mainAxisAlignment: MainAxisAlignment.spaceBetween,
+            children: [
+              Column(
+                crossAxisAlignment: CrossAxisAlignment.start,
+                children: [
+                  Text("₹${plan.basePrice.toInt()} + ₹${plan.gstAmount.toInt()} GST", 
+                    style: AppTypography.label.copyWith(color: Colors.white38)),
+                  Text("₹${plan.finalAmount.toInt()}", 
+                    style: AppTypography.hero.copyWith(fontSize: 32, color: Colors.white)),
+                ],
+              ),
+              Container(
+                padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 6),
+                decoration: BoxDecoration(
+                  color: AppColors.gold.withOpacity(0.1),
+                  borderRadius: BorderRadius.circular(20),
+                ),
+                child: Text("${plan.durationDays} DAYS", 
+                  style: AppTypography.label.copyWith(color: AppColors.gold, fontWeight: FontWeight.bold)),
+              ),
+            ],
+          ),
+          const SizedBox(height: 24),
+          _buildFeatureRow(Icons.check_circle_outline, "Full Syllabus Coverage"),
+          _buildFeatureRow(Icons.check_circle_outline, "Premium PYQ Access"),
+          _buildFeatureRow(Icons.check_circle_outline, "DigiBook Unlimited"),
+          _buildFeatureRow(Icons.check_circle_outline, "Daily Mission Tracking"),
+          const SizedBox(height: 32),
+          SizedBox(
+            width: double.infinity,
+            height: 56,
+            child: ElevatedButton(
+              onPressed: () => _handlePayment(plan),
+              style: ElevatedButton.styleFrom(
+                backgroundColor: AppColors.gold,
+                foregroundColor: Colors.black,
+                shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(12)),
+              ),
+              child: const Text("PAY WITH UPI", style: TextStyle(fontWeight: FontWeight.bold, fontSize: 16)),
+            ),
+          ),
+          const SizedBox(height: 16),
+          const Center(
+            child: Text("Gateway charges are borne by RankCrackers.", 
+              style: TextStyle(color: Colors.white24, fontSize: 10)),
+          ),
+        ],
+      ),
+    );
+  }
+
+  Widget _buildFeatureRow(IconData icon, String text) {
+    return Padding(
+      padding: const EdgeInsets.only(bottom: 12),
+      child: Row(
+        children: [
+          Icon(icon, color: AppColors.gold, size: 18),
+          const SizedBox(width: 12),
+          Text(text, style: AppTypography.body.copyWith(color: Colors.white70)),
+        ],
+      ),
+    );
+  }
+}
