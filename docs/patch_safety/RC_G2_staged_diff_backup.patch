+    await db.collection('rc_payment_orders').doc(orderId).set(orderPayload);
+
+    return {
+        success: true,
+        orderId,
+        finalAmount: plan.finalAmount,
+        currency: 'INR'
+    };
+});
+
+/**
+ *  VERIFY PAYMENT
+ * Validates the transaction and activates the subscription.
+ */
+exports.verifyRankCrackersPayment = functions.https.onCall(async (data, context) => {
+    if (!context.auth) throw new functions.https.HttpsError('unauthenticated', 'Login required.');
+
+    const { orderId, gatewayPaymentId, gatewaySignature } = data;
+    const userId = context.auth.uid;
+
+    const orderRef = db.collection('rc_payment_orders').doc(orderId);
+    const orderSnap = await orderRef.get();
+
+    if (!orderSnap.exists) throw new functions.https.HttpsError('not-found', 'Order not found.');
+    const order = orderSnap.data();
+
+    if (order.userId !== userId) throw new functions.https.HttpsError('permission-denied', 'Unauthorized.');
+    if (order.status === 'paid') return { success: true, message: 'Already activated.' };
+
+    // 🔱 SECURITY GATE: In a real implementation, you'd verify the signature here
+    // with your gateway's secret (e.g., Razorpay.utils.verifyPaymentSignature)
+    const isVerified = true; // Placeholder for real cryptographic verification
+
+    if (!isVerified) {
+        throw new functions.https.HttpsError('invalid-argument', 'Payment verification failed.');
+    }
+
+    // Create Transaction Record
+    const transactionId = `txn_${gatewayPaymentId || Date.now()}`;
+    await db.collection('rc_payment_transactions').doc(transactionId).set({
+        transactionId,
+        orderId,
+        userId,
+        gatewayPaymentId,
+        gatewaySignature,
+        amountPaid: order.finalAmount,
+        paymentMode: 'upi',
+        status: 'success',
+        createdAt: admin.firestore.FieldValue.serverTimestamp(),
+    });
+
+    // Activate Access
+    await activateRankCrackers100DayAccess(userId, order.planId, orderId);
+
+    return {
+        success: true,
+        message: 'Access pass activated successfully.'
+    };
+});
