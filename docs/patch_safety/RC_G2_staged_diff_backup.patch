+import 'package:equatable/equatable.dart';
+import 'micro_topic_node.dart';
+import 'atomic_topic.dart';
+import 'atomic_fact.dart';
+
+/// 🔱 KNOWLEDGE HIERARCHY (Document 46)
+/// Implements the Sovereign Knowledge Chain: Major -> Macro -> Micro -> Atomic -> Fact
+
+typedef MicroNode = MicroTopicNode;
+typedef AtomicNode = AtomicTopic;
+typedef FactNode = AtomicFact;
+
+/// 🔱 MAJOR NODE (Subject Level)
+class MajorNode extends Equatable {
+  final String id;
+  final String examId;
+  final String title;
+  final int order;
+
+  const MajorNode({
+    required this.id,
+    required this.examId,
+    required this.title,
+    this.order = 0,
+  });
+
+  Map<String, dynamic> toMap() => {
+    'id': id,
+    'examId': examId,
+    'title': title,
+    'order': order,
+  };
+
+  factory MajorNode.fromMap(Map<String, dynamic> map) => MajorNode(
+    id: map['id'] ?? '',
+    examId: map['examId'] ?? '',
+    title: map['title'] ?? '',
+    order: map['order'] ?? 0,
+  );
+
+  @override
+  List<Object?> get props => [id, examId, title];
+}
+
+/// 🔱 MACRO NODE (Unit/Chapter Level)
+class MacroNode extends Equatable {
+  final String id;
+  final String majorNodeId;
+  final String title;
+  final int order;
+
+  const MacroNode({
+    required this.id,
+    required this.majorNodeId,
+    required this.title,
+    this.order = 0,
+  });
+
+  Map<String, dynamic> toMap() => {
+    'id': id,
+    'majorNodeId': majorNodeId,
+    'title': title,
+    'order': order,
+  };
+
+  factory MacroNode.fromMap(Map<String, dynamic> map) => MacroNode(
+    id: map['id'] ?? '',
+    majorNodeId: map['majorNodeId'] ?? '',
+    title: map['title'] ?? '',
+    order: map['order'] ?? 0,
+  );
+
+  @override
+  List<Object?> get props => [id, majorNodeId, title];
+}
