+
+function normalizeEntityName(input) {
+    if (!input) return "";
+    // 1. Lowercase
+    // 2. Remove all whitespace
+    // 3. Remove all non-alphanumeric (keeping Indian characters)
+    return input.toLowerCase()
+        .replace(/\s+/g, '')
+        .replace(/[^\w\u0900-\u097F]/g, '');
+}
+
+module.exports = { normalizeEntityName };
