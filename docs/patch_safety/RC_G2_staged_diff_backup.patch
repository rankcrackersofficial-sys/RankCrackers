+const admin = require("firebase-admin");
+const { getCurrentState, STATES } = require("./crucible_state_service");
+
+/**
+ * 🔱 CRUCIBLE CYCLE ENGINE (RC-P16-B)
+ * Generates Daily and Weekly Crucible Cycles based on Battle State.
+ */
+
+const db = admin.firestore();
+
+const INTENSITY_MAP = {
+    [STATES.DORMANT]: 0,
+    [STATES.ACTIVE]: 1,
+    [STATES.ENGAGED]: 2,
+    [STATES.INTENSIVE]: 3,
+    [STATES.CRITICAL]: 4,
+    [STATES.RECOVERY]: 1
+};
+
+const TARGETS_MAP = {
+    [STATES.DORMANT]: { revision: 0, practice: 0, battle: 0 },
+    [STATES.ACTIVE]: { revision: 2, practice: 1, battle: 0 },
+    [STATES.ENGAGED]: { revision: 3, practice: 2, battle: 1 },
+    [STATES.INTENSIVE]: { revision: 4, practice: 3, battle: 2 },
+    [STATES.CRITICAL]: { revision: 5, practice: 1, battle: 0, coreRecoveryMode: true },
+    [STATES.RECOVERY]: { revision: 2, practice: 1, battle: 0, burnoutProtection: true }
+};
+
+/**
+ * Generates the Daily Crucible Cycle for a student.
+ * Deterministic ID: studentId_YYYYMMDD
+ */
+async function generateDailyCycle(studentId) {
+    const stateDoc = await getCurrentState(studentId);
+    const state = stateDoc.currentState || STATES.DORMANT;
+
+    const now = new Date();
+    const dateId = now.toISOString().split('T')[0].replace(/-/g, ''); // YYYYMMDD
+    const cycleId = `${studentId}_${dateId}`;
+
+    const intensity = INTENSITY_MAP[state];
+    const targets = TARGETS_MAP[state];
+
+    const dailyCycle = {
+        studentId,
+        cycleDate: dateId,
+        state,
+        intensity,
+        revisionSessions: targets.revision,
+        practiceSessions: targets.practice,
+        battleSessions: targets.battle,
+        coreRecoveryMode: targets.coreRecoveryMode || false,
+        burnoutProtection: targets.burnoutProtection || false,
+        updatedAt: admin.firestore.FieldValue.serverTimestamp()
+    };
+
+    await db.collection('daily_crucible_cycles').doc(cycleId).set(dailyCycle, { merge: true });
+    return dailyCycle;
+}
+
+/**
+ * Generates the Weekly Crucible Cycle for a student.
+ * Deterministic ID: studentId_YYYYWW
+ */
+async function generateWeeklyCycle(studentId) {
+    const stateDoc = await getCurrentState(studentId);
+    const state = stateDoc.currentState || STATES.DORMANT;
+
+    const now = new Date();
+    const weekId = getWeekId(now);
+    const cycleId = `${studentId}_${weekId}`;
+
+    const intensity = INTENSITY_MAP[state];
+    const targets = TARGETS_MAP[state];
+
+    const weeklyCycle = {
+        studentId,
+        weekId,
+        state,
+        intensity,
+        dailyTargets: targets,
+        updatedAt: admin.firestore.FieldValue.serverTimestamp()
+    };
+
+    await db.collection('weekly_crucible_cycles').doc(cycleId).set(weeklyCycle, { merge: true });
+    return weeklyCycle;
+}
+
+/**
+ * Retrieves the current daily cycle for a student.
+ */
+async function getCurrentDailyCycle(studentId) {
+    const dateId = new Date().toISOString().split('T')[0].replace(/-/g, '');
+    const snap = await db.collection('daily_crucible_cycles').doc(`${studentId}_${dateId}`).get();
+    return snap.exists ? snap.data() : null;
+}
+
+/**
+ * Helper to get ISO Week ID (YYYYWW)
+ */
+function getWeekId(date) {
+    const d = new Date(Date.UTC(date.getFullYear(), date.getMonth(), date.getDate()));
+    const dayNum = d.getUTCDay() || 7;
+    d.setUTCDate(d.getUTCDate() + 4 - dayNum);
+    const yearStart = new Date(Date.UTC(d.getUTCFullYear(), 0, 1));
+    const weekNo = Math.ceil((((d - yearStart) / 86400000) + 1) / 7);
+    return `${d.getUTCFullYear()}${weekNo.toString().padStart(2, '0')}`;
+}
+
+module.exports = {
+    generateDailyCycle,
+    generateWeeklyCycle,
+    getCurrentDailyCycle
+};
