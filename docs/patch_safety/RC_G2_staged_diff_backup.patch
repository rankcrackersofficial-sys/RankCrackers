+const admin = require("firebase-admin");
+
+/**
+ * 🔱 INTERVENTION ENGINE SERVICE (RC-P15-G)
+ * Suggests corrective actions based on Risk analysis.
+ */
+
+const db = admin.firestore();
+
+const ACTIONS = {
+    REVISION_REQUIRED: 'REVISION_REQUIRED',
+    HIGH_PRIORITY_REALM: 'HIGH_PRIORITY_REALM',
+    CORE_GAP_RECOVERY: 'CORE_GAP_RECOVERY',
+    MISSION_CRITICAL: 'MISSION_CRITICAL'
+};
+
+async function generateInterventions(studentId) {
+    const riskSnap = await db.collection('risk_snapshots').doc(studentId).get();
+    const alertsSnap = await db.collection('critical_risk_alerts')
+        .where('studentId', '==', studentId)
+        .where('status', '==', 'ACTIVE')
+        .get();
+
+    if (!riskSnap.exists) return [];
+
+    const risk = riskSnap.data();
+    const interventions = [];
+
+    // 1. Mission Critical check
+    if (risk.collapseProbability > 70 || risk.riskScore > 80) {
+        interventions.push({
+            action: ACTIONS.MISSION_CRITICAL,
+            urgency: 'IMMEDIATE',
+            reason: `Mission collapse probability is dangerously high (${risk.collapseProbability}%)`,
+            metadata: { riskScore: risk.riskScore, collapseProb: risk.collapseProbability }
+        });
+    }
+
+    // 2. Realm specific interventions from alerts
+    alertsSnap.forEach(doc => {
+        const alert = doc.data();
+        if (alert.type === 'LOW_CORE_COVERAGE') {
+            interventions.push({
+                action: ACTIONS.CORE_GAP_RECOVERY,
+                urgency: 'HIGH',
+                realmId: alert.realmId,
+                reason: `Critical core knowledge gap detected in ${alert.realmId}`,
+                metadata: { type: alert.type }
+            });
+        }
+    });
+
+    // 3. General revision intervention
+    if (risk.riskScore > 40) {
+        interventions.push({
+            action: ACTIONS.REVISION_REQUIRED,
+            urgency: risk.riskScore > 60 ? 'HIGH' : 'MEDIUM',
+            reason: `Overall risk score is ${risk.riskScore}. Systematic revision recommended.`,
+            metadata: { weakestRealms: risk.weakestRealms }
+        });
+    }
+
+    // Save interventions to a collection for the UI to consume
+    if (interventions.length > 0) {
+        const ref = db.collection('student_interventions').doc(studentId);
+        await ref.set({
+            studentId,
+            interventions,
+            updatedAt: admin.firestore.Timestamp.now()
+        }, { merge: true });
+    }
+
+    return interventions;
+}
+
+module.exports = { generateInterventions, ACTIONS };
