+++ b/functions/services/coverage_service.js
@@ -0,0 +1,133 @@
+const admin = require("firebase-admin");
+
+/**
+ * 🔱 COVERAGE ENGINE SERVICE (RC-P13-A)
+ * Foundation for Relational Mastery and Preparation Analytics.
+ * Implementation of Document 48: The Coverage Graph.
+ */
+
+const db = admin.firestore();
+
+/**
+ * Marks an Atomic Fact as mastered by a student.
+ */
+async function markFactMastered(studentId, factId, confidence = 1.0, source = "digibook") {
+    const masteryId = `${studentId}_${factId}`;
+    const masteryRef = db.collection('student_fact_mastery').doc(masteryId);
+    const now = admin.firestore.FieldValue.serverTimestamp();
+
+    const batch = db.batch();
+
+    // 1. Update Mastery State
+    batch.set(masteryRef, {
+        studentId,
+        factId,
+        masteryState: "mastered",
+        confidence: confidence,
+        lastReviewedAt: now,
+        firstLearnedAt: admin.firestore.FieldValue.serverTimestamp(), // merge:true handles existing
+        updatedAt: now
+    }, { merge: true });
+
+    // 2. Log Immutable Event
+    const eventRef = db.collection('coverage_events').doc();
+    batch.set(eventRef, {
+        studentId,
+        factId,
+        type: "FACT_MASTERED",
+        source,
+        confidence,
+        timestamp: now
+    });
+
+    await batch.commit();
+    console.log(`🔱 COVERAGE: Fact ${factId} mastered by ${studentId}`);
+}
+
+/**
+ * Marks an Atomic Fact as forgotten or requiring review.
+ */
+async function markFactForgotten(studentId, factId) {
+    const masteryId = `${studentId}_${factId}`;
+    const masteryRef = db.collection('student_fact_mastery').doc(masteryId);
+    const now = admin.firestore.FieldValue.serverTimestamp();
+
+    const batch = db.batch();
+
+    batch.update(masteryRef, {
+        masteryState: "review_required",
+        updatedAt: now
+    });
+
+    const eventRef = db.collection('coverage_events').doc();
+    batch.set(eventRef, {
+        studentId,
+        factId,
+        type: "FACT_FORGOTTEN",
+        timestamp: now
+    });
+
+    await batch.commit();
+}
+
+/**
+ * Calculates simple coverage percentage for a student in a specific Realm.
+ * Formula: masteredFacts / totalFacts
+ */
+async function calculateCoverage(studentId, realmId) {
+    // 1. Get all facts required by this Realm
+    const realmFactsSnap = await db.collection('realm_fact_map')
+        .where('realmId', '==', realmId)
+        .get();
+
+    if (realmFactsSnap.empty) return 0;
+
+    const requiredFactIds = realmFactsSnap.docs.map(doc => doc.data().factId);
+    const totalFacts = requiredFactIds.length;
+
+    // 2. Get mastered facts for this student
+    // Optimization: In a real hyperscale scenario, we'd use a more complex join or pre-aggregation.
+    const masteredSnap = await db.collection('student_fact_mastery')
+        .where('studentId', '==', studentId)
+        .where('masteryState', '==', 'mastered')
+        .get();
+
+    const masteredFactIds = new Set(masteredSnap.docs.map(doc => doc.data().factId));
+
+    // 3. Intersect: How many required facts are mastered?
+    let masteredCount = 0;
+    requiredFactIds.forEach(id => {
+        if (masteredFactIds.has(id)) masteredCount++;
+    });
+
+    const coveragePercent = (masteredCount / totalFacts) * 100;
+
+    // 4. Update Snapshot Cache
+    const snapshotId = `${studentId}_${realmId}`;
+    await db.collection('coverage_snapshots').doc(snapshotId).set({
+        studentId,
+        realmId,
+        totalFacts,
+        masteredFacts: masteredCount,
+        coveragePercent: parseFloat(coveragePercent.toFixed(2)),
+        updatedAt: admin.firestore.FieldValue.serverTimestamp()
+    }, { merge: true });
+
+    return coveragePercent;
+}
+
+/**
+ * Retrieves the latest coverage snapshot for a student.
+ */
+async function getCoverageSnapshot(studentId, realmId) {
+    const snapshotId = `${studentId}_${realmId}`;
+    const snap = await db.collection('coverage_snapshots').doc(snapshotId).get();
+    return snap.exists ? snap.data() : null;
+}
+
+module.exports = {
+    markFactMastered,
+    markFactForgotten,
+    calculateCoverage,
+    getCoverageSnapshot
+};
