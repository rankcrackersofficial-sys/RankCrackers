+import 'package:cloud_firestore/cloud_firestore.dart';
+import 'package:flutter/material.dart';
+
+import '../../shared/rc_colors.dart';
+import '../../shared/rc_layout.dart';
+import '../../shared/rc_loaders.dart';
+import 'create_mission_dialog.dart';
+import 'mission_detail_center.dart';
+
+class MissionControlRoom extends StatefulWidget {
+  const MissionControlRoom({super.key});
+
+  @override
+  State<MissionControlRoom> createState() => _MissionControlRoomState();
+}
+
+class _MissionControlRoomState extends State<MissionControlRoom> {
+  String? _selectedMissionId;
+  String _searchQuery = '';
+  String _categoryFilter = 'all';
+  String _statusFilter = 'all';
+
+  void _showCreateMissionDialog() {
+    showDialog(
+      context: context,
+      builder: (context) => const CreateMissionDialog(),
+    );
+  }
+
+  Widget _statusPill(String status) {
+    Color col;
+    switch (status.toUpperCase()) {
+      case 'ACTIVE':
+        col = rcGreen;
+        break;
+      case 'PUBLISHED':
+        col = Colors.cyan;
+        break;
+      case 'ARCHIVED':
+        col = Colors.grey;
+        break;
+      default:
+        col = rcGold;
+    }
+    return Container(
+      padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 4),
+      decoration: BoxDecoration(
+        color: col.withOpacity(0.12),
+        borderRadius: BorderRadius.circular(4),
+        border: Border.all(color: col, width: 0.5),
+      ),
+      child: Text(
+        status.toUpperCase(),
+        style: TextStyle(color: col, fontSize: 11, fontWeight: FontWeight.bold),
+      ),
+    );
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    return Row(
+      crossAxisAlignment: CrossAxisAlignment.stretch,
+      children: [
+        // Left Column: Mission List
+        Container(
+          width: 380,
+          decoration: const BoxDecoration(
+            border: Border(right: BorderSide(color: rcLine)),
+          ),
+          child: Column(
+            crossAxisAlignment: CrossAxisAlignment.stretch,
+            children: [
+              const Padding(
+                padding: EdgeInsets.fromLTRB(20, 20, 20, 4),
+                child: RcPageTitle(
+                  title: 'MISSION CONTROL ROOM',
+                  subtitle:
+                      'Create, configure, publish, and manage exam missions.',
+                ),
+              ),
+              Padding(
+                padding: const EdgeInsets.all(20),
+                child: FilledButton.icon(
+                  onPressed: _showCreateMissionDialog,
+                  icon: const Icon(Icons.add_rounded),
+                  label: const Text('CREATE NEW MISSION'),
+                  style: FilledButton.styleFrom(
+                    padding: const EdgeInsets.symmetric(vertical: 16),
+                    shape: RoundedRectangleBorder(
+                      borderRadius: BorderRadius.circular(12),
+                    ),
+                  ),
+                ),
+              ),
+              Padding(
+                padding: const EdgeInsets.symmetric(
+                  horizontal: 20,
+                  vertical: 4,
+                ),
+                child: TextField(
+                  onChanged: (val) =>
+                      setState(() => _searchQuery = val.trim().toLowerCase()),
+                  decoration: InputDecoration(
+                    prefixIcon: const Icon(
+                      Icons.search_rounded,
+                      color: Colors.white30,
+                      size: 20,
+                    ),
+                    hintText: 'Search missions...',
+                    isDense: true,
+                    filled: true,
+                    fillColor: Colors.black26,
+                    border: OutlineInputBorder(
+                      borderRadius: BorderRadius.circular(8),
+                      borderSide: BorderSide.none,
+                    ),
+                  ),
+                ),
+              ),
+              Padding(
+                padding: const EdgeInsets.symmetric(
+                  horizontal: 20,
+                  vertical: 8,
+                ),
+                child: Row(
+                  children: [
+                    Expanded(
+                      child: DropdownButtonFormField<String>(
+                        value: _categoryFilter,
+                        isDense: true,
+                        decoration: const InputDecoration(
+                          labelText: 'Category',
+                          border: OutlineInputBorder(),
+                          contentPadding: EdgeInsets.symmetric(
+                            horizontal: 10,
+                            vertical: 8,
+                          ),
+                        ),
+                        items: const [
+                          DropdownMenuItem(
+                            value: 'all',
+                            child: Text(
+                              'All Categories',
+                              style: TextStyle(fontSize: 12),
+                            ),
+                          ),
+                          DropdownMenuItem(
+                            value: 'competitive',
+                            child: Text(
+                              'Competitive',
+                              style: TextStyle(fontSize: 12),
+                            ),
+                          ),
+                          DropdownMenuItem(
+                            value: 'qualifying',
+                            child: Text(
+                              'Qualifying',
+                              style: TextStyle(fontSize: 12),
+                            ),
+                          ),
+                        ],
+                        onChanged: (val) =>
+                            setState(() => _categoryFilter = val!),
+                      ),
+                    ),
+                    const SizedBox(width: 8),
+                    Expanded(
+                      child: DropdownButtonFormField<String>(
+                        value: _statusFilter,
+                        isDense: true,
+                        decoration: const InputDecoration(
+                          labelText: 'Status',
+                          border: OutlineInputBorder(),
+                          contentPadding: EdgeInsets.symmetric(
+                            horizontal: 10,
+                            vertical: 8,
+                          ),
+                        ),
+                        items: const [
+                          DropdownMenuItem(
+                            value: 'all',
+                            child: Text(
+                              'All Statuses',
+                              style: TextStyle(fontSize: 12),
+                            ),
+                          ),
+                          DropdownMenuItem(
+                            value: 'ACTIVE',
+                            child: Text(
+                              'Active (Live)',
+                              style: TextStyle(fontSize: 12),
+                            ),
+                          ),
+                          DropdownMenuItem(
+                            value: 'PASSIVE',
+                            child: Text(
+                              'Passive / Draft',
+                              style: TextStyle(fontSize: 12),
+                            ),
+                          ),
+                          DropdownMenuItem(
+                            value: 'ARCHIVED',
+                            child: Text(
+                              'Archived',
+                              style: TextStyle(fontSize: 12),
+                            ),
+                          ),
+                        ],
+                        onChanged: (val) =>
+                            setState(() => _statusFilter = val!),
+                      ),
+                    ),
+                  ],
+                ),
+              ),
+              const SizedBox(height: 8),
+              const Divider(height: 1, color: rcLine),
+              Expanded(
+                child: StreamBuilder<QuerySnapshot<Map<String, dynamic>>>(
+                  stream: FirebaseFirestore.instance
+                      .collection('mission_realms')
+                      .snapshots(),
+                  builder: (context, snapshot) {
+                    if (!snapshot.hasData)
+                      return const RcCenteredLoader(compact: true);
+                    final docs = snapshot.data!.docs;
+
+                    final filteredDocs = docs.where((doc) {
+                      final data = doc.data();
+                      final String missionId = doc.id;
+                      final String name =
+                          (data['name'] ?? '').toString().toLowerCase();
+                      final String hindiName =
+                          (data['hindiName'] ?? '').toString().toLowerCase();
+                      final String code =
+                          (data['code'] ?? '').toString().toLowerCase();
+                      final String category = (data['category'] ??
+                              data['examCategory'] ??
+                              'competitive')
+                          .toString()
+                          .toLowerCase();
+                      final String status =
+                          (data['status'] ?? 'DRAFT').toString().toUpperCase();
+
+                      final matchesSearch = _searchQuery.isEmpty ||
+                          name.contains(_searchQuery) ||
+                          hindiName.contains(_searchQuery) ||
+                          code.contains(_searchQuery) ||
+                          missionId.toLowerCase().contains(_searchQuery);
+
+                      final matchesCategory = _categoryFilter == 'all' ||
+                          category == _categoryFilter;
+                      final matchesStatus = _statusFilter == 'all' ||
+                          (status == _statusFilter) ||
+                          (_statusFilter == 'PASSIVE' &&
+                              (status == 'PASSIVE' || status == 'DRAFT'));
+
+                      return matchesSearch && matchesCategory && matchesStatus;
+                    }).toList();
+
+                    if (filteredDocs.isEmpty) {
+                      return const Center(
+                        child: Text('No matching mission realms found.'),
+                      );
+                    }
+
+                    return ListView.builder(
+                      itemCount: filteredDocs.length,
+                      itemBuilder: (context, index) {
+                        final doc = filteredDocs[index];
+                        final data = doc.data();
+                        final missionId = doc.id;
+                        final active = _selectedMissionId == missionId;
+                        final category = data['category'] ??
+                            data['examCategory'] ??
+                            'competitive';
+                        final variables = data['variables'] as List? ?? [];
+
+                        return InkWell(
+                          onTap: () {
+                            setState(() {
+                              _selectedMissionId = missionId;
+                            });
+                          },
+                          child: Container(
+                            decoration: BoxDecoration(
+                              color: active
+                                  ? rcGold.withValues(alpha: 0.08)
+                                  : Colors.transparent,
+                              border: const Border(
+                                bottom: BorderSide(color: rcLine),
+                              ),
+                            ),
+                            padding: const EdgeInsets.symmetric(
+                              horizontal: 20,
+                              vertical: 16,
+                            ),
+                            child: Column(
+                              crossAxisAlignment: CrossAxisAlignment.start,
+                              children: [
+                                Row(
+                                  children: [
+                                    Expanded(
+                                      child: Text(
+                                        data['name']?.toString() ??
+                                            data['title']?.toString() ??
+                                            missionId,
+                                        style: TextStyle(
+                                          color: active ? rcGold : Colors.white,
+                                          fontWeight: FontWeight.w700,
+                                          fontSize: 14,
+                                        ),
+                                      ),
+                                    ),
+                                    const SizedBox(width: 8),
+                                    _statusPill(
+                                      data['status']?.toString() ?? 'DRAFT',
+                                    ),
+                                  ],
+                                ),
+                                const SizedBox(height: 8),
+                                Row(
+                                  children: [
+                                    Text(
+                                      '${category.toString().toUpperCase()}  |  ${data['state'] ?? 'Central'}',
+                                      style: const TextStyle(
+                                        color: Colors.white30,
+                                        fontSize: 12,
+                                      ),
+                                    ),
+                                    const Spacer(),
+                                    Text(
+                                      '${variables.length} subject variables',
+                                      style: TextStyle(
+                                        color: rcGold.withValues(alpha: 0.8),
+                                        fontSize: 12,
+                                        fontWeight: FontWeight.bold,
+                                      ),
+                                    ),
+                                  ],
+                                ),
+                              ],
+                            ),
+                          ),
+                        );
+                      },
+                    );
+                  },
+                ),
+              ),
+            ],
+          ),
+        ),
+
+        // Right Column: Mission Detail View
+        Expanded(
+          child: _selectedMissionId == null
+              ? const Center(
+                  child: Text(
+                    'Select a prep mission from the sidebar to manage variables and content.',
+                    style: TextStyle(color: Colors.white30),
+                  ),
+                )
+              : StreamBuilder<DocumentSnapshot<Map<String, dynamic>>>(
+                  stream: FirebaseFirestore.instance
+                      .collection('mission_realms')
+                      .doc(_selectedMissionId)
+                      .snapshots(),
+                  builder: (context, snapshot) {
+                    if (!snapshot.hasData)
+                      return const RcCenteredLoader(compact: true);
+                    final missionData = snapshot.data!.data();
+                    if (missionData == null) {
+                      return const Center(child: Text('Mission not found.'));
+                    }
+                    return MissionDetailCenter(
+                      missionId: _selectedMissionId!,
+                      mission: missionData,
+                    );
+                  },
+                ),
+        ),
+      ],
+    );
+  }
+}
diff --git a/lib/web/founder/mission_control/mission_detail_center.dart b/lib/web/founder/mission_control/mission_detail_center.dart
new file mode 100644
