+const functions = require("firebase-functions");
+const { processGlobalDecay, updateMasterySnapshot } = require("../services/mastery_service");
+
+/**
+ * 🔱 MASTERY DECAY WORKER (RC-P14-C/D)
+ * Scheduled task to process overdue facts and update student snapshots.
+ */
+exports.masteryDecayWorker = functions.pubsub
+  .schedule('every 24 hours')
+  .onRun(async (context) => {
+    console.log("🔱 DECAY: Starting global decay processing...");
+
+    let totalProcessed = 0;
+    let batchInfo;
+    const allAffectedStudents = new Set();
+
+    // 1. Process Decay in batches until exhausted or limit reached
+    let iterations = 0;
+    const MAX_ITERATIONS = 50; // Safety cap
+
+    do {
+      batchInfo = await processGlobalDecay();
+      totalProcessed += batchInfo.count;
+      batchInfo.affectedStudents.forEach(s => allAffectedStudents.add(s));
+      iterations++;
+      console.log(`🔱 DECAY: Batch ${iterations} - Processed ${batchInfo.count} facts.`);
+    } while (batchInfo.count > 0 && iterations < MAX_ITERATIONS);
+
+    console.log(`🔱 DECAY: Decay processing complete. Total transitioned: ${totalProcessed}`);
+
+    // 2. Update snapshots for affected students
+    if (allAffectedStudents.size > 0) {
+      console.log(`🔱 DECAY: Updating snapshots for ${allAffectedStudents.size} students...`);
+      const studentIds = Array.from(allAffectedStudents);
+
+      // Update snapshots sequentially to avoid overwhelming Firestore (or use chunked parallelism)
+      for (const studentId of studentIds) {
+        try {
+          await updateMasterySnapshot(studentId);
+        } catch (err) {
+          console.error(`🔱 DECAY Error: Failed to update snapshot for ${studentId}`, err);
+        }
+      }
+    }
+
+    console.log("🔱 DECAY: All operations complete.");
+    return null;
+  });
