+const admin = require("firebase-admin");
+
+/**
+ * 🔱 RISK ENGINE SERVICE (RC-P15-A Foundation)
+ * Calculates Exam Failure Risk based on Coverage, Retention, and Mastery Health.
+ */
+
+const db = admin.firestore();
+
+const RISK_LEVELS = {
+    LOW: 'LOW',
+    MODERATE: 'MODERATE',
+    HIGH: 'HIGH',
+    SEVERE: 'SEVERE',
+    CRITICAL: 'CRITICAL'
+};
+
+/**
+ * Calculates a comprehensive Risk Snapshot for a student.
+ */
+async function calculateRiskSnapshot(studentId) {
+    // 1. Fetch Necessary Inputs
+    const [masterySnap, coverageSnaps] = await Promise.all([
+        db.collection('mastery_snapshots').doc(studentId).get(),
+        db.collection('coverage_snapshots').where('studentId', '==', studentId).get()
+    ]);
+
+    if (!masterySnap.exists) return null;
+
+    const mastery = masterySnap.data();
+
+    // Aggregating Coverage across all realms
+    let totalWeightedCoverage = 0;
+    let totalCoreCoverage = 0;
+    let count = 0;
+    const weakestRealms = [];
+
+    coverageSnaps.forEach(doc => {
+        const data = doc.data();
+        totalWeightedCoverage += (data.weightedCoveragePercent || 0);
+        totalCoreCoverage += (data.coreCoveragePercent || 0);
+
+        // Track potential weakest realms for P15-C
+        weakestRealms.push({
+            realmId: data.realmId,
+            score: data.weightedCoveragePercent
+        });
+
+        count++;
+    });
+
+    const avgWeightedCoverage = count > 0 ? totalWeightedCoverage / count : 0;
+    const avgCoreCoverage = count > 0 ? totalCoreCoverage / count : 0;
+
+    // 🔱 RC-P15-A Formula
+    // riskScore = 100 - (0.35*WCP + 0.25*CCP + 0.25*Retention + 0.15*Health)
+    const riskScore = 100 - (
+        (0.35 * avgWeightedCoverage) +
+        (0.25 * avgCoreCoverage) +
+        (0.25 * (mastery.retentionPercent || 0)) +
+        (0.15 * (mastery.masteryHealthScore || 0))
+    );
+
+    const clampedRiskScore = Math.max(0, Math.min(100, riskScore));
+
+    // 🔱 Classification
+    let riskLevel = RISK_LEVELS.LOW;
+    if (clampedRiskScore > 80) riskLevel = RISK_LEVELS.CRITICAL;
+    else if (clampedRiskScore > 60) riskLevel = RISK_LEVELS.SEVERE;
+    else if (clampedRiskScore > 40) riskLevel = RISK_LEVELS.HIGH;
+    else if (clampedRiskScore > 20) riskLevel = RISK_LEVELS.MODERATE;
+
+    // Revision Urgency based on Decay stats
+    const decayCount = (mastery.decayingFacts || 0) + (mastery.atRiskFacts || 0) + (mastery.forgottenFacts || 0);
+    const revisionUrgency = decayCount > 50 ? 'HIGH' : (decayCount > 10 ? 'MEDIUM' : 'LOW');
+
+    const riskSnapshot = {
+        studentId,
+        riskScore: parseFloat(clampedRiskScore.toFixed(2)),
+        riskLevel,
+        revisionUrgency,
+        decayingFacts: mastery.decayingFacts || 0,
+        atRiskFacts: mastery.atRiskFacts || 0,
+        forgottenFacts: mastery.forgottenFacts || 0,
+        avgWeightedCoverage: parseFloat(avgWeightedCoverage.toFixed(2)),
+        avgCoreCoverage: parseFloat(avgCoreCoverage.toFixed(2)),
+        retentionPercent: mastery.retentionPercent || 0,
+        masteryHealthScore: mastery.masteryHealthScore || 0,
+        weakestRealms: weakestRealms.sort((a, b) => a.score - b.score).slice(0, 3),
+        generatedAt: admin.firestore.Timestamp.now()
+    };
+
+    await db.collection('risk_snapshots').doc(studentId).set(riskSnapshot, { merge: true });
+    return riskSnapshot;
+}
+
+module.exports = {
+    calculateRiskSnapshot,
+    RISK_LEVELS
+};
