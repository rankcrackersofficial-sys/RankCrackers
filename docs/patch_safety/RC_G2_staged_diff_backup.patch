@@ -0,0 +1,142 @@
+const admin = require("firebase-admin");
+const { getStudentCache } = require("./analytics_cache_service");
+
+/**
+ * 🔱 CRUCIBLE STATE MACHINE (RC-P16-A)
+ * Manages the Battle State of a student based on Analytics & Risk.
+ */
+
+const db = admin.firestore();
+
+const STATES = {
+    DORMANT: 'DORMANT',
+    ACTIVE: 'ACTIVE',
+    ENGAGED: 'ENGAGED',
+    INTENSIVE: 'INTENSIVE',
+    CRITICAL: 'CRITICAL',
+    RECOVERY: 'RECOVERY'
+};
+
+// 🔱 State Progression Order (Linear Transitions)
+const STATE_SEQUENCE = [
+    STATES.DORMANT,
+    STATES.ACTIVE,
+    STATES.ENGAGED,
+    STATES.INTENSIVE,
+    STATES.CRITICAL,
+    STATES.RECOVERY
+];
+
+/**
+ * Evaluates and transitions the Crucible state for a student.
+ */
+async function evaluateCrucibleState(studentId) {
+    const [cache, stateDoc, interventionsSnap] = await Promise.all([
+        getStudentCache(studentId),
+        db.collection('crucible_states').doc(studentId).get(),
+        db.collection('student_interventions').doc(studentId).get()
+    ]);
+
+    if (!cache) return null;
+
+    let currentState = STATES.DORMANT;
+    if (stateDoc.exists) {
+        currentState = stateDoc.data().currentState;
+    }
+
+    const interventions = interventionsSnap.exists ? (interventionsSnap.data().activeInterventions || []) : [];
+    const hasMissionCritical = interventions.some(i => i.action === 'MISSION_CRITICAL');
+
+    // 🔱 Target State Selection based on Metrics
+    let targetState = STATES.ACTIVE;
+
+    // Triggers based on P15 Analytics
+    if (cache.globalWCP < 5) {
+        targetState = STATES.DORMANT;
+    } else if (cache.collapseProbability > 80 || hasMissionCritical) {
+        targetState = STATES.CRITICAL;
+    } else if (cache.collapseProbability > 60 || cache.riskLevel === 'SEVERE') {
+        targetState = STATES.INTENSIVE;
+    } else if (cache.collapseProbability > 40 || cache.riskLevel === 'HIGH') {
+        targetState = STATES.ENGAGED;
+    } else if (currentState === STATES.CRITICAL && cache.collapseProbability <= 80) {
+        // Recovery logic: Must pass through RECOVERY after CRITICAL
+        targetState = STATES.RECOVERY;
+    } else if (currentState === STATES.RECOVERY && cache.collapseProbability < 30) {
+        targetState = STATES.ACTIVE;
+    }
+
+    // 🔱 Linear Transition Enforcement (Observation: No jumping to CRITICAL from ACTIVE)
+    if (targetState !== currentState) {
+        const currentIndex = STATE_SEQUENCE.indexOf(currentState);
+        const targetIndex = STATE_SEQUENCE.indexOf(targetState);
+
+        let nextState = currentState;
+
+        // If target is ahead, move one step forward
+        if (targetIndex > currentIndex) {
+            nextState = STATE_SEQUENCE[currentIndex + 1];
+        }
+        // If target is behind, move one step backward (or follow specific recovery loop)
+        else if (targetIndex < currentIndex) {
+            // Special case: Recovery loop CRITICAL -> RECOVERY -> ACTIVE
+            if (currentState === STATES.RECOVERY) {
+                nextState = STATES.ACTIVE;
+            } else if (currentState === STATES.CRITICAL) {
+                nextState = STATES.RECOVERY;
+            } else {
+                nextState = STATE_SEQUENCE[currentIndex - 1];
+            }
+        }
+
+        if (nextState !== currentState) {
+            await transitionState(studentId, currentState, nextState, `Automated evaluation: Prob ${cache.collapseProbability}%, Risk ${cache.riskLevel}`);
+        }
+    }
+
+    return getCurrentState(studentId);
+}
+
+/**
+ * Performs the state transition and logs the event.
+ */
+async function transitionState(studentId, oldState, newState, reason) {
+    const now = admin.firestore.Timestamp.now();
+    const batch = db.batch();
+
+    // 1. Update Crucible State
+    const stateRef = db.collection('crucible_states').doc(studentId);
+    batch.set(stateRef, {
+        studentId,
+        currentState: newState,
+        previousState: oldState,
+        enteredAt: now,
+        lastTransitionAt: now,
+        reason,
+        updatedAt: now
+    }, { merge: true });
+
+    // 2. Log Immutable Event
+    const eventRef = db.collection('crucible_events').doc();
+    batch.set(eventRef, {
+        studentId,
+        oldState,
+        newState,
+        trigger: reason,
+        timestamp: now
+    });
+
+    await batch.commit();
+    console.log(`🔱 CRUCIBLE: Student ${studentId} transitioned ${oldState} -> ${newState}`);
+}
+
+async function getCurrentState(studentId) {
+    const snap = await db.collection('crucible_states').doc(studentId).get();
+    return snap.exists ? snap.data() : { currentState: STATES.DORMANT };
+}
+
+module.exports = {
+    evaluateCrucibleState,
+    getCurrentState,
+    STATES
+};
