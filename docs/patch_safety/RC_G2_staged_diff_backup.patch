+/**
+ * 🔱 TEXT QUALITY ENGINE
+ * Evaluates the structural integrity and semantic density of extracted text.
+ */
+function calculateTextQuality(text) {
+  if (!text) return 0;
+
+  // 1. Alpha Character Density (Check for OCR artifacts/noise)
+  const alphaChars = (text.match(/[a-zA-Z\u0900-\u097F]/g) || []).length;
+  const totalChars = text.length;
+  const alphaRatio = alphaChars / Math.max(totalChars, 1);
+
+  // 2. Word Count & Semantic Volume
+  const words = text.split(/\s+/).filter(Boolean);
+  const wordCount = words.length;
+
+  // 3. Unique Lexicon (Entropy)
+  const uniqueWords = new Set(words.map(w => w.toLowerCase())).size;
+
+  let score = 0;
+
+  // Rule A: Alpha Density (Weight: 40) - Low ratio suggests non-textual data or heavy corruption
+  if (alphaRatio > 0.5) score += 40;
+  else if (alphaRatio > 0.3) score += 20;
+
+  // Rule B: Minimum Word Volume (Weight: 30)
+  if (wordCount > 100) score += 30;
+  else if (wordCount > 50) score += 15;
+
+  // Rule C: Lexical Diversity (Weight: 30)
+  if (uniqueWords > 40) score += 30;
+  else if (uniqueWords > 20) score += 15;
+
+  return score;
+}
+
+module.exports = calculateTextQuality;
diff --git a/functions/services/adaptive_scheduler_service.js b/functions/services/adaptive_scheduler_service.js
