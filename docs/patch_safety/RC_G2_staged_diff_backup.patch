+const admin = require("firebase-admin");
+const { getSystemConfig } = require("./config_service");
+const { getCurrentDailyCycle } = require("./crucible_cycle_service");
+
+/**
+ * 🔱 TACTICAL SCHEDULE ENGINE (RC-P16-C)
+ * Converts Crucible Cycle Targets into actual Tactical Time Blocks.
+ */
+
+const db = admin.firestore();
+
+const BLOCK_TYPES = {
+    REVISION: 'REVISION',
+    PRACTICE: 'PRACTICE',
+    BATTLE: 'BATTLE',
+    BREAK: 'BREAK'
+};
+
+/**
+ * Generates the Daily Tactical Schedule for a student.
+ */
+async function generateDailySchedule(studentId, options = {}) {
+    const config = await getSystemConfig();
+    const dailyCycle = await getCurrentDailyCycle(studentId);
+
+    if (!dailyCycle) {
+        console.error(`🔱 TACTICAL: No daily cycle found for student ${studentId}.`);
+        return null;
+    }
+
+    const availableHours = options.availableHours || 8;
+    const maxWorkload = dailyCycle.burnoutProtection
+        ? config.workloadCaps.recoveryMaxMinutes
+        : config.workloadCaps.defaultMaxMinutes;
+
+    const scheduleDate = dailyCycle.cycleDate;
+    const scheduleId = `${studentId}_${scheduleDate}`;
+
+    // 1. Fetch Priority Inputs
+    const [priorityQueueSnap, interventionsSnap, cacheSnap] = await Promise.all([
+        db.collection('revision_priority_queue').where('studentId', '==', studentId).get(),
+        db.collection('student_interventions').doc(studentId).get(),
+        db.collection('student_analytics_cache').doc(studentId).get()
+    ]);
+
+    const priorityQueue = priorityQueueSnap.docs.map(doc => doc.data());
+    const interventions = interventionsSnap.exists ? (interventionsSnap.data().activeInterventions || []) : [];
+    const cache = cacheSnap.exists ? cacheSnap.data() : {};
+
+    // 2. Generate Time Blocks
+    const timeBlocks = [];
+    let currentOrder = 0;
+    let totalMinutes = 0;
+
+    const durations = config.sessionDurations;
+
+    // A. REVISION BLOCKS (Highest Priority)
+    // Map interventions to revision tasks
+    const criticalInterventions = interventions.filter(i => i.action === 'MISSION_CRITICAL');
+    const coreGapInterventions = interventions.filter(i => i.action === 'CORE_GAP_RECOVERY');
+
+    let revisionTarget = dailyCycle.revisionSessions;
+
+    // Fill revision blocks using priority queue and interventions
+    for (let i = 0; i < revisionTarget; i++) {
+        if (totalMinutes + durations.revision > maxWorkload) break;
+
+        let meta = {};
+        let source = 'PRIORITY_QUEUE';
+        let factId = null;
+        let realmId = null;
+
+        if (criticalInterventions.length > 0 && i < criticalInterventions.length) {
+            source = 'MISSION_CRITICAL';
+            meta = criticalInterventions[i];
+        } else if (coreGapInterventions.length > 0 && (i - criticalInterventions.length) < coreGapInterventions.length) {
+            source = 'CORE_GAP_RECOVERY';
+            meta = coreGapInterventions[i - criticalInterventions.length];
+            realmId = meta.realmId;
+        } else if (priorityQueue.length > 0) {
+            const fact = priorityQueue.shift();
+            factId = fact.factId;
+            source = 'REVISION_PRIORITY_QUEUE';
+        } else if (cache.weakestRealms && cache.weakestRealms.length > 0) {
+            realmId = cache.weakestRealms[i % cache.weakestRealms.length].realmId;
+            source = 'WEAKEST_REALMS';
+        }
+
+        timeBlocks.push({
+            type: BLOCK_TYPES.REVISION,
+            startOrder: currentOrder++,
+            durationMinutes: durations.revision,
+            source,
+            priority: 1,
+            realmId,
+            factId,
+            metadata: meta
+        });
+        totalMinutes += durations.revision;
+
+        // Add break
+        if (totalMinutes + durations.break <= maxWorkload) {
+            timeBlocks.push({
+                type: BLOCK_TYPES.BREAK,
+                startOrder: currentOrder++,
+                durationMinutes: durations.break,
+                source: 'SYSTEM',
+                priority: 0
+            });
+            totalMinutes += durations.break;
+        }
+    }
+
+    // B. PRACTICE BLOCKS
+    for (let i = 0; i < dailyCycle.practiceSessions; i++) {
+        if (totalMinutes + durations.practice > maxWorkload) break;
+
+        let realmId = null;
+        if (cache.weakestRealms && cache.weakestRealms.length > 0) {
+            realmId = cache.weakestRealms[i % cache.weakestRealms.length].realmId;
+        }
+
+        timeBlocks.push({
+            type: BLOCK_TYPES.PRACTICE,
+            startOrder: currentOrder++,
+            durationMinutes: durations.practice,
+            source: 'DAILY_CYCLE',
+            priority: 2,
+            realmId
+        });
+        totalMinutes += durations.practice;
+
+        if (totalMinutes + durations.break <= maxWorkload) {
+            timeBlocks.push({
+                type: BLOCK_TYPES.BREAK,
+                startOrder: currentOrder++,
+                durationMinutes: durations.break,
+                source: 'SYSTEM',
+                priority: 0
+            });
+            totalMinutes += durations.break;
+        }
+    }
+
+    // C. BATTLE BLOCKS
+    for (let i = 0; i < dailyCycle.battleSessions; i++) {
+        if (totalMinutes + durations.battle > maxWorkload) break;
+
+        timeBlocks.push({
+            type: BLOCK_TYPES.BATTLE,
+            startOrder: currentOrder++,
+            durationMinutes: durations.battle,
+            source: 'DAILY_CYCLE',
+            priority: 3
+        });
+        totalMinutes += durations.battle;
+
+        if (totalMinutes + durations.break <= maxWorkload) {
+            timeBlocks.push({
+                type: BLOCK_TYPES.BREAK,
+                startOrder: currentOrder++,
+                durationMinutes: durations.break,
+                source: 'SYSTEM',
+                priority: 0
+            });
+            totalMinutes += durations.break;
+        }
+    }
+
+    const schedule = {
+        studentId,
+        scheduleDate,
+        state: dailyCycle.state,
+        timeBlocks,
+        totalStudyMinutes: totalMinutes,
+        burnoutProtection: dailyCycle.burnoutProtection,
+        coreRecoveryMode: dailyCycle.coreRecoveryMode,
+        updatedAt: admin.firestore.FieldValue.serverTimestamp()
+    };
+
+    await db.collection('tactical_schedules').doc(scheduleId).set(schedule, { merge: true });
+    return schedule;
+}
+
+async function getCurrentSchedule(studentId) {
+    const dateId = new Date().toISOString().split('T')[0].replace(/-/g, '');
+    const snap = await db.collection('tactical_schedules').doc(`${studentId}_${dateId}`).get();
+    return snap.exists ? snap.data() : null;
+}
+
+module.exports = {
+    generateDailySchedule,
+    getCurrentSchedule
+};
