+++ b/lib/web/admin/admin_web_shell.dart
@@ -0,0 +1,151 @@
+import 'package:cloud_firestore/cloud_firestore.dart';
+import 'package:firebase_auth/firebase_auth.dart';
+import 'package:flutter/material.dart';
+import '../../features/admin/presentation/widgets/review_queue/admin_tasks_list.dart';
+import '../shared/rc_colors.dart';
+import '../shared/rc_loaders.dart';
+import 'admin_header.dart';
+import 'admin_my_access_panel.dart';
+import 'admin_module_placeholder.dart';
+
+class AdminWebShell extends StatefulWidget {
+  final User user;
+  const AdminWebShell({super.key, required this.user});
+
+  @override
+  State<AdminWebShell> createState() => _AdminWebShellState();
+}
+
+class _AdminWebShellState extends State<AdminWebShell> {
+  int _selectedIndex = 0;
+
+  @override
+  Widget build(BuildContext context) {
+    return StreamBuilder<DocumentSnapshot<Map<String, dynamic>>>(
+      stream: FirebaseFirestore.instance.collection('users').doc(widget.user.uid).snapshots(),
+      builder: (context, snapshot) {
+        if (!snapshot.hasData) return const Scaffold(body: RcCenteredLoader());
+        
+        final data = snapshot.data!.data();
+        final status = data?['status'] ?? 'ACTIVE';
+        
+        if (status != 'ACTIVE') {
+          return const Scaffold(
+            body: Center(
+              child: Text('Admin access is not active. Contact Founder.', style: TextStyle(color: rcRed, fontSize: 18, fontWeight: FontWeight.bold)),
+            ),
+          );
+        }
+
+        final permissions = Map<String, bool>.from(data?['permissions'] ?? {});
+        final modules = _getModules(permissions);
+
+        if (_selectedIndex >= modules.length) _selectedIndex = 0;
+        final currentModule = modules[_selectedIndex];
+
+        return Scaffold(
+          backgroundColor: rcBg,
+          body: Row(
+            children: [
+              NavigationRail(
+                backgroundColor: const Color(0xFF050A10),
+                selectedIndex: _selectedIndex,
+                onDestinationSelected: (idx) => setState(() => _selectedIndex = idx),
+                labelType: NavigationRailLabelType.all,
+                useIndicator: true,
+                indicatorColor: rcGold.withValues(alpha: 0.1),
+                destinations: modules.map((m) => NavigationRailDestination(
+                  icon: Icon(m.icon, color: Colors.white24),
+                  selectedIcon: Icon(m.icon, color: rcGold),
+                  label: Text(m.label, style: const TextStyle(fontSize: 9, fontWeight: FontWeight.bold)),
+                )).toList(),
+              ),
+              const VerticalDivider(width: 1, color: rcLine),
+              Expanded(
+                child: Column(
+                  children: [
+                    const AdminHeader(),
+                    Expanded(child: currentModule.builder(context)),
+                  ],
+                ),
+              ),
+            ],
+          ),
+        );
+      },
+    );
+  }
+
+  List<AdminModule> _getModules(Map<String, bool> perms) {
+    final List<AdminModule> list = [
+      AdminModule(
+        label: 'Work Queue',
+        icon: Icons.assignment_ind_rounded,
+        builder: (_) => const AdminTasksList(),
+      ),
+    ];
+
+    if (perms['missionControlView'] == true || perms['missionDocumentsView'] == true) {
+      list.add(AdminModule(
+        label: 'Missions',
+        icon: Icons.account_tree_rounded,
+        builder: (_) => const AdminModulePlaceholder(title: 'Mission Workspace', message: 'Mission Workspace will show assigned mission context. Deep workspace coming in A5D/A5E.', icon: Icons.account_tree_rounded),
+      ));
+    }
+
+    if (perms['ingestionReviewView'] == true || perms['missionDocumentsView'] == true) {
+      list.add(AdminModule(
+        label: 'Documents',
+        icon: Icons.fact_check_rounded,
+        builder: (_) => const AdminModulePlaceholder(title: 'Document Review', message: 'Document Review workspace for OCR and Linkage Audit coming in A5E.', icon: Icons.fact_check_rounded),
+      ));
+    }
+
+    if (perms['syllabusAtomReview'] == true) {
+      list.add(AdminModule(
+        label: 'Syllabus',
+        icon: Icons.verified_rounded,
+        builder: (_) => const AdminModulePlaceholder(title: 'Syllabus Review', message: 'Syllabus atom verification workspace coming in A5F.', icon: Icons.verified_rounded),
+      ));
+    }
+
+    if (perms['pyqQuestionReview'] == true) {
+      list.add(AdminModule(
+        label: 'PYQ',
+        icon: Icons.history_edu_rounded,
+        builder: (_) => const AdminModulePlaceholder(title: 'PYQ Review', message: 'PYQ question verification workspace coming in A5F.', icon: Icons.history_edu_rounded),
+      ));
+    }
+
+    if (perms['cruciblePlanView'] == true || perms['blueprintView'] == true || perms['questionSetView'] == true) {
+      list.add(AdminModule(
+        label: 'Crucible',
+        icon: Icons.analytics_rounded,
+        builder: (_) => const AdminModulePlaceholder(title: 'Crucible Audit', message: 'Crucible Review workspace for Plans and Blueprints coming in A5G.', icon: Icons.analytics_rounded),
+      ));
+    }
+
+    if (perms['studyMasterView'] == true) {
+      list.add(AdminModule(
+        label: 'Study Library',
+        icon: Icons.menu_book_rounded,
+        builder: (_) => const AdminModulePlaceholder(title: 'Study Library Review', message: 'Study Library Review workspace coming in A5G/A5H.', icon: Icons.menu_book_rounded),
+      ));
+    }
+
+    list.add(AdminModule(
+      label: 'My Access',
+      icon: Icons.shield_rounded,
+      builder: (_) => const AdminMyAccessPanel(),
+    ));
+
+    return list;
+  }
+}
+
+class AdminModule {
+  final String label;
+  final IconData icon;
+  final WidgetBuilder builder;
+  AdminModule({required this.label, required this.icon, required this.builder});
+}
diff --git a/lib/web/founder/access/admin_task_assignment_dialog.dart b/lib/web/founder/access/admin_task_assignment_dialog.dart
new file mode 100644
index 0000000..99831cb
--- /dev/null
+++ b/lib/web/founder/access/admin_task_assignment_dialog.dart
@@ -0,0 +1,162 @@
+import 'package:cloud_firestore/cloud_firestore.dart';
+import 'package:firebase_auth/firebase_auth.dart';
+import 'package:flutter/material.dart';
+import '../../shared/rc_colors.dart';
+import '../../shared/rc_field.dart';
+
+class AdminTaskAssignmentDialog extends StatefulWidget {
+  final String missionId;
+  final String adminUid;
+  final String adminName;
+  final String adminEmail;
+  final Map<String, dynamic> adminPermissions;
+
+  const AdminTaskAssignmentDialog({
+    super.key,
+    required this.missionId,
+    required this.adminUid,
+    required this.adminName,
+    required this.adminEmail,
+    required this.adminPermissions,
+  });
+
+  @override
+  State<AdminTaskAssignmentDialog> createState() => _AdminTaskAssignmentDialogState();
+}
+
+class _AdminTaskAssignmentDialogState extends State<AdminTaskAssignmentDialog> {
+  String _taskType = 'DOCUMENT_REVIEW';
+  String _priority = 'NORMAL';
+  final _descCtrl = TextEditingController();
+  final _titleCtrl = TextEditingController();
+  bool _busy = false;
+
+  final Map<String, String> _typePermissions = {
+    'DOCUMENT_REVIEW': 'missionDocumentsView',
+    'OCR_REPROCESS_REVIEW': 'ingestionReviewView',
+    'SYLLABUS_ATOM_REVIEW': 'syllabusAtomReview',
+    'PYQ_QUESTION_REVIEW': 'pyqQuestionReview',
+    'CRUCIBLE_PLAN_AUDIT': 'cruciblePlanView',
+    'BLUEPRINT_REVIEW': 'blueprintView',
+    'QUESTION_SET_REVIEW': 'questionSetView',
+    'ASSESSMENT_DRAFT_REVIEW': 'cruciblePlanView',
+    'PUBLISH_PACKAGE_REVIEW': 'publishCenterView',
+  };
+
+  bool get _hasPermission {
+    final req = _typePermissions[_taskType];
+    return widget.adminPermissions[req] == true;
+  }
+
+  Future<void> _assignTask() async {
+    if (_titleCtrl.text.trim().isEmpty) return;
+    if (!_hasPermission) return;
+
+    setState(() => _busy = true);
+    try {
+      final db = FirebaseFirestore.instance;
+      final taskId = 'task_${DateTime.now().millisecondsSinceEpoch}';
+      final currentUser = FirebaseAuth.instance.currentUser;
+      final now = FieldValue.serverTimestamp();
+
+      await db.runTransaction((transaction) async {
+        final taskRef = db.collection('admin_tasks').doc(taskId);
+        transaction.set(taskRef, {
+          'taskId': taskId,
+          'title': _titleCtrl.text.trim(),
+          'description': _descCtrl.text.trim(),
+          'taskType': _taskType,
+          'status': 'OPEN',
+          'priority': _priority,
+          'assignedToUid': widget.adminUid,
+          'assignedToName': widget.adminName,
+          'assignedToEmail': widget.adminEmail,
+          'assignedByUid': currentUser?.uid,
+          'assignedByEmail': currentUser?.email,
+          'missionId': widget.missionId,
+          'requiredPermission': _typePermissions[_taskType],
+          'createdAt': now,
+          'updatedAt': now,
+        });
+
+        final auditRef = db.collection('admin_task_audit').doc('audit_$taskId');
+        transaction.set(auditRef, {
+          'taskId': taskId,
+          'action': 'TASK_CREATED',
+          'actorUid': currentUser?.uid,
+          'actorEmail': currentUser?.email,
+          'targetAdminUid': widget.adminUid,
+          'afterStatus': 'OPEN',
+          'timestamp': now,
+        });
+      });
+
+      if (mounted) Navigator.pop(context, true);
+    } catch (e) {
+      if (mounted) {
+        ScaffoldMessenger.of(context).showSnackBar(SnackBar(content: Text('Failed to assign task: $e')));
+      }
+    } finally {
+      if (mounted) setState(() => _busy = false);
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    return AlertDialog(
+      backgroundColor: rcBg,
+      title: const Text('ASSIGN ADMIN TASK', style: TextStyle(color: rcGold, fontWeight: FontWeight.bold, fontSize: 16)),
+      content: SizedBox(
+        width: 500,
+        child: SingleChildScrollView(
+          child: Column(
+            mainAxisSize: MainAxisSize.min,
+            crossAxisAlignment: CrossAxisAlignment.start,
+            children: [
+              Text('Assigning to: ${widget.adminName}', style: const TextStyle(color: Colors.white70, fontSize: 13)),
+              const SizedBox(height: 20),
+              RcField(controller: _titleCtrl, label: 'Task Title (Short)'),
+              const SizedBox(height: 12),
+              DropdownButtonFormField<String>(
+                value: _taskType,
+                decoration: const InputDecoration(labelText: 'Task Type'),
+                items: _typePermissions.keys.map((t) => DropdownMenuItem(value: t, child: Text(t.replaceAll('_', ' ')))).toList(),
+                onChanged: (v) => setState(() => _taskType = v!),
+              ),
+              const SizedBox(height: 12),
+              if (!_hasPermission)
+                Container(
+                  padding: const EdgeInsets.all(8),
+                  decoration: BoxDecoration(color: rcRed.withValues(alpha: 0.1), borderRadius: BorderRadius.circular(4)),
+                  child: Row(
+                    children: [
+                      const Icon(Icons.error_outline, color: rcRed, size: 16),
+                      const SizedBox(width: 8),
+                      Expanded(child: Text('Admin lacks required permission: ${_typePermissions[_taskType]}', style: const TextStyle(color: rcRed, fontSize: 11))),
+                    ],
+                  ),
+                ),
+              const SizedBox(height: 12),
+              DropdownButtonFormField<String>(
+                value: _priority,
+                decoration: const InputDecoration(labelText: 'Priority'),
+                items: ['LOW', 'NORMAL', 'HIGH', 'URGENT'].map((p) => DropdownMenuItem(value: p, child: Text(p))).toList(),
+                onChanged: (v) => setState(() => _priority = v!),
+              ),
+              const SizedBox(height: 12),
+              RcField(controller: _descCtrl, label: 'Instructions / Notes', maxLines: 3),
+            ],
+          ),
+        ),
+      ),
+      actions: [
+        TextButton(onPressed: () => Navigator.pop(context), child: const Text('CANCEL')),
+        FilledButton(
+          onPressed: (_busy || !_hasPermission) ? null : _assignTask,
+          style: FilledButton.styleFrom(backgroundColor: rcGold, foregroundColor: Colors.black),
+          child: Text(_busy ? 'ASSIGNING...' : 'CONFIRM ASSIGNMENT'),
+        ),
+      ],
+    );
+  }
