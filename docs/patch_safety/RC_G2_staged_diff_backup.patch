+import 'package:flutter/material.dart';
+
+import '../../shared/rc_colors.dart';
+import 'ai_proposals_tab.dart';
+import 'user_preview_tab.dart';
+import 'mission_documents_tab.dart';
+import 'mission_variables_tab.dart';
+import 'mission_overview_tab.dart';
+import 'publish_center_tab.dart';
+import 'edit_mission_dialog.dart';
+
+class MissionDetailCenter extends StatefulWidget {
+  final String missionId;
+  final Map<String, dynamic> mission;
+  const MissionDetailCenter({
+    super.key,
+    required this.missionId,
+    required this.mission,
+  });
+
+  @override
+  State<MissionDetailCenter> createState() => _MissionDetailCenterState();
+}
+
+class _MissionDetailCenterState extends State<MissionDetailCenter> {
+  int _detailTab = 0;
+
+  @override
+  Widget build(BuildContext context) {
+    final tabs = [
+      'Overview',
+      'Variables',
+      'Mission Documents',
+      'AI Proposals / Review',
+      'Publish Center',
+      'User Preview',
+    ];
+
+    Widget body;
+    switch (_detailTab) {
+      case 0:
+        body = OverviewTab(
+          missionId: widget.missionId,
+          mission: widget.mission,
+          onEditMission: () {
+            showDialog(
+              context: context,
+              builder: (context) => EditMissionDialog(
+                missionId: widget.missionId,
+                mission: widget.mission,
+              ),
+            );
+          },
+        );
+        break;
+      case 1:
+        body = VariablesTab(
+          missionId: widget.missionId,
+          mission: widget.mission,
+        );
+        break;
+      case 2:
+        body = MissionDocumentsTab(
+          missionId: widget.missionId,
+          mission: widget.mission,
+        );
+        break;
+      case 3:
+        body = ProposalsTab(missionId: widget.missionId);
+        break;
+      case 4:
+        body = PublishCenterTab(
+          missionId: widget.missionId,
+          mission: widget.mission,
+        );
+        break;
+      case 5:
+        body = UserPreviewTab(
+          missionId: widget.missionId,
+          mission: widget.mission,
+        );
+        break;
+      default:
+        body = Container();
+    }
+
+    return Column(
+      crossAxisAlignment: CrossAxisAlignment.stretch,
+      children: [
+        // Sub tabs header
+        Container(
+          color: const Color(0xFF0C141F),
+          child: SingleChildScrollView(
+            scrollDirection: Axis.horizontal,
+            child: Row(
+              children: List.generate(
+                tabs.length,
+                (index) => InkWell(
+                  onTap: () => setState(() => _detailTab = index),
+                  child: Container(
+                    padding: const EdgeInsets.symmetric(
+                      horizontal: 16,
+                      vertical: 14,
+                    ),
+                    decoration: BoxDecoration(
+                      border: Border(
+                        bottom: BorderSide(
+                          color:
+                              _detailTab == index ? rcGold : Colors.transparent,
+                          width: 2,
+                        ),
+                      ),
+                    ),
+                    child: Text(
+                      tabs[index],
+                      style: TextStyle(
+                        fontSize: 12,
+                        color: _detailTab == index ? rcGold : Colors.white54,
+                        fontWeight: _detailTab == index
+                            ? FontWeight.bold
+                            : FontWeight.normal,
+                      ),
+                    ),
+                  ),
+                ),
+              ),
+            ),
+          ),
+        ),
+        const Divider(height: 1, color: rcLine),
+        Expanded(child: body),
+      ],
+    );
+  }
+}
