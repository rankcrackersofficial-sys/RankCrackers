@@ -0,0 +1,69 @@
+const { GoogleGenerativeAI } = require("@google-generative-ai");
+const BaseProvider = require("./base_provider");
+
+/**
+ * 🔱 GEMINI PROVIDER ADAPTER
+ * Integrated with RankCrackers Exponential Backoff & Status-based Retry.
+ */
+class GeminiProvider extends BaseProvider {
+    constructor() {
+        super();
+        this.lastRequestTime = 0;
+        this.MIN_INTERVAL_MS = 1000;
+    }
+
+    async generate(prompt, options = {}) {
+        const apiKey = process.env.GEMINI_API_KEY;
+        if (!apiKey) throw new Error("GEMINI_API_KEY_MISSING");
+
+        const genAI = new GoogleGenerativeAI(apiKey);
+        const modelType = options.model === "pro" ? "gemini-1.5-pro" : "gemini-1.5-flash";
+
+        const MAX_RETRIES = 3;
+        let lastError;
+
+        for (let attempt = 1; attempt <= MAX_RETRIES; attempt++) {
+            try {
+                // 🛡️ Rate Limiter (Basic Instance-level protection)
+                const now = Date.now();
+                if (now - this.lastRequestTime < this.MIN_INTERVAL_MS) {
+                    await new Promise(r => setTimeout(r, this.MIN_INTERVAL_MS - (now - this.lastRequestTime)));
+                }
+                this.lastRequestTime = Date.now();
+
+                const model = genAI.getGenerativeModel({
+                    model: modelType,
+                    generationConfig: {
+                        responseMimeType: "application/json",
+                        temperature: options.temperature || 0.1,
+                    }
+                });
+
+                const result = await model.generateContent(prompt);
+                const response = await result.response;
+                const text = response.text();
+
+                if (!text) throw new Error("GEMINI_EMPTY_RESPONSE");
+                return text;
+
+            } catch (error) {
+                lastError = error;
+                const status = error.status || (error.response ? error.response.status : null);
+                const isRetryable = [429, 500, 503, 504].includes(status) ||
+                                    error.message.includes('429') ||
+                                    error.message.includes('TIMEOUT') ||
+                                    error.message.includes('DEADLINE_EXCEEDED');
+
+                if (isRetryable && attempt < MAX_RETRIES) {
+                    const backoffMs = Math.pow(2, attempt) * 1000;
+                    console.warn(`🔱 GEMINI ADAPTER RETRY (${attempt}/${MAX_RETRIES}): ${error.message}`);
+                    await new Promise(r => setTimeout(r, backoffMs));
+                } else {
+                    throw new Error(`GEMINI_ADAPTER_FAILURE: ${error.message}`);
+                }
+            }
+        }
+    }
+}
+
+module.exports = GeminiProvider;
