+const admin = require("firebase-admin");
+
+/**
+ * 🔱 PROVIDER RATE & BUDGET SERVICE (RC-P12-D)
+ * Centralized Rate Limiting and Cost Tracking for Hyperscale Sovereignty.
+ */
+
+const db = admin.firestore();
+
+// 🔱 Cost Multipliers (In INR - Approximate for Gemini)
+const COSTS = {
+    "gemini-1.5-flash": 0.01 / 1000, // Very cheap
+    "gemini-1.5-pro": 0.30 / 1000,   // Expensive
+};
+
+/**
+ * Checks and acquires quota before an AI call.
+ */
+async function acquireQuota(providerId, model) {
+    const today = new Date().toISOString().substring(0, 10);
+    const budgetRef = db.collection('provider_budget').doc(providerId);
+
+    return await db.runTransaction(async (transaction) => {
+        const snap = await transaction.get(budgetRef);
+        if (!snap.exists) {
+            // Default Daily Budget: 2M Tokens, 5000 Requests
+            const defaultBudget = {
+                dailyTokenLimit: 2000000,
+                dailyRequestLimit: 5000,
+                consumedTokens: 0,
+                consumedRequests: 0,
+                lastResetDate: today
+            };
+            transaction.set(budgetRef, defaultBudget);
+            return true;
+        }
+
+        const data = snap.data();
+
+        // Reset if new day
+        if (data.lastResetDate !== today) {
+            transaction.update(budgetRef, {
+                consumedTokens: 0,
+                consumedRequests: 0,
+                lastResetDate: today
+            });
+            return true;
+        }
+
+        // 🛡️ BUDGET GUARD
+        if (data.consumedTokens >= data.dailyTokenLimit) throw new Error("BUDGET_EXCEEDED: Token limit reached.");
+        if (data.consumedRequests >= data.dailyRequestLimit) throw new Error("BUDGET_EXCEEDED: Request limit reached.");
+
+        // Optimistically increment request count
+        transaction.update(budgetRef, { consumedRequests: admin.firestore.FieldValue.increment(1) });
+        return true;
+    });
+}
+
+/**
+ * Tracks actual usage after a successful AI call.
+ */
+async function trackUsage(usageData) {
+    const { provider, model, tokens, workflowId, correlationId, latencyMs } = usageData;
+    const today = new Date().toISOString().substring(0, 10);
+    const logId = `log_${Date.now()}_${Math.floor(Math.random() * 1000)}`;
+
+    const costPerToken = COSTS[model] || COSTS["gemini-1.5-flash"];
+    const costEstimate = tokens * costPerToken;
+
+    const batch = db.batch();
+
+    // 1. Log detailed usage
+    batch.set(db.collection('provider_usage_logs').doc(logId), {
+        provider, model, tokens, costEstimate, workflowId, correlationId, latencyMs,
+        timestamp: admin.firestore.FieldValue.serverTimestamp()
+    });
+
+    // 2. Update Daily Budget Consumption
+    batch.set(db.collection('provider_budget').doc(provider), {
+        consumedTokens: admin.firestore.FieldValue.increment(tokens),
+        updatedAt: admin.firestore.FieldValue.serverTimestamp()
+    }, { merge: true });
+
+    await batch.commit();
+
+    // 3. Kill Switch Check (External to batch for speed)
+    const budgetSnap = await db.collection('provider_budget').doc(provider).get();
+    if (budgetSnap.exists && budgetSnap.data().consumedTokens >= budgetSnap.data().dailyTokenLimit) {
+        await db.collection('provider_health').doc(provider).update({
+            healthy: false,
+            reason: "DAILY_TOKEN_BUDGET_EXCEEDED"
+        });
+    }
+}
+
+module.exports = { acquireQuota, trackUsage };
