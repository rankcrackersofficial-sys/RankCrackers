@@ -0,0 +1,76 @@
+const admin = require("firebase-admin");
+
+/**
+ * 🔱 CANONICAL TRUTH SERVICE
+ * Resolves messy LLM names into Standardized Canonical IDs.
+ * Preventing fragmentation and duplicate entities.
+ */
+
+const db = admin.firestore();
+
+/**
+ * Resolves an Organization/Board name.
+ * Maps "Staff Selection Commission" -> "ssc"
+ */
+async function resolveBoard(inputName) {
+    if (!inputName) return 'unknown';
+
+    const cleanInput = inputName.trim().toLowerCase();
+
+    // 1. Check Canonical Registry (Aliases Map)
+    // Collection: canonical_boards | Document: ssc { aliases: ["staff selection commission", "s.s.c."] }
+    const boardsSnap = await db.collection('canonical_boards')
+        .where('aliases', 'array-contains', cleanInput)
+        .limit(1)
+        .get();
+
+    if (!boardsSnap.empty) {
+        return boardsSnap.docs[0].id;
+    }
+
+    // 2. Direct ID Match
+    const directDoc = await db.collection('canonical_boards').doc(cleanInput).get();
+    if (directDoc.exists) return directDoc.id;
+
+    // 3. Fallback: Slugify and Flag for Review
+    const slug = cleanInput.replace(/\s+/g, '_').replace(/[^\w]/g, '');
+    console.warn(`🔱 TRUTH_SERVICE: Unmapped board detected: "${inputName}". Using slug: ${slug}`);
+
+    return slug;
+}
+
+/**
+ * Resolves Exam Category.
+ * Maps "Combined Graduate Level" -> "ssc_cgl"
+ */
+async function resolveCategory(inputName) {
+    if (!inputName) return 'general';
+
+    const cleanInput = inputName.trim().toLowerCase();
+
+    const catSnap = await db.collection('canonical_exam_categories')
+        .where('aliases', 'array-contains', cleanInput)
+        .limit(1)
+        .get();
+
+    if (!catSnap.empty) return catSnap.docs[0].id;
+
+    return cleanInput.replace(/\s+/g, '_').replace(/[^\w]/g, '');
+}
+
+/**
+ * Generates a Stable, Non-Hallucinated ID for Recruitment.
+ * Priority: fileHash-based anchoring.
+ */
+function generateStableRecruitmentId(fileHash, year) {
+    if (!fileHash) return null;
+    const prefix = String(fileHash).substring(0, 10);
+    const targetYear = year || new Date().getFullYear();
+    return `rec_${prefix}_${targetYear}`;
+}
+
+module.exports = {
+    resolveBoard,
+    resolveCategory,
+    generateStableRecruitmentId
+};
