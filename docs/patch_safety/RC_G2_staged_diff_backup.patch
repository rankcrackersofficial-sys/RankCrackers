+const admin = require("firebase-admin");
+
+/**
+ * 🔱 REVISION PRIORITY QUEUE SERVICE (RC-P15-D)
+ * Calculates which facts need urgent revision based on Importance, Risk, and Decay.
+ */
+
+const db = admin.firestore();
+
+/**
+ * Updates the Revision Priority Queue for a student.
+ */
+async function updatePriorityQueue(studentId) {
+    const now = admin.firestore.Timestamp.now();
+
+    // 1. Fetch facts that are not MASTERED (Learning, Decaying, At Risk, Forgotten)
+    const pendingSnap = await db.collection('student_fact_mastery')
+        .where('studentId', '==', studentId)
+        .where('masteryState', 'in', ['LEARNING', 'DECAYING', 'AT_RISK', 'FORGOTTEN'])
+        .limit(100) // Focus on top 100 urgent ones
+        .get();
+
+    if (pendingSnap.empty) return [];
+
+    const factIds = pendingSnap.docs.map(doc => doc.data().factId);
+
+    // 2. Fetch Entity Metadata for Importance Weights
+    const entitySnaps = await Promise.all(factIds.map(id => db.collection('entity_registry').doc(id).get()));
+    const weightMap = {};
+    entitySnaps.forEach(snap => {
+        if (snap.exists) weightMap[snap.id] = snap.data().metadata?.importance || 1;
+    });
+
+    // 3. Fetch Student's Risk Snapshot for Global Risk Context
+    const riskSnap = await db.collection('risk_snapshots').doc(studentId).get();
+    const globalRiskScore = riskSnap.exists ? riskSnap.data().riskScore : 50;
+
+    const priorities = [];
+    const batch = db.batch();
+
+    pendingSnap.forEach(doc => {
+        const data = doc.data();
+        const importance = weightMap[data.factId] || 1;
+
+        // Decay Factor based on State
+        let decayMultiplier = 1.0;
+        if (data.masteryState === 'FORGOTTEN') decayMultiplier = 2.5;
+        else if (data.masteryState === 'AT_RISK') decayMultiplier = 1.8;
+        else if (data.masteryState === 'DECAYING') decayMultiplier = 1.3;
+
+        // 🔱 RC-P15-D Formula: Priority Score
+        // Priority = Importance * (GlobalRisk/50) * DecayFactor
+        const priorityScore = importance * (globalRiskScore / 50) * decayMultiplier;
+
+        const queueItem = {
+            studentId,
+            factId: data.factId,
+            priorityScore: parseFloat(priorityScore.toFixed(2)),
+            masteryState: data.masteryState,
+            importance,
+            updatedAt: now
+        };
+
+        const queueRef = db.collection('revision_priority_queue').doc(`${studentId}_${data.factId}`);
+        batch.set(queueRef, queueItem, { merge: true });
+        priorities.push(queueItem);
+    });
+
+    await batch.commit();
+    return priorities.sort((a, b) => b.priorityScore - a.priorityScore);
+}
+
+module.exports = { updatePriorityQueue };
