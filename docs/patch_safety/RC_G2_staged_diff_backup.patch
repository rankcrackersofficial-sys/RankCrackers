@@ -0,0 +1,166 @@
+import 'package:cloud_firestore/cloud_firestore.dart';
+import 'package:firebase_auth/firebase_auth.dart';
+import 'package:flutter/material.dart';
+
+class CrucibleTestBlueprintGenerator {
+  static Future<void> generateBlueprints({
+    required BuildContext context,
+    required String missionId,
+    required String planId,
+    required Map<String, dynamic> mission,
+    required List<Map<String, dynamic>> variables,
+  }) async {
+    final scaffold = ScaffoldMessenger.of(context);
+    final db = FirebaseFirestore.instance;
+    final user = FirebaseAuth.instance.currentUser;
+
+    try {
+      // 1. Fetch Plan Days
+      final daysSnap = await db
+          .collection('mission_realms')
+          .doc(missionId)
+          .collection('crucible_plans')
+          .doc(planId)
+          .collection('days')
+          .orderBy('dayNumber')
+          .get();
+
+      if (daysSnap.docs.isEmpty) {
+        scaffold.showSnackBar(const SnackBar(content: Text('No days found in the approved plan.')));
+        return;
+      }
+
+      // 2. Fetch Verified Atoms for Metadata (Question counts/Difficulties)
+      final atomsSnap = await db
+          .collection('mission_realms')
+          .doc(missionId)
+          .collection('syllabus_atoms')
+          .where('crucibleEligible', isEqualTo: true)
+          .get();
+      
+      final Map<String, Map<String, dynamic>> atomMap = {
+        for (var doc in atomsSnap.docs) doc.id: doc.data()
+      };
+
+      final batch = db.batch();
+      
+      // 3. Supersede old draft blueprints
+      final oldBlueprints = await db
+          .collection('mission_realms')
+          .doc(missionId)
+          .collection('crucible_test_blueprints')
+          .where('planId', isEqualTo: planId)
+          .where('status', isEqualTo: 'DRAFT')
+          .get();
+      
+      for (var doc in oldBlueprints.docs) {
+        batch.update(doc.reference, {
+          'status': 'SUPERSEDED',
+          'updatedAt': FieldValue.serverTimestamp(),
+        });
+      }
+
+      int blueprintCount = 0;
+      final struct = mission['examStructure'] as Map?;
+      final papers = List.from(struct?['papers'] ?? []);
+
+      // 4. Generate Blueprints per variable if mission has variables
+      final varsToProcess = variables.isNotEmpty ? variables : [{'variableId': 'GLOBAL', 'displayName': 'Global'}];
+
+      for (var v in varsToProcess) {
+        final varId = v['variableId'];
+        
+        List<String> accumulatedAtomsSinceLastMacro = [];
+
+        for (var doc in daysSnap.docs) {
+          final dayData = doc.data();
+          final int dayNum = dayData['dayNumber'];
+          final String testMarker = dayData['testMarker'] ?? 'none';
+          
+          final List<String> dayAtomIds = List<String>.from(dayData['assignedAtomIds'] ?? []);
+          // Filter atoms for this specific variable (Common + This Var)
+          final List<String> varSafeDayAtoms = dayAtomIds.where((id) {
+            final atom = atomMap[id];
+            if (atom == null) return false;
+            return atom['appliesToAllVariables'] == true || 
+                   atom['variableId'] == varId || 
+                   (atom['appliesToVariableIds'] as List?)?.contains(varId) == true;
+          }).toList();
+
+          accumulatedAtomsSinceLastMacro.addAll(varSafeDayAtoms);
+
+          if (testMarker == 'none') continue;
+
+          String testType = '';
+          List<String> blueprintAtoms = [];
+          int suggestedCount = 10;
+          String purpose = '';
+
+          if (testMarker == 'final_major_due') {
+            testType = 'FINAL_MAJOR';
+            blueprintAtoms = atomMap.keys.where((id) {
+              final atom = atomMap[id];
+              return atom?['appliesToAllVariables'] == true || 
+                     atom?['variableId'] == varId || 
+                     (atom?['appliesToVariableIds'] as List?)?.contains(varId) == true;
+            }).toList();
+            suggestedCount = 100;
+            purpose = 'full_coverage_simulation';
+          } else if (testMarker == 'macro_test_due') {
+            testType = 'MACRO';
+            blueprintAtoms = List.from(accumulatedAtomsSinceLastMacro);
+            suggestedCount = 30;
+            purpose = 'cumulative_revision';
+            accumulatedAtomsSinceLastMacro = []; // Reset after macro
+          } else if (testMarker == 'micro_test_due') {
+            testType = 'MICRO';
+            blueprintAtoms = varSafeDayAtoms;
+            suggestedCount = 10;
+            purpose = 'immediate_recall';
+          }
+
+          if (blueprintAtoms.isEmpty) continue;
+
+          final blueprintId = 'bp_${missionId}_${varId}_day$dayNum' + (testType == 'MACRO' ? '_macro' : '');
+          final bpRef = db.collection('mission_realms').doc(missionId).collection('crucible_test_blueprints').doc(blueprintId);
+
+          batch.set(bpRef, {
+            'blueprintId': blueprintId,
+            'missionId': missionId,
+            'planId': planId,
+            'dayNumber': dayNum,
+            'testType': testType,
+            'variableId': varId == 'GLOBAL' ? null : varId,
+            'variableName': v['displayName'],
+            'assignedAtomIds': blueprintAtoms,
+            'atomCoverageCount': blueprintAtoms.length,
+            'suggestedQuestionCount': suggestedCount,
+            'testPurpose': purpose,
+            'status': 'DRAFT',
+            'founderReviewStatus': 'PENDING',
+            'publishStatus': 'DRAFT',
+            'generatedFrom': 'C2',
+            'sourcePlanStatus': 'APPROVED',
+            'createdAt': FieldValue.serverTimestamp(),
+            'updatedAt': FieldValue.serverTimestamp(),
+            'createdBy': user?.email ?? user?.uid,
+          });
+          blueprintCount++;
+        }
+      }
+
+      // 5. Update Plan Meta
+      batch.update(db.collection('mission_realms').doc(missionId).collection('crucible_plans').doc(planId), {
+        'testBlueprintStatus': 'DRAFT_CREATED',
+        'testBlueprintCount': blueprintCount,
+        'lastTestBlueprintGeneratedAt': FieldValue.serverTimestamp(),
+      });
+
+      await batch.commit();
+      scaffold.showSnackBar(SnackBar(content: Text('Generated $blueprintCount draft test blueprints.')));
+
+    } catch (e) {
+      scaffold.showSnackBar(SnackBar(content: Text('Failed to generate blueprints: $e')));
+    }
+  }
+}
