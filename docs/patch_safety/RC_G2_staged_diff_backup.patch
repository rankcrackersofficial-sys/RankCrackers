+
+class _AtomChip extends StatelessWidget {
+  final String missionId;
+  final String atomId;
+  final VoidCallback onDelete;
+
+  const _AtomChip({required this.missionId, required this.atomId, required this.onDelete});
+
+  @override
+  Widget build(BuildContext context) {
+    return FutureBuilder<DocumentSnapshot<Map<String, dynamic>>>(
+      future: FirebaseFirestore.instance.collection('mission_realms').doc(missionId).collection('syllabus_atoms').doc(atomId).get(),
+      builder: (context, snapshot) {
+        final title = snapshot.data?.data()?['displayTitle'] ?? atomId;
+        return Chip(
+          label: Text(title, style: const TextStyle(fontSize: 10)),
+          onDeleted: onDelete,
+          deleteIconSize: 14,
+          visualDensity: VisualDensity.compact,
+        );
+      },
+    );
+  }
+}
+
+class _AtomPickerDialog extends StatefulWidget {
+  final String missionId;
+  final String? variableId;
+  final String? paperCode;
+  final Function(String) onSelect;
+
+  const _AtomPickerDialog({required this.missionId, this.variableId, this.paperCode, required this.onSelect});
+
+  @override
+  State<_AtomPickerDialog> createState() => _AtomPickerDialogState();
+}
+
+class _AtomPickerDialogState extends State<_AtomPickerDialog> {
+  String _search = '';
+
+  @override
+  Widget build(BuildContext context) {
+    Query<Map<String, dynamic>> query = FirebaseFirestore.instance
+        .collection('mission_realms')
+        .doc(widget.missionId)
+        .collection('syllabus_atoms')
+        .where('status', isEqualTo: 'VERIFIED');
+
+    if (widget.paperCode != null) query = query.where('paperCode', isEqualTo: widget.paperCode);
+
+    return AlertDialog(
+      backgroundColor: rcBg,
+      title: const Text('Link Syllabus Atom'),
+      content: SizedBox(
+        width: 500,
+        height: 600,
+        child: Column(
+          children: [
+            TextField(
+              decoration: const InputDecoration(labelText: 'Search Topic...', prefixIcon: Icon(Icons.search)),
+              onChanged: (v) => setState(() => _search = v.toLowerCase()),
+            ),
+            const SizedBox(height: 12),
+            Expanded(
+              child: StreamBuilder<QuerySnapshot<Map<String, dynamic>>>(
+                stream: query.snapshots(),
+                builder: (context, snapshot) {
+                  if (!snapshot.hasData) return const RcCenteredLoader(compact: true);
+                  final allAtoms = snapshot.data!.docs;
+                  
+                  final filtered = allAtoms.where((doc) {
+                    final data = doc.data();
+                    // Scope safety
+                    if (data['paperScope'] == 'VARIABLE_SPECIFIC') {
+                      if (widget.variableId != null && data['variableId'] != widget.variableId) return false;
+                    }
+                    
+                    final title = (data['displayTitle'] ?? '').toString().toLowerCase();
+                    final path = (data['path'] ?? '').toString().toLowerCase();
+                    return title.contains(_search) || path.contains(_search);
+                  }).toList();
+
+                  if (filtered.isEmpty) return const Center(child: Text('No verified atoms found.'));
+
+                  return ListView.builder(
+                    itemCount: filtered.length,
+                    itemBuilder: (context, index) {
+                      final doc = filtered[index];
+                      final data = doc.data();
+                      return ListTile(
+                        dense: true,
+                        title: Text(data['displayTitle'] ?? 'Untitled'),
+                        subtitle: Text(data['path'] ?? '', style: const TextStyle(fontSize: 10)),
+                        trailing: const Icon(Icons.add_link_rounded, size: 18),
+                        onTap: () {
+                          widget.onSelect(doc.id);
+                          Navigator.pop(context);
+                        },
+                      );
+                    },
+                  );
+                },
+              ),
+            ),
+          ],
+        ),
+      ),
+    );
+  }
+}
