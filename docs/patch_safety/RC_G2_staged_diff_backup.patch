+import 'package:cloud_firestore/cloud_firestore.dart';
+import 'package:firebase_auth/firebase_auth.dart';
+import 'package:flutter/material.dart';
+import '../shared/rc_colors.dart';
+import '../shared/rc_panel.dart';
+
+class AdminMyAccessPanel extends StatelessWidget {
+  const AdminMyAccessPanel({super.key});
+
+  @override
+  Widget build(BuildContext context) {
+    final user = FirebaseAuth.instance.currentUser;
+    if (user == null) return const SizedBox.shrink();
+
+    return StreamBuilder<DocumentSnapshot<Map<String, dynamic>>>(
+      stream: FirebaseFirestore.instance.collection('users').doc(user.uid).snapshots(),
+      builder: (context, snapshot) {
+        final data = snapshot.data?.data();
+        if (data == null) return const Center(child: CircularProgressIndicator());
+
+        final perms = Map<String, bool>.from(data['permissions'] ?? {});
+        
+        return SingleChildScrollView(
+          padding: const EdgeInsets.all(32),
+          child: Column(
+            crossAxisAlignment: CrossAxisAlignment.start,
+            children: [
+              const Text('MY ACCESS & AUTHORITY', style: TextStyle(color: rcGold, fontSize: 18, fontWeight: FontWeight.w900, letterSpacing: 2)),
+              const SizedBox(height: 8),
+              const Text('Transparent view of your current verification and audit permissions.', style: TextStyle(color: Colors.white24, fontSize: 12)),
+              const SizedBox(height: 32),
+              Row(
+                children: [
+                   _InfoBox(label: 'ROLE', value: (data['role'] ?? 'admin').toString().toUpperCase()),
+                   const SizedBox(width: 16),
+                   _InfoBox(label: 'STATUS', value: (data['status'] ?? 'ACTIVE').toString().toUpperCase(), color: rcGreen),
+                   const SizedBox(width: 16),
+                   _InfoBox(label: 'DESIGNATION', value: data['designation'] ?? 'RankCrackers Staff'),
+                ],
+              ),
+              const SizedBox(height: 40),
+              const Text('GRANTED PERMISSIONS', style: TextStyle(color: Colors.white70, fontSize: 11, fontWeight: FontWeight.bold, letterSpacing: 1)),
+              const SizedBox(height: 16),
+              Wrap(
+                spacing: 12,
+                runSpacing: 12,
+                children: perms.entries.where((e) => e.value).map((e) => _PermChip(label: e.key, granted: true)).toList(),
+              ),
+              if (perms.values.every((v) => !v))
+                 const Text('No modular permissions assigned yet. Contact Founder.', style: TextStyle(color: Colors.white10, fontSize: 12)),
+              
+              const SizedBox(height: 40),
+              const Text('LOCKED MODULES', style: TextStyle(color: Colors.white24, fontSize: 11, fontWeight: FontWeight.bold, letterSpacing: 1)),
+              const SizedBox(height: 16),
+              Wrap(
+                spacing: 12,
+                runSpacing: 12,
+                children: _allPerms.where((k) => !perms.containsKey(k) || perms[k] == false).map((k) => _PermChip(label: k, granted: false)).toList(),
+              ),
+              const SizedBox(height: 60),
+              Container(
+                padding: const EdgeInsets.all(20),
+                decoration: BoxDecoration(color: Colors.white.withValues(alpha: 0.02), borderRadius: BorderRadius.circular(12), border: Border.all(color: Colors.white.withValues(alpha: 0.05))),
+                child: const Row(
+                  children: [
+                    Icon(Icons.info_outline_rounded, color: rcGold, size: 20),
+                    SizedBox(width: 16),
+                    Expanded(child: Text('Only the Founder can modify these permissions. If you need access to a specific workspace, please request a permission update from the Command Center.', style: TextStyle(color: Colors.white38, fontSize: 11, height: 1.5))),
+                  ],
+                ),
+              ),
+            ],
+          ),
+        );
+      },
+    );
+  }
+
+  static const _allPerms = [
+    'missionControlView', 'missionCreateEdit', 'missionDocumentsView',
+    'ingestionReviewView', 'ingestionApprove',
+    'syllabusAtomReview', 'syllabusAtomBulkVerify',
+    'pyqQuestionReview',
+    'cruciblePlanView', 'cruciblePlanApprove',
+    'blueprintView', 'blueprintApprove',
+    'questionSetView', 'questionSetApprove',
+    'publishCenterView', 'publishApprove',
+    'studyMasterView', 'studyMasterEdit',
+    'revenueView', 'accessSecurityView',
+    'adminInviteCreate', 'adminPermissionManage'
+  ];
+}
+
+class _InfoBox extends StatelessWidget {
+  final String label;
+  final String value;
+  final Color? color;
+  const _InfoBox({required this.label, required this.value, this.color});
+
+  @override
+  Widget build(BuildContext context) {
+    return Expanded(
+      child: RcPanel(
+        child: Column(
+          crossAxisAlignment: CrossAxisAlignment.start,
+          children: [
+            Text(label, style: const TextStyle(color: Colors.white10, fontSize: 9, fontWeight: FontWeight.w900)),
+            const SizedBox(height: 4),
+            Text(value, style: TextStyle(color: color ?? Colors.white70, fontSize: 14, fontWeight: FontWeight.bold)),
+          ],
+        ),
+      ),
+    );
+  }
+}
+
+class _PermChip extends StatelessWidget {
+  final String label;
+  final bool granted;
+  const _PermChip({required this.label, required this.granted});
+
+  @override
+  Widget build(BuildContext context) {
+    final color = granted ? rcGold : Colors.white10;
+    return Container(
+      padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 6),
+      decoration: BoxDecoration(
+        color: color.withValues(alpha: 0.05),
+        borderRadius: BorderRadius.circular(8),
+        border: Border.all(color: color.withValues(alpha: 0.2)),
+      ),
+      child: Row(
+        mainAxisSize: MainAxisSize.min,
+        children: [
+          Icon(granted ? Icons.check_circle_rounded : Icons.lock_outline_rounded, size: 12, color: color.withValues(alpha: 0.5)),
+          const SizedBox(width: 8),
+          Text(label, style: TextStyle(color: color, fontSize: 10, fontWeight: FontWeight.bold)),
+        ],
+      ),
+    );
+  }
+}
diff --git a/lib/web/admin/admin_recommendation_dialog.dart b/lib/web/admin/admin_recommendation_dialog.dart
new file mode 100644
index 0000000..239e7ba
--- /dev/null
+++ b/lib/web/admin/admin_recommendation_dialog.dart
@@ -0,0 +1,286 @@
+import 'package:cloud_firestore/cloud_firestore.dart';
+import 'package:firebase_auth/firebase_auth.dart';
+import 'package:flutter/material.dart';
+import '../shared/rc_colors.dart';
+import '../shared/rc_field.dart';
+import '../shared/rc_panel.dart';
+
+enum RecommendationType {
+  APPROVE_RECOMMENDED,
+  REJECT_RECOMMENDED,
+  CHANGES_REQUESTED,
+  REPROCESS_REQUESTED,
+  QUALITY_ISSUE,
+  NEEDS_FOUNDER_ATTENTION,
+  INFO_NOTE
+}
+
+enum RecommendationTargetType {
+  INGESTION_SOURCE,
+  MISSION_DOCUMENT,
+  SYLLABUS_ATOM,
+  PYQ_QUESTION,
+  CRUCIBLE_PLAN,
+  BLUEPRINT,
+  QUESTION_SET,
+  TASK_ONLY
+}
+
+class AdminRecommendationDialog extends StatefulWidget {
+  final RecommendationTargetType targetType;
+  final String targetId;
+  final String targetPath;
+  final String? missionId;
+  final String? documentId;
+  final String? sourceId;
+  final String? taskId;
+  final String permissionUsed;
+  final Map<String, dynamic> targetSummary;
+
+  const AdminRecommendationDialog({
+    super.key,
+    required this.targetType,
+    required this.targetId,
+    required this.targetPath,
+    required this.permissionUsed,
+    required this.targetSummary,
+    this.missionId,
+    this.documentId,
+    this.sourceId,
+    this.taskId,
+  });
+
+  @override
+  State<AdminRecommendationDialog> createState() => _AdminRecommendationDialogState();
+}
+
+class _AdminRecommendationDialogState extends State<AdminRecommendationDialog> {
+  RecommendationType _recommendationType = RecommendationType.INFO_NOTE;
+  final _noteCtrl = TextEditingController();
+  final List<String> _selectedIssueTags = [];
+  bool _busy = false;
+
+  final List<String> _availableIssueTags = [
+    'OCR_MISMATCH',
+    'HINDI_GARBLED',
+    'MISSING_DATA',
+    'WRONG_MAPPING',
+    'DUPLICATE',
+    'INCOMPLETE_EXTRACTION',
+    'LOW_CONFIDENCE',
+  ];
+
+  @override
+  void dispose() {
+    _noteCtrl.dispose();
+    super.dispose();
+  }
+
+  Future<void> _submit() async {
+    final note = _noteCtrl.text.trim();
+    if (note.isEmpty) {
+      ScaffoldMessenger.of(context).showSnackBar(
+        const SnackBar(content: Text('Please provide a note/justification for your recommendation.')),
+      );
+      return;
+    }
+
+    setState(() => _busy = true);
+
+    try {
+      final user = FirebaseAuth.instance.currentUser;
+      final db = FirebaseFirestore.instance;
+      final now = FieldValue.serverTimestamp();
+
+      // 1. Fetch Admin Profile for Metadata
+      final userDoc = await db.collection('users').doc(user?.uid).get();
+      final userData = userDoc.data() ?? {};
+
+      final recommendationId = 'rec_${DateTime.now().millisecondsSinceEpoch}_${user?.uid?.substring(0, 5)}';
+
+      final recommendationData = {
+        'recommendationId': recommendationId,
+        'targetType': widget.targetType.name,
+        'targetPath': widget.targetPath,
+        'targetId': widget.targetId,
+        'missionId': widget.missionId,
+        'documentId': widget.documentId,
+        'sourceId': widget.sourceId,
+        'taskId': widget.taskId,
+        'adminUid': user?.uid,
+        'adminName': userData['name'] ?? userData['displayName'] ?? user?.email ?? 'Admin',
+        'adminEmail': user?.email,
+        'adminDesignation': userData['designation'] ?? 'Administrator',
+        'permissionUsed': widget.permissionUsed,
+        'recommendationType': _recommendationType.name,
+        'founderReviewStatus': 'PENDING',
+        'note': note,
+        'issueTags': _selectedIssueTags,
+        'createdAt': now,
+        'updatedAt': now,
+      };
+
+      // 2. Save Recommendation
+      await db.collection('admin_review_recommendations').doc(recommendationId).set(recommendationData);
+
+      // 3. Update Admin Task if present
+      if (widget.taskId != null) {
+        await db.collection('admin_tasks').doc(widget.taskId).update({
+          'status': 'REVIEW_SUBMITTED',
+          'latestRecommendationId': recommendationId,
+          'adminNote': note,
+          'updatedAt': now,
+          'lastActionAt': now,
+        });
+      }
+
+      // 4. Write Audit Log
+      await db.collection('admin_task_audit').add({
+        'action': 'RECOMMENDATION_SUBMITTED',
+        'actorUid': user?.uid,
+        'actorEmail': user?.email,
+        'taskId': widget.taskId,
+        'targetType': widget.targetType.name,
+        'targetPath': widget.targetPath,
+        'recommendationId': recommendationId,
+        'notePreview': note.length > 100 ? '${note.substring(0, 100)}...' : note,
+        'timestamp': now,
+      });
+
+      if (mounted) {
+        Navigator.pop(context, true);
+        ScaffoldMessenger.of(context).showSnackBar(
+          const SnackBar(content: Text('Recommendation submitted for Founder review.'), backgroundColor: rcGreen),
+        );
+      }
+    } catch (e) {
+      if (mounted) {
+        ScaffoldMessenger.of(context).showSnackBar(
+          SnackBar(content: Text('Submission failed: $e'), backgroundColor: rcRed),
+        );
+      }
+    } finally {
+      if (mounted) setState(() => _busy = false);
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    return Dialog(
+      backgroundColor: Colors.transparent,
+      insetPadding: const EdgeInsets.all(40),
+      child: Container(
+        width: 600,
+        decoration: BoxDecoration(
+          color: rcBg,
+          border: Border.all(color: rcLine),
+          borderRadius: BorderRadius.circular(16),
+        ),
+        child: Column(
+          mainAxisSize: MainAxisSize.min,
+          children: [
+            Padding(
+              padding: const EdgeInsets.all(20),
+              child: Row(
+                children: [
+                  const Icon(Icons.recommend_rounded, color: rcGold, size: 24),
+                  const SizedBox(width: 12),
+                  const Text('SUBMIT REVIEW RECOMMENDATION', style: TextStyle(color: Colors.white, fontSize: 16, fontWeight: FontWeight.bold)),
+                  const Spacer(),
+                  IconButton(onPressed: () => Navigator.pop(context), icon: const Icon(Icons.close)),
+                ],
+              ),
+            ),
+            const Divider(height: 1, color: rcLine),
+            Flexible(
+              child: SingleChildScrollView(
+                padding: const EdgeInsets.all(24),
+                child: Column(
+                  crossAxisAlignment: CrossAxisAlignment.stretch,
+                  children: [
+                    _buildTargetSummary(),
+                    const SizedBox(height: 24),
+                    const Text('RECOMMENDATION ACTION', style: TextStyle(color: rcGold, fontSize: 11, fontWeight: FontWeight.bold, letterSpacing: 1.2)),
+                    const SizedBox(height: 8),
+                    DropdownButtonFormField<RecommendationType>(
+                      value: _recommendationType,
+                      dropdownColor: rcSurface,
+                      decoration: const InputDecoration(border: OutlineInputBorder()),
+                      items: RecommendationType.values.map((t) => DropdownMenuItem(
+                        value: t,
+                        child: Text(t.name.replaceAll('_', ' '), style: const TextStyle(fontSize: 13)),
+                      )).toList(),
+                      onChanged: (val) => setState(() => _recommendationType = val!),
+                    ),
+                    const SizedBox(height: 24),
+                    const Text('ISSUE TAGS', style: TextStyle(color: rcGold, fontSize: 11, fontWeight: FontWeight.bold, letterSpacing: 1.2)),
+                    const SizedBox(height: 12),
+                    Wrap(
+                      spacing: 8,
+                      runSpacing: 8,
+                      children: _availableIssueTags.map((tag) {
+                        final isSelected = _selectedIssueTags.contains(tag);
+                        return FilterChip(
+                          label: Text(tag, style: TextStyle(fontSize: 10, color: isSelected ? Colors.black : Colors.white60)),
+                          selected: isSelected,
+                          selectedColor: rcGold,
+                          onSelected: (val) {
+                            setState(() {
+                              if (val) _selectedIssueTags.add(tag);
+                              else _selectedIssueTags.remove(tag);
+                            });
+                          },
+                        );
+                      }).toList(),
+                    ),
+                    const SizedBox(height: 24),
+                    const Text('REVIEW NOTES & JUSTIFICATION', style: TextStyle(color: rcGold, fontSize: 11, fontWeight: FontWeight.bold, letterSpacing: 1.2)),
+                    const SizedBox(height: 8),
+                    RcField(
+                      controller: _noteCtrl,
+                      label: 'Explain your decision or findings...',
+                      maxLines: 5,
+                    ),
+                  ],
+                ),
+              ),
+            ),
+            const Divider(height: 1, color: rcLine),
+            Padding(
+              padding: const EdgeInsets.all(20),
+              child: Row(
+                mainAxisAlignment: MainAxisAlignment.end,
+                children: [
+                  TextButton(onPressed: () => Navigator.pop(context), child: const Text('CANCEL')),
+                  const SizedBox(width: 12),
+                  FilledButton(
+                    onPressed: _busy ? null : _submit,
+                    style: FilledButton.styleFrom(backgroundColor: rcGold, foregroundColor: Colors.black),
+                    child: Text(_busy ? 'SUBMITTING...' : 'SUBMIT RECOMMENDATION'),
+                  ),
+                ],
+              ),
+            ),
+          ],
+        ),
+      ),
+    );
+  }
+
+  Widget _buildTargetSummary() {
+    return Container(
+      padding: const EdgeInsets.all(16),
+      decoration: BoxDecoration(color: Colors.white.withValues(alpha: 0.03), borderRadius: BorderRadius.circular(8), border: Border.all(color: rcLine)),
+      child: Column(
+        crossAxisAlignment: CrossAxisAlignment.start,
+        children: [
+          Text('TARGET: ${widget.targetType.name}', style: const TextStyle(color: Colors.white38, fontSize: 9, fontWeight: FontWeight.bold)),
+          const SizedBox(height: 4),
+          Text(widget.targetSummary['title'] ?? widget.targetId, style: const TextStyle(color: Colors.white, fontSize: 14, fontWeight: FontWeight.bold)),
+          if (widget.targetSummary['subtitle'] != null)
+             Text(widget.targetSummary['subtitle'], style: const TextStyle(color: Colors.white54, fontSize: 11)),
+        ],
+      ),
+    );
+  }
+}
diff --git a/lib/web/admin/admin_web_shell.dart b/lib/web/admin/admin_web_shell.dart
new file mode 100644
index 0000000..cf49c0b
