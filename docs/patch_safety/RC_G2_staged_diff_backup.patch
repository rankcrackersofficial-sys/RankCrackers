+           Container(
+             padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 4),
+             decoration: BoxDecoration(color: statusColor.withValues(alpha: 0.1), borderRadius: BorderRadius.circular(4), border: Border.all(color: statusColor.withValues(alpha: 0.2))),
+             child: Text(status.toString().toUpperCase(), style: TextStyle(color: statusColor, fontSize: 8, fontWeight: FontWeight.bold)),
+           ),
+        ),
+        DataCell(
+          isFounder ? Row(
+            children: [
+              if (!isVerified)
+                 IconButton(
+                   icon: const Icon(Icons.check_circle_rounded, color: rcGreen, size: 20),
+                   onPressed: () => _updateQuestion(qId, {'verificationStatus': 'verified', 'founder_approved': true, 'published': true}),
+                   tooltip: 'Approve & Publish',
+                 ),
+              IconButton(
+                icon: const Icon(Icons.edit_note_rounded, color: Colors.blue, size: 20),
+                onPressed: () => _showEditDialog(qId, data),
+                tooltip: 'Edit / View Proof',
+              ),
+              if (data['sourceImgChunkPath'] != null)
+                 IconButton(
+                   icon: const Icon(Icons.image_search_rounded, color: rcGold, size: 20),
+                   onPressed: () {}, // Logic to show source chunk
+                   tooltip: 'View Source Chunk',
+                 ),
+            ],
+          ) : const Text('READ ONLY', style: TextStyle(color: Colors.white10, fontSize: 10)),
+        ),
+      ],
+    );
+  }
+
+  Widget _miniStatus(String label, String status) {
+    final color = status == 'present' || status == 'verified' ? rcGreen : rcRed;
+    return Row(
+      children: [
+        Text('$label: ', style: const TextStyle(color: Colors.white24, fontSize: 8)),
+        Text(status.toUpperCase(), style: TextStyle(color: color, fontSize: 8, fontWeight: FontWeight.bold)),
+      ],
+    );
+  }
+
+  void _showEditDialog(String qId, Map<String, dynamic> data) {
+    final latexCtrl = TextEditingController(text: data['questionLatex']);
+    final ansCtrl = TextEditingController(text: data['correctAnswer']?.toString());
+    final proofCtrl = TextEditingController(text: data['answerProofStepByStep']);
+
+    showDialog(
+      context: context,
+      builder: (context) => AlertDialog(
+        backgroundColor: rcBg,
+        title: const Text('EDIT QUESTION DATA', style: TextStyle(color: rcGold, fontSize: 14, fontWeight: FontWeight.bold)),
+        content: SizedBox(
+          width: 700,
+          child: SingleChildScrollView(
+            child: Column(
+              mainAxisSize: MainAxisSize.min,
+              children: [
+                TextField(controller: latexCtrl, decoration: const InputDecoration(labelText: 'Question LaTeX'), maxLines: 4),
+                const SizedBox(height: 12),
+                TextField(controller: ansCtrl, decoration: const InputDecoration(labelText: 'Correct Answer')),
+                const SizedBox(height: 12),
+                TextField(controller: proofCtrl, decoration: const InputDecoration(labelText: 'Answer Proof (Step-by-Step)'), maxLines: 6),
+              ],
+            ),
+          ),
+        ),
+        actions: [
+          TextButton(onPressed: () => Navigator.pop(context), child: const Text('CANCEL')),
+          FilledButton(
+            onPressed: () {
+               _updateQuestion(qId, {
+                 'questionLatex': latexCtrl.text.trim(),
+                 'correctAnswer': ansCtrl.text.trim(),
+                 'answerProofStepByStep': proofCtrl.text.trim(),
+               });
+               Navigator.pop(context);
+            },
+            child: const Text('SAVE CHANGES'),
+          ),
+        ],
+      ),
+    );
+  }
+}
