@@ -0,0 +1,125 @@
+const admin = require("firebase-admin");
+const { getCurrentSchedule } = require("./tactical_schedule_service");
+const { getCurrentState, STATES } = require("./crucible_state_service");
+
+/**
+ * 🔱 BATTLE ENGINE SERVICE (RC-P16-D)
+ * Converts Tactical Schedule Blocks into executable Battle/Practice/Revision Sessions.
+ */
+
+const db = admin.firestore();
+
+const SESSION_TYPES = {
+    REVISION: 'REVISION_SESSION',
+    PRACTICE: 'PRACTICE_SESSION',
+    BATTLE: 'BATTLE_SESSION'
+};
+
+const STATUS = {
+    PENDING: 'PENDING',
+    ACTIVE: 'ACTIVE',
+    COMPLETED: 'COMPLETED',
+    FAILED: 'FAILED',
+    SKIPPED: 'SKIPPED'
+};
+
+/**
+ * Generates all sessions for the current day based on the Tactical Schedule.
+ */
+async function generateBattleSessions(studentId) {
+    console.log(`🔱 BATTLE_ENGINE: Generating sessions for ${studentId}`);
+
+    const [schedule, stateDoc] = await Promise.all([
+        getCurrentSchedule(studentId),
+        getCurrentState(studentId)
+    ]);
+
+    if (!schedule || !schedule.timeBlocks) {
+        console.warn(`🔱 BATTLE_ENGINE: No tactical schedule found for ${studentId}.`);
+        return [];
+    }
+
+    const state = stateDoc.currentState || STATES.DORMANT;
+
+    // Safety: No battle generation in CRITICAL mode (Schedule Engine should already handle this)
+    if (state === STATES.CRITICAL) {
+        console.log(`🔱 BATTLE_ENGINE: CRITICAL state detected. Battles disabled.`);
+    }
+
+    const sessions = [];
+    const batch = db.batch();
+    const dateId = schedule.scheduleDate; // YYYYMMDD
+
+    schedule.timeBlocks.forEach((block, index) => {
+        // Skip BREAK blocks
+        if (block.type === 'BREAK') return;
+
+        const sessionType = SESSION_TYPES[block.type];
+        if (!sessionType) return;
+
+        const sessionId = `${studentId}_${dateId}_${index}`;
+        const sessionRef = db.collection('battle_sessions').doc(sessionId);
+
+        const sessionData = {
+            sessionId,
+            studentId,
+            sessionType,
+            state,
+            blockType: block.type,
+            priority: block.priority || 0,
+            realmId: block.realmId || null,
+            factId: block.factId || null,
+            source: block.source || 'SYSTEM',
+            status: STATUS.PENDING,
+            scheduledDate: dateId,
+            durationMinutes: block.durationMinutes,
+            metadata: block.metadata || {},
+            updatedAt: admin.firestore.FieldValue.serverTimestamp()
+        };
+
+        batch.set(sessionRef, sessionData, { merge: true });
+        sessions.push(sessionData);
+    });
+
+    if (sessions.length > 0) {
+        await batch.commit();
+        console.log(`🔱 BATTLE_ENGINE: Created ${sessions.length} sessions for ${studentId}`);
+    }
+
+    return sessions;
+}
+
+/**
+ * Specific entry point for Practice Sessions (delegates to main generator if needed)
+ */
+async function generatePracticeSessions(studentId) {
+    return generateBattleSessions(studentId);
+}
+
+/**
+ * Specific entry point for Revision Sessions (delegates to main generator if needed)
+ */
+async function generateRevisionSessions(studentId) {
+    return generateBattleSessions(studentId);
+}
+
+/**
+ * Retrieves the current day's battle plan.
+ */
+async function getCurrentBattlePlan(studentId) {
+    const dateId = new Date().toISOString().split('T')[0].replace(/-/g, '');
+    const snap = await db.collection('battle_sessions')
+        .where('studentId', '==', studentId)
+        .where('scheduledDate', '==', dateId)
+        .orderBy('priority', 'asc')
+        .get();
+
+    return snap.docs.map(doc => doc.data());
+}
+
+module.exports = {
+    generateBattleSessions,
+    generatePracticeSessions,
+    generateRevisionSessions,
+    getCurrentBattlePlan
+};
