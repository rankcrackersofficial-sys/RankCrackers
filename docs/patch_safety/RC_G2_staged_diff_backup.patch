+const admin = require("firebase-admin");
+
+/**
+ * 🔱 PROVIDER QUOTA & RESERVATION SERVICE (RC-P12-D.5)
+ * Implementation of the Reserve-Commit-Refund pattern for strict budget sovereignty.
+ */
+
+const db = admin.firestore();
+
+// 🔱 Max Tokens to reserve per call if unknown
+const DEFAULT_RESERVATION = 10000;
+
+/**
+ * Reserves tokens before an AI call.
+ */
+async function reserveQuota(providerId, model) {
+    const today = new Date().toISOString().substring(0, 10);
+    const budgetRef = db.collection('provider_budget').doc(providerId);
+
+    return await db.runTransaction(async (transaction) => {
+        const snap = await transaction.get(budgetRef);
+        if (!snap.exists) {
+            const defaultBudget = {
+                dailyTokenLimit: 2000000,
+                dailyRequestLimit: 5000,
+                consumedTokens: 0,
+                consumedRequests: 0,
+                lastResetDate: today
+            };
+            transaction.set(budgetRef, defaultBudget);
+            return { success: true, reservationId: `res_${Date.now()}` };
+        }
+
+        const data = snap.data();
+        if (data.lastResetDate !== today) {
+            transaction.update(budgetRef, { consumedTokens: 0, consumedRequests: 0, lastResetDate: today });
+            return { success: true, reservationId: `res_${Date.now()}` };
+        }
+
+        // 🛡️ BUDGET GUARD: Reserve with buffer
+        if ((data.consumedTokens + DEFAULT_RESERVATION) > data.dailyTokenLimit) {
+            throw new Error("BUDGET_RESERVATION_FAILED: Insufficient token headroom.");
+        }
+        if (data.consumedRequests >= data.dailyRequestLimit) {
+            throw new Error("BUDGET_RESERVATION_FAILED: Request limit reached.");
+        }
+
+        // Optimistically lock tokens
+        transaction.update(budgetRef, {
+            consumedTokens: admin.firestore.FieldValue.increment(DEFAULT_RESERVATION),
+            consumedRequests: admin.firestore.FieldValue.increment(1)
+        });
+
+        return { success: true, reservationId: `res_${Date.now()}` };
+    });
+}
+
+/**
+ * Commits actual usage and refunds the surplus.
+ */
+async function commitUsage(providerId, actualTokens, model) {
+    const budgetRef = db.collection('provider_budget').doc(providerId);
+    const surplus = DEFAULT_RESERVATION - actualTokens;
+
+    const batch = db.batch();
+
+    // 🔱 Refund if we used less than reserved
+    if (surplus !== 0) {
+        batch.update(budgetRef, {
+            consumedTokens: admin.firestore.FieldValue.increment(-surplus)
+        });
+    }
+
+    // Log the transaction
+    const logId = `log_${Date.now()}_${Math.floor(Math.random() * 1000)}`;
+    batch.set(db.collection('provider_usage_logs').doc(logId), {
+        providerId, model, tokens: actualTokens,
+        timestamp: admin.firestore.FieldValue.serverTimestamp()
+    });
+
+    await batch.commit();
+}
+
+/**
+ * Full refund in case of total failure (no models succeeded).
+ */
+async function refundQuota(providerId) {
+    const budgetRef = db.collection('provider_budget').doc(providerId);
+    await budgetRef.update({
+        consumedTokens: admin.firestore.FieldValue.increment(-DEFAULT_RESERVATION),
+        consumedRequests: admin.firestore.FieldValue.increment(-1)
+    });
+}
+
+module.exports = { reserveQuota, commitUsage, refundQuota };
