@@ -0,0 +1,71 @@
+import 'package:cloud_firestore/cloud_firestore.dart';
+import 'package:flutter/material.dart';
+import 'rc_colors.dart';
+
+class MissionProcessingHealthBar extends StatelessWidget {
+  final String missionId;
+  const MissionProcessingHealthBar({super.key, required this.missionId});
+
+  @override
+  Widget build(BuildContext context) {
+    return StreamBuilder<QuerySnapshot<Map<String, dynamic>>>(
+      stream: FirebaseFirestore.instance
+          .collection('mission_realms')
+          .doc(missionId)
+          .collection('official_documents')
+          .snapshots(),
+      builder: (context, snapshot) {
+        if (!snapshot.hasData) return const SizedBox.shrink();
+        final docs = snapshot.data!.docs;
+        
+        int uploaded = docs.length;
+        int clean = docs.where((d) => d.data()['extractionQuality'] == 'GOOD').length;
+        int lowQuality = docs.where((d) => d.data()['extractionQuality'] == 'LOW_CONFIDENCE').length;
+        int failed = docs.where((d) => d.data()['extractionQuality'] == 'FAILED').length;
+        int readyReview = docs.where((d) => d.data()['extractionStatus'] == 'structured' && d.data()['reviewStatus'] == 'PENDING').length;
+        int blocked = docs.where((d) => d.data()['extractionQuality'] == 'FAILED' || d.data()['structuredDataQuality'] == 'INVALID').length;
+
+        return Container(
+          padding: const EdgeInsets.all(16),
+          decoration: BoxDecoration(
+            color: rcSurface.withValues(alpha: 0.5),
+            borderRadius: BorderRadius.circular(12),
+            border: Border.all(color: rcLine),
+          ),
+          child: Column(
+            crossAxisAlignment: CrossAxisAlignment.start,
+            children: [
+              const Text(
+                'AI PROCESSING HEALTH (MISSION SCOPE)',
+                style: TextStyle(color: rcGold, fontSize: 10, fontWeight: FontWeight.bold, letterSpacing: 1.2),
+              ),
+              const SizedBox(height: 12),
+              Wrap(
+                spacing: 16,
+                runSpacing: 12,
+                children: [
+                  _stat('Uploaded', uploaded.toString(), Colors.white),
+                  _stat('Extracted Clean', clean.toString(), rcGreen),
+                  _stat('Low Quality', lowQuality.toString(), rcGold),
+                  _stat('Reprocess Req.', failed.toString(), rcRed),
+                  _stat('Ready Review', readyReview.toString(), Colors.blue),
+                  _stat('Blocked Crucible', blocked.toString(), rcRed),
+                ],
+              ),
+            ],
+          ),
+        );
+      },
+    );
+  }
+
+  Widget _stat(String label, String value, Color color) {
+    return Column(
+      crossAxisAlignment: CrossAxisAlignment.start,
+      children: [
+        Text(label, style: const TextStyle(color: Colors.white24, fontSize: 9)),
+        Text(value, style: TextStyle(color: color, fontWeight: FontWeight.bold, fontSize: 14)),
+      ],
+    );
+  }
+}
