+import 'package:cloud_firestore/cloud_firestore.dart';
+
+class RcPlan {
+  final String planId;
+  final String name;
+  final double basePrice;
+  final double gstRate;
+  final double gstAmount;
+  final double finalAmount;
+  final int durationDays;
+  final bool active;
+  final DateTime createdAt;
+  final DateTime updatedAt;
+
+  RcPlan({
+    required this.planId,
+    required this.name,
+    required this.basePrice,
+    required this.gstRate,
+    required this.gstAmount,
+    required this.finalAmount,
+    required this.durationDays,
+    required this.active,
+    required this.createdAt,
+    required this.updatedAt,
+  });
+
+  factory RcPlan.fromFirestore(DocumentSnapshot doc) {
+    Map<String, dynamic> data = doc.data() as Map<String, dynamic>;
+    return RcPlan(
+      planId: doc.id,
+      name: data['name'] ?? '',
+      basePrice: (data['basePrice'] ?? 0).toDouble(),
+      gstRate: (data['gstRate'] ?? 0).toDouble(),
+      gstAmount: (data['gstAmount'] ?? 0).toDouble(),
+      finalAmount: (data['finalAmount'] ?? 0).toDouble(),
+      durationDays: data['durationDays'] ?? 0,
+      active: data['active'] ?? false,
+      createdAt: (data['createdAt'] as Timestamp?)?.toDate() ?? DateTime.now(),
+      updatedAt: (data['updatedAt'] as Timestamp?)?.toDate() ?? DateTime.now(),
+    );
+  }
+}
+
+class RcPaymentOrder {
+  final String orderId;
+  final String userId;
+  final String planId;
+  final double basePrice;
+  final double gstRate;
+  final double gstAmount;
+  final double finalAmount;
+  final String gatewayName;
+  final String gatewayOrderId;
+  final String status;
+  final DateTime createdAt;
+  final DateTime updatedAt;
+
+  RcPaymentOrder({
+    required this.orderId,
+    required this.userId,
+    required this.planId,
+    required this.basePrice,
+    required this.gstRate,
+    required this.gstAmount,
+    required this.finalAmount,
+    required this.gatewayName,
+    required this.gatewayOrderId,
+    required this.status,
+    required this.createdAt,
+    required this.updatedAt,
+  });
+
+  factory RcPaymentOrder.fromFirestore(DocumentSnapshot doc) {
+    Map<String, dynamic> data = doc.data() as Map<String, dynamic>;
+    return RcPaymentOrder(
+      orderId: doc.id,
+      userId: data['userId'] ?? '',
+      planId: data['planId'] ?? '',
+      basePrice: (data['basePrice'] ?? 0).toDouble(),
+      gstRate: (data['gstRate'] ?? 0).toDouble(),
+      gstAmount: (data['gstAmount'] ?? 0).toDouble(),
+      finalAmount: (data['finalAmount'] ?? 0).toDouble(),
+      gatewayName: data['gatewayName'] ?? '',
+      gatewayOrderId: data['gatewayOrderId'] ?? '',
+      status: data['status'] ?? '',
+      createdAt: (data['createdAt'] as Timestamp?)?.toDate() ?? DateTime.now(),
+      updatedAt: (data['updatedAt'] as Timestamp?)?.toDate() ?? DateTime.now(),
+    );
+  }
+}
+
+class RcUserSubscription {
+  final String subscriptionId;
+  final String userId;
+  final String planId;
+  final String status;
+  final DateTime startDate;
+  final DateTime endDate;
+  final int durationDays;
+  final String lastPaymentOrderId;
+  final DateTime createdAt;
+  final DateTime updatedAt;
+
+  RcUserSubscription({
+    required this.subscriptionId,
+    required this.userId,
+    required this.planId,
+    required this.status,
+    required this.startDate,
+    required this.endDate,
+    required this.durationDays,
+    required this.lastPaymentOrderId,
+    required this.createdAt,
+    required this.updatedAt,
+  });
+
+  factory RcUserSubscription.fromFirestore(DocumentSnapshot doc) {
+    Map<String, dynamic> data = doc.data() as Map<String, dynamic>;
+    return RcUserSubscription(
+      subscriptionId: doc.id,
+      userId: data['userId'] ?? '',
+      planId: data['planId'] ?? '',
+      status: data['status'] ?? '',
+      startDate: (data['startDate'] as Timestamp?)?.toDate() ?? DateTime.now(),
+      endDate: (data['endDate'] as Timestamp?)?.toDate() ?? DateTime.now(),
+      durationDays: data['durationDays'] ?? 0,
+      lastPaymentOrderId: data['lastPaymentOrderId'] ?? '',
+      createdAt: (data['createdAt'] as Timestamp?)?.toDate() ?? DateTime.now(),
+      updatedAt: (data['updatedAt'] as Timestamp?)?.toDate() ?? DateTime.now(),
+    );
+  }
+
+  bool get isActive => status == 'active' && endDate.isAfter(DateTime.now());
+  
+  int get daysRemaining {
+    final now = DateTime.now();
+    if (endDate.isBefore(now)) return 0;
+    return endDate.difference(now).inDays;
+  }
+}
