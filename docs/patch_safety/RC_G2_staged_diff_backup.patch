+import 'package:flutter_riverpod/flutter_riverpod.dart';
+import '../../../../core/backend/digibook_repository.dart';
+import '../../../../core/models/knowledge_hierarchy.dart';
+import '../../../../shared/providers/session_provider.dart';
+
+/// 🔱 DIGIBOOK REPOSITORY PROVIDER
+final digibookRepositoryProvider = Provider((ref) => DigiBookRepository());
+
+/// 🔱 MAJOR NODES (Subjects)
+final majorNodesProvider = FutureProvider<List<MajorNode>>((ref) async {
+  final session = ref.watch(sessionUserProvider).valueOrNull;
+  if (session == null) return [];
+  
+  final repo = ref.watch(digibookRepositoryProvider);
+  return repo.fetchMajorNodes(session.selectedExamId);
+});
+
+/// 🔱 MACRO NODES (Chapters)
+final macroNodesProvider = FutureProvider.family<List<MacroNode>, String>((ref, majorId) async {
+  final repo = ref.watch(digibookRepositoryProvider);
+  return repo.fetchMacroNodes(majorId);
+});
+
+/// 🔱 MICRO NODES (Topics)
+final microNodesProvider = FutureProvider.family<List<MicroNode>, String>((ref, macroId) async {
+  final repo = ref.watch(digibookRepositoryProvider);
+  return repo.fetchMicroNodes(macroId);
+});
+
+/// 🔱 ATOMIC NODES (Atomic Topics)
+final atomicNodesProvider = FutureProvider.family<List<AtomicNode>, String>((ref, microId) async {
+  final repo = ref.watch(digibookRepositoryProvider);
+  return repo.fetchAtomicNodes(microId);
+});
+
+/// 🔱 ACTIVE DIGIBOOK STREAM
+final activeDigibookProvider = StreamProvider<List<MicroNode>>((ref) {
+  final session = ref.watch(sessionUserProvider).valueOrNull;
+  if (session == null) return const Stream.empty();
+  
+  final repo = ref.watch(digibookRepositoryProvider);
+  return repo.streamDigiBook(session.selectedExamId);
+});
diff --git a/lib/features/profile/presentation/screens/profile_setup_screen.dart b/lib/features/profile/presentation/screens/profile_setup_screen.dart
