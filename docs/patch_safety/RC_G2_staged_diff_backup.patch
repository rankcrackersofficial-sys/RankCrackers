new file mode 100644
index 0000000..07d0e1d
--- /dev/null
+++ b/lib/web/shared/unified_command_console.dart
@@ -0,0 +1,326 @@
+import 'dart:html' as html;
+import 'package:cloud_firestore/cloud_firestore.dart';
+import 'package:crypto/crypto.dart';
+import 'package:file_picker/file_picker.dart';
+import 'package:firebase_auth/firebase_auth.dart';
+import 'package:firebase_storage/firebase_storage.dart';
+import 'package:flutter/material.dart';
+import 'package:rank_crackers/web/shared/rc_colors.dart';
+import 'package:rank_crackers/web/shared/rc_panel.dart';
+import 'package:rank_crackers/web/shared/rc_layout.dart';
+import 'package:rank_crackers/web/shared/rc_loaders.dart';
+import 'package:rank_crackers/web/shared/rc_file_helpers.dart';
+
+import '../founder/mission_control/mission_control_room.dart';
+import '../founder/study_master/study_master_library_web.dart';
+import '../founder/ingestion/ingestion_review_web.dart';
+import '../founder/intelligence/intelligence_room_web.dart';
+import '../founder/activity/recent_activity_web.dart';
+import '../founder/system/founder_system_operations_web.dart';
+import '../founder/revenue/revenue_subscription_control_web.dart';
+import '../founder/access/access_security_web.dart';
+import '../../features/admin/presentation/widgets/review_queue/admin_tasks_list.dart';
+import '../admin/admin_my_access_panel.dart';
+
+enum ConsoleRoleMode {
+  founder,
+  admin,
+}
+
+class UnifiedCommandConsole extends StatefulWidget {
+  final ConsoleRoleMode roleMode;
+  final Map<String, dynamic> permissions;
+  final Map<String, dynamic> userDoc;
+
+  const UnifiedCommandConsole({
+    super.key,
+    required this.roleMode,
+    required this.permissions,
+    required this.userDoc,
+  });
+
+  @override
+  State<UnifiedCommandConsole> createState() => _UnifiedCommandConsoleState();
+}
+
+class _UnifiedCommandConsoleState extends State<UnifiedCommandConsole> {
+  int _subTab = 0;
+  int _ingestionTab = 0; // 0: Review Board, 1: Unified Registry
+
+  // Existing upload state
+  static const _categories = {
+    'Notification': 'recruitment_notification',
+    'Syllabus': 'syllabus',
+    'PYQ': 'pyq',
+    'Study Material': 'study_material',
+    'Update / Notice': 'notice',
+  };
+  String _category = 'recruitment_notification';
+  bool _uploading = false;
+  String? _message;
+
+  @override
+  void initState() {
+    super.initState();
+    // For admin, landing should be Work Queue (index 0 in filtered list)
+  }
+
+  Future<void> _upload() async {
+    if (widget.roleMode == ConsoleRoleMode.admin) {
+      // Ingestion upload might be restricted to specific permissions later
+      // For now, only Founders usually upload from the generic Ingestion tab
+    }
+
+    final result = await FilePicker.pickFiles(
+      type: FileType.custom,
+      allowedExtensions: [
+        'pdf', 'docx', 'xlsx', 'json', 'csv', 'txt', 'png', 'jpg', 'jpeg', 'webp',
+      ],
+      withData: true,
+    );
+    final file = result?.files.single;
+    final bytes = file?.bytes;
+    if (file == null || bytes == null) return;
+
+    setState(() {
+      _uploading = true;
+      _message = null;
+    });
+
+    try {
+      final hash = sha256.convert(bytes).toString();
+      final ext = file.extension?.toLowerCase() ??
+          file.name.split('.').last.toLowerCase();
+      final sourceId = 'hash_$hash';
+      final storagePath = 'ingestion_refinery/$hash.$ext';
+      final metadata = SettableMetadata(contentType: mimeForExtension(ext));
+      await FirebaseStorage.instance.ref(storagePath).putData(bytes, metadata);
+      final downloadUrl =
+          await FirebaseStorage.instance.ref(storagePath).getDownloadURL();
+
+      final now = FieldValue.serverTimestamp();
+      await FirebaseFirestore.instance
+          .collection('ingestion_refinery')
+          .doc(sourceId)
+          .set({
+        'id': sourceId,
+        'sourceId': sourceId,
+        'fileName': file.name,
+        'fileType': ext,
+        'mimeType': mimeForExtension(ext),
+        'fileSize': bytes.length,
+        'fileHash': hash,
+        'assetType': _category,
+        'status': 'uploaded',
+        'documentStatus': _category == 'pyq' ? 'HISTORICAL' : 'LIVE',
+        'sourceUrl': downloadUrl,
+        'storagePath': storagePath,
+        'createdAt': now,
+        'updatedAt': now,
+        'uploadedFrom': 'rankcrackers_web_unified',
+      }, SetOptions(merge: true));
+
+      await FirebaseFirestore.instance.collection('ai_queue').add({
+        'type': 'pdfParse',
+        'provider': 'gemini',
+        'payload': {
+          'id': sourceId,
+          'fileName': file.name,
+          'filePath': downloadUrl,
+          'storagePath': storagePath,
+          'fileType': ext,
+          'mimeType': mimeForExtension(ext),
+          'intent': _category,
+          'fileHash': hash,
+          'mediumPolicy': 'ENGLISH_ONLY',
+        },
+        'status': 'received',
+        'manualTrigger': true,
+        'createdAt': now,
+        'triggeredFrom': 'rankcrackers_web_unified',
+      });
+
+      setState(
+        () => _message = 'Upload queued. Extraction worker should pick it up.',
+      );
+    } catch (e) {
+      setState(() => _message = 'Upload failed: $e');
+    } finally {
+      if (mounted) setState(() => _uploading = false);
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final modules = _getFilteredModules();
+    if (_subTab >= modules.length) _subTab = 0;
+    
+    final currentModule = modules[_subTab];
+
+    return Scaffold(
+      backgroundColor: Colors.transparent,
+      appBar: PreferredSize(
+        preferredSize: const Size.fromHeight(60),
+        child: Container(
+          decoration: const BoxDecoration(
+            border: Border(bottom: BorderSide(color: rcLine)),
+          ),
+          padding: const EdgeInsets.symmetric(horizontal: 20),
+          child: Row(
+            mainAxisAlignment: MainAxisAlignment.spaceBetween,
+            children: [
+              Expanded(
+                child: SingleChildScrollView(
+                  scrollDirection: Axis.horizontal,
+                  child: Row(
+                    children: List.generate(modules.length, (index) {
+                       return _subTabButton(modules[index].label, index);
+                    }),
+                  ),
+                ),
+              ),
+              const SizedBox(width: 16),
+              _buildIdentityHeader(),
+            ],
+          ),
+        ),
+      ),
+      body: IndexedStack(
+        index: _subTab,
+        children: modules.map((m) => m.builder(context)).toList(),
+      ),
+    );
+  }
+
+  List<_ConsoleModule> _getFilteredModules() {
+    final isFounder = widget.roleMode == ConsoleRoleMode.founder;
+    final perms = widget.permissions;
+    final List<_ConsoleModule> list = [];
+
+    if (isFounder) {
+      list.add(_ConsoleModule(label: 'Mission Control Room', builder: (_) => const MissionControlRoom()));
+      list.add(_ConsoleModule(label: 'Study Master Library', builder: (_) => const StudyMasterLibraryWeb()));
+      list.add(_ConsoleModule(label: 'Ingestion & Review', builder: (_) => _buildIngestionView()));
+      list.add(_ConsoleModule(label: 'Intelligence Room', builder: (_) => const IntelligenceRoomWeb()));
+      list.add(_ConsoleModule(label: 'Recent Activity Log', builder: (_) => const RecentActivityWeb()));
+      list.add(_ConsoleModule(label: 'System Operations', builder: (_) => const FounderSystemOperationsWeb()));
+      list.add(_ConsoleModule(label: 'Revenue & Subscription Control', builder: (_) => const RevenueSubscriptionControlWeb()));
+      list.add(_ConsoleModule(label: 'Access & Security', builder: (_) => const AccessSecurityWeb()));
+    } else {
+      // Admin Mode - Dynamic filtering
+      if (perms['myTasksView'] == true || perms['adminDashboardView'] == true) {
+        list.add(_ConsoleModule(label: 'My Work Queue', builder: (_) => const AdminTasksList()));
+      }
+      if (perms['missionControlView'] == true || perms['missionDocumentsView'] == true) {
+        list.add(_ConsoleModule(label: 'Mission Control', builder: (_) => const MissionControlRoom()));
+      }
+      if (perms['studyMasterView'] == true) {
+        list.add(_ConsoleModule(label: 'Study Master', builder: (_) => const StudyMasterLibraryWeb()));
+      }
+      if (perms['ingestionReviewView'] == true || perms['missionDocumentsView'] == true) {
+        list.add(_ConsoleModule(label: 'Ingestion & Review', builder: (_) => _buildIngestionView()));
+      }
+      if (perms['intelligenceRoomView'] == true) {
+        list.add(_ConsoleModule(label: 'Intelligence Room', builder: (_) => const IntelligenceRoomWeb()));
+      }
+      if (perms['recentActivityView'] == true) {
+        list.add(_ConsoleModule(label: 'Recent Activity', builder: (_) => const RecentActivityWeb()));
+      }
+      
+      list.add(_ConsoleModule(label: 'My Access', builder: (_) => const AdminMyAccessPanel()));
+    }
+
+    return list;
+  }
+
+  Widget _buildIdentityHeader() {
+    final isFounder = widget.roleMode == ConsoleRoleMode.founder;
+    final name = widget.userDoc['name'] ?? widget.userDoc['displayName'] ?? 'Administrator';
+    final designation = widget.userDoc['designation'] ?? (isFounder ? 'Founder & CEO' : 'Administrator');
+    
+    return Row(
+      mainAxisSize: MainAxisSize.min,
+      children: [
+        Container(
+          width: 8,
+          height: 8,
+          decoration: const BoxDecoration(
+            color: rcGreen,
+            shape: BoxShape.circle,
+            boxShadow: [
+              BoxShadow(color: rcGreen, blurRadius: 4, spreadRadius: 1),
+            ],
+          ),
+        ),
+        const SizedBox(width: 8),
+        const Text(
+          'SYSTEM ONLINE',
+          style: TextStyle(color: rcGreen, fontSize: 10, fontWeight: FontWeight.bold, letterSpacing: 0.5),
+        ),
+        const SizedBox(width: 20),
+        const VerticalDivider(width: 1, color: rcLine, indent: 16, endIndent: 16),
+        const SizedBox(width: 20),
+        Column(
+          crossAxisAlignment: CrossAxisAlignment.end,
+          mainAxisAlignment: MainAxisAlignment.center,
+          children: [
+            Text(
+              name.toString().toUpperCase(),
+              style: const TextStyle(color: Colors.white, fontSize: 13, fontWeight: FontWeight.bold),
+            ),
+            Text(
+              designation.toString(),
+              style: TextStyle(color: rcGold, fontSize: 10, fontWeight: FontWeight.bold),
+            ),
+          ],
+        ),
+      ],
+    );
+  }
+
+  Widget _buildIngestionView() {
+    return IngestionReviewWeb(
+      ingestionTab: _ingestionTab,
+      category: _category,
+      categories: _categories,
+      uploading: _uploading,
+      message: _message,
+      onIngestionTabChanged: (value) => setState(() => _ingestionTab = value),
+      onCategoryChanged: (value) =>
+          setState(() => _category = value ?? _category),
+      onUpload: _upload,
+      onKpiTap: (idx) => setState(() => _subTab = idx),
+    );
+  }
+
+  Widget _subTabButton(String label, int index) {
+    final active = _subTab == index;
+    return InkWell(
+      onTap: () => setState(() => _subTab = index),
+      child: Container(
+        padding: const EdgeInsets.symmetric(horizontal: 24, vertical: 16),
+        decoration: BoxDecoration(
+          border: Border(
+            bottom: BorderSide(
+              color: active ? rcGold : Colors.transparent,
+              width: 3,
+            ),
+          ),
+        ),
+        child: Text(
+          label,
+          style: TextStyle(
+            color: active ? rcGold : Colors.white60,
+            fontWeight: active ? FontWeight.w800 : FontWeight.normal,
+          ),
+        ),
+      ),
+    );
+  }
+}
+
+class _ConsoleModule {
+  final String label;
+  final WidgetBuilder builder;
+  _ConsoleModule({required this.label, required this.builder});
+}
