+                        Icon(isCorrect ? Icons.check_circle_rounded : Icons.radio_button_unchecked_rounded, 
+                             size: 16, color: isCorrect ? rcGreen : Colors.white10),
+                        const SizedBox(width: 10),
+                        Expanded(
