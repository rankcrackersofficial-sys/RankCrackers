+import 'package:cloud_functions/cloud_functions.dart';
+import 'package:firebase_auth/firebase_auth.dart';
+import 'package:flutter/material.dart';
+import 'package:go_router/go_router.dart';
+import '../../../../core/theme/app_colors.dart';
+import '../../../../core/theme/app_typography.dart';
+import '../../../../core/theme/tactical_noir_background.dart';
+import '../../../../core/utils/app_routes.dart';
+import '../../../../shared/widgets/tactical_button.dart';
+
+class AdminInviteScreen extends StatefulWidget {
+  final String token;
+  const AdminInviteScreen({super.key, required this.token});
+
+  @override
+  State<AdminInviteScreen> createState() => _AdminInviteScreenState();
+}
+
+class _AdminInviteScreenState extends State<AdminInviteScreen> {
+  bool _validating = true;
+  bool _accepting = false;
+  Map<String, dynamic>? _inviteDetails;
+  String? _error;
+
+  @override
+  void initState() {
+    super.initState();
+    _validateInvite();
+  }
+
+  Future<void> _validateInvite() async {
+    try {
+      final callable = FirebaseFunctions.instance.httpsCallable('manageUserAccess');
+      final result = await callable.call({
+        'action': 'validateAdminInvite',
+        'inviteToken': widget.token,
+      });
+
+      if (mounted) {
+        setState(() {
+          _inviteDetails = Map<String, dynamic>.from(result.data as Map);
+          _validating = false;
+        });
+      }
+    } catch (e) {
+      if (mounted) {
+        setState(() {
+          _error = e.toString();
+          _validating = false;
+        });
+      }
+    }
+  }
+
+  Future<void> _acceptInvite() async {
+    final user = FirebaseAuth.instance.currentUser;
+    if (user == null) {
+      context.push(AppRoutes.login);
+      return;
+    }
+
+    if (user.email?.toLowerCase() != _inviteDetails?['email']?.toString().toLowerCase()) {
+      setState(() => _error = 'Please sign in with the email address linked to this invite: ${_inviteDetails?['email']}');
+      return;
+    }
+
+    setState(() => _accepting = true);
+    try {
+      final callable = FirebaseFunctions.instance.httpsCallable('manageUserAccess');
+      await callable.call({
+        'action': 'acceptAdminInvite',
+        'inviteToken': widget.token,
+        'details': {
+          'name': _inviteDetails?['name'],
+          'mobile': user.phoneNumber ?? 'Not provided', // Fallback if phone not linked
+        }
+      });
+
+      // Force token refresh to get new claims
+      await user.getIdToken(true);
+
+      if (mounted) {
+        ScaffoldMessenger.of(context).showSnackBar(
+          const SnackBar(content: Text('Welcome, Commander. Admin access activated.')),
+        );
+        context.go(AppRoutes.admin);
+      }
+    } catch (e) {
+      if (mounted) {
+        setState(() {
+          _error = e.toString();
+          _accepting = false;
+        });
+      }
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    return Scaffold(
+      backgroundColor: AppColors.background,
+      body: TacticalNoirBackground(
+        child: Center(
+          child: Container(
+            constraints: const BoxConstraints(maxWidth: 450),
+            padding: const EdgeInsets.all(32),
+            decoration: BoxDecoration(
+              color: Colors.white.withValues(alpha: 0.03),
+              borderRadius: BorderRadius.circular(24),
+              border: Border.all(color: Colors.white.withValues(alpha: 0.05)),
+            ),
+            child: _buildContent(),
+          ),
+        ),
+      ),
+    );
+  }
+
+  Widget _buildContent() {
+    if (_validating) {
+      return const Column(
+        mainAxisSize: MainAxisSize.min,
+        children: [
+          CircularProgressIndicator(color: AppColors.gold),
+          SizedBox(height: 24),
+          Text("VALIDATING SECURITY TOKEN...", style: TextStyle(color: Colors.white38, fontSize: 12, letterSpacing: 1.2)),
+        ],
+      );
+    }
+
+    if (_error != null) {
+      return Column(
+        mainAxisSize: MainAxisSize.min,
+        children: [
+          const Icon(Icons.error_outline_rounded, color: AppColors.error, size: 48),
+          const SizedBox(height: 24),
+          Text("INVITE ERROR", style: AppTypography.hero.copyWith(fontSize: 20, color: AppColors.error)),
+          const SizedBox(height: 12),
+          Text(_error!, textAlign: TextAlign.center, style: const TextStyle(color: Colors.white70, fontSize: 13)),
+          const SizedBox(height: 32),
+          TacticalButton(title: "RETURN TO LOGIN", onTap: () => context.go(AppRoutes.login)),
+        ],
+      );
+    }
+
+    final user = FirebaseAuth.instance.currentUser;
+    final bool isCorrectUser = user != null && user.email?.toLowerCase() == _inviteDetails?['email']?.toString().toLowerCase();
+
+    return Column(
+      mainAxisSize: MainAxisSize.min,
+      crossAxisAlignment: CrossAxisAlignment.start,
+      children: [
+        Row(
+          children: [
+            Container(
+              padding: const EdgeInsets.all(12),
+              decoration: BoxDecoration(color: AppColors.gold.withValues(alpha: 0.1), shape: BoxShape.circle),
+              child: const Icon(Icons.shield_rounded, color: AppColors.gold, size: 28),
+            ),
+            const SizedBox(width: 16),
+            const Text("ADMIN INVITE", style: TextStyle(color: AppColors.gold, fontSize: 18, fontWeight: FontWeight.w900, letterSpacing: 2)),
+          ],
+        ),
+        const SizedBox(height: 32),
+        const Text("INVITATION DETAILS", style: TextStyle(color: Colors.white24, fontSize: 10, fontWeight: FontWeight.bold, letterSpacing: 1)),
+        const SizedBox(height: 12),
+        _detailItem("NAME", _inviteDetails?['name']),
+        _detailItem("EMAIL", _inviteDetails?['email']),
+        _detailItem("ROLE", _inviteDetails?['designation']),
+        const SizedBox(height: 32),
+        if (user == null) ...[
+          const Text("AUTHORIZATION REQUIRED", style: TextStyle(color: Colors.orangeAccent, fontSize: 11, fontWeight: FontWeight.bold)),
+          const SizedBox(height: 8),
+          const Text("Please sign in to confirm your identity and activate your command authority.", style: TextStyle(color: Colors.white54, fontSize: 12)),
+          const SizedBox(height: 24),
+          TacticalButton(title: "SIGN IN TO ACTIVATE", onTap: () => context.push(AppRoutes.login)),
+        ] else if (!isCorrectUser) ...[
+          const Text("IDENTITY MISMATCH", style: TextStyle(color: AppColors.error, fontSize: 11, fontWeight: FontWeight.bold)),
+          const SizedBox(height: 8),
+          Text("Current user (${user.email}) does not match the invited email. Please switch accounts.", style: const TextStyle(color: Colors.white54, fontSize: 12)),
+          const SizedBox(height: 24),
+          TacticalButton(title: "SWITCH ACCOUNT", onTap: () {
+            FirebaseAuth.instance.signOut();
+            context.go(AppRoutes.login);
+          }),
+        ] else ...[
+          const Text("READY FOR ACTIVATION", style: TextStyle(color: Colors.greenAccent, fontSize: 11, fontWeight: FontWeight.bold)),
+          const SizedBox(height: 8),
+          const Text("Your identity has been verified. Clicking below will activate your administrator privileges.", style: TextStyle(color: Colors.white54, fontSize: 12)),
+          const SizedBox(height: 32),
+          TacticalButton(
+            title: _accepting ? "ACTIVATING..." : "ACTIVATE PRIVILEGES", 
+            onTap: _accepting ? null : _acceptInvite,
+          ),
+        ],
+      ],
+    );
+  }
+
+  Widget _detailItem(String label, String? value) {
+    return Padding(
+      padding: const EdgeInsets.only(bottom: 12),
+      child: Column(
+        crossAxisAlignment: CrossAxisAlignment.start,
+        children: [
+          Text(label, style: const TextStyle(color: Colors.white10, fontSize: 9, fontWeight: FontWeight.w900)),
+          Text(value ?? '---', style: const TextStyle(color: Colors.white70, fontSize: 14, fontWeight: FontWeight.w500)),
+        ],
+      ),
+    );
+  }
+}
