+++ b/lib/web/founder/fdc/document_command_center.dart
@@ -0,0 +1,293 @@
+import 'package:cloud_firestore/cloud_firestore.dart';
+import 'package:flutter/material.dart';
+import 'package:intl/intl.dart';
+import '../../shared/rc_colors.dart';
+import '../../shared/rc_loaders.dart';
+import '../../shared/rc_panel.dart';
+import '../../shared/rc_layout.dart';
+import '../../shared/unified_command_console.dart';
+import '../mission_control/mission_document_detail_dialog.dart';
+
+class DocumentCommandCenter extends StatefulWidget {
+  final ConsoleRoleMode roleMode;
+  const DocumentCommandCenter({super.key, this.roleMode = ConsoleRoleMode.founder});
+
+  @override
+  State<DocumentCommandCenter> createState() => _DocumentCommandCenterState();
+}
+
+class _DocumentCommandCenterState extends State<DocumentCommandCenter> {
+  String _typeFilter = 'ALL';
+  String _statusFilter = 'ALL';
+  String _searchQuery = '';
+
+  @override
+  Widget build(BuildContext context) {
+    return RcPagePad(
+      child: Column(
+        crossAxisAlignment: CrossAxisAlignment.stretch,
+        children: [
+          const RcPageTitle(
+            title: 'DOCUMENT COMMAND CENTER',
+            subtitle: 'Real-time visibility and recovery controls for uploaded pilot documents.',
+          ),
+          const SizedBox(height: 24),
+          _buildFilters(),
+          const SizedBox(height: 16),
+          Expanded(child: _buildDocumentGrid()),
+        ],
+      ),
+    );
+  }
+
+  Widget _buildFilters() {
+    return RcPanel(
+      child: Row(
+        children: [
+          Expanded(
+            child: TextField(
+              onChanged: (v) => setState(() => _searchQuery = v.toLowerCase()),
+              decoration: const InputDecoration(
+                hintText: 'Search by file name or mission ID...',
+                prefixIcon: Icon(Icons.search_rounded),
+                isDense: true,
+              ),
+            ),
+          ),
+          const SizedBox(width: 16),
+          _dropdown('Type', _typeFilter, ['ALL', 'SYLLABUS', 'PYQ', 'NOTIFICATION'], (v) => setState(() => _typeFilter = v!)),
+          const SizedBox(width: 12),
+          _dropdown('Status', _statusFilter, ['ALL', 'STUCK', 'FAILED', 'VERIFIED', 'PUBLISHED'], (v) => setState(() => _statusFilter = v!)),
+        ],
+      ),
+    );
+  }
+
+  Widget _dropdown(String label, String value, List<String> items, ValueChanged<String?> onChanged) {
+    return SizedBox(
+      width: 160,
+      child: DropdownButtonFormField<String>(
+        value: value,
+        decoration: InputDecoration(labelText: label, isDense: true),
+        items: items.map((e) => DropdownMenuItem(value: e, child: Text(e, style: const TextStyle(fontSize: 11)))).toList(),
+        onChanged: onChanged,
+      ),
+    );
+  }
+
+  Widget _buildDocumentGrid() {
+    return StreamBuilder<QuerySnapshot<Map<String, dynamic>>>(
+      stream: FirebaseFirestore.instance.collectionGroup('official_documents').orderBy('uploadedAt', descending: true).snapshots(),
+      builder: (context, snapshot) {
+        if (snapshot.hasError) return Center(child: Text('Error: ${snapshot.error}', style: const TextStyle(color: rcRed)));
+        if (!snapshot.hasData) return const RcCenteredLoader();
+
+        final docs = snapshot.data!.docs.where((doc) {
+          final data = doc.data();
+          final String mId = data['missionId'] ?? '';
+          final String title = (data['title'] ?? data['fileName'] ?? '').toString().toLowerCase();
+          final String type = (data['documentType'] ?? '').toString().toUpperCase();
+          final String status = (data['status'] ?? '').toString().toUpperCase();
+          final String aiStatus = (data['aiQueueStatus'] ?? '').toString().toUpperCase();
+
+          if (!mId.contains('neet') && !mId.contains('jee')) return false;
+
+          final matchesSearch = _searchQuery.isEmpty || title.contains(_searchQuery) || mId.toLowerCase().contains(_searchQuery);
+          final matchesType = _typeFilter == 'ALL' || type.contains(_typeFilter);
+          
+          bool matchesStatus = true;
+          if (_statusFilter == 'STUCK') {
+             matchesStatus = aiStatus == 'RECEIVED' || aiStatus == 'PENDING' || aiStatus == 'PROCESSING';
+          } else if (_statusFilter == 'FAILED') {
+             matchesStatus = aiStatus == 'FAILED' || data['extractionQuality'] == 'FAILED';
+          } else if (_statusFilter == 'VERIFIED') {
+             matchesStatus = data['reviewStatus'] == 'APPROVED' || data['reviewStatus'] == 'VERIFIED';
+          } else if (_statusFilter == 'PUBLISHED') {
+             matchesStatus = data['publishStatus'] == 'published';
+          }
+
+          return matchesSearch && matchesType && matchesStatus;
+        }).toList();
+
+        if (docs.isEmpty) return const Center(child: Text('No pilot documents matching filters.', style: TextStyle(color: Colors.white24)));
+
+        return ListView.builder(
+          itemCount: docs.length,
+          itemBuilder: (context, index) => _DocumentRow(doc: docs[index], roleMode: widget.roleMode),
+        );
+      },
+    );
+  }
+}
+
+class _DocumentRow extends StatelessWidget {
+  final QueryDocumentSnapshot<Map<String, dynamic>> doc;
+  final ConsoleRoleMode roleMode;
+  const _DocumentRow({required this.doc, required this.roleMode});
+
+  @override
+  Widget build(BuildContext context) {
+    final data = doc.data();
+    final missionId = data['missionId'] ?? 'Unknown';
+    final fileName = data['fileName'] ?? 'Untitled';
+    final type = (data['documentTypeLabel'] ?? data['documentType'] ?? 'Doc').toString().toUpperCase();
+    final uploadedAt = data['uploadedAt'] != null ? DateFormat('dd MMM, HH:mm').format(data['uploadedAt'].toDate()) : '--';
+    
+    final aiStatus = (data['aiQueueStatus'] ?? 'not_queued').toString();
+    final extractionStatus = (data['extractionStatus'] ?? 'idle').toString();
+    final publishStatus = (data['publishStatus'] ?? 'draft').toString();
+
+    // Stats
+    final atoms = data['syllabusAtomCount'] ?? 0;
+    final questions = data['questionCount'] ?? 0;
+    final verifiedAtoms = data['syllabusAtomVerifiedCount'] ?? 0;
+    final approvedQuestions = data['approvedQuestionCount'] ?? 0;
+
+    return Container(
+      margin: const EdgeInsets.only(bottom: 8),
+      padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 12),
+      decoration: BoxDecoration(
+        color: rcSurface,
+        border: Border.all(color: rcLine),
+        borderRadius: BorderRadius.circular(8),
+      ),
+      child: Row(
+        children: [
+          // Identity
+          Expanded(
+            flex: 3,
+            child: Column(
+              crossAxisAlignment: CrossAxisAlignment.start,
+              children: [
+                Text(missionId.toUpperCase(), style: const TextStyle(color: rcGold, fontSize: 10, fontWeight: FontWeight.bold)),
+                const SizedBox(height: 4),
+                Text(fileName, style: const TextStyle(color: Colors.white, fontSize: 13, fontWeight: FontWeight.bold), maxLines: 1, overflow: TextOverflow.ellipsis),
+                const SizedBox(height: 2),
+                Text('$type | Uploaded: $uploadedAt', style: const TextStyle(color: Colors.white24, fontSize: 10)),
+              ],
+            ),
+          ),
+
+          // Pipeline Stage
+          Expanded(
+            flex: 2,
+            child: Column(
+              crossAxisAlignment: CrossAxisAlignment.start,
+              children: [
+                _stageChip('QUEUE', aiStatus, _getAiStatusColor(aiStatus)),
+                const SizedBox(height: 4),
+                _stageChip('EXTRACTION', extractionStatus, _getExtractionColor(extractionStatus)),
+              ],
+            ),
+          ),
+
+          // Output Summary
+          Expanded(
+            flex: 2,
+            child: Column(
+              crossAxisAlignment: CrossAxisAlignment.start,
+              children: [
+                if (type.contains('SYLLABUS')) ...[
+                  _outputLine('Atoms', '$atoms ($verifiedAtoms V)', verifiedAtoms > 0 ? rcGreen : rcGold),
+                ] else if (type.contains('PYQ')) ...[
+                  _outputLine('Questions', '$questions ($approvedQuestions A)', approvedQuestions > 0 ? rcGreen : rcGold),
+                ] else ...[
+                  const Text('No structured output', style: TextStyle(color: Colors.white10, fontSize: 10)),
+                ],
+              ],
+            ),
+          ),
+
+          // Publish & Health
+          Expanded(
+            flex: 2,
+            child: Column(
+              crossAxisAlignment: CrossAxisAlignment.start,
+              children: [
+                _stageChip('PUBLISH', publishStatus, publishStatus == 'published' ? rcGreen : rcGold),
+                const SizedBox(height: 4),
+                _healthBadge(data),
+              ],
+            ),
+          ),
+
+          // Actions
+          IconButton(
+            onPressed: () {
+               showDialog(
+                context: context,
+                builder: (context) => MissionDocumentDetailDialog(
+                  missionId: missionId,
+                  documentId: doc.id,
+                  data: data,
+                  roleMode: roleMode,
+                ),
+              );
+            },
+            icon: const Icon(Icons.troubleshoot_rounded, color: rcGold, size: 20),
+            tooltip: 'Queue Doctor / Traceability',
+          ),
+        ],
+      ),
+    );
+  }
+
+  Widget _stageChip(String label, String value, Color color) {
+    return Row(
+      children: [
+        Text('$label: ', style: const TextStyle(color: Colors.white24, fontSize: 8, fontWeight: FontWeight.bold)),
+        Container(
+          padding: const EdgeInsets.symmetric(horizontal: 6, vertical: 2),
+          decoration: BoxDecoration(color: color.withValues(alpha: 0.1), borderRadius: BorderRadius.circular(4)),
+          child: Text(value.toUpperCase(), style: TextStyle(color: color, fontSize: 8, fontWeight: FontWeight.bold)),
+        ),
+      ],
+    );
+  }
+
+  Widget _outputLine(String label, String value, Color color) {
+    return Row(
+      children: [
+        Text('$label: ', style: const TextStyle(color: Colors.white24, fontSize: 9)),
+        Text(value, style: TextStyle(color: color, fontSize: 9, fontWeight: FontWeight.bold)),
+      ],
+    );
+  }
+
+  Widget _healthBadge(Map<String, dynamic> data) {
+    final aiStatus = (data['aiQueueStatus'] ?? '').toString().toLowerCase();
+    final extractionQuality = (data['extractionQuality'] ?? '').toString();
+    
+    String label = 'HEALTHY';
+    Color color = rcGreen;
+
+    if (aiStatus == 'failed' || extractionQuality == 'FAILED') {
+      label = 'CRITICAL';
+      color = rcRed;
+    } else if (aiStatus == 'received' || aiStatus == 'pending') {
+      label = 'STUCK?';
+      color = rcGold;
+    }
+
+    return Container(
+      padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 2),
+      decoration: BoxDecoration(border: Border.all(color: color.withValues(alpha: 0.3)), borderRadius: BorderRadius.circular(4)),
+      child: Text(label, style: TextStyle(color: color, fontSize: 7, fontWeight: FontWeight.bold, letterSpacing: 0.5)),
+    );
+  }
+
+  Color _getAiStatusColor(String s) {
+    s = s.toLowerCase();
+    if (s == 'completed' || s == 'structured') return rcGreen;
+    if (s == 'failed') return rcRed;
+    if (s == 'processing' || s == 'extracting') return Colors.blue;
+    return rcGold;
+  }
+
+  Color _getExtractionColor(String s) {
+    s = s.toLowerCase();
+    if (s == 'structured' || s == 'success') return rcGreen;
+    if (s == 'failed' || s == 'failed_quality') return rcRed;
+    return rcGold;
+  }
+}
diff --git a/lib/web/founder/mission_control/crucible_assessment_builder.dart b/lib/web/founder/mission_control/crucible_assessment_builder.dart
new file mode 100644
index 0000000..cde5765
--- /dev/null
+++ b/lib/web/founder/mission_control/crucible_assessment_builder.dart
@@ -0,0 +1,145 @@
+import 'package:cloud_firestore/cloud_firestore.dart';
+import 'package:firebase_auth/firebase_auth.dart';
+import 'package:flutter/material.dart';
+
+class CrucibleAssessmentBuilder {
+  static Future<void> buildDraftAssessment({
+    required BuildContext context,
+    required String missionId,
+    required String setId,
+    required Map<String, dynamic> questionSet,
+  }) async {
+    final scaffold = ScaffoldMessenger.of(context);
+    final db = FirebaseFirestore.instance;
+    final user = FirebaseAuth.instance.currentUser;
+
+    try {
+      // 1. Fetch Selected Questions
+      final List<String> qIds = List<String>.from(questionSet['selectedQuestionIds'] ?? []);
+      if (qIds.isEmpty) {
+        scaffold.showSnackBar(const SnackBar(content: Text('No questions found in this set.')));
+        return;
+      }
+
+      // Fetch full question data for ordering and metadata
+      final List<DocumentSnapshot<Map<String, dynamic>>> qSnaps = [];
+      // Firestore 'in' query supports up to 30 items. If more, we might need multiple fetches.
+      // For Crucible Micro/Macro, usually it's within limits or handled by individual gets.
+      for (var id in qIds) {
+        final snap = await db.collection('mission_realms').doc(missionId).collection('question_bank').doc(id).get();
+        if (snap.exists) qSnaps.add(snap);
+      }
+
+      // 2. Deterministic Ordering
+      // Rules: PaperCode -> Difficulty -> SourceQuestionNumber -> ID
+      qSnaps.sort((a, b) {
+        final da = a.data()!;
+        final db = b.data()!;
+
+        // Paper Code
+        final pa = (da['paperCode'] ?? '').toString();
+        final pb = (db['paperCode'] ?? '').toString();
+        if (pa != pb) return pa.compareTo(pb);
+
+        // Difficulty
+        final diffs = {'basic': 0, 'medium': 1, 'advanced': 2};
+        final fa = diffs[da['difficulty']] ?? 9;
+        final fb = diffs[db['difficulty']] ?? 9;
+        if (fa != fb) return fa.compareTo(fb);
+
+        // Source Question Number
+        final na = int.tryParse((da['sourceQuestionNumber'] ?? '').toString()) ?? 0;
+        final nb = int.tryParse((db['sourceQuestionNumber'] ?? '').toString()) ?? 0;
+        if (na != nb) return na.compareTo(nb);
+
+        return a.id.compareTo(b.id);
+      });
+
+      final List<Map<String, dynamic>> questionOrder = qSnaps.asMap().entries.map((e) {
+        final data = e.value.data()!;
+        return {
+          'order': e.key + 1,
+          'questionId': e.value.id,
+          'paperCode': data['paperCode'],
+          'difficulty': data['difficulty'],
+          'sourceType': data['sourceType'],
+        };
+      }).toList();
+
+      // 3. Metadata Generation
+      final String testType = questionSet['testType'] ?? 'STUDY';
+      final int day = questionSet['dayNumber'] ?? 0;
+      final String? varId = questionSet['variableId'];
+      
+      final String title = '${testType.replaceAll('_', ' ')} TEST — DAY $day — ${varId ?? 'COMMON'}';
+      final String instructions = 'Attempt all questions. This is a source-backed assessment draft.';
+
+      final String assessmentId = 'assessment_${setId}_${DateTime.now().millisecondsSinceEpoch}';
+      final assessmentRef = db.collection('mission_realms').doc(missionId).collection('crucible_assessment_drafts').doc(assessmentId);
+
+      final batch = db.batch();
+
+      // 4. Supersede old drafts for this set
+      final oldDrafts = await db.collection('mission_realms').doc(missionId).collection('crucible_assessment_drafts')
+          .where('questionSetId', isEqualTo: setId).get();
+      for (var doc in oldDrafts.docs) {
+        batch.update(doc.reference, {'status': 'SUPERSEDED', 'updatedAt': FieldValue.serverTimestamp()});
+      }
+
+      // 5. Create Assessment Draft
+      batch.set(assessmentRef, {
+        'assessmentId': assessmentId,
+        'missionId': missionId,
+        'planId': questionSet['planId'],
+        'blueprintId': questionSet['blueprintId'],
+        'questionSetId': setId,
+        'dayNumber': day,
+        'testType': testType,
+        'variableId': varId,
+        
+        'selectedQuestionIds': qIds,
+        'questionCount': qIds.length,
+        'questionOrder': questionOrder,
+        
+        'testTitle': title,
+        'testInstructions': instructions,
+        
+        'status': 'DRAFT',
+        'founderReviewStatus': 'PENDING',
+        'publishStatus': 'DRAFT',
+        'approvedForStudentUse': false,
+        'studentVisible': false,
+        
+        'builtFromApprovedQuestionSet': true,
+        'sourceProofComplete': true,
+        'answerProofComplete': true,
+        
+        'generatedFrom': 'Q2',
+        'createdAt': FieldValue.serverTimestamp(),
+        'updatedAt': FieldValue.serverTimestamp(),
+        'createdBy': user?.email ?? user?.uid,
+      });
+
+      // 6. Update Summary Mirrors
+      final setRef = db.collection('mission_realms').doc(missionId).collection('crucible_question_sets').doc(setId);
+      batch.update(setRef, {
+        'assessmentBuildStatus': 'DRAFT_CREATED',
+        'assessmentDraftId': assessmentId,
+        'assessmentQuestionCount': qIds.length,
+        'lastAssessmentBuildAt': FieldValue.serverTimestamp(),
+      });
+
+      final bpRef = db.collection('mission_realms').doc(missionId).collection('crucible_test_blueprints').doc(questionSet['blueprintId']);
+      batch.update(bpRef, {
+        'assessmentBuildStatus': 'DRAFT_CREATED',
+        'assessmentDraftId': assessmentId,
+      });
+
+      await batch.commit();
+      scaffold.showSnackBar(const SnackBar(content: Text('Draft assessment built successfully.')));
+
+    } catch (e) {
+      scaffold.showSnackBar(SnackBar(content: Text('Failed to build assessment: $e')));
+    }
+  }
+}
diff --git a/lib/web/founder/mission_control/crucible_assessment_viewer.dart b/lib/web/founder/mission_control/crucible_assessment_viewer.dart
