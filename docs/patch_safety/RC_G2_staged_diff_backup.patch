+import 'package:flutter/material.dart';
+import 'package:url_launcher/url_launcher.dart';
+import 'package:intl/intl.dart';
+
+import '../../shared/rc_colors.dart';
+import '../../shared/rc_panel.dart';
+
+class MissionDocumentDetailDialog extends StatelessWidget {
+  final String missionId;
+  final String documentId;
+  final Map<String, dynamic> data;
+
+  const MissionDocumentDetailDialog({
+    super.key,
+    required this.missionId,
+    required this.documentId,
+    required this.data,
+  });
+
+  @override
+  Widget build(BuildContext context) {
+    final title = (data['title'] ?? data['fileName'] ?? documentId).toString();
+    final type = (data['documentTypeLabel'] ?? data['documentType'] ?? 'Document').toString();
+    final level = (data['documentLevelLabel'] ?? data['scope'] ?? 'General').toString();
+    final paper = (data['paperType'] ?? data['paperIndex'] ?? data['paperCode'] ?? '--').toString();
+    final variable = (data['variableName'] ?? '--').toString();
+    
+    final storagePath = (data['storagePath'] ?? data['storageRawPath'] ?? '--').toString();
+    final refineryId = (data['refineryId'] ?? data['docId'] ?? '--').toString();
+    final aiTaskId = (data['aiQueueTaskId'] ?? '--').toString();
+    
+    final uploadTime = data['uploadedAt'] != null 
+        ? DateFormat('dd MMM yyyy, hh:mm a').format(data['uploadedAt'].toDate())
+        : '--';
+
+    final downloadUrl = (data['downloadUrl'] ?? data['sourceUrl'] ?? '').toString();
+
+    return Dialog(
+      backgroundColor: Colors.transparent,
+      insetPadding: const EdgeInsets.all(40),
+      child: Container(
+        width: 800,
+        height: 600,
+        decoration: BoxDecoration(
+          color: rcBg,
+          border: Border.all(color: rcLine),
+          borderRadius: BorderRadius.circular(16),
+        ),
+        child: Column(
+          children: [
+            // Header
+            Padding(
+              padding: const EdgeInsets.all(20),
+              child: Row(
+                children: [
+                  const Icon(Icons.description_rounded, color: rcGold, size: 28),
+                  const SizedBox(width: 16),
+                  Expanded(
+                    child: Column(
+                      crossAxisAlignment: CrossAxisAlignment.start,
+                      children: [
+                        Text(
+                          title,
+                          style: const TextStyle(
+                            fontSize: 18,
+                            fontWeight: FontWeight.bold,
+                            color: Colors.white,
+                          ),
+                        ),
+                        Text(
+                          'ID: $documentId',
+                          style: const TextStyle(color: Colors.white30, fontSize: 11),
+                        ),
+                      ],
+                    ),
+                  ),
+                  IconButton(
+                    onPressed: () => Navigator.pop(context),
+                    icon: const Icon(Icons.close),
+                  ),
+                ],
+              ),
+            ),
+            const Divider(height: 1, color: rcLine),
+            
+            Expanded(
+              child: SingleChildScrollView(
+                padding: const EdgeInsets.all(24),
+                child: Row(
+                  crossAxisAlignment: CrossAxisAlignment.start,
+                  children: [
+                    // Left Column: Identity & Location
+                    Expanded(
+                      child: Column(
+                        crossAxisAlignment: CrossAxisAlignment.start,
+                        children: [
+                          _sectionTitle('IDENTITY & SCOPE'),
+                          _detailRow('Document Type', type),
+                          _detailRow('Hierarchy Level', level),
+                          _detailRow('Paper Scope', paper),
+                          _detailRow('Linked Variable', variable),
+                          _detailRow('Uploaded At', uploadTime),
+                          
+                          const SizedBox(height: 24),
+                          _sectionTitle('PIPELINE ANCHORS'),
+                          _detailRow('Storage Path', storagePath, isPath: true),
+                          _detailRow('Refinery ID', refineryId),
+                          _detailRow('AI Task ID', aiTaskId),
+                        ],
+                      ),
+                    ),
+                    const SizedBox(width: 32),
+                    // Right Column: Pipeline Status
+                    Expanded(
+                      child: Column(
+                        crossAxisAlignment: CrossAxisAlignment.start,
+                        children: [
+                          _sectionTitle('LIFECYCLE STATUS'),
+                          _statusRow('Storage Status', 'Uploaded', rcGreen),
+                          _statusRow('Extraction', _getAiStatus(data), _getAiColor(data)),
+                          _statusRow('Review Status', (data['reviewStatus'] ?? 'PENDING').toString().toUpperCase(), _getReviewColor(data)),
+                          _statusRow('Publish State', (data['publishStatus'] ?? 'draft').toString().toUpperCase(), _getPublishColor(data)),
+                          
+                          const SizedBox(height: 24),
+                          _sectionTitle('STRATEGIC READINESS'),
+                          _statusRow('Syllabus Atoms', _getAtomSummary(data), rcGold),
+                          _statusRow('Crucible Ready', 'Waiting for Verification', Colors.white24),
+                          _statusRow('DigiBook Used', 'Not connected yet', Colors.white24),
+                        ],
+                      ),
+                    ),
+                  ],
+                ),
+              ),
+            ),
+            
+            const Divider(height: 1, color: rcLine),
+            // Footer Actions
+            Padding(
+              padding: const EdgeInsets.all(20),
+              child: Row(
+                mainAxisAlignment: MainAxisAlignment.end,
+                children: [
+                  OutlinedButton.icon(
+                    onPressed: downloadUrl.isEmpty ? null : () => launchUrl(Uri.parse(downloadUrl), mode: LaunchMode.externalApplication),
+                    icon: const Icon(Icons.open_in_new_rounded, size: 18),
+                    label: const Text('View Official File'),
+                  ),
+                  const SizedBox(width: 12),
+                  const OutlinedButton(
+                    onPressed: null,
+                    child: Text('Open in Ingestion Review'),
+                  ),
+                  const SizedBox(width: 12),
+                  const FilledButton(
+                    onPressed: null,
+                    child: Text('Open Syllabus Atom Verification'),
+                  ),
+                ],
+              ),
+            ),
+          ],
+        ),
+      ),
+    );
+  }
+
+  Widget _sectionTitle(String title) {
+    return Padding(
+      padding: const EdgeInsets.only(bottom: 12),
+      child: Text(
+        title,
+        style: const TextStyle(
+          fontSize: 11,
+          fontWeight: FontWeight.w900,
+          color: rcGold,
+          letterSpacing: 1.2,
+        ),
+      ),
+    );
+  }
+
+  Widget _detailRow(String label, String value, {bool isPath = false}) {
+    return Padding(
+      padding: const EdgeInsets.only(bottom: 12),
+      child: Column(
+        crossAxisAlignment: CrossAxisAlignment.start,
+        children: [
+          Text(label, style: const TextStyle(color: Colors.white30, fontSize: 10)),
+          const SizedBox(height: 4),
+          Text(
+            value,
+            style: TextStyle(
+              color: Colors.white70,
+              fontSize: 12,
+              fontFamily: isPath ? 'monospace' : null,
+            ),
+          ),
+        ],
+      ),
+    );
+  }
+
+  Widget _statusRow(String label, String value, Color color) {
+    return Padding(
+      padding: const EdgeInsets.only(bottom: 16),
+      child: Row(
+        mainAxisAlignment: MainAxisAlignment.spaceBetween,
+        children: [
+          Text(label, style: const TextStyle(color: Colors.white30, fontSize: 12)),
+          Container(
+            padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 4),
+            decoration: BoxDecoration(
+              color: color.withValues(alpha: 0.1),
+              borderRadius: BorderRadius.circular(4),
+              border: Border.all(color: color.withValues(alpha: 0.3)),
+            ),
+            child: Text(
+              value,
+              style: TextStyle(color: color, fontSize: 10, fontWeight: FontWeight.bold),
+            ),
+          ),
+        ],
+      ),
+    );
+  }
+
+  String _getAiStatus(Map<String, dynamic> data) {
+    final raw = (data['aiQueueStatus'] ?? data['aiStatus'] ?? '').toString().toLowerCase();
+    if (raw.contains('fail')) return 'FAILED';
+    if (raw.contains('process')) return 'PROCESSING';
+    if (raw.contains('receive') || raw == 'pending') return 'IN QUEUE';
+    if (raw == 'completed' || raw == 'verified' || data['extractedText'] != null) return 'COMPLETED';
+    return 'UNKNOWN';
+  }
+
+  Color _getAiColor(Map<String, dynamic> data) {
+    final status = _getAiStatus(data);
+    if (status == 'COMPLETED') return rcGreen;
+    if (status == 'FAILED') return rcRed;
+    if (status == 'PROCESSING') return Colors.blue;
+    return rcGold;
+  }
+
+  Color _getReviewColor(Map<String, dynamic> data) {
+    final s = (data['reviewStatus'] ?? 'PENDING').toString().toUpperCase();
+    if (s == 'APPROVED' || s == 'VERIFIED') return rcGreen;
+    if (s == 'REJECTED') return rcRed;
+    return rcGold;
+  }
+
+  Color _getPublishColor(Map<String, dynamic> data) {
+    final s = (data['publishStatus'] ?? 'draft').toString().toLowerCase();
+    if (s == 'published') return rcGreen;
+    return rcGold;
+  }
+
+  String _getAtomSummary(Map<String, dynamic> data) {
+    if (data['syllabusAtomStatus'] == 'persisted') {
+      return '${data['syllabusAtomCount'] ?? 0} Extracted';
+    }
+    return 'Not Extracted';
+  }
+}
