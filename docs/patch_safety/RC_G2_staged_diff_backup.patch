@@ -0,0 +1,406 @@
+import 'package:cloud_firestore/cloud_firestore.dart';
+import 'package:firebase_auth/firebase_auth.dart';
+import 'package:flutter/material.dart';
+import 'package:url_launcher/url_launcher.dart';
+
+import '../../shared/rc_colors.dart';
+import '../../shared/rc_loaders.dart';
+import '../../shared/rc_panel.dart';
+
+class SyllabusAtomVerificationTab extends StatefulWidget {
+  final String missionId;
+  final String? initialDocumentId;
+  final List<QueryDocumentSnapshot<Map<String, dynamic>>> variables;
+
+  const SyllabusAtomVerificationTab({
+    super.key,
+    required this.missionId,
+    this.initialDocumentId,
+    required this.variables,
+  });
+
+  @override
+  State<SyllabusAtomVerificationTab> createState() =>
+      _SyllabusAtomVerificationTabState();
+}
+
+class _SyllabusAtomVerificationTabState
+    extends State<SyllabusAtomVerificationTab> {
+  String? _documentFilter;
+  String _statusFilter = 'all'; // all, NEEDS_REVIEW, EXTRACTED, VERIFIED, REJECTED
+  String _paperFilter = 'all';
+  String _variableFilter = 'all';
+  bool _missingProofOnly = false;
+
+  @override
+  void initState() {
+    super.initState();
+    _documentFilter = widget.initialDocumentId;
+  }
+
+  Future<void> _updateAtomStatus(
+    String atomId,
+    String status,
+    bool eligible, {
+    String? note,
+    String? verificationStatus,
+    String? reviewStatus,
+  }) async {
+    final now = FieldValue.serverTimestamp();
+    final user = FirebaseAuth.instance.currentUser;
+
+    final Map<String, dynamic> update = {
+      'status': status,
+      'crucibleEligible': eligible,
+      'updatedAt': now,
+      'reviewedBy': user?.email ?? user?.uid,
+      'reviewedAt': now,
+    };
+
+    if (verificationStatus != null) update['verificationStatus'] = verificationStatus;
+    if (reviewStatus != null) update['founderReviewStatus'] = reviewStatus;
+    if (note != null) update['reviewNote'] = note;
+
+    try {
+      await FirebaseFirestore.instance
+          .collection('mission_realms')
+          .doc(widget.missionId)
+          .collection('syllabus_atoms')
+          .doc(atomId)
+          .update(update);
+
+      // Trigger summary update logic here later or via Cloud Function
+      // For S2, we'll rely on the UI to reflect changes and eventually mirror to parent.
+    } catch (e) {
+      if (mounted) {
+        ScaffoldMessenger.of(context).showSnackBar(
+          SnackBar(content: Text('Failed to update atom: $e')),
+        );
+      }
+    }
+  }
+
+  Future<void> _showRejectDialog(String atomId, String action) async {
+    final ctrl = TextEditingController();
+    final isReject = action == 'REJECTED';
+
+    await showDialog(
+      context: context,
+      builder: (context) => AlertDialog(
+        backgroundColor: rcSurface,
+        title: Text(isReject ? 'REJECT SYLLABUS ATOM' : 'MARK NEEDS CORRECTION'),
+        content: Column(
+          mainAxisSize: MainAxisSize.min,
+          children: [
+            TextField(
+              controller: ctrl,
+              decoration: const InputDecoration(
+                labelText: 'Review Note / Reason',
+                hintText: 'Explain why this atom is being rejected or needs correction...',
+              ),
+              maxLines: 3,
+            ),
+          ],
+        ),
+        actions: [
+          TextButton(onPressed: () => Navigator.pop(context), child: const Text('Cancel')),
+          FilledButton(
+            onPressed: () {
+              if (ctrl.text.trim().isEmpty) return;
+              Navigator.pop(context);
+              _updateAtomStatus(
+                atomId,
+                isReject ? 'REJECTED' : 'NEEDS_REVIEW',
+                false,
+                note: ctrl.text.trim(),
+                verificationStatus: isReject ? 'REJECTED' : 'NEEDS_CORRECTION',
+                reviewStatus: isReject ? 'REJECTED' : 'NEEDS_CORRECTION',
+              );
+            },
+            style: FilledButton.styleFrom(backgroundColor: isReject ? rcRed : rcGold),
+            child: Text(isReject ? 'Reject' : 'Mark Needs Correction'),
+          ),
+        ],
+      ),
+    );
+  }
+
+  bool _matchesFilters(Map<String, dynamic> data) {
+    if (_documentFilter != null && data['documentId'] != _documentFilter) return false;
+    if (_statusFilter != 'all' && data['status'] != _statusFilter) return false;
+    if (_paperFilter != 'all' && data['paperCode'] != _paperFilter) return false;
+    if (_variableFilter != 'all' && data['variableId'] != _variableFilter) return false;
+    if (_missingProofOnly) {
+      final hasProof = (data['sourcePageNumber'] != null || data['sourcePage'] != null) &&
+          (data['sourceSnippet'] ?? '').toString().length > 5;
+      if (hasProof) return false;
+    }
+    return true;
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    return Column(
+      children: [
+        _buildHeader(),
+        _buildFilters(),
+        Expanded(child: _buildAtomList()),
+      ],
+    );
+  }
+
+  Widget _buildHeader() {
+    return StreamBuilder<QuerySnapshot<Map<String, dynamic>>>(
+      stream: FirebaseFirestore.instance
+          .collection('mission_realms')
+          .doc(widget.missionId)
+          .collection('syllabus_atoms')
+          .snapshots(),
+      builder: (context, snapshot) {
+        final docs = snapshot.data?.docs ?? [];
+        final total = docs.length;
+        final verified = docs.where((d) => d.data()['status'] == 'VERIFIED').length;
+        final needsReview = docs.where((d) => d.data()['status'] == 'NEEDS_REVIEW' || d.data()['status'] == 'EXTRACTED').length;
+        final eligible = docs.where((d) => d.data()['crucibleEligible'] == true).length;
+
+        return Container(
+          padding: const EdgeInsets.symmetric(horizontal: 24, vertical: 16),
+          color: rcSurface.withValues(alpha: 0.5),
+          child: Row(
+            children: [
+              _stat('Total Atoms', total.toString(), Colors.white),
+              const SizedBox(width: 24),
+              _stat('Needs Review', needsReview.toString(), rcGold),
+              const SizedBox(width: 24),
+              _stat('Verified', verified.toString(), rcGreen),
+              const SizedBox(width: 24),
+              _stat('Crucible Eligible', eligible.toString(), Colors.blue),
+            ],
+          ),
+        );
+      },
+    );
+  }
+
+  Widget _stat(String label, String value, Color color) {
+    return Column(
+      crossAxisAlignment: CrossAxisAlignment.start,
+      children: [
+        Text(label, style: const TextStyle(color: Colors.white30, fontSize: 10, fontWeight: FontWeight.bold)),
+        Text(value, style: TextStyle(color: color, fontSize: 18, fontWeight: FontWeight.w900)),
+      ],
+    );
+  }
+
+  Widget _buildFilters() {
+    return Padding(
+      padding: const EdgeInsets.all(16),
+      child: RcPanel(
+        child: Wrap(
+          spacing: 12,
+          runSpacing: 12,
+          crossAxisAlignment: WrapCrossAlignment.center,
+          children: [
+            SizedBox(
+              width: 200,
+              child: DropdownButtonFormField<String>(
+                value: _statusFilter,
+                decoration: const InputDecoration(labelText: 'Status'),
+                items: const [
+                  DropdownMenuItem(value: 'all', child: Text('All Statuses')),
+                  DropdownMenuItem(value: 'EXTRACTED', child: Text('Extracted')),
+                  DropdownMenuItem(value: 'NEEDS_REVIEW', child: Text('Needs Review')),
+                  DropdownMenuItem(value: 'VERIFIED', child: Text('Verified')),
+                  DropdownMenuItem(value: 'REJECTED', child: Text('Rejected')),
+                ],
+                onChanged: (v) => setState(() => _statusFilter = v!),
+              ),
+            ),
+            SizedBox(
+              width: 180,
+              child: DropdownButtonFormField<String>(
+                value: _variableFilter,
+                decoration: const InputDecoration(labelText: 'Variable'),
+                items: [
+                  const DropdownMenuItem(value: 'all', child: Text('All Variables')),
+                  ...widget.variables.map((v) => DropdownMenuItem(
+                        value: v.id,
+                        child: Text(v.data()['displayName'] ?? v.id),
+                      )),
+                ],
+                onChanged: (v) => setState(() => _variableFilter = v!),
+              ),
+            ),
+            Row(
+              mainAxisSize: MainAxisSize.min,
+              children: [
+                const Text('Missing Proof Only', style: TextStyle(fontSize: 12, color: Colors.white54)),
+                Switch(
+                  value: _missingProofOnly,
+                  onChanged: (v) => setState(() => _missingProofOnly = v),
+                ),
+              ],
+            ),
+            if (_documentFilter != null)
+              Chip(
+                label: Text('Filtered by Document'),
+                onDeleted: () => setState(() => _documentFilter = null),
+                backgroundColor: rcGold.withValues(alpha: 0.1),
+                labelStyle: const TextStyle(color: rcGold, fontSize: 11),
+                deleteIconColor: rcGold,
+              ),
+          ],
+        ),
+      ),
+    );
+  }
+
+  Widget _buildAtomList() {
+    return StreamBuilder<QuerySnapshot<Map<String, dynamic>>>(
+      stream: FirebaseFirestore.instance
+          .collection('mission_realms')
+          .doc(widget.missionId)
+          .collection('syllabus_atoms')
+          .snapshots(),
+      builder: (context, snapshot) {
+        if (!snapshot.hasData) return const RcCenteredLoader(compact: true);
+        final allDocs = snapshot.data!.docs;
+        final filteredDocs = allDocs.where((doc) => _matchesFilters(doc.data())).toList();
+
+        if (filteredDocs.isEmpty) {
+          return const Center(child: Text('No syllabus atoms match current filters.'));
+        }
+
+        return ListView.builder(
+          padding: const EdgeInsets.symmetric(horizontal: 24, bottom: 40),
+          itemCount: filteredDocs.length,
+          itemBuilder: (context, index) {
+            final doc = filteredDocs[index];
+            final data = doc.data();
+            return _buildAtomCard(doc.id, data);
+          },
+        );
+      },
+    );
+  }
+
+  Widget _buildAtomCard(String atomId, Map<String, dynamic> data) {
+    final status = data['status']?.toString() ?? 'EXTRACTED';
+    final isVerified = status == 'VERIFIED';
+    final isRejected = status == 'REJECTED';
+    
+    final paper = '${data['paperCode'] ?? '--'} (${data['paperScope'] ?? 'Unknown'})';
+    final sourcePage = data['sourcePageNumber'] ?? data['sourcePage'] ?? '--';
+    final sourceSnippet = data['sourceSnippet'] ?? '';
+    final hasProof = sourceSnippet.length > 5;
+    
+    Color statusColor = rcGold;
+    if (isVerified) statusColor = rcGreen;
+    if (isRejected) statusColor = rcRed;
+
+    return Card(
+      color: rcSurface,
+      margin: const EdgeInsets.only(bottom: 12),
+      shape: RoundedRectangleBorder(
+        borderRadius: BorderRadius.circular(12),
+        side: BorderSide(color: isVerified ? rcGreen.withValues(alpha: 0.3) : rcLine),
+      ),
+      child: Column(
+        crossAxisAlignment: CrossAxisAlignment.start,
+        children: [
+          ListTile(
+            title: Text(data['displayTitle'] ?? 'Untitled Topic', style: const TextStyle(fontWeight: FontWeight.bold)),
+            subtitle: Text(data['path'] ?? '', style: const TextStyle(fontSize: 11, color: Colors.white30)),
+            trailing: Container(
+              padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 4),
+              decoration: BoxDecoration(
+                color: statusColor.withValues(alpha: 0.1),
+                borderRadius: BorderRadius.circular(4),
+                border: Border.all(color: statusColor.withValues(alpha: 0.3)),
+              ),
+              child: Text(status, style: TextStyle(color: statusColor, fontSize: 10, fontWeight: FontWeight.bold)),
+            ),
+          ),
+          Padding(
+            padding: const EdgeInsets.fromLTRB(16, 0, 16, 16),
+            child: Column(
+              crossAxisAlignment: CrossAxisAlignment.start,
+              children: [
