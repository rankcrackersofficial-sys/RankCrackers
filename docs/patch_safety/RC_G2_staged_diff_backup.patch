+import 'package:flutter/material.dart';
+import 'package:intl/intl.dart';
+import 'package:rank_crackers/core/theme/app_colors.dart';
+import 'package:rank_crackers/core/theme/app_typography.dart';
+import 'package:rank_crackers/core/theme/tactical_noir_background.dart';
+import 'package:rank_crackers/features/subscription/data/models/subscription_models.dart';
+import 'package:rank_crackers/features/subscription/data/repositories/subscription_repository.dart';
+import 'subscription_pass_screen.dart';
+
+class MySubscriptionScreen extends StatelessWidget {
+  const MySubscriptionScreen({super.key});
+
+  @override
+  Widget build(BuildContext context) {
+    final SubscriptionRepository repository = SubscriptionRepository();
+
+    return Scaffold(
+      body: TacticalNoirBackground(
+        child: SafeArea(
+          child: Column(
+            children: [
+              _buildHeader(context),
+              Expanded(
+                child: StreamBuilder<RcUserSubscription?>(
+                  stream: repository.watchUserSubscription(),
+                  builder: (context, snapshot) {
+                    if (snapshot.connectionState == ConnectionState.waiting) {
+                      return const Center(child: CircularProgressIndicator(color: AppColors.gold));
+                    }
+
+                    final subscription = snapshot.data;
+                    if (subscription == null || !subscription.isActive) {
+                      return _buildInactiveState(context);
+                    }
+
+                    return _buildActiveState(context, subscription);
+                  },
+                ),
+              ),
+            ],
+          ),
+        ),
+      ),
+    );
+  }
+
+  Widget _buildHeader(BuildContext context) {
+    return Container(
+      padding: const EdgeInsets.all(24),
+      child: Row(
