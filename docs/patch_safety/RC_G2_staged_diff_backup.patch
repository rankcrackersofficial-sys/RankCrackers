+const admin = require("firebase-admin");
+
+/**
+ * 🔱 PROVIDER HEALTH SERVICE (RC-P12-B)
+ * Manages the operational status and reliability metrics of AI Providers.
+ */
+
+const db = admin.firestore();
+
+async function getProviderHealth(providerId) {
+    const doc = await db.collection('provider_health').doc(providerId).get();
+    if (!doc.exists) {
+        // Bootstrap Default
+        return { enabled: true, healthy: true, failureCount: 0, priority: 1 };
+    }
+    return doc.data();
+}
+
+async function reportSuccess(providerId) {
+    await db.collection('provider_health').doc(providerId).set({
+        healthy: true,
+        failureCount: 0,
+        lastSuccessAt: admin.firestore.FieldValue.serverTimestamp(),
+        updatedAt: admin.firestore.FieldValue.serverTimestamp()
+    }, { merge: true });
+}
+
+async function reportFailure(providerId, error) {
+    await db.collection('provider_health').doc(providerId).set({
+        failureCount: admin.firestore.FieldValue.increment(1),
+        lastFailureAt: admin.firestore.FieldValue.serverTimestamp(),
+        lastError: error.message || String(error),
+        updatedAt: admin.firestore.FieldValue.serverTimestamp()
+    }, { merge: true });
+
+    // 🔱 Failure Logic: Mark unhealthy if 5 consecutive failures
+    const snap = await db.collection('provider_health').doc(providerId).get();
+    if (snap.exists && snap.data().failureCount >= 5) {
+        await snap.ref.update({ healthy: false });
+        console.error(`🔱 GOVERNANCE: Provider ${providerId} marked UNHEALTHY due to repeated failures.`);
+    }
+}
+
+module.exports = {
+    getProviderHealth,
+    reportSuccess,
+    reportFailure
+};
