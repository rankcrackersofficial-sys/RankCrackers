+                  Text('Review Note: ${data['reviewNote']}', style: const TextStyle(color: rcGold, fontSize: 11, fontStyle: FontStyle.italic)),
+                ],
+                const SizedBox(height: 16),
+                Row(
+                  children: [
+                    if (!isVerified) ...[
+                      FilledButton.icon(
+                        onPressed: !hasProof ? null : () => _updateAtomStatus(atomId, 'VERIFIED', true, verificationStatus: 'VERIFIED', reviewStatus: 'APPROVED'),
+                        icon: const Icon(Icons.check_circle_outline_rounded, size: 16),
+                        label: const Text('Verify Atom'),
+                        style: FilledButton.styleFrom(backgroundColor: rcGreen, foregroundColor: Colors.black),
+                      ),
+                      const SizedBox(width: 8),
+                    ],
+                    OutlinedButton(
+                      onPressed: () => _showRejectDialog(atomId, 'NEEDS_CORRECTION'),
