diff --git a/lib/web/founder/mission_control/crucible_draft_planner.dart b/lib/web/founder/mission_control/crucible_draft_planner.dart
new file mode 100644
index 0000000..336e6c0
--- /dev/null
+++ b/lib/web/founder/mission_control/crucible_draft_planner.dart
@@ -0,0 +1,116 @@
+import 'package:cloud_firestore/cloud_firestore.dart';
+import 'package:firebase_auth/firebase_auth.dart';
+import 'package:flutter/material.dart';
+
+import '../../shared/rc_colors.dart';
+
+class CrucibleDraftPlanner {
+  static Future<void> createDraftPlan({
+    required BuildContext context,
+    required String missionId,
+    required Map<String, dynamic> mission,
+    required List<Map<String, dynamic>> vars,
+    required List<Map<String, dynamic>> atoms,
+  }) async {
+    final scaffold = ScaffoldMessenger.of(context);
+    final planId = 'draft_${DateTime.now().millisecondsSinceEpoch}';
+    final db = FirebaseFirestore.instance;
+    final user = FirebaseAuth.instance.currentUser;
+
+    final plan = mission['missionPlan'] as Map?;
+    final totalDays = plan?['totalDays'] ?? 100;
+    final microFreq = plan?['microTestRule']?['frequencyDays'] ?? 2;
+    final macroFreq = plan?['macroTestRule']?['frequencyDays'] ?? 15;
+
+    // Filter verified atoms
+    final eligibleAtoms = atoms.where((a) => a['crucibleEligible'] == true).toList();
+    final commonAtoms = eligibleAtoms.where((a) => a['paperScope'] == 'COMMON_TO_ALL_VARIABLES').toList();
+
+    try {
+      final batch = db.batch();
+      final planRef = db.collection('mission_realms').doc(missionId).collection('crucible_plans').doc(planId);
+
+      int totalAssigned = 0;
+
+      // For Phase C1, we are creating a generic "Master Draft" that shows the potential coverage.
+      // In a real multi-variable scenario, we might need variable-specific plans, 
+      // but for the "Draft Planner", we'll create the 100-day structure first.
+
+      for (int i = 1; i <= totalDays; i++) {
+        final dayRef = planRef.collection('days').doc(i.toString());
+        
+        String dayType = 'STUDY';
+        String testMarker = 'none';
+
+        if (i % microFreq == 0) {
+          dayType = 'STUDY_WITH_MICRO_TEST';
+          testMarker = 'micro_test_due';
+        }
+        if (i % macroFreq == 0) {
+          dayType = 'MACRO_TEST';
+          testMarker = 'macro_test_due';
+        }
+        if (i == totalDays) {
+          dayType = 'FINAL_MAJOR_TEST_DRAFT';
+          testMarker = 'final_major_due';
+        }
+
+        // Simple Deterministic Distribution for C1 Draft
+        // In real S3/C1, we'd distribute atoms by index/load.
+        // For this draft, we'll just assign a slice of atoms to show the UI works.
+        final atomsPerDay = (eligibleAtoms.length / totalDays).ceil();
+        final startIdx = (i - 1) * atomsPerDay;
+        final endIdx = i * atomsPerDay;
+        
+        final List<Map<String, dynamic>> dayAtoms = [];
+        if (startIdx < eligibleAtoms.length) {
+          final slice = eligibleAtoms.sublist(
+            startIdx, 
+            endIdx > eligibleAtoms.length ? eligibleAtoms.length : endIdx
+          );
+          dayAtoms.addAll(slice);
+          totalAssigned += slice.length;
+        }
+
+        batch.set(dayRef, {
+          'dayNumber': i,
+          'dayType': dayType,
+          'testMarker': testMarker,
+          'assignedAtomIds': dayAtoms.map((a) => a['atomId']).toList(),
+          'commonAtomIds': dayAtoms.where((a) => a['paperScope'] == 'COMMON_TO_ALL_VARIABLES').map((a) => a['atomId']).toList(),
+          'variableSpecificAtomIds': dayAtoms.where((a) => a['paperScope'] == 'VARIABLE_SPECIFIC').map((a) => a['atomId']).toList(),
+          'estimatedStudyMinutes': dayAtoms.length * 20, // Dummy estimate
+          'loadLevel': dayAtoms.length > 5 ? 'HEAVY' : 'MEDIUM',
+          'status': 'DRAFT',
+          'createdAt': FieldValue.serverTimestamp(),
+          'updatedAt': FieldValue.serverTimestamp(),
+        });
+      }
+
+      batch.set(planRef, {
+        'planId': planId,
+        'missionId': missionId,
+        'status': 'DRAFT',
+        'generatedFrom': 'C1',
+        'totalDays': totalDays,
+        'totalEligibleAtoms': eligibleAtoms.length,
+        'totalAssignedAtoms': totalAssigned,
+        'unassignedAtoms': eligibleAtoms.length - totalAssigned,
+        'coveragePercent': (totalAssigned / eligibleAtoms.length * 100).round(),
+        'commonAtomCount': commonAtoms.length,
+        'variableSpecificAtomCount': eligibleAtoms.length - commonAtoms.length,
+        'createdBy': user?.email ?? user?.uid,
+        'createdAt': FieldValue.serverTimestamp(),
+        'updatedAt': FieldValue.serverTimestamp(),
+        'founderReviewStatus': 'PENDING',
+        'publishStatus': 'DRAFT',
+      });
+
+      await batch.commit();
+      scaffold.showSnackBar(const SnackBar(content: Text('Draft Crucible Plan successfully generated.')));
+
+    } catch (e) {
+      scaffold.showSnackBar(SnackBar(content: Text('Failed to generate draft plan: $e')));
+    }
+  }
+}
