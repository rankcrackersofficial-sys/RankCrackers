+++ b/functions/workers/verification_worker.js
@@ -0,0 +1,99 @@
+const functions = require("firebase-functions");
+const admin = require("firebase-admin");
+const { callPro } = require("../services/gemini_service");
+const { updateHeartbeat, isWorkerEnabled } = require("../services/worker_service");
+const sanitizeJsonResponse = require("../helpers/sanitizer");
+
+const WORKER_VERSION = "1.0.0 (Pro-Auditor)";
+
+/**
+ * 🔱 SENTINEL VERIFICATION WORKER (Phase P9)
+ * Uses Gemini Pro to audit Flash extractions against the source truth.
+ */
+exports.sentinelVerificationWorker = functions
+  .runWith({ secrets: ["GEMINI_API_KEY"] })
+  .firestore
+  .document("ai_queue/{taskId}")
+  .onWrite(async (change, context) => {
+    const taskId = context.params.taskId;
+    if (!change.after.exists) return;
+
+    const task = change.after.data();
+    if (task.type !== 'SENTINEL_VERIFICATION' || task.status !== 'received') return;
+
+    const { payload } = task;
+    const { draftId, sourceText, extractedData } = payload;
+    const db = admin.firestore();
+
+    if (!(await isWorkerEnabled('verification_worker'))) return;
+
+    await updateHeartbeat('verification_worker', { activeTask: taskId, status: 'ONLINE' });
+
+    try {
+      // 🔱 AUDIT PROMPT
+      const prompt = `
+        🔱 SOVEREIGN AUDIT PROTOCOL: GEMINI PRO VERIFICATION
+        You are the Supreme Auditor of the RankCrackers Knowledge Factory.
+
+        SOURCE TEXT:
+        ${sourceText}
+
+        PREVIOUS EXTRACTION (By Gemini Flash):
+        ${JSON.stringify(extractedData, null, 2)}
+
+        TASK:
+        Verify the accuracy of the extraction against the source text.
+        Look for:
+        1. Hallucinations (Data present in extraction but NOT in source).
+        2. Omissions (Critical data like lastDate, vacancies, or exam name missing).
+        3. Errors (Wrong dates, wrong organization, typo in titles).
+
+        RETURN JSON FORMAT:
+        {
+          "isValid": true | false,
+          "confidence": 0.0 - 1.0,
+          "corrections": {
+             "field_name": "correct_value"
+          },
+          "audit_notes": "Short explanation of changes"
+        }
+      `;
+
+      const responseText = await callPro(prompt);
+      const auditResult = JSON.parse(sanitizeJsonResponse(responseText));
+
+      const draftRef = db.collection("sentinel_drafts").doc(draftId);
+
+      await db.runTransaction(async (transaction) => {
+          const draftSnap = await transaction.get(draftRef);
+          if (!draftSnap.exists) return;
+
+          const update = {
+              verificationReport: auditResult,
+              lastAuditAt: admin.firestore.FieldValue.serverTimestamp()
+          };
+
+          if (auditResult.isValid && auditResult.confidence > 0.85) {
+              // If perfectly valid, we can auto-update the data if corrections exist
+              if (Object.keys(auditResult.corrections || {}).length > 0) {
+                  update.rawData = { ...extractedData, ...auditResult.corrections };
+                  update.auditStatus = 'PRO_AUTO_FIXED';
+              } else {
+                  update.auditStatus = 'PRO_VERIFIED';
+              }
+          } else {
+              update.auditStatus = 'PRO_DISPUTED';
+              update.status = 'review_required';
+          }
+
+          transaction.update(draftRef, update);
+      });
+
+      await db.collection("ai_queue").doc(taskId).update({ status: 'completed', result: auditResult });
+      await updateHeartbeat('verification_worker', { success: true });
+
+    } catch (error) {
+      console.error(`VERIFICATION ERROR:`, error);
+      await db.collection("ai_queue").doc(taskId).update({ status: 'failed', error: error.message });
+    }
+  });
