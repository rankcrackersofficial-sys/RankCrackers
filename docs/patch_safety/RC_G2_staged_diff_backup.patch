+
+import '../../shared/rc_colors.dart';
+import '../../shared/rc_loaders.dart';
+import '../../shared/rc_panel.dart';
+
+class CrucibleAssessmentViewerDialog extends StatelessWidget {
+  final String missionId;
+  final String assessmentId;
+
+  const CrucibleAssessmentViewerDialog({
+    super.key,
+    required this.missionId,
+    required this.assessmentId,
+  });
+
+  @override
+  Widget build(BuildContext context) {
+    return Dialog(
+      backgroundColor: Colors.transparent,
+      insetPadding: const EdgeInsets.all(40),
+      child: Container(
+        width: 1000,
+        height: 850,
+        decoration: BoxDecoration(
+          color: rcBg,
+          border: Border.all(color: rcLine),
+          borderRadius: BorderRadius.circular(16),
+        ),
+        child: FutureBuilder<DocumentSnapshot<Map<String, dynamic>>>(
+          future: FirebaseFirestore.instance
+              .collection('mission_realms')
+              .doc(missionId)
+              .collection('crucible_assessment_drafts')
+              .doc(assessmentId)
+              .get(),
+          builder: (context, snapshot) {
+            if (!snapshot.hasData) return const RcCenteredLoader();
+            final data = snapshot.data!.data();
+            if (data == null) return const Center(child: Text('Assessment draft not found.'));
+
+            final List<dynamic> questionOrder = data['questionOrder'] ?? [];
+
+            return Column(
+              children: [
+                // Header
+                Padding(
+                  padding: const EdgeInsets.all(20),
+                  child: Row(
+                    children: [
+                      const Icon(Icons.fact_check_rounded, color: rcGold, size: 28),
+                      const SizedBox(width: 16),
+                      Expanded(
+                        child: Column(
+                          crossAxisAlignment: CrossAxisAlignment.start,
+                          children: [
+                            Text(
+                              data['testTitle'] ?? 'DRAFT ASSESSMENT',
+                              style: const TextStyle(fontSize: 18, fontWeight: FontWeight.bold, color: Colors.white),
+                            ),
+                            Text(
+                              'Assessment ID: $assessmentId | Status: ${data['status']}',
+                              style: const TextStyle(color: Colors.white30, fontSize: 11),
+                            ),
+                          ],
+                        ),
+                      ),
+                      IconButton(
+                        onPressed: () => Navigator.pop(context),
+                        icon: const Icon(Icons.close),
