+import 'package:cloud_firestore/cloud_firestore.dart';
+import 'package:flutter/material.dart';
+import 'package:rank_crackers/core/theme/app_colors.dart';
+import 'package:rank_crackers/core/theme/app_typography.dart';
+import 'package:rank_crackers/core/widgets/dark_card.dart';
+import '../shared/center_header.dart';
+
+class PaymentAuditCenter extends StatelessWidget {
+  const PaymentAuditCenter({super.key});
+
+  @override
+  Widget build(BuildContext context) {
+    return ListView(
+      padding: const EdgeInsets.all(24),
+      children: [
+        const CenterHeader(
+          title: "PAYMENT AUDIT",
+          subtitle: "Financial oversight and subscription management.",
+        ),
+        const SizedBox(height: 32),
+        
+        _buildStatsGrid(),
+        
+        const SizedBox(height: 40),
+        
+        Text("RECENT TRANSACTIONS", style: AppTypography.cardTitle.copyWith(fontSize: 12)),
+        const SizedBox(height: 16),
+        _buildTransactionList(),
+      ],
+    );
+  }
+
+  Widget _buildStatsGrid() {
+    return GridView.count(
+      crossAxisCount: 2,
+      shrinkWrap: true,
+      physics: const NeverScrollableScrollPhysics(),
+      mainAxisSpacing: 12,
+      crossAxisSpacing: 12,
+      childAspectRatio: 1.6,
+      children: [
+        _statCard("TOTAL REVENUE", _streamSum('rc_payment_orders', 'finalAmount', status: 'paid'), prefix: "₹"),
+        _statCard("GST COLLECTED", _streamSum('rc_payment_orders', 'gstAmount', status: 'paid'), prefix: "₹"),
+        _statCard("ACTIVE PASSES", _streamCount('rc_user_subscriptions', status: 'active')),
+        _statCard("FAILED PAYMENTS", _streamCount('rc_payment_orders', status: 'failed')),
+      ],
+    );
+  }
+
+  Widget _statCard(String label, Stream<num> stream, {String prefix = ""}) {
+    return DarkCard(
+      padding: const EdgeInsets.all(16),
+      child: Column(
+        crossAxisAlignment: CrossAxisAlignment.start,
+        mainAxisAlignment: MainAxisAlignment.center,
+        children: [
+          Text(label, style: AppTypography.label.copyWith(fontSize: 8, color: Colors.white24)),
+          const SizedBox(height: 8),
+          StreamBuilder<num>(
+            stream: stream,
+            builder: (context, snap) {
+              final val = snap.data ?? 0;
+              return Text("$prefix$val", style: AppTypography.hero.copyWith(fontSize: 20, color: AppColors.gold));
+            },
+          ),
+        ],
+      ),
+    );
+  }
+
+  Stream<num> _streamSum(String collection, String field, {String? status}) {
+    var query = FirebaseFirestore.instance.collection(collection);
+    if (status != null) {
+      return query.where('status', isEqualTo: status).snapshots().map((snap) {
+        return snap.docs.fold(0.0, (prev, doc) => prev + (doc.data()[field] ?? 0));
+      });
+    }
+    return query.snapshots().map((snap) {
+      return snap.docs.fold(0.0, (prev, doc) => prev + (doc.data()[field] ?? 0));
+    });
+  }
+
+  Stream<int> _streamCount(String collection, {String? status}) {
+    var query = FirebaseFirestore.instance.collection(collection);
+    if (status != null) {
+      return query.where('status', isEqualTo: status).snapshots().map((snap) => snap.size);
+    }
+    return query.snapshots().map((snap) => snap.size);
+  }
+
+  Widget _buildTransactionList() {
+    return StreamBuilder<QuerySnapshot>(
+      stream: FirebaseFirestore.instance
+          .collection('rc_payment_orders')
+          .orderBy('createdAt', descending: true)
+          .limit(20)
+          .snapshots(),
+      builder: (context, snap) {
+        if (!snap.hasData) return const Center(child: CircularProgressIndicator());
+        final docs = snap.data!.docs;
+        
+        if (docs.isEmpty) {
+          return const Center(child: Text("No transactions found.", style: TextStyle(color: Colors.white24)));
+        }
+
+        return Column(
+          children: docs.map((doc) {
+            final data = doc.data() as Map<String, dynamic>;
+            final status = data['status'] ?? 'unknown';
+            final color = status == 'paid' ? Colors.greenAccent : status == 'failed' ? Colors.redAccent : Colors.orangeAccent;
+            
+            return Padding(
+              padding: const EdgeInsets.only(bottom: 8),
+              child: DarkCard(
+                padding: const EdgeInsets.all(16),
+                child: Row(
+                  children: [
+                    Container(
+                      width: 4, height: 32,
+                      decoration: BoxDecoration(color: color, borderRadius: BorderRadius.circular(2)),
+                    ),
+                    const SizedBox(width: 16),
+                    Expanded(
+                      child: Column(
+                        crossAxisAlignment: CrossAxisAlignment.start,
+                        children: [
+                          Text("Order: ${doc.id}", style: AppTypography.label.copyWith(fontSize: 8, color: Colors.white24)),
+                          Text("User: ${data['userId']?.toString().substring(0, 8)}...", style: AppTypography.body.copyWith(fontSize: 10)),
+                        ],
+                      ),
+                    ),
+                    Column(
+                      crossAxisAlignment: CrossAxisAlignment.end,
+                      children: [
+                        Text("₹${data['finalAmount']}", style: AppTypography.body.copyWith(fontWeight: FontWeight.bold, color: Colors.white)),
+                        Text(status.toUpperCase(), style: AppTypography.label.copyWith(fontSize: 7, color: color)),
+                      ],
+                    ),
+                  ],
+                ),
+              ),
+            );
+          }).toList(),
+        );
+      },
+    );
+  }
+}
