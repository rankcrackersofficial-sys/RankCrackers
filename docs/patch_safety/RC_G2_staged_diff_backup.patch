+const admin = require("firebase-admin");
+const db = admin.firestore();
+
+/**
+ *  RANKCRACKERS SUBSCRIPTION SERVICE
+ * Handles activation and lifecycle of user access passes.
+ */
+
+async function activateRankCrackers100DayAccess(userId, planId, orderId) {
+    const planRef = db.collection('rc_plans').doc(planId);
+    const planSnap = await planRef.get();
+
+    if (!planSnap.exists) throw new Error("PLAN_NOT_FOUND");
+    const plan = planSnap.data();
+
+    const durationDays = plan.durationDays || 100;
+    const now = new Date();
+    const endDate = new Date();
+    endDate.setDate(now.getDate() + durationDays);
+
+    const subscriptionId = `sub_${userId}_${Date.now()}`;
+    const subscriptionPayload = {
+        subscriptionId,
+        userId,
+        planId,
+        status: 'active',
+        startDate: admin.firestore.FieldValue.serverTimestamp(),
+        endDate: admin.firestore.Timestamp.fromDate(endDate),
+        durationDays,
+        lastPaymentOrderId: orderId,
+        createdAt: admin.firestore.FieldValue.serverTimestamp(),
+        updatedAt: admin.firestore.FieldValue.serverTimestamp(),
+    };
+
+    // Create Invoice
+    const invoiceId = `inv_${orderId}`;
+    const invoicePayload = {
+        invoiceId,
+        userId,
+        planId,
+        basePrice: plan.basePrice,
+        gstRate: plan.gstRate,
+        gstAmount: plan.gstAmount,
+        finalAmount: plan.finalAmount,
+        invoiceStatus: 'issued',
+        paymentOrderId: orderId,
+        createdAt: admin.firestore.FieldValue.serverTimestamp(),
+    };
+
+    const batch = db.batch();
+
+    // We update/set the subscription
+    // If user already has an active one, we might want to extend it
+    // For simplicity in V1, we create a new record or overwrite the latest
+    batch.set(db.collection('rc_user_subscriptions').doc(subscriptionId), subscriptionPayload);
+    batch.set(db.collection('rc_invoices').doc(invoiceId), invoicePayload);
+
+    // Update Order status
+    batch.update(db.collection('rc_payment_orders').doc(orderId), {
+        status: 'paid',
+        updatedAt: admin.firestore.FieldValue.serverTimestamp()
+    });
+
+    await batch.commit();
+    console.log(`🔱 SUBSCRIPTION_ACTIVATED: User ${userId} for ${durationDays} days.`);
+
+    return subscriptionId;
+}
+
+async function expireSubscriptions() {
+    const now = admin.firestore.Timestamp.now();
+    const snapshot = await db.collection('rc_user_subscriptions')
+        .where('status', '==', 'active')
+        .where('endDate', '<=', now)
+        .get();
+
+    if (snapshot.empty) return 0;
+
+    const batch = db.batch();
+    snapshot.forEach(doc => {
+        batch.update(doc.ref, {
+            status: 'expired',
+            updatedAt: admin.firestore.FieldValue.serverTimestamp()
+        });
+    });
+
+    await batch.commit();
+    return snapshot.size;
+}
+
+module.exports = {
+    activateRankCrackers100DayAccess,
+    expireSubscriptions
+};
