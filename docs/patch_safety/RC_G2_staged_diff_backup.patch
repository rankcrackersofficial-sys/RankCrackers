+  final String status;
+  final bool missionStructureReady;
+  final bool missionPlanReady;
+  final bool commonPaperReady;
+  final bool variableCoverageReady;
+  final bool sourceProofReady;
+  final bool crossSubjectSafe;
+  final int totalEligibleAtoms;
+  final int totalBlockedAtoms;
+  final List<String> missingItems;
+  final List papers;
+  final List<Map<String, dynamic>> atoms;
+  final List<Map<String, dynamic>> vars;
+
+  _ReadinessReport({
+    required this.status,
+    required this.missionStructureReady,
+    required this.missionPlanReady,
+    required this.commonPaperReady,
+    required this.variableCoverageReady,
+    required this.sourceProofReady,
+    required this.crossSubjectSafe,
+    required this.totalEligibleAtoms,
+    required this.totalBlockedAtoms,
+    required this.missingItems,
+    required this.papers,
+    required this.atoms,
+    required this.vars,
+  });
+}
