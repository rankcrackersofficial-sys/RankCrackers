+import '../../shared/rc_panel.dart';
+
+class AdminTaskQueuePanel extends StatefulWidget {
+  const AdminTaskQueuePanel({super.key});
+
+  @override
+  State<AdminTaskQueuePanel> createState() => _AdminTaskQueuePanelState();
+}
+
+class _AdminTaskQueuePanelState extends State<AdminTaskQueuePanel> {
+  String _statusFilter = 'all';
+
+  @override
+  Widget build(BuildContext context) {
+    return RcPanel(
+      child: Column(
+        crossAxisAlignment: CrossAxisAlignment.start,
+        children: [
+          Row(
+            mainAxisAlignment: MainAxisAlignment.spaceBetween,
+            children: [
+              const Text('ADMIN TASK QUEUE (GLOBAL)', style: TextStyle(color: rcGold, fontWeight: FontWeight.w800)),
+              SizedBox(
+                width: 150,
+                child: DropdownButtonFormField<String>(
+                  value: _statusFilter,
+                  decoration: const InputDecoration(labelText: 'Status', isDense: true),
+                  items: ['all', 'OPEN', 'IN_PROGRESS', 'DONE', 'BLOCKED', 'CANCELLED'].map((s) => DropdownMenuItem(value: s, child: Text(s, style: const TextStyle(fontSize: 10)))).toList(),
+                  onChanged: (v) => setState(() => _statusFilter = v!),
+                ),
+              ),
+            ],
+          ),
+          const SizedBox(height: 16),
+          Expanded(
+            child: StreamBuilder<QuerySnapshot<Map<String, dynamic>>>(
+              stream: _statusFilter == 'all' 
+                ? FirebaseFirestore.instance.collection('admin_tasks').orderBy('createdAt', descending: true).snapshots()
+                : FirebaseFirestore.instance.collection('admin_tasks').where('status', isEqualTo: _statusFilter).orderBy('createdAt', descending: true).snapshots(),
+              builder: (context, snapshot) {
+                if (snapshot.hasError) return Text('Error: ${snapshot.error}');
+                if (!snapshot.hasData) return const RcCenteredLoader(compact: true);
+                
+                final tasks = snapshot.data!.docs;
+                if (tasks.isEmpty) return const Center(child: Text('No tasks found.', style: TextStyle(color: Colors.white24, fontSize: 12)));
+
+                return ListView.separated(
+                  itemCount: tasks.length,
+                  separatorBuilder: (_, __) => const Divider(color: rcLine, height: 8),
+                  itemBuilder: (context, index) {
+                    final task = tasks[index].data();
+                    final time = task['createdAt'] as Timestamp?;
+                    final dateStr = time != null ? DateFormat('dd MMM HH:mm').format(time.toDate()) : '--';
+
+                    return ListTile(
+                      contentPadding: EdgeInsets.zero,
+                      title: Text(task['title'] ?? 'Untitled', style: const TextStyle(fontSize: 12, fontWeight: FontWeight.bold, color: Colors.white70)),
+                      subtitle: Text('Assigned to: ${task['assignedToName']} (${task['assignedToEmail']})\nType: ${task['taskType']} | Created: $dateStr', style: const TextStyle(fontSize: 10, color: Colors.white30)),
+                      trailing: _statusChip(task['status'] ?? 'OPEN'),
+                    );
+                  },
+                );
+              },
+            ),
+          ),
+        ],
+      ),
+    );
+  }
+
+  Widget _statusChip(String status) {
+    Color color = Colors.blue;
+    if (status == 'IN_PROGRESS') color = Colors.orange;
+    if (status == 'DONE') color = Colors.green;
+    if (status == 'BLOCKED') color = Colors.red;
+    return Container(
+      padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 4),
+      decoration: BoxDecoration(color: color.withValues(alpha: 0.1), borderRadius: BorderRadius.circular(4)),
+      child: Text(status, style: TextStyle(color: color, fontSize: 8, fontWeight: FontWeight.bold)),
+    );
+  }
+}
diff --git a/lib/web/founder/fdc/document_command_center.dart b/lib/web/founder/fdc/document_command_center.dart
new file mode 100644
index 0000000..4940add
