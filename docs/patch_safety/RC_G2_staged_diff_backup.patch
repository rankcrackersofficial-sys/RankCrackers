--- /dev/null
+++ b/functions/callable/payments.js
@@ -0,0 +1,99 @@
+const functions = require("firebase-functions");
+const admin = require("firebase-admin");
+const { activateRankCrackers100DayAccess } = require("../services/subscription_service");
+
+const db = admin.firestore();
+
+/**
+ *  CREATE PAYMENT ORDER
+ * Checks plan and creates a backend-validated order record.
+ */
+exports.createRankCrackersPaymentOrder = functions.https.onCall(async (data, context) => {
+    if (!context.auth) throw new functions.https.HttpsError('unauthenticated', 'Login required.');
+
+    const { planId } = data;
+    const userId = context.auth.uid;
+
+    const planRef = db.collection('rc_plans').doc(planId);
+    const planSnap = await planRef.get();
+
+    if (!planSnap.exists || !planSnap.data().active) {
+        throw new functions.https.HttpsError('not-found', 'Invalid or inactive plan.');
+    }
+
+    const plan = planSnap.data();
+    const orderId = `ord_${userId}_${Date.now()}`;
+
+    const orderPayload = {
+        orderId,
+        userId,
+        planId,
+        basePrice: plan.basePrice,
+        gstRate: plan.gstRate,
+        gstAmount: plan.gstAmount,
