@@ -0,0 +1,57 @@
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+import '../../data/services/crucible_repository.dart';
+import '../../models/crucible_protocol_state.dart';
+import '../../models/crucible_schedule.dart';
+import '../../../../shared/providers/session_provider.dart';
+import '../../../../core/knowledge/knowledge_engine.dart';
+import '../core/crucible_engine.dart';
+
+/// 🔱 CRUCIBLE REPOSITORY PROVIDER
+final crucibleRepositoryProvider = Provider((ref) => CrucibleRepository());
+
+/// 🔱 CRUCIBLE PROTOCOL STATE PROVIDER
+final crucibleProtocolStateProvider = FutureProvider<CrucibleProtocolState?>((ref) async {
+  final session = ref.watch(sessionUserProvider).valueOrNull;
+  if (session == null) return null;
+
+  final repo = ref.watch(crucibleRepositoryProvider);
+  return repo.getProtocolState(session.uid, session.selectedExamId);
+});
+
+/// 🔱 TACTICAL ROADMAP PROVIDER
+final crucibleRoadmapProvider = StreamProvider<List<CrucibleSchedule>>((ref) {
+  final session = ref.watch(sessionUserProvider).valueOrNull;
+  if (session == null) return const Stream.empty();
+
+  final repo = ref.watch(crucibleRepositoryProvider);
+  return repo.streamSchedules(session.uid, session.selectedExamId);
+});
+
+/// 🔱 ACTIVE BATTLE NODES PROVIDER
+final activeBattleNodesProvider = FutureProvider<List<dynamic>>((ref) async {
+  final protocolAsync = ref.watch(crucibleProtocolStateProvider);
+  final roadmapAsync = ref.watch(crucibleRoadmapProvider);
+  
+  return protocolAsync.when(
+    data: (state) {
+      if (state == null) return [];
+      
+      return roadmapAsync.when(
+        data: (schedules) {
+          final currentSchedule = schedules.firstWhere(
+            (s) => s.id == state.currentScheduleId,
+            orElse: () => schedules.first,
+          );
+          
+          // In a real implementation, we would fetch CrucibleNodes here
+          // For baseline, we return the IDs to be resolved by the Battle Screen
+          return currentSchedule.nodeIds;
+        },
+        loading: () => [],
+        error: (_, __) => [],
+      );
+    },
+    loading: () => [],
+    error: (_, __) => [],
+  );
+});
