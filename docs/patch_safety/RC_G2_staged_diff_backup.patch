+          ),
+          const SizedBox(height: 12),
+          Text(task['title'] ?? 'Untitled Task', style: AppTypography.cardTitle.copyWith(fontSize: 14)),
+          const SizedBox(height: 4),
+          Text(task['description'] ?? 'No instructions.', style: const TextStyle(color: Colors.white38, fontSize: 11)),
+          const SizedBox(height: 16),
+          Row(
+            children: [
+              _statusBadge(status),
+              const Spacer(),
+              if (status != 'DONE' && status != 'CANCELLED')
+                ElevatedButton(
+                  onPressed: onAction,
+                  style: ElevatedButton.styleFrom(
+                    backgroundColor: AppColors.gold,
+                    foregroundColor: Colors.black,
+                    padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 8),
+                    minimumSize: Size.zero,
+                  ),
+                  child: Text(status == 'OPEN' ? 'START' : 'UPDATE', style: const TextStyle(fontSize: 10, fontWeight: FontWeight.bold)),
+                ),
+            ],
+          ),
+        ],
+      ),
+    );
+  }
+
+  Widget _statusBadge(String status) {
+    Color color = Colors.blue;
+    if (status == 'IN_PROGRESS') color = Colors.orange;
+    if (status == 'DONE') color = Colors.green;
+    if (status == 'BLOCKED') color = Colors.red;
+    if (status == 'CANCELLED') color = Colors.grey;
