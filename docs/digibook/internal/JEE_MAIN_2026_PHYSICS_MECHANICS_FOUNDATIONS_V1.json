        "siUnits": "m/s",
        "condition": "Always applicable for average speed",
        "commonError": "Confusing with displacement for velocity",
        "authorizedAtomId": "JEE_2026_PHY_U01_CH01_TOP05_001"
      },
      {
        "id": "FOR_02",
        "formula": "V_avg = Total Displacement / Total Time",
        "symbols": "V_avg: average velocity",
        "siUnits": "m/s",
        "condition": "Always applicable for average velocity",
        "commonError": "Confusing with total distance",
        "authorizedAtomId": "JEE_2026_PHY_U01_CH01_TOP05_001"
      },
      {
        "id": "FOR_03",
        "formula": "a = (v - u) / t",
        "symbols": "a: acceleration, v: final vel, u: initial vel, t: time",
        "siUnits": "m/s^2",
        "condition": "Definition of average acceleration",
        "commonError": "Using speed instead of velocity vector",
        "authorizedAtomId": "JEE_2026_PHY_U01_CH01_TOP05_001"
      },
      {
        "id": "FOR_04",
        "formula": "v = u + at",
        "symbols": "v: final, u: initial, a: acceleration, t: time",
        "siUnits": "m/s",
        "condition": "Constant acceleration only",
        "commonError": "Using it for varying acceleration",
        "authorizedAtomId": "JEE_2026_PHY_U01_CH01_TOP05_001"
      },
      {
        "id": "FOR_05",
        "formula": "s = ut + 0.5 * at^2",
        "symbols": "s: displacement, u: initial, a: acceleration, t: time",
        "siUnits": "m",
        "condition": "Constant acceleration only",
