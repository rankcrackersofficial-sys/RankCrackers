    "workedExamples": [
      {
        "id": "WE_01",
        "authorizedAtomId": "JEE_2026_PHY_U01_CH01_TOP05_001",
        "concept": "Distance vs Displacement",
        "given": "x1=+2m, x2=+10m, x3=+5m",
        "find": "Total Distance, Net Displacement",
        "signConvention": "Right is positive",
        "principleUsed": "Path length vs Change in position",
        "steps": ["Path 1: 10-2=8", "Path 2: |5-10|=5", "Dist=8+5=13", "Disp=5-2=+3"],
        "finalResult": "Dist: 13m, Disp: +3m",
        "units": "m",
        "reasonablenessCheck": "Dist >= |Disp|",
        "commonError": "Thinking displacement is total path",
        "sourceType": "ORIGINAL_TEACHING_EXAMPLE",
        "pyqClaim": false,
        "officialAnswerKey": false
      },
      {
        "id": "WE_02",
        "authorizedAtomId": "JEE_2026_PHY_U01_CH01_TOP05_001",
        "concept": "Avg Speed vs Velocity",
        "given": "100m East in 20s, 40m West in 10s",
        "find": "Avg Speed, Avg Velocity",
        "signConvention": "East is positive",
        "principleUsed": "v_avg = Disp/Time",
        "steps": ["Dist=140", "Time=30", "Disp=+60", "Speed=140/30=4.67", "Vel=60/30=2.0"],
        "finalResult": "Speed: 4.67 m/s, Vel: 2.0 m/s East",
        "units": "m/s",
        "reasonablenessCheck": "Speed > |Vel| due to turn",
        "commonError": "Using distance for velocity",
        "sourceType": "ORIGINAL_TEACHING_EXAMPLE",
        "pyqClaim": false,
        "officialAnswerKey": false
      },
      {
        "id": "WE_03",
        "authorizedAtomId": "JEE_2026_PHY_U01_CH01_TOP05_001",
        "concept": "Slope of x-t graph",
        "given": "Straight line (0,0) to (5,25)",
        "find": "Velocity",
        "signConvention": "Standard Cartesian",
        "principleUsed": "v = slope of x-t",
        "steps": ["dy = 25", "dx = 5", "slope = 25/5 = 5"],
        "finalResult": "5 m/s",
        "units": "m/s",
        "reasonablenessCheck": "Positive slope -> positive velocity",
        "commonError": "Thinking height is speed",
        "sourceType": "ORIGINAL_TEACHING_EXAMPLE",
        "pyqClaim": false,
        "officialAnswerKey": false
      },
      {
        "id": "WE_04",
        "authorizedAtomId": "JEE_2026_PHY_U01_CH01_TOP05_001",
        "concept": "Area of v-t graph",
        "given": "v=5m/s from t=0 to 4",
        "find": "Displacement",
        "signConvention": "Above axis positive",
        "principleUsed": "Disp = Area of v-t",
        "steps": ["Area = height * width", "Area = 5 * 4 = 20"],
        "finalResult": "20 m",
        "units": "m",
        "reasonablenessCheck": "Dimensionally correct L/T * T = L",
        "commonError": "Calculating slope instead of area",
        "sourceType": "ORIGINAL_TEACHING_EXAMPLE",
        "pyqClaim": false,
        "officialAnswerKey": false
      },
      {
        "id": "WE_05",
        "authorizedAtomId": "JEE_2026_PHY_U01_CH01_TOP05_001",
        "concept": "UAM equations",
        "given": "u=0, a=2, t=5",
        "find": "v, s",
        "signConvention": "Forward positive",
        "principleUsed": "Kinematic equations",
        "steps": ["v = 0 + 2*5 = 10", "s = 0 + 0.5*2*25 = 25"],
        "finalResult": "v: 10 m/s, s: 25 m",
        "units": "m/s, m",
        "reasonablenessCheck": "Values consistent with v^2=u^2+2as",
        "commonError": "Forgetting 1/2 in s formula",
        "sourceType": "ORIGINAL_TEACHING_EXAMPLE",
        "pyqClaim": false,
        "officialAnswerKey": false
      },
      {
        "id": "WE_06",
        "authorizedAtomId": "JEE_2026_PHY_U01_CH01_TOP06_001",
        "concept": "Newton's First Law / Static Equilibrium",
        "given": "1kg book at rest on table, gravity = 9.8N",
        "find": "Net external force",
        "signConvention": "Up is positive",
        "principleUsed": "NLM 1: Static equilibrium implies zero acceleration",
        "steps": ["Book remains at rest, so a=0", "Zero acceleration implies net force is zero", "Weight is balanced by normal force"],
        "finalResult": "Net external force is zero",
        "units": "N",
        "reasonablenessCheck": "If net force != 0, it would move",
        "commonError": "Assuming net force is 9.8N",
        "sourceType": "ORIGINAL_TEACHING_EXAMPLE",
        "pyqClaim": false,
        "officialAnswerKey": false
      },
      {
        "id": "WE_07",
        "authorizedAtomId": "JEE_2026_PHY_U01_CH01_TOP06_001",
        "concept": "Qualitative Inertia Comparison",
        "given": "10kg bicycle vs 2000kg car",
        "find": "Which is harder to start moving?",
        "signConvention": "N/A",
        "principleUsed": "Inertia is resistance to change in state; measured by mass",
        "steps": ["Mass of car >> Mass of bike", "Greater mass means greater inertia", "Higher inertia means higher resistance to change"],
        "finalResult": "Car is harder to start due to higher mass/inertia",
        "units": "N/A",
        "reasonablenessCheck": "Matches physical intuition",
        "commonError": "Thinking inertia is a force",
        "sourceType": "ORIGINAL_TEACHING_EXAMPLE",
        "pyqClaim": false,
        "officialAnswerKey": false
      }
