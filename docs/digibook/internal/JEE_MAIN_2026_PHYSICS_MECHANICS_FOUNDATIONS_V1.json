    "misconceptionRegister": [
      {
        "id": "MIS_01",
        "incorrectBelief": "Distance and displacement are always equal.",
        "correctPrinciple": "Displacement is directed change in position; Distance is total path.",
        "correctiveExample": "Walking in a circle has zero displacement but non-zero distance.",
        "authorizedAtomId": "JEE_2026_PHY_U01_CH01_TOP05_001"
      },
      {
        "id": "MIS_02",
        "incorrectBelief": "Speed and velocity are identical.",
        "correctPrinciple": "Velocity is a vector (has direction); Speed is scalar.",
        "correctiveExample": "Cars moving North and South at 60 km/h have same speed but different velocities.",
        "authorizedAtomId": "JEE_2026_PHY_U01_CH01_TOP05_001"
      },
      {
        "id": "MIS_03",
        "incorrectBelief": "Negative velocity means slowing down.",
        "correctPrinciple": "Negative sign only indicates direction in 1D.",
        "correctiveExample": "Moving at -20 m/s with acceleration -5 m/s^2 is speeding up backwards.",
        "authorizedAtomId": "JEE_2026_PHY_U01_CH01_TOP05_001"
      },
      {
        "id": "MIS_04",
        "incorrectBelief": "Zero velocity means zero acceleration.",
        "correctPrinciple": "Velocity can be zero momentarily while acceleration acts.",
        "correctiveExample": "A ball at the peak of its flight has v=0 but a=g.",
        "authorizedAtomId": "JEE_2026_PHY_U01_CH01_TOP05_001"
      },
      {
        "id": "MIS_05",
        "incorrectBelief": "A moving object always needs a force to keep moving.",
        "correctPrinciple": "No net force is needed for uniform straight-line motion (NLM 1).",
        "correctiveExample": "Voyager spacecraft moves through space without fuel once at constant velocity.",
        "authorizedAtomId": "JEE_2026_PHY_U01_CH01_TOP06_001"
      },
      {
        "id": "MIS_06",
        "incorrectBelief": "Inertia is a force.",
        "correctPrinciple": "Inertia is an inherent property of matter (resistance to change).",
        "correctiveExample": "Mass doesn't push; it just resists acceleration.",
        "authorizedAtomId": "JEE_2026_PHY_U01_CH01_TOP06_001"
      },
      {
        "id": "MIS_07",
        "incorrectBelief": "Heavier objects always fall faster.",
        "correctPrinciple": "In a vacuum, all objects fall with same acceleration 'g'.",
        "correctiveExample": "Hammer and feather drop on the moon.",
        "authorizedAtomId": "JEE_2026_PHY_U01_CH01_TOP05_001"
      },
      {
        "id": "MIS_08",
        "incorrectBelief": "Position-time graph height represents speed.",
        "correctPrinciple": "Slope of the x-t graph represents velocity/speed.",
        "correctiveExample": "A parked car far from origin has high height but zero slope.",
        "authorizedAtomId": "JEE_2026_PHY_U01_CH01_TOP05_001"
      }
