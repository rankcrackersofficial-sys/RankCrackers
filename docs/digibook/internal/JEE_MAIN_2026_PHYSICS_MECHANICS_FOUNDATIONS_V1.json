      },
      {
        "id": "FOR_06",
        "formula": "v^2 = u^2 + 2as",
        "symbols": "v: final, u: initial, a: acceleration, s: displacement",
        "siUnits": "m/s",
        "condition": "Constant acceleration only",
        "commonError": "Using distance instead of displacement",
