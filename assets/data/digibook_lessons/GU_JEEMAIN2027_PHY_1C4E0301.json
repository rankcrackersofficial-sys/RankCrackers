          "exampleId": "EX_GU_JEEMAIN2027_PHY_1C4E0301_01",
          "title": "Acceleration of a Solid Cylinder Rolling Down Incline",
          "problemStatement": "Calculate acceleration of a solid cylinder ($k^2/R^2 = 1/2$) rolling down a $30^\\\\circ$ incline ($g = 9.8\\\\text{ m/s}^2$).",
          "stepByStepSolution": [
            "Step 1: Identify $\\\\theta = 30^\\\\circ$ ($\\\\sin 30^\\\\circ = 0.5$), $k^2/R^2 = 0.5$, $g = 9.8\\\\text{ m/s}^2$.",
            "Step 2: Apply formula: $a_{\\\\text{cm}} = \\\\frac{g \\\\sin 30^\\\\circ}{1 + 0.5} = \\\\frac{9.8 \\\\times 0.5}{1.5} = \\\\frac{4.9}{1.5} \\\\approx 3.27\\\\text{ m/s}^2$."
          ],
          "finalAnswer": "a_{\\\\text{cm}} \\\\approx 3.27\\\\text{ m/s}^2",
