        {
          "name": "Total Linear Momentum of System",
          "formula": "\\vec{P}_{total} = M \\vec{V}_{cm} = \\sum_{i=1}^n m_i \\vec{v}_i",
          "constraints": "System of n particles of total mass M",
          "boundFactIds": [
