      "workedExamples": [
        {
          "exampleId": "EX_GU_JEEMAIN2027_PHY_REM_0003_01",
          "title": "Recoil Velocity of Exploding Shell Pieces",
          "problemStatement": "A stationary shell of mass 4 kg bursts into two pieces of masses 1 kg and 3 kg. If the 1 kg piece flies off with speed 30 m/s, find the velocity of the 3 kg piece.",
          "stepByStepSolution": [
            "Step 1: Initial state: System is at rest, so initial momentum P_initial = 0.",
            "Step 2: Explosion involves only internal forces, so F_ext = 0 and total linear momentum is conserved: P_final = P_initial = 0.",
            "Step 3: P_final = m1*v1 + m2*v2 = (1)*(30) + (3)*v2 = 0.",
            "Step 4: Solve for v2: 30 + 3*v2 = 0 ==> v2 = -10 m/s."
          ],
          "finalAnswer": "v2 = -10 m/s (in opposite direction to the 1 kg piece)",
          "difficulty": "EASY",
          "targetAtomicFactIds": [
            "AF_GU_JEEMAIN2027_PHY_REM_0003_54DD92F9"
          ],
          "isVerified": true
        }
      ],
