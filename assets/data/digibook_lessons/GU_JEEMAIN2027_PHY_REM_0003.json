      "blocks": [
        {
          "blockId": "BLK_GU_JEEMAIN2027_PHY_REM_0003_01",
          "semanticAnchorId": "ANCHOR_MOMENTUM_CM_VELOCITY",
          "title": "1. Total Linear Momentum and CM Velocity",
          "contentMarkdown": "The velocity of the centre of mass is $$\\vec{V}_{cm} = \\frac{1}{M}\\sum m_i \\vec{v}_i = \\frac{\\vec{P}_{total}}{M}$$. The total linear momentum of a system of particles is equal to the product of total mass M and the velocity of its centre of mass: $$\\vec{P}_{total} = M \\vec{V}_{cm}$$.",
          "boundAtomicFactIds": [
            "AF_GU_JEEMAIN2027_PHY_REM_0003_8DE8B549",
            "AF_GU_JEEMAIN2027_PHY_REM_0003_2E151437"
          ]
        },
        {
          "blockId": "BLK_GU_JEEMAIN2027_PHY_REM_0003_02",
          "semanticAnchorId": "ANCHOR_NEWTON_SECOND_LAW_SYSTEM",
          "title": "2. Newton's Second Law for System of Particles & Conservation",
          "contentMarkdown": "Differentiating gives $$M \\vec{A}_{cm} = \\vec{F}_{ext}$$, because internal forces cancel in pairs by Newton's third law ($$\\sum \\vec{F}_{int} = 0$$). The centre of mass moves as if all mass and external forces were concentrated at that point. If $$\\vec{F}_{ext} = 0$$, then $$\\vec{A}_{cm} = 0$$, so $$\\vec{V}_{cm} = \\text{constant}$$ and total linear momentum $$\\vec{P}_{total} = \\text{constant}$$.",
          "boundAtomicFactIds": [
            "AF_GU_JEEMAIN2027_PHY_REM_0003_25754C33",
            "AF_GU_JEEMAIN2027_PHY_REM_0003_D5235CF0",
            "AF_GU_JEEMAIN2027_PHY_REM_0003_54DD92F9",
            "AF_GU_JEEMAIN2027_PHY_REM_0003_AB75C5FB"
          ]
        }
      ],
