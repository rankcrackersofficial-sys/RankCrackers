      "blocks": [
        {
          "blockId": "BLK_GU_JEEMAIN2027_PHY_65A072BD_CONCEPTS_01",
          "semanticAnchorId": "ANCHOR__65A072BD_1",
          "title": "1. Key Academic Principles: Work Done by a Constant and Variable Force, Kinetic Energy, Work-Energy Theorem",
          "contentMarkdown": "Work done by a constant force F during displacement d is defined as the scalar product W = F . d = F * d * cos(theta). Kinetic energy of an object of mass m moving with velocity v is given by K = (1/2) * m * v^2 = p^2 / (2m). The Work-Energy Theorem states that the work done by the net force on a particle equals the change in its kinetic energy: W_net = Delta K. For a variable force F(x), the work done during displacement from initial position to final position is W = Integral F(x) dx.",
          "boundAtomicFactIds": [
            "AF_GU_JEEMAIN2027_PHY_65A072BD_B40F5BD7",
            "AF_GU_JEEMAIN2027_PHY_65A072BD_EDF9BC49",
            "AF_GU_JEEMAIN2027_PHY_65A072BD_70EE9783",
            "AF_GU_JEEMAIN2027_PHY_65A072BD_84A1DF1B"
          ]
        },
        {
          "blockId": "BLK_GU_JEEMAIN2027_PHY_65A072BD_CONCEPTS_02",
          "semanticAnchorId": "ANCHOR__65A072BD_2",
          "title": "2. Key Academic Principles: Work Done by a Constant and Variable Force, Kinetic Energy, Work-Energy Theorem",
          "contentMarkdown": "Work done is positive for acute angles, zero at 90 degrees, and negative for obtuse angles between force and displacement. Kinetic energy of a physical body is always non-negative. Work is said to be done by a force when the point of application of the force undergoes a displacement. d = F * d * cos(theta), where theta is the angle between force F and displacement vector d.",
          "boundAtomicFactIds": [
            "AF_GU_JEEMAIN2027_PHY_65A072BD_C59D7132",
            "AF_GU_JEEMAIN2027_PHY_65A072BD_0E021E0D",
            "AF_GU_JEEMAIN2027_PHY_65A072BD_CA03C134",
            "AF_GU_JEEMAIN2027_PHY_65A072BD_9A67ECE6"
          ]
        },
        {
          "blockId": "BLK_GU_JEEMAIN2027_PHY_65A072BD_CONCEPTS_03",
          "semanticAnchorId": "ANCHOR__65A072BD_3",
          "title": "3. Key Academic Principles: Work Done by a Constant and Variable Force, Kinetic Energy, Work-Energy Theorem",
          "contentMarkdown": "Work is a scalar quantity with SI unit joule (J = N*m). Work done is positive if 0 <= theta < 90 deg, zero if theta = 90 deg (e.g. work done by centripetal force is zero), and negative if 90 deg < theta <= 180 deg (e.g. The work-energy theorem holds identically for both constant and variable forces.",
          "boundAtomicFactIds": [
            "AF_GU_JEEMAIN2027_PHY_65A072BD_CD1FF257",
            "AF_GU_JEEMAIN2027_PHY_65A072BD_7146D319",
            "AF_GU_JEEMAIN2027_PHY_65A072BD_1E9739B7",
            "AF_GU_JEEMAIN2027_PHY_65A072BD_6CB4BE87"
          ]
        }
      ],
