      "workedExamples": [
        {
          "exampleId": "EX_GU_JEEMAIN2027_PHY_057CEE13_01_ROUND_TRIP_DISPLACEMENT",
          "title": "Round-Trip Average Speed and Velocity",
          "problemStatement": "A car travels from point A to B along a straight line of length $120\\text{ m}$ in $4\\text{ s}$, and returns immediately to A in $6\\text{ s}$. Find its average speed and average velocity for the whole trip.",
          "stepByStepSolution": [
            "Step 1: Calculate total path length: $d = 120\\text{ m} + 120\\text{ m} = 240\\text{ m}$.",
            "Step 2: Calculate total time taken: $\\Delta t = 4\\text{ s} + 6\\text{ s} = 10\\text{ s}$.",
            "Step 3: Compute average speed: $s_{\\text{avg}} = \\frac{240\\text{ m}}{10\\text{ s}} = 24\\text{ m/s}$.",
            "Step 4: Compute displacement: Since the car returns to its starting point A, $\\Delta x = 0\\text{ m}$.",
            "Step 5: Compute average velocity: $v_{\\text{avg}} = \\frac{0\\text{ m}}{10\\text{ s}} = 0\\text{ m/s}$."
          ],
          "finalAnswer": "Average speed = 24 m/s; Average velocity = 0 m/s.",
          "difficulty": "EASY",
          "targetAtomicFactIds": [
            "AF_GU_JEEMAIN2027_PHY_057CEE13_41439691",
            "AF_GU_JEEMAIN2027_PHY_057CEE13_BAB1AAFF",
            "AF_GU_JEEMAIN2027_PHY_057CEE13_DE97A799"
          ],
          "isVerified": true
