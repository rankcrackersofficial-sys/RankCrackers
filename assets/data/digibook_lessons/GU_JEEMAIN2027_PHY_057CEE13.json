      "formulaTable": [
        {
          "name": "Displacement Definition",
          "formula": "\\Delta x = x_2 - x_1",
          "constraints": "x1 and x2 are positions at times t1 and t2",
          "boundFactIds": [
            "AF_GU_JEEMAIN2027_PHY_057CEE13_A000AC8C"
          ]
        },
        {
          "name": "Average Velocity",
          "formula": "v_{\\text{avg}} = \\frac{\\Delta x}{\\Delta t} = \\frac{x_2 - x_1}{t_2 - t_1}",
          "constraints": "Vector quantity; can be positive, negative, or zero",
          "boundFactIds": [
            "AF_GU_JEEMAIN2027_PHY_057CEE13_BAB1AAFF"
          ]
        },
        {
          "name": "Average Speed",
          "formula": "s_{\\text{avg}} = \\frac{\\text{Total Path Length}}{\\text{Total Time Interval}}",
          "constraints": "Scalar quantity; always >= |v_avg|",
          "boundFactIds": [
            "AF_GU_JEEMAIN2027_PHY_057CEE13_41439691"
          ]
        },
        {
          "name": "Displacement-Distance Inequality",
          "formula": "|\\Delta x| \\le \\text{Path Length}",
          "constraints": "Equality holds only for unidirectional rectilinear motion",
          "boundFactIds": [
            "AF_GU_JEEMAIN2027_PHY_057CEE13_DE97A799"
          ]
        }
