      "blocks": [
        {
          "blockId": "BLK_GU_JEEMAIN2027_PHY_0059FC83_CONCEPTS_01_FIRST_LAW_INERTIA_MOMENTUM",
          "semanticAnchorId": "ANCHOR_FIRST_LAW_AND_MOMENTUM",
          "title": "1. Newtons First Law, Inertia, and Linear Momentum",
          "contentMarkdown": "Newtons First Law states that a body remains at rest or in uniform straight-line motion unless acted upon by net external force. Inertia is resistance to change in motion, measured by mass. Linear momentum is $$\\mathbf{p} = m\\\\mathbf{v}$$, a vector in the direction of velocity.",
          "boundAtomicFactIds": [
            "AF_GU_JEEMAIN2027_PHY_0059FC83_C34B2B3B",
            "AF_GU_JEEMAIN2027_PHY_0059FC83_6F4A7B5E",
            "AF_GU_JEEMAIN2027_PHY_0059FC83_37D926D4",
            "AF_GU_JEEMAIN2027_PHY_0059FC83_7EDF8194",
            "AF_GU_JEEMAIN2027_PHY_0059FC83_4583C5F7"
          ]
        },
        {
          "blockId": "BLK_GU_JEEMAIN2027_PHY_0059FC83_CONCEPTS_02_NEWTON_SECOND_LAW",
          "semanticAnchorId": "ANCHOR_NEWTON_SECOND_LAW",
          "title": "2. Newtons Second Law of Motion",
          "contentMarkdown": "Newtons Second Law states that net external force equals the time rate of change of linear momentum: $$\\mathbf{F} = \\frac{d\\mathbf{p}}{dt}$$. For constant mass $m$, this simplifies to $$\\mathbf{F} = m\\mathbf{a}$$.",
          "boundAtomicFactIds": [
            "AF_GU_JEEMAIN2027_PHY_0059FC83_7AB71087",
            "AF_GU_JEEMAIN2027_PHY_0059FC83_39C67303",
            "AF_GU_JEEMAIN2027_PHY_0059FC83_F7BEF1F3"
          ]
        },
        {
          "blockId": "BLK_GU_JEEMAIN2027_PHY_0059FC83_CONCEPTS_03_FORCE_UNITS",
          "semanticAnchorId": "ANCHOR_FORCE_SI_UNITS",
          "title": "3. SI Unit of Force and the Newton Definition",
          "contentMarkdown": "In SI units, force is measured in newtons (N). One newton is defined as the force required to produce an acceleration of $1\\text{ m/s}^2$ in a mass of $1\\text{ kg}$.",
          "boundAtomicFactIds": [
            "AF_GU_JEEMAIN2027_PHY_0059FC83_47406476",
            "AF_GU_JEEMAIN2027_PHY_0059FC83_FA49D7BF"
          ]
        }
      ],
