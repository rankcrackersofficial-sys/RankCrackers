          "exampleId": "EX_GU_JEEMAIN2027_CHE_024AF105_01",
          "title": "Molecular Formula of Glucose from Empirical Formula",
          "problemStatement": "A compound has empirical formula $CH_2O$ (empirical mass $30.03\\\\text{ g/mol}$) and molar mass $180.18\\\\text{ g/mol}$. Find its molecular formula.",
          "stepByStepSolution": [
            "Step 1: Calculate multiplier $n = \\\\frac{\\\\text{Molar Mass}}{\\\\text{Empirical Mass}} = \\\\frac{180.18}{30.03} = 6$.",
            "Step 2: Multiply empirical subscripts by $n = 6$: $(CH_2O)_6 = C_6H_{12}O_6$."
          ],
          "finalAnswer": "C_6H_{12}O_6",
          "difficulty": "EASY",
          "targetAtomicFactIds": [
            "AF_GU_JEEMAIN2027_CHE_024AF105_A7896E62"
          ],
