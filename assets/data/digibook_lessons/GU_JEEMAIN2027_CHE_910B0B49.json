      "workedExamples": [
        {
          "exampleId": "EX_GU_JEEMAIN2027_CHE_910B0B49_01_LIMITING_REAGENT_WATER",
          "title": "Limiting Reagent in Water Synthesis",
          "problemStatement": "$2\\text{ moles of } \\text{H}_2$ react with $2\\text{ moles of } \\text{O}_2$ according to $2\\text{H}_2 + \\text{O}_2 \\rightarrow 2\\text{H}_2\\text{O}$. Identify the limiting reagent and moles of $\\text{H}_2\\text{O}$ formed.",
          "stepByStepSolution": [
            "Step 1: Write stoichiometric requirements: $2\\text{ moles of } \\text{H}_2$ require $1\\text{ mole of } \\text{O}_2$ to form $2\\text{ moles of } \\text{H}_2\\text{O}$.",
            "Step 2: Compare available reactants: $2\\text{ moles of } \\text{H}_2$ are present, which consumes exactly $1\\text{ mole of } \\text{O}_2$.",
            "Step 3: Identify limiting and excess reactants: $\\text{H}_2$ is completely consumed (limiting reagent), leaving $2 - 1 = 1\\text{ mole of } \\text{O}_2$ in excess.",
            "Step 4: Compute product formed based on limiting reagent: $2\\text{ moles of } \\text{H}_2\\text{O}$ are produced."
          ],
          "finalAnswer": "Limiting reagent = H2; H2O formed = 2 moles; Excess O2 remaining = 1 mole.",
          "difficulty": "MEDIUM",
