      "blocks": [
        {
          "blockId": "BLK_GU_JEEMAIN2027_CHE_B6EA7762_CONCEPTS_01_PROPERTIES_AND_UNITS",
          "semanticAnchorId": "ANCHOR_PROPERTIES_AND_UNITS",
          "title": "1. Physical vs. Chemical Properties and SI Units",
          "contentMarkdown": "**Physical properties** (e.g. colour, melting point, density) can be measured without changing the chemical identity of a substance. **Chemical properties** (e.g. combustibility, acidity) require a chemical reaction to occur.\nThe SI system defines seven base units in chemistry: metre ($\\text{m}$), kilogram ($\\text{kg}$), second ($\\text{s}$), ampere ($\\text{A}$), kelvin ($\\text{K}$), mole ($\\text{mol}$), and candela ($\\text{cd}$).",
          "boundAtomicFactIds": [
            "AF_GU_JEEMAIN2027_CHE_B6EA7762_2C85B844",
            "AF_GU_JEEMAIN2027_CHE_B6EA7762_EF395D34"
          ]
        },
        {
          "blockId": "BLK_GU_JEEMAIN2027_CHE_B6EA7762_CONCEPTS_02_MASS_VS_WEIGHT",
          "semanticAnchorId": "ANCHOR_MASS_VS_WEIGHT",
          "title": "2. Invariant Mass vs. Gravitational Weight",
          "contentMarkdown": "**Mass** is the quantity of matter contained in a sample; it is intrinsic and constant regardless of location. **Weight** is the gravitational force exerted on an object ($W = mg$), which varies with local gravitational field strength.",
          "boundAtomicFactIds": [
            "AF_GU_JEEMAIN2027_CHE_B6EA7762_9A9874ED"
          ]
        }
      ],
