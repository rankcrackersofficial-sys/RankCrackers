        {
          "exampleId": "EX_GU_JEEMAIN2027_CHE_B6EA7762_01_MASS_WEIGHT_MOON",
          "title": "Comparing Mass and Weight on Earth vs Moon",
          "problemStatement": "A sample has a mass of $12\\text{ kg}$ on Earth ($g_{\\text{Earth}} = 9.8\\text{ m/s}^2$). What is its mass and weight on the Moon ($g_{\\text{Moon}} = 1.63\\text{ m/s}^2$)?",
          "stepByStepSolution": [
            "Step 1: Mass is an intrinsic property of matter and is invariant with location: $\\text{Mass on Moon} = 12\\text{ kg}$.",
            "Step 2: Calculate weight on Moon: $W_{\\text{Moon}} = m \\cdot g_{\\text{Moon}} = 12\\text{ kg} \\times 1.63\\text{ m/s}^2 = 19.56\\text{ N}$."
          ],
          "finalAnswer": "Mass on Moon = 12 kg (constant); Weight on Moon = 19.56 N.",
          "difficulty": "EASY",
