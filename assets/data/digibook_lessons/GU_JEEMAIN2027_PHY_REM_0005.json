      "workedExamples": [
        {
          "exampleId": "EX_GU_JEEMAIN2027_PHY_REM_0005_01",
          "title": "Acceleration Ratio of Sphere vs Cylinder on Incline",
          "problemStatement": "A solid sphere (k^2/R^2 = 2/5) and a solid cylinder (k^2/R^2 = 1/2) roll down the same incline from rest. Find the ratio of their accelerations a_sphere / a_cylinder.",
          "stepByStepSolution": [
            "Step 1: Formula for pure rolling acceleration: a_cm = (g * sin(theta)) / (1 + k^2/R^2).",
            "Step 2: For solid sphere: 1 + k^2/R^2 = 1 + 2/5 = 7/5 ==> a_sphere = (5/7) * g * sin(theta).",
            "Step 3: For solid cylinder: 1 + k^2/R^2 = 1 + 1/2 = 3/2 ==> a_cylinder = (2/3) * g * sin(theta).",
            "Step 4: Calculate ratio: a_sphere / a_cylinder = [(5/7) * g * sin(theta)] / [(2/3) * g * sin(theta)] = (5/7) / (2/3) = (5/7) * (3/2) = 15/14."
          ],
          "finalAnswer": "a_sphere / a_cylinder = 15 / 14 (≈ 1.071)",
          "difficulty": "MEDIUM",
          "targetAtomicFactIds": [
            "AF_GU_JEEMAIN2027_PHY_REM_0005_B2EB39F9"
          ],
          "isVerified": true
        }
      ],
