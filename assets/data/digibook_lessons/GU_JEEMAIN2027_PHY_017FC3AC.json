          "title": "Energy Stored in a Compressed Spring",
          "problemStatement": "Calculate the potential energy stored in a spring with $k = 400\\\\text{ N/m}$ compressed by $0.05\\\\text{ m}$.",
          "stepByStepSolution": [
            "Step 1: Identify spring constant $k = 400\\\\text{ N/m}$ and displacement $x = 0.05\\\\text{ m}$.",
            "Step 2: Apply formula: $V_s = \\\\frac{1}{2} k x^2 = \\\\frac{1}{2} \\\\times 400 \\\\times (0.05)^2 = 200 \\\\times 0.0025 = 0.5\\\\text{ J}$."
          ],
          "finalAnswer": "V_s = 0.5\\\\text{ J}",
