        {
          "blockId": "BLK_GU_JEEMAIN2027_PHY_017FC3AC_CONCEPTS_02_SPRING_AND_CONSERVATION",
          "semanticAnchorId": "ANCHOR_SPRING_AND_CONSERVATION",
          "title": "2. Ideal Spring Potential Energy and Energy Conservation",
          "contentMarkdown": "An ideal spring exerts restoring force $$F_s = -kx$$ and stores potential energy $$V_s = \\\\frac{1}{2}kx^2$$. Total mechanical energy is conserved: $$\\Delta E = 0$$.",
