          "exampleId": "EX_GU_JEEMAIN2027_PHY_4E89B101_01",
          "title": "Resultant of Two Orthogonal Vectors",
          "problemStatement": "Two vectors of magnitudes $3\\\\text{ N}$ and $4\\\\text{ N}$ act perpendicularly ($\\\\theta = 90^\\\\circ$). Find the resultant magnitude.",
          "stepByStepSolution": [
            "Step 1: Identify $A = 3\\\\text{ N}$, $B = 4\\\\text{ N}$, $\\\\theta = 90^\\\\circ$ ($\\\\cos 90^\\\\circ = 0$).",
            "Step 2: Apply formula: $R = \\\\sqrt{A^2 + B^2 + 2AB\\\\cos 90^\\\\circ} = \\\\sqrt{3^2 + 4^2 + 0} = \\\\sqrt{9 + 16} = 5\\\\text{ N}$."
          ],
          "finalAnswer": "R = 5\\\\text{ N}",
          "difficulty": "EASY",
