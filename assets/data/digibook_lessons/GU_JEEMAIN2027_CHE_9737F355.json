      "blocks": [
        {
          "blockId": "BLK_GU_JEEMAIN2027_CHE_9737F355_CONCEPTS_01",
          "semanticAnchorId": "ANCHOR__9737F355_1",
          "title": "1. Key Academic Principles: Solution Concentrations: Mass Percent and Mole Fraction",
          "contentMarkdown": "Mass percent (w/w %) is defined as [(Mass of solute) / (Total mass of solution)] x 100. Mole fraction (x) is the ratio of moles of a component to the total moles of all components in solution, where the sum of mole fractions equals 1.",
          "boundAtomicFactIds": [
            "AF_GU_JEEMAIN2027_CHE_9737F355_84136E45",
            "AF_GU_JEEMAIN2027_CHE_9737F355_7928B31E"
          ]
        },
        {
          "blockId": "BLK_GU_JEEMAIN2027_CHE_9737F355_CONCEPTS_02",
          "semanticAnchorId": "ANCHOR__9737F355_2",
          "title": "2. Key Academic Principles: Solution Concentrations: Mass Percent and Mole Fraction",
          "contentMarkdown": "For binary solution of A and B: x_A = n_A / (n_A + n_B) and x_B = n_B / (n_A + n_B), where x_A + x_B = 1. Mole fraction is a dimensionless quantity.",
          "boundAtomicFactIds": [
            "AF_GU_JEEMAIN2027_CHE_9737F355_7D868E3D",
