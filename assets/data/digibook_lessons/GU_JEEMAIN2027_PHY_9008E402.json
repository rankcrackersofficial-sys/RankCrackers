      "blocks": [
        {
          "blockId": "BLK_GU_JEEMAIN2027_PHY_9008E402_CONCEPTS_01_UNCERTAINTY_ACCURACY_PRECISION",
          "semanticAnchorId": "ANCHOR_ACCURACY_AND_PRECISION",
          "title": "1. Measurement Uncertainty, Accuracy, and Precision",
          "contentMarkdown": "The result of every measurement by any measuring instrument contains some uncertainty called **error**. **Accuracy** indicates how close a measured value is to the true value of the quantity, whereas **precision** indicates the resolution or limit to which the quantity is measured by the instrument. The smallest value measurable by an instrument is its **least count**, and the associated uncertainty is the least count error.",
          "boundAtomicFactIds": [
            "AF_GU_JEEMAIN2027_PHY_9008E402_5BB4C1F8",
            "AF_GU_JEEMAIN2027_PHY_9008E402_D6FF5DAE",
            "AF_GU_JEEMAIN2027_PHY_9008E402_6B4C0C4F",
            "AF_GU_JEEMAIN2027_PHY_9008E402_A039AEBD",
            "AF_GU_JEEMAIN2027_PHY_9008E402_CEF4A60E",
            "AF_GU_JEEMAIN2027_PHY_9008E402_C4C55D7E",
            "AF_GU_JEEMAIN2027_PHY_9008E402_8AB83234"
          ]
        },
        {
          "blockId": "BLK_GU_JEEMAIN2027_PHY_9008E402_CONCEPTS_02_ABSOLUTE_RELATIVE_PERCENT_ERROR",
          "semanticAnchorId": "ANCHOR_ERROR_FORMULATIONS",
          "title": "2. Absolute, Relative, and Percentage Errors",
          "contentMarkdown": "- **Absolute Error ($|\\Delta a_i|$)**: the magnitude of the difference between the true value and the measured value: $|\\Delta a_i| = |a_{\\text{true}} - a_i|$.\n- **Relative Error**: the ratio of the mean absolute error to the mean measured value: $\\text{Relative Error} = \\frac{\\Delta a_{\\text{mean}}}{a_{\\text{mean}}}$.\n- **Percentage Error**: relative error expressed in percentage: $\\delta a = \\frac{\\Delta a_{\\text{mean}}}{a_{\\text{mean}}} \\times 100\\%$.\nEvery calculated quantity based on measured values also inherits an error.",
          "boundAtomicFactIds": [
            "AF_GU_JEEMAIN2027_PHY_9008E402_AB6CCE8E",
            "AF_GU_JEEMAIN2027_PHY_9008E402_09175661",
            "AF_GU_JEEMAIN2027_PHY_9008E402_A0B38F68",
            "AF_GU_JEEMAIN2027_PHY_9008E402_C084CCD4"
          ]
        },
        {
          "blockId": "BLK_GU_JEEMAIN2027_PHY_9008E402_CONCEPTS_03_SIGNIFICANT_FIGURES_RULES",
          "semanticAnchorId": "ANCHOR_SIGNIFICANT_FIGURES_ARITHMETIC",
          "title": "3. Rules for Arithmetic with Significant Figures",
          "contentMarkdown": "1. **Multiplication & Division**: The final result must retain as many significant figures as the input measurement with the least significant figures.\n2. **Addition & Subtraction**: The final result should retain as many decimal places as are present in the input number with the least decimal places.",
          "boundAtomicFactIds": [
            "AF_GU_JEEMAIN2027_PHY_9008E402_D76BA2D1",
            "AF_GU_JEEMAIN2027_PHY_9008E402_619719C5"
          ]
        }
      ],
