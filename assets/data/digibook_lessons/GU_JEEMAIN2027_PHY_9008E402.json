      "workedExamples": [
        {
          "exampleId": "EX_GU_JEEMAIN2027_PHY_9008E402_01_DENSITY_SIGNIFICANT_FIGURES",
          "title": "Density Calculation with Significant Figures",
          "problemStatement": "The mass of a substance is measured as $4.237\\text{ g}$ and its volume is measured as $2.51\\text{ cm}^3$. Calculate its density to the correct number of significant figures.",
          "stepByStepSolution": [
            "Step 1: State the formula for density: $\\rho = \\frac{\\text{mass}}{\\text{volume}} = \\frac{4.237\\text{ g}}{2.51\\text{ cm}^3}$.",
            "Step 2: Identify significant figures in the inputs: mass has $4$ significant figures; volume has $3$ significant figures.",
            "Step 3: Perform division: $\\rho = 1.6880478...\\text{ g/cm}^3$.",
            "Step 4: Round to $3$ significant figures (the least among inputs): $\\rho = 1.69\\text{ g/cm}^3$."
          ],
          "finalAnswer": "Density = 1.69 g/cm³ (rounded to 3 significant figures).",
          "difficulty": "EASY",
          "targetAtomicFactIds": [
            "AF_GU_JEEMAIN2027_PHY_9008E402_D76BA2D1"
          ],
          "isVerified": true
        },
        {
          "exampleId": "EX_GU_JEEMAIN2027_PHY_9008E402_02_PERCENTAGE_ERROR_COMBINATION",
          "title": "Percentage Error in Kinetic Energy",
          "problemStatement": "The percentage error in measuring mass $m$ is $2\\%$ and in velocity $v$ is $3\\%$. Determine the maximum percentage error in the calculated kinetic energy $E = \\frac{1}{2}mv^2$.",
          "stepByStepSolution": [
            "Step 1: Express kinetic energy formula: $E = \\frac{1}{2}mv^2$.",
            "Step 2: Write relative error combination formula for powers: $\\frac{\\Delta E}{E} = \\frac{\\Delta m}{m} + 2\\left(\\frac{\\Delta v}{v}\\right)$.",
            "Step 3: Substitute percentage errors: $\\delta E = \\delta m + 2\\delta v = 2\\% + 2(3\\%) = 2\\% + 6\\% = 8\\%$."
          ],
          "finalAnswer": "Maximum percentage error in kinetic energy is 8%.",
          "difficulty": "MEDIUM",
          "targetAtomicFactIds": [
            "AF_GU_JEEMAIN2027_PHY_9008E402_A0B38F68",
            "AF_GU_JEEMAIN2027_PHY_9008E402_C084CCD4"
          ],
          "isVerified": true
        }
      ],
