        },
        {
          "blockId": "BLK_GU_JEEMAIN2027_PHY_2218270C_CONCEPTS_02_AXIS_THEOREMS",
          "semanticAnchorId": "ANCHOR_AXIS_THEOREMS",
          "title": "2. Parallel and Perpendicular Axis Theorems",
          "contentMarkdown": "Parallel Axis Theorem: $$I = I_{\\\\text{cm}} + M d^2$$. Perpendicular Axis Theorem for planar laminae: $$I_z = I_x + I_y$$.",
          "boundAtomicFactIds": [
            "AF_GU_JEEMAIN2027_PHY_2218270C_A8BB6369",
            "AF_GU_JEEMAIN2027_PHY_2218270C_D7D82CF3"
          ]
        },
        {
          "blockId": "BLK_GU_JEEMAIN2027_PHY_2218270C_CONCEPTS_03_STANDARD_BODIES",
          "semanticAnchorId": "ANCHOR_STANDARD_BODIES",
          "title": "3. Moments of Inertia of Standard Rigid Bodies",
          "contentMarkdown": "Moments of Inertia for standard bodies: Ring: $I = M R^2$; Disc: $I = \\\\frac{1}{2} M R^2$; Solid Sphere: $I = \\\\frac{2}{5} M R^2$; Thin Rod: $I = \\\\frac{1}{12} M L^2$ (bisector) and $I = \\\\frac{1}{3} M L^2$ (end); Solid Cylinder: $I = \\\\frac{1}{2} M R^2$.",
