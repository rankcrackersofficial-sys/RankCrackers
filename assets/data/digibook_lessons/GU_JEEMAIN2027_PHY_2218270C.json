      "workedExamples": [
        {
          "exampleId": "EX_GU_JEEMAIN2027_PHY_2218270C_01",
          "title": "Parallel Axis Theorem for a Thin Rod",
          "problemStatement": "Using $I_{\\\\text{cm}} = \\\\frac{1}{12}ML^2$ for a thin rod about its bisector, find $I$ about an axis passing through one end.",
          "stepByStepSolution": [
            "Step 1: Distance from center of mass to one end is $d = L/2$.",
            "Step 2: Apply Parallel Axis Theorem: $I = I_{\\\\text{cm}} + M d^2 = \\\\frac{1}{12}ML^2 + M(L/2)^2 = \\\\frac{1}{12}ML^2 + \\\\frac{1}{4}ML^2 = \\\\frac{4}{12}ML^2 = \\\\frac{1}{3}ML^2$."
          ],
          "finalAnswer": "I = \\\\frac{1}{3} M L^2",
          "difficulty": "MEDIUM",
          "targetAtomicFactIds": [
            "AF_GU_JEEMAIN2027_PHY_2218270C_A8BB6369",
            "AF_GU_JEEMAIN2027_PHY_2218270C_19F35CBB"
          ],
