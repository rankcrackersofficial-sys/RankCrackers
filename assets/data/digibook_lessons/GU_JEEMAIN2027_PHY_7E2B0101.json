      "blocks": [
        {
          "blockId": "BLK_GU_JEEMAIN2027_PHY_7E2B0101_CONCEPTS_01",
          "semanticAnchorId": "ANCHOR__7E2B0101_1",
          "title": "1. Key Academic Principles: Centre of Mass of a Two-Particle System and Rigid Body",
          "contentMarkdown": "The centre of mass of a system of particles is the unique point where the entire mass of the system may be considered concentrated. For a two-particle system with masses m1 and m2 at r1 and r2, the centre of mass position vector is R_cm = (m1*r1 + m2*r2) / (m1 + m2). For an n-particle system, the position vector of the centre of mass is R_cm = (1/M) * Sum(m_i * r_i).",
          "boundAtomicFactIds": [
            "AF_GU_JEEMAIN2027_PHY_7E2B0101_84AFE37F",
            "AF_GU_JEEMAIN2027_PHY_7E2B0101_C395E73D",
            "AF_GU_JEEMAIN2027_PHY_7E2B0101_FBCC716C"
          ]
        },
        {
          "blockId": "BLK_GU_JEEMAIN2027_PHY_7E2B0101_CONCEPTS_02",
          "semanticAnchorId": "ANCHOR__7E2B0101_2",
          "title": "2. Key Academic Principles: Centre of Mass of a Two-Particle System and Rigid Body",
          "contentMarkdown": "For a continuous mass distribution with total mass M, the centre of mass is given by R_cm = (1/M) * Integral(r dm). For symmetrical bodies of uniform density, the centre of mass coincides with their geometric centre. The centre of mass of a body does not necessarily lie inside the material of the body.",
          "boundAtomicFactIds": [
            "AF_GU_JEEMAIN2027_PHY_7E2B0101_88553E96",
            "AF_GU_JEEMAIN2027_PHY_7E2B0101_33020B8F",
            "AF_GU_JEEMAIN2027_PHY_7E2B0101_48E93743"
          ]
        },
        {
          "blockId": "BLK_GU_JEEMAIN2027_PHY_7E2B0101_CONCEPTS_03",
          "semanticAnchorId": "ANCHOR__7E2B0101_3",
          "title": "3. Key Academic Principles: Centre of Mass of a Two-Particle System and Rigid Body",
          "contentMarkdown": "for a uniform ring or hollow sphere, centre of mass lies in empty space).",
          "boundAtomicFactIds": [
            "AF_GU_JEEMAIN2027_PHY_7E2B0101_19A82BF0"
          ]
        }
