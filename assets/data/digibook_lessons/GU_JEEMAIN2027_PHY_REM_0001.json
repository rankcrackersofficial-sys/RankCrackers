      "workedExamples": [
        {
          "exampleId": "EX_GU_JEEMAIN2027_PHY_REM_0001_01",
          "title": "Centre of Mass of Two Particles on X-Axis",
          "problemStatement": "Two particles of masses 2 kg and 3 kg are located on the x-axis at x1 = 1 m and x2 = 6 m respectively. Calculate the x-coordinate of the centre of mass.",
          "stepByStepSolution": [
            "Step 1: Identify masses and coordinates: m1 = 2 kg, x1 = 1 m; m2 = 3 kg, x2 = 6 m.",
            "Step 2: Calculate total mass: M = m1 + m2 = 2 + 3 = 5 kg.",
            "Step 3: Apply formula: X_cm = (m1*x1 + m2*x2) / M = (2*1 + 3*6) / 5 = (2 + 18) / 5 = 20 / 5 = 4.0 m."
          ],
          "finalAnswer": "X_cm = 4.0 m",
          "difficulty": "EASY",
          "targetAtomicFactIds": [
            "AF_GU_JEEMAIN2027_PHY_REM_0001_FFBCADBA"
          ],
          "isVerified": true
        }
