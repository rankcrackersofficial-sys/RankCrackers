      "blocks": [
        {
          "blockId": "BLK_GU_JEEMAIN2027_PHY_REM_0001_01",
          "semanticAnchorId": "ANCHOR_CENTRE_OF_MASS_DEF",
          "title": "1. Definition and Multi-Particle Formula",
          "contentMarkdown": "The centre of mass of a system of particles is that unique point where the entire mass of the system may be considered to be concentrated for describing translational motion. For a two-particle system: $$\\vec{R}_{cm} = \\frac{m_1 \\vec{r}_1 + m_2 \\vec{r}_2}{m_1 + m_2}$$. For an n-particle system: $$\\vec{R}_{cm} = \\frac{1}{M} \\sum_{i=1}^n m_i \\vec{r}_i$$.",
          "boundAtomicFactIds": [
            "AF_GU_JEEMAIN2027_PHY_REM_0001_2F036D79",
            "AF_GU_JEEMAIN2027_PHY_REM_0001_FFBCADBA",
            "AF_GU_JEEMAIN2027_PHY_REM_0001_30B893F7"
          ]
        },
        {
          "blockId": "BLK_GU_JEEMAIN2027_PHY_REM_0001_02",
          "semanticAnchorId": "ANCHOR_CENTRE_OF_MASS_COORDINATES",
          "title": "2. Cartesian Coordinates and Continuous Distribution",
          "contentMarkdown": "In Cartesian coordinates: $$X_{cm} = \\frac{1}{M}\\sum m_i x_i$$, $$Y_{cm} = \\frac{1}{M}\\sum m_i y_i$$, $$Z_{cm} = \\frac{1}{M}\\sum m_i z_i$$. For continuous mass distribution: $$\\vec{R}_{cm} = \\frac{1}{M}\\int \\vec{r}\\,dm$$. For uniform symmetric bodies, the centre of mass lies at their geometric centre and can lie in empty space outside the material.",
          "boundAtomicFactIds": [
            "AF_GU_JEEMAIN2027_PHY_REM_0001_47F629A5",
            "AF_GU_JEEMAIN2027_PHY_REM_0001_FAA7E356",
            "AF_GU_JEEMAIN2027_PHY_REM_0001_FA7373F8"
          ]
        }
      ],
