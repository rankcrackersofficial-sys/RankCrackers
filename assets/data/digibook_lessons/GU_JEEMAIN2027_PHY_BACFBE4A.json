        },
        {
          "blockId": "BLK_GU_JEEMAIN2027_PHY_BACFBE4A_CONCEPTS_02",
          "semanticAnchorId": "ANCHOR__BACFBE4A_2",
          "title": "2. Key Academic Principles: The Universal Law of Gravitation, Gravitational Constant",
          "contentMarkdown": "The Principle of Superposition states that the net gravitational force on a particle is the vector sum of individual forces from all other particles. The gravitational constant G is independent of the intervening medium, temperature, and nature of the interacting bodies. Gravitational force forms an action-reaction pair obeying Newton's third law: F_12 = - F_21.",
          "boundAtomicFactIds": [
            "AF_GU_JEEMAIN2027_PHY_BACFBE4A_F16CA48C",
            "AF_GU_JEEMAIN2027_PHY_BACFBE4A_BE4CD636",
