      "blocks": [
        {
          "blockId": "BLK_GU_JEEMAIN2027_PHY_AD1F2FDA_CONCEPTS_01_INSTANTANEOUS_KINEMATICS",
          "semanticAnchorId": "ANCHOR_INSTANTANEOUS_KINEMATICS",
          "title": "1. Instantaneous Velocity and Acceleration",
          "contentMarkdown": "- **Instantaneous Velocity ($v$)**: the rate of change of position with time: $v = \\frac{dx}{dt}$. Instantaneous speed is always equal to $|v|$.\n- **Instantaneous Acceleration ($a$)**: the rate of change of velocity with time: $a = \\frac{dv}{dt} = \\frac{d^2x}{dt^2}$.\n- **Average Acceleration ($a_{\\text{avg}}$)**: over time interval $\\Delta t$: $a_{\\text{avg}} = \\frac{v_2 - v_1}{t_2 - t_1} = \\frac{\\Delta v}{\\Delta t}$.",
          "boundAtomicFactIds": [
            "AF_GU_JEEMAIN2027_PHY_AD1F2FDA_CAEE4A04",
            "AF_GU_JEEMAIN2027_PHY_AD1F2FDA_413975B7",
            "AF_GU_JEEMAIN2027_PHY_AD1F2FDA_191DEAE6",
            "AF_GU_JEEMAIN2027_PHY_AD1F2FDA_463B56D2",
            "AF_GU_JEEMAIN2027_PHY_AD1F2FDA_6CC5D22A"
          ]
        },
        {
          "blockId": "BLK_GU_JEEMAIN2027_PHY_AD1F2FDA_CONCEPTS_02_EQUATIONS_OF_MOTION",
          "semanticAnchorId": "ANCHOR_EQUATIONS_OF_MOTION",
          "title": "2. Kinematic Equations for Uniformly Accelerated Motion",
          "contentMarkdown": "For constant acceleration $a$ along a straight line:\n1. Velocity-Time: $v = v_0 + at$\n2. Position-Time: $x - x_0 = v_0 t + \\frac{1}{2}at^2$\n3. Velocity-Displacement: $v^2 = v_0^2 + 2a(x - x_0)$",
          "boundAtomicFactIds": [
            "AF_GU_JEEMAIN2027_PHY_AD1F2FDA_494EB9B8",
            "AF_GU_JEEMAIN2027_PHY_AD1F2FDA_9F55300C",
            "AF_GU_JEEMAIN2027_PHY_AD1F2FDA_30B16264"
          ]
        },
        {
          "blockId": "BLK_GU_JEEMAIN2027_PHY_AD1F2FDA_CONCEPTS_03_FREE_FALL",
          "semanticAnchorId": "ANCHOR_FREE_FALL_GRAVITY",
          "title": "3. Free Fall Under Gravity",
          "contentMarkdown": "An object released near Earth's surface in the absence of air resistance undergoes free fall with a constant downward acceleration of magnitude $g \\approx 9.8\\text{ m/s}^2$, independent of mass.",
          "boundAtomicFactIds": [
            "AF_GU_JEEMAIN2027_PHY_AD1F2FDA_9A286ACA"
          ]
        }
      ],
