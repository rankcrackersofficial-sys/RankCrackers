      "workedExamples": [
        {
          "exampleId": "EX_GU_JEEMAIN2027_PHY_AD1F2FDA_01_BALL_THROWN_UPWARD",
          "title": "Maximum Height and Time of Flight under Gravity",
          "problemStatement": "A ball is thrown vertically upward with an initial velocity of $20\\text{ m/s}$ ($g = 10\\text{ m/s}^2$). Find the maximum height reached.",
          "stepByStepSolution": [
            "Step 1: Identify given parameters: $v_0 = 20\\text{ m/s}$, $a = -g = -10\\text{ m/s}^2$, at maximum height $v = 0\\text{ m/s}$.",
            "Step 2: Apply the velocity-displacement relation: $v^2 = v_0^2 + 2a h$.",
            "Step 3: Substitute values: $0 = 20^2 + 2(-10)h \\implies 0 = 400 - 20h \\implies h = 20\\text{ m}$."
          ],
          "finalAnswer": "Maximum height reached is 20 m.",
          "difficulty": "EASY",
          "targetAtomicFactIds": [
            "AF_GU_JEEMAIN2027_PHY_AD1F2FDA_30B16264",
