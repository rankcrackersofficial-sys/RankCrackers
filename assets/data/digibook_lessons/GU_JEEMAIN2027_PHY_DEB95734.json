      "workedExamples": [
        {
          "exampleId": "EX_GU_JEEMAIN2027_PHY_DEB95734_01_SOLID_ANGLE_CALCULATION",
          "title": "Calculating Solid Angle of a Hemisphere",
          "problemStatement": "Calculate the total solid angle subtended by a complete hemisphere at its centre.",
          "stepByStepSolution": [
            "Step 1: State the formula for solid angle: $\\Omega = \\frac{A}{r^2}$, where $A$ is the spherical surface area.",
            "Step 2: The surface area of a hemisphere of radius $r$ is $A = 2\\pi r^2$.",
            "Step 3: Substitute $A$ into the solid angle formula:\n$\\Omega = \\frac{2\\pi r^2}{r^2} = 2\\pi\\text{ steradians (sr)}$."
          ],
          "finalAnswer": "The solid angle subtended by a hemisphere is 2π sr.",
          "difficulty": "EASY",
          "targetAtomicFactIds": [
            "AF_GU_JEEMAIN2027_PHY_DEB95734_3B4860F9"
          ],
          "isVerified": true
        },
        {
          "exampleId": "EX_GU_JEEMAIN2027_PHY_DEB95734_02_BASE_UNITS_IDENTIFICATION",
          "title": "Identifying Base vs Derived Units for Force",
          "problemStatement": "Express the SI derived unit of Force (Newton, $\\text{N}$) strictly in terms of SI base units.",
          "stepByStepSolution": [
            "Step 1: Recall Newton's second law: $F = m \\cdot a$.",
            "Step 2: Identify the base unit of mass $m$: $[m] = \\text{kg}$.",
            "Step 3: Identify the base units of acceleration $a$: $[a] = \\text{m}/\\text{s}^2 = \\text{m}\\cdot\\text{s}^{-2}$.",
            "Step 4: Combine the base units to express Force:\n$1\\text{ N} = 1\\text{ kg}\\cdot\\text{m}\\cdot\\text{s}^{-2}$."
          ],
          "finalAnswer": "1 N = 1 kg·m·s⁻² in SI base units.",
          "difficulty": "EASY",
          "targetAtomicFactIds": [
            "AF_GU_JEEMAIN2027_PHY_DEB95734_C6745CDC",
            "AF_GU_JEEMAIN2027_PHY_DEB95734_5C39C275"
          ],
          "isVerified": true
        }
      ],
