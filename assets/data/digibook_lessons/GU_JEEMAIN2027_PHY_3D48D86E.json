      "workedExamples": [
        {
          "exampleId": "EX_GU_JEEMAIN2027_PHY_3D48D86E_01",
          "title": "Orbital Period Comparison using Keplers Third Law",
          "problemStatement": "If a planet has semi-major axis $a = 4 a_E$ where $a_E$ is Earths orbit, find its period in years.",
          "stepByStepSolution": [
            "Step 1: From Keplers Third Law, $(T/T_E)^2 = (a/a_E)^3$.",
            "Step 2: Substitute $a/a_E = 4$: $(T/T_E)^2 = 4^3 = 64 \\\\implies T/T_E = \\\\sqrt{64} = 8$."
          ],
          "finalAnswer": "T = 8\\\\text{ Earth years}",
          "difficulty": "EASY",
          "targetAtomicFactIds": [
            "AF_GU_JEEMAIN2027_PHY_3D48D86E_4EE99DEA"
          ],
          "isVerified": true
        }
