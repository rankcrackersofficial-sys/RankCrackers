      "blocks": [
        {
          "blockId": "BLK_GU_JEEMAIN2027_PHY_REM_0004_01",
          "semanticAnchorId": "ANCHOR_SCALARS_VECTORS_ADDITION",
          "title": "1. Scalars, Vectors, and Addition Laws",
          "contentMarkdown": "A scalar quantity has magnitude only. A vector quantity has both magnitude and direction and obeys the triangle law or parallelogram law of vector addition. Triangle Law: $$\\vec{R} = \\vec{A} + \\vec{B}$$, where resultant is the closing side of the triangle taken in reverse order.",
          "boundAtomicFactIds": [
            "AF_GU_JEEMAIN2027_PHY_REM_0004_2C492A95",
            "AF_GU_JEEMAIN2027_PHY_REM_0004_50651CFD",
            "AF_GU_JEEMAIN2027_PHY_REM_0004_A994B889"
          ]
        },
        {
          "blockId": "BLK_GU_JEEMAIN2027_PHY_REM_0004_02",
          "semanticAnchorId": "ANCHOR_PARALLELOGRAM_AND_RESOLUTION",
          "title": "2. Parallelogram Law & Rectangular Component Resolution",
          "contentMarkdown": "Parallelogram Law resultant magnitude: $$R = \\sqrt{A^2 + B^2 + 2AB \\cos \\theta}$$. In two dimensions, vector resolution along Cartesian axes gives $$\\vec{A} = A_x \\hat{i} + A_y \\hat{j}$$, where $$A_x = A \\cos \\theta$$ and $$A_y = A \\sin \\theta$$. Magnitude $$|\\vec{A}| = \\sqrt{A_x^2 + A_y^2}$$ and $$\\theta = \\arctan(A_y / A_x)$$.",
          "boundAtomicFactIds": [
            "AF_GU_JEEMAIN2027_PHY_REM_0004_E4D8D1E8",
            "AF_GU_JEEMAIN2027_PHY_REM_0004_C87D2631",
            "AF_GU_JEEMAIN2027_PHY_REM_0004_93E68788"
          ]
        }
      ],
