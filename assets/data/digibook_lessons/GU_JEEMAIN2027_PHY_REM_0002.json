      "workedExamples": [
        {
          "exampleId": "EX_GU_JEEMAIN2027_PHY_REM_0002_01",
          "title": "Centre of Mass Trajectory During Projectile Explosion",
          "problemStatement": "A shell of mass M is fired into the air and explodes into two pieces at the top of its path. Describe the motion of the centre of mass before the fragments hit the ground.",
          "stepByStepSolution": [
            "Step 1: Note that the explosion occurs solely due to internal forces between fragments.",
            "Step 2: By Newton's second law for a system of particles: M * A_cm = F_ext.",
            "Step 3: The only external force acting on the fragments is gravity (F_ext = M*g downwards).",
            "Step 4: Because internal forces cannot alter net external force, A_cm = g downwards throughout.",
            "Step 5: Therefore, the centre of mass continues along the exact original parabolic trajectory."
          ],
          "finalAnswer": "The centre of mass follows the exact original parabolic path under gravity.",
          "difficulty": "MEDIUM",
          "targetAtomicFactIds": [
            "AF_GU_JEEMAIN2027_PHY_REM_0002_34AEE492"
          ],
          "isVerified": true
        }
      ],
