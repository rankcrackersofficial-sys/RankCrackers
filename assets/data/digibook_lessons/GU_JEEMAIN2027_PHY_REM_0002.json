      "blocks": [
        {
          "blockId": "BLK_GU_JEEMAIN2027_PHY_REM_0002_01",
          "semanticAnchorId": "ANCHOR_RIGID_BODY_DEF",
          "title": "1. Rigid Body Definition and Motion Decomposition",
          "contentMarkdown": "A rigid body is a body with a perfectly definite and unchanging shape, such that the distances between all pairs of particles remain fixed under all forces. The general motion of a rigid body can always be represented as a combination of translation of the centre of mass and rotation about an axis passing through the centre of mass.",
          "boundAtomicFactIds": [
            "AF_GU_JEEMAIN2027_PHY_REM_0002_5CCFA784",
            "AF_GU_JEEMAIN2027_PHY_REM_0002_0DA48D55"
          ]
        },
        {
          "blockId": "BLK_GU_JEEMAIN2027_PHY_REM_0002_02",
          "semanticAnchorId": "ANCHOR_RIGID_BODY_KINEMATICS",
          "title": "2. Translational vs Rotational Kinematics & Projectile Explosions",
          "contentMarkdown": "In pure translational motion, all particles have the same velocity and acceleration at any given instant. In pure rotational motion about a fixed axis, all particles move in circles and have the same angular velocity $$\\omega$$. When an airborne projectile explodes, internal forces diverge the fragments, but the centre of mass continues along the exact same parabolic trajectory.",
          "boundAtomicFactIds": [
            "AF_GU_JEEMAIN2027_PHY_REM_0002_ADDF9FF0",
            "AF_GU_JEEMAIN2027_PHY_REM_0002_03A4A4DC",
            "AF_GU_JEEMAIN2027_PHY_REM_0002_34AEE492"
          ]
        }
      ],
