      "blocks": [
        {
          "blockId": "BLK_GU_JEEMAIN2027_PHY_10A164C1_CONCEPTS_01_THIRD_LAW",
          "semanticAnchorId": "ANCHOR_NEWTON_THIRD_LAW",
          "title": "1. Newtons Third Law of Motion",
          "contentMarkdown": "Newtons Third Law states that every action has an equal and opposite reaction: $$\\mathbf{F}_{AB} = -\\\\mathbf{F}_{BA}$$. Action-reaction forces act simultaneously on different bodies and never cancel each other.",
          "boundAtomicFactIds": [
            "AF_GU_JEEMAIN2027_PHY_10A164C1_8E944C2F",
            "AF_GU_JEEMAIN2027_PHY_10A164C1_CA00FA92"
          ]
        },
        {
          "blockId": "BLK_GU_JEEMAIN2027_PHY_10A164C1_CONCEPTS_02_IMPULSE_MOMENTUM",
          "semanticAnchorId": "ANCHOR_IMPULSE_MOMENTUM",
          "title": "2. Impulse and Impulse-Momentum Theorem",
          "contentMarkdown": "Impulse $\\\\mathbf{J}$ is the time integral of force: $$\\mathbf{J} = \\\\int \\\\mathbf{F} dt = \\\\Delta \\\\mathbf{p} = \\\\mathbf{p}_{\\\\text{final}} - \\\\mathbf{p}_{\\\\text{initial}}$$. A large force acting for a short time is an impulsive force.",
          "boundAtomicFactIds": [
            "AF_GU_JEEMAIN2027_PHY_10A164C1_B0CFBBFE",
            "AF_GU_JEEMAIN2027_PHY_10A164C1_B35C7BE0",
            "AF_GU_JEEMAIN2027_PHY_10A164C1_BC6353B4",
            "AF_GU_JEEMAIN2027_PHY_10A164C1_5482452A"
          ]
        },
        {
          "blockId": "BLK_GU_JEEMAIN2027_PHY_10A164C1_CONCEPTS_03_CONSERVATION_COLLISIONS",
          "semanticAnchorId": "ANCHOR_MOMENTUM_CONSERVATION",
          "title": "3. Conservation of Linear Momentum and Gun Recoil",
          "contentMarkdown": "Total momentum of an isolated system is conserved: $$m_1 u_1 + m_2 u_2 = m_1 v_1 + m_2 v_2$$. Gun recoil velocity is $$v_{\\\\text{recoil}} = -\\\\frac{m_{\\\\text{bullet}}}{M_{\\\\text{gun}}} v_{\\\\text{bullet}}$$.",
          "boundAtomicFactIds": [
            "AF_GU_JEEMAIN2027_PHY_10A164C1_E2F4716A",
            "AF_GU_JEEMAIN2027_PHY_10A164C1_12BE6F76",
            "AF_GU_JEEMAIN2027_PHY_10A164C1_BA3ACA98"
          ]
        }
      ],
