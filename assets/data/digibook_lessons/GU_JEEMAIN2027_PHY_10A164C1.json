          "exampleId": "EX_GU_JEEMAIN2027_PHY_10A164C1_01",
          "title": "Gun Recoil Velocity Calculation",
          "problemStatement": "A rifle of mass $M = 4.0\\\\text{ kg}$ fires a bullet of mass $m = 0.02\\\\text{ kg}$ with muzzle speed $v = 400\\\\text{ m/s}$. Find recoil velocity.",
          "stepByStepSolution": [
            "Step 1: Identify $M = 4.0\\\\text{ kg}$, $m = 0.02\\\\text{ kg}$, $v_{\\\\text{bullet}} = 400\\\\text{ m/s}$.",
            "Step 2: Apply conservation of momentum: $v_{\\\\text{recoil}} = -\\\\frac{m}{M} v = -\\\\frac{0.02}{4.0} \\\\times 400 = -2.0\\\\text{ m/s}$."
          ],
          "finalAnswer": "v_{\\\\text{recoil}} = -2.0\\\\text{ m/s}",
          "difficulty": "EASY",
