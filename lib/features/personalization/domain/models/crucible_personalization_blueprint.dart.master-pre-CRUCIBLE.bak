/// RankCrackers governed Crucible Personalization Blueprint Contract.
        )) {
      throw const FormatException(
        'maintain treatment requires masteryMaintenance allocation.',
      );
    }
  }


  Map<String, Object?> toJson() {
    validate();


    return <String, Object?>{
      'schemaVersion': schemaVersion,
      'studentId': studentId,
      'crucibleSessionId': crucibleSessionId,
      'targetAmtnId': targetAmtnId,
      'createdAtUtc': createdAtUtc.toIso8601String(),
      'sourceTreatmentTypes': sourceTreatmentTypes
          .map((type) => type.wireName)
          .toList(growable: false),
      'totalQuestionCount': totalQuestionCount,
      'maximumDurationMinutes': maximumDurationMinutes,
      'allocations': allocations
          .map((allocation) => allocation.toJson())
          .toList(growable: false),
    };
  }
}


extension CruciblePersonalizationBucketTypeWire
    on CruciblePersonalizationBucketType {
  String get wireName {
    switch (this) {
      case CruciblePersonalizationBucketType.diagnosticProbe:
        return 'diagnostic_probe';
      case CruciblePersonalizationBucketType.prerequisiteRepair:
        return 'prerequisite_repair';
      case CruciblePersonalizationBucketType.targetRemediation:
        return 'target_remediation';
      case CruciblePersonalizationBucketType.retentionRetrieval:
        return 'retention_retrieval';
      case CruciblePersonalizationBucketType.fluencyPractice:
        return 'fluency_practice';
      case CruciblePersonalizationBucketType.masteryMaintenance:
        return 'mastery_maintenance';
      case CruciblePersonalizationBucketType.transferCheck:
        return 'transfer_check';
    }
  }
}


