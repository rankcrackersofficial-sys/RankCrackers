/// RankCrackers governed Student Revision Queue Contract.
  Map<String, Object?> toJson() {
    validate();


    return <String, Object?>{
      'schemaVersion': schemaVersion,
      'studentId': studentId,
      'generatedAtUtc': generatedAtUtc.toIso8601String(),
      'items': orderedItems
          .map((item) => item.toJson())
          .toList(growable: false),
    };
  }
}


extension StudentRevisionQueueStateWire
    on StudentRevisionQueueState {
  String get wireName {
    switch (this) {
      case StudentRevisionQueueState.overdue:
        return 'overdue';
      case StudentRevisionQueueState.dueToday:
        return 'due_today';
      case StudentRevisionQueueState.upcoming:
        return 'upcoming';
      case StudentRevisionQueueState.maintenance:
        return 'maintenance';
      case StudentRevisionQueueState.blocked:
        return 'blocked';
      case StudentRevisionQueueState.evidenceNeeded:
        return 'evidence_needed';
      case StudentRevisionQueueState.completed:
        return 'completed';
    }
  }
}


extension StudentRevisionQueueReasonWire
    on StudentRevisionQueueReason {
  String get wireName {
    switch (this) {
      case StudentRevisionQueueReason.retentionFragile:
        return 'retention_fragile';
      case StudentRevisionQueueReason.retentionUnstable:
        return 'retention_unstable';
      case StudentRevisionQueueReason.scheduledReviewDue:
        return 'scheduled_review_due';
      case StudentRevisionQueueReason.healthyMaintenance:
        return 'healthy_maintenance';
      case StudentRevisionQueueReason.staleEvidence:
        return 'stale_evidence';
      case StudentRevisionQueueReason.insufficientEvidence:
        return 'insufficient_evidence';
      case StudentRevisionQueueReason.prerequisiteNotReady:
        return 'prerequisite_not_ready';
      case StudentRevisionQueueReason.completedWithIndependentEvidence:
        return 'completed_with_independent_evidence';
    }
  }
}


extension StudentRevisionUrgencyWire on StudentRevisionUrgency {
  String get wireName {
    switch (this) {
      case StudentRevisionUrgency.low:
        return 'low';
      case StudentRevisionUrgency.medium:
        return 'medium';
      case StudentRevisionUrgency.high:
        return 'high';
      case StudentRevisionUrgency.critical:
        return 'critical';
    }
  }
}
