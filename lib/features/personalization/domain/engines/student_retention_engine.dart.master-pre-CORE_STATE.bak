/// RankCrackers deterministic AMTN Retention Engine.
    if (rawWeight < minimumEvidenceRecencyWeight) {
      return minimumEvidenceRecencyWeight;
    }


    if (rawWeight > 1.0) {
      return 1.0;
    }


    return rawWeight;
  }


  double _retentionHalfLifeDays(
    int successfulRetrievalCount,
  ) {
    if (successfulRetrievalCount <= 1) {
      return 3.0;
    }


    if (successfulRetrievalCount == 2) {
      return 7.0;
    }


    if (successfulRetrievalCount == 3) {
      return 14.0;
    }


    if (successfulRetrievalCount == 4) {
      return 30.0;
    }


    return 60.0;
  }


  double _logBase2(double value) {
    return math.log(value) / math.log(2.0);
  }


  double _clampProbability(double value) {
    if (value < 0.0) {
      return 0.0;
    }


    if (value > 1.0) {
      return 1.0;
    }


    return value;
  }


  void _incrementExclusion(
    Map<StudentRetentionExclusionReason, int> counts,
    StudentRetentionExclusionReason reason,
  ) {
    counts.update(
      reason,
      (value) => value + 1,
      ifAbsent: () => 1,
    );
  }
}


extension StudentRetentionExclusionReasonWire
    on StudentRetentionExclusionReason {
  String get wireName {
    switch (this) {
      case StudentRetentionExclusionReason.duplicateEventId:
        return 'duplicate_event_id';
      case StudentRetentionExclusionReason.invalidEvent:
        return 'invalid_event';
      case StudentRetentionExclusionReason.wrongStudent:
        return 'wrong_student';
      case StudentRetentionExclusionReason.wrongAmtn:
        return 'wrong_amtn';
      case StudentRetentionExclusionReason.futureDatedEvidence:
        return 'future_dated_evidence';
      case StudentRetentionExclusionReason.notRetentionEligible:
        return 'not_retention_eligible';
    }
  }
}
