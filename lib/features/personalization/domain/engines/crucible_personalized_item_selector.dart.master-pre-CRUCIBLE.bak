/// RankCrackers deterministic Personalized Crucible Item Selector.
  }


  void _incrementExclusion(
    Map<CrucibleItemExclusionReason, int> counts,
    CrucibleItemExclusionReason reason,
  ) {
    counts.update(
      reason,
      (value) => value + 1,
      ifAbsent: () => 1,
    );
  }
}


extension CrucibleSelectableItemFormatWire
    on CrucibleSelectableItemFormat {
  String get wireName {
    switch (this) {
      case CrucibleSelectableItemFormat.mcq:
        return 'mcq';
      case CrucibleSelectableItemFormat.numerical:
        return 'numerical';
    }
  }
}


extension CrucibleSelectableItemReadinessWire
    on CrucibleSelectableItemReadiness {
  String get wireName {
    switch (this) {
      case CrucibleSelectableItemReadiness.draft:
        return 'draft';
      case CrucibleSelectableItemReadiness.underReview:
        return 'under_review';
      case CrucibleSelectableItemReadiness.verified:
        return 'verified';
      case CrucibleSelectableItemReadiness.studentReady:
        return 'student_ready';
      case CrucibleSelectableItemReadiness.retired:
        return 'retired';
    }
  }
}


extension CrucibleItemExclusionReasonWire
    on CrucibleItemExclusionReason {
  String get wireName {
    switch (this) {
      case CrucibleItemExclusionReason.invalidItem:
        return 'invalid_item';
      case CrucibleItemExclusionReason.duplicateQuestionId:
        return 'duplicate_question_id';
      case CrucibleItemExclusionReason.wrongAmtn:
        return 'wrong_amtn';
      case CrucibleItemExclusionReason.wrongDifficulty:
        return 'wrong_difficulty';
      case CrucibleItemExclusionReason.formatNotAllowed:
        return 'format_not_allowed';
      case CrucibleItemExclusionReason.inactive:
        return 'inactive';
      case CrucibleItemExclusionReason.notStudentReady:
        return 'not_student_ready';
      case CrucibleItemExclusionReason.missingVerifiedAnswerKey:
        return 'missing_verified_answer_key';
      case CrucibleItemExclusionReason.missingVerifiedSolution:
        return 'missing_verified_solution';
      case CrucibleItemExclusionReason.missingSourceProvenance:
        return 'missing_source_provenance';
      case CrucibleItemExclusionReason.pyqNotAllowed:
        return 'pyq_not_allowed';
      case CrucibleItemExclusionReason.unverifiedPyqClaim:
        return 'unverified_pyq_claim';
    }
  }
}
