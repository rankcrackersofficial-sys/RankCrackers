/// RankCrackers deterministic AMTN Fluency Engine.


    if (acceptableAccuracy) {
      return StudentFluencyPattern.balanced;
    }


    return StudentFluencyPattern.slowAndInaccurate;
  }


  double? _medianDouble(List<double> values) {
    if (values.isEmpty) {
      return null;
    }


    final sorted = List<double>.from(values)..sort();


    final middle = sorted.length ~/ 2;


    if (sorted.length.isOdd) {
      return sorted[middle];
    }


    return (sorted[middle - 1] + sorted[middle]) / 2.0;
  }


  int? _medianInt(List<int> values) {
    if (values.isEmpty) {
      return null;
    }


    final sorted = List<int>.from(values)..sort();


    final middle = sorted.length ~/ 2;


    if (sorted.length.isOdd) {
      return sorted[middle];
    }


    return ((sorted[middle - 1] + sorted[middle]) / 2.0).round();
  }


  void _incrementExclusion(
    Map<StudentFluencyExclusionReason, int> counts,
    StudentFluencyExclusionReason reason,
  ) {
    counts.update(
      reason,
      (value) => value + 1,
      ifAbsent: () => 1,
    );
  }
}


extension StudentFluencyPatternWire on StudentFluencyPattern {
  String get wireName {
    switch (this) {
      case StudentFluencyPattern.unknown:
        return 'unknown';
      case StudentFluencyPattern.slowAndInaccurate:
        return 'slow_and_inaccurate';
      case StudentFluencyPattern.slowButAccurate:
        return 'slow_but_accurate';
      case StudentFluencyPattern.balanced:
        return 'balanced';
      case StudentFluencyPattern.fastAndAccurate:
        return 'fast_and_accurate';
      case StudentFluencyPattern.fastButInaccurate:
        return 'fast_but_inaccurate';
    }
  }
}


extension StudentFluencyExclusionReasonWire
    on StudentFluencyExclusionReason {
  String get wireName {
    switch (this) {
      case StudentFluencyExclusionReason.duplicateEventId:
        return 'duplicate_event_id';
      case StudentFluencyExclusionReason.invalidEvent:
        return 'invalid_event';
      case StudentFluencyExclusionReason.wrongStudent:
        return 'wrong_student';
      case StudentFluencyExclusionReason.wrongAmtn:
        return 'wrong_amtn';
      case StudentFluencyExclusionReason.futureDatedEvidence:
        return 'future_dated_evidence';
      case StudentFluencyExclusionReason.notFluencyEligible:
        return 'not_fluency_eligible';
      case StudentFluencyExclusionReason.missingActiveDuration:
        return 'missing_active_duration';
      case StudentFluencyExclusionReason.missingExpectedDuration:
        return 'missing_expected_duration';
      case StudentFluencyExclusionReason.nonPositiveExpectedDuration:
        return 'non_positive_expected_duration';
      case StudentFluencyExclusionReason.unsupportedAnswerOutcome:
        return 'unsupported_answer_outcome';
    }
  }
}
