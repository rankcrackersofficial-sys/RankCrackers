/// RankCrackers deterministic AMTN Mastery Engine.
      case StudentEvidenceConfidence.unknown:
        return 0.00;


      case StudentEvidenceConfidence.low:
        return 0.00;


      case StudentEvidenceConfidence.medium:
        return 0.85;


      case StudentEvidenceConfidence.high:
        return 1.00;
    }
  }


  double _recencyWeight({
    required DateTime occurredAtUtc,
    required DateTime calculatedAtUtc,
  }) {
    final age =
        calculatedAtUtc.difference(occurredAtUtc);


    if (age.isNegative) {
      return 0.0;
    }


    final ageDays =
        age.inMilliseconds /
        Duration.millisecondsPerDay;


    final rawWeight = math
        .pow(
          0.5,
          ageDays / recencyHalfLifeDays,
        )
        .toDouble();


    if (rawWeight < minimumRecencyWeight) {
      return minimumRecencyWeight;
    }


    if (rawWeight > 1.0) {
      return 1.0;
    }


    return rawWeight;
  }


  double _clampProbability(double value) {
    if (value < 0.0) {
      return 0.0;
    }


    if (value > 1.0) {
      return 1.0;
    }


    return value;
  }


  void _incrementExclusion(
    Map<StudentMasteryExclusionReason, int> counts,
    StudentMasteryExclusionReason reason,
  ) {
    counts.update(
      reason,
      (value) => value + 1,
      ifAbsent: () => 1,
    );
  }
}


extension StudentMasteryExclusionReasonWire
    on StudentMasteryExclusionReason {
  String get wireName {
    switch (this) {
      case StudentMasteryExclusionReason.duplicateEventId:
        return 'duplicate_event_id';


      case StudentMasteryExclusionReason.invalidEvent:
        return 'invalid_event';


      case StudentMasteryExclusionReason.wrongStudent:
        return 'wrong_student';


      case StudentMasteryExclusionReason.wrongAmtn:
        return 'wrong_amtn';


      case StudentMasteryExclusionReason.futureDatedEvidence:
        return 'future_dated_evidence';


      case StudentMasteryExclusionReason.notMasteryEligible:
        return 'not_mastery_eligible';
    }
  }
}
