rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // 🔱 USER ASSETS: Citizens can read/write their own identity folder
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 🔱 PUBLIC ASSETS: Authenticated users can read mission/educational content
    match /assets/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.token.admin == true || request.auth.token.founder == true);
    }

    // 🔱 CERTIFICATES: Users can read their own, only workers can write
    match /certificates/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; // Handled by Render Worker (Admin SDK)
    }

    // 🔱 INGESTION: Sentinel Worker path
    match /ingestion/{allPaths=**} {
      allow read, write: if request.auth != null && (request.auth.token.admin == true || request.auth.token.founder == true);
    }

    // Temporary staging area for the Founder Console's official source-pair
    // upload. The callable finalizer re-verifies bytes against the official
    // URLs before any document is promoted into mission_realms.
    match /ingestion_refinery/mission_source_staging/{allPaths=**} {
      // The Founder Console session may be authenticated before custom-role
      // claims are refreshed. This is staging only; the backend finalizer
      // independently validates the official URL bytes before promotion.
      allow read, write: if request.auth != null;
    }

    // Founder-governed source documents bound to canonical mission authority.
    match /mission_realms/{realmId}/official_documents/{allPaths=**} {
      // Only trusted backend code may write official source bytes. Admin SDK
      // bypasses client rules; a future client upload must use a server-issued
      // scoped upload authorization and finalization flow.
      allow read: if request.auth != null && request.auth.token.founder == true;
      allow write: if false;
    }
  }
}
